---
/** H66/H68 网关页面主体（V130 多语言化）。
 * props: content(产品 JSON), ui(语种 UI，可空=EN), prefix(语种前缀，EN 为 '')。
 * T(k) 取 UI 文案；R(k,vars) 额外替换 {model}/{count} 占位符。 */
import uiEn from '../../data/gateway-i18n/ui.en.json';
import '../../styles/gateway.css';
const { content:c, ui=null, prefix='' }=Astro.props;
const U=Object.assign({},uiEn,ui||{});
const T=(k:string):string=>U[k]||uiEn[k]||k;
const R=(k:string,vars:Record<string,string|number>={}):string=>T(k).replace(/\{(\w+)\}/g,(_,n)=>String(vars[n]||''));
const split=(s:string)=>s.split('\n');
const photo=(g:any)=>'/assets/'+g.imageKey+'.webp';
const productName=T(c.model==='H66'?'productNameH66':'productNameH68');
const tableCaption=T(c.model==='H66'?'tableCaptionH66':'tableCaptionH68');
const emailSubject=R('emailSubject',{model:c.model});
const icons=['M4 13a8 8 0 0 1 16 0M7 13a5 5 0 0 1 10 0M10 13a2 2 0 0 1 4 0M12 16v5','M5 19V9m5 10V5m5 14V2m5 17V7','M4 5h16v14H4zM4 9h16M8 13h3m3 0h3M8 16h8','M12 2 3 6v6c0 5 9 10 9 10s9-5 9-10V6zM8 12l3 3 5-6','M4 12h16M12 4v16M5 5l14 14M5 19 19 5','M4 18l4-7 5 4 7-11M16 4h4v4','M3 4h18v6H3zM3 14h18v6H3zM7 7h1m-1 10h1','M13 2 5 14h6l-1 8 9-13h-7z'];
const countTpl=(k:string,n:number):[string,string]=>{const p=R(k,{count:'\u0000'}).split('\u0000');return [p[0]||'',p[1]||''];};
const selectionItems=[[T('selectionSensorTitle'),T('selectionSensorText')],[T('selectionInstallTitle'),T('selectionInstallText')],[T('selectionSystemTitle'),T('selectionSystemText')]];
// 交互脚本用的本地化字符串（占位符已按型号解析，{objective} 保留给 JS 运行时替换）
const jsI18n={
  emailSubject,
  emailHello:T('emailHello'),
  emailIntro:R('emailIntro',{model:c.model}),
  pleaseAdvise:T('pleaseAdvise'),
  emailRequest:T('emailRequest'),
  emailThanks:T('emailThanks'),
  briefReady:T('briefReady'),
  briefCopied:T('briefCopied'),
  briefCopyFallback:T('briefCopyFallback'),
  wechatCopied:T('wechatCopied'),
  wechatCopyFallback:T('wechatCopyFallback'),
  monitoringObjective:T('monitoringObjective'),
  fieldLabels:{Model:T('emailModel'),Application:T('emailApplication'),Country:T('emailCountry'),'Sensor count':T('emailSensorCount'),'Gateway quantity':T('emailQuantity'),'Sensor models and reporting':T('emailSensorModels'),'Backhaul and platform':T('emailPlatform'),Requirements:T('emailRequirements')},
};
---
<main id="main" class="ht-gateway" data-model={c.model}>
<div class="hero-band">
<img class="hero-background" src="/assets/sensor-hero-background.webp" width="1920" height="1090" alt="" aria-hidden="true" loading="eager" decoding="async"/>
<div class="wrap breadcrumb" aria-label={T('breadcrumbAria')}><a href={`${prefix}/`}>{T('home')}</a><span>/</span><a href={`${prefix}/product/lists/cid/258#cate`}>{T('gatewayCatalog')}</a><span>/</span><span>{productName}</span></div>
<section class="hero wrap" aria-labelledby="hero-title">
<div class="hero-heading"><h1 id="hero-title">{split(c.heroHeading).map((line,i)=><Fragment>{i>0&&<br/>}{line}</Fragment>)}<br/><span>{split(c.heroValue).map((line,i)=><Fragment>{i>0&&<br/>}{line}</Fragment>)}</span></h1></div>
<figure class="hero-visual gateway-product"><img src={'/assets/'+c.image} width={c.imageWidth} height={c.imageHeight} alt={c.imageAlt} fetchpriority="high" loading="eager" decoding="async"/><figcaption><span class="live-dot" aria-hidden="true"></span>{c.caption}</figcaption></figure>
<p class="hero-description">{c.heroDescription}</p>
<div class="hero-actions"><a href="#enquiry" class="button button-primary">{T('discussProject')} <span aria-hidden="true">↗</span></a><a href="#specifications" class="text-link">{T('viewSpecifications')} <span aria-hidden="true">↗</span></a></div>
<div class="hero-proof">{c.proof.map(x=><div><strong>{x.value}</strong><span>{x.label}</span><small>{x.note}</small></div>)}</div>
</section></div>
<nav class="section-nav" aria-label={T('pageNavAria')}><div class="wrap"><a href="#network">{T('networkNav')}</a><a href="#applications">{T('applicationsNav')}</a><a href="#specifications">{T('specificationsNav')}</a><a href="#integration">{T('integrationNav')}</a><a href="#faq">{T('faqNav')}</a><a href="#enquiry" class="nav-quote">{T('requestQuote')} ↗</a></div></nav>
<section class="section features-section" id="features"><div class="wrap"><div class="section-heading compact-heading"><div><p class="eyebrow">{T('featuresEyebrow')}</p><h2>{split(c.featureTitle).map((l,i)=><Fragment>{i>0&&<br/>}{i===0?l:<span>{l}</span>}</Fragment>)}</h2></div><p>{c.featureIntro}</p></div><div class="feature-grid">{c.features.map((f,i)=><article><span class="feature-mark" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={icons[i]}/></svg></span><h3>{f.title}</h3><p>{f.text}</p></article>)}</div></div></section>
<section class="section measurement-section" id="network"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{T('networkEyebrow')}</p><h2>{split(T('networkHeading')).map((l,i)=><Fragment>{i>0&&<br/>}{i===0?l:<span>{l}</span>}</Fragment>)}</h2></div><p>{c.planningIntro}</p></div><div class="measurement-grid">{c.planning.map((p,i)=><article class="measurement-card"><div class="measurement-heading"><span class="measurement-number">0{i+1}</span><span class="measurement-symbol" aria-hidden="true">↗</span></div><h3>{p.title}</h3><p>{p.text}</p><dl><dt>{T('planNetwork')}</dt><dd>{p.brief}</dd></dl><a class="text-link" href="#enquiry">{T('discussNetwork')} ↗</a></article>)}</div><div class="installation-note"><span class="small-label">{T('installationEyebrow')}</span><h3>{split(T('installationHeading')).map((l,i)=><Fragment>{i>0&&<br/>}{l}</Fragment>)}</h3><p>{c.installationText}</p></div></div></section>
<section class="section profile-section" id="operating-profile"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{T('workflowEyebrow')}</p><h2>{split(T('workflowHeading')).map((l,i)=><Fragment>{i>0&&<br/>}{l}</Fragment>)}</h2></div><p>{T('workflowIntro')}</p></div><div class="gateway-workflow">{c.workflow.map((x,i)=><article><span class="step-number">0{i+1}</span><h3>{x.title}</h3><p>{x.text}</p></article>)}</div><div class="profile-note"><div><span class="small-label">{T('coverageEyebrow')}</span><strong>{split(c.coverageTitle).map((l,i)=><Fragment>{i>0&&<br/>}{l}</Fragment>)}</strong></div><p>{c.coverageText}</p></div></div></section>
<section class="section application-section" id="applications"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{T('applicationsEyebrow')}</p><h2>{split(T(c.model==='H66'?'applicationsHeadingH66':'applicationsHeadingH68')).map((l,i)=><Fragment>{i>0&&<br/>}{i===0?l:<span>{l}</span>}</Fragment>)}</h2></div><p>{T(c.model==='H66'?'applicationsIntroH66':'applicationsIntroH68')}</p></div><div class="application-overview"><p>{(()=>{const a=countTpl('categoryCount',c.groups.length),b=countTpl('taskCount',c.groups.reduce((n,g)=>n+g.tasks.length,0));const total=c.groups.reduce((n,g)=>n+g.tasks.length,0);return <Fragment>{a[0]}<strong>{c.groups.length}</strong>{a[1]} <span>/</span> {b[0]}<strong>{total}</strong>{b[1]}</Fragment>;})()}</p><p class="image-note">{T('imageNote')}</p></div><nav class="application-jump-nav" aria-label={T('applicationsAria')}>{c.groups.map(g=><a href={'#group-'+g.id}>{g.jumpLabel}<span>{g.tasks.length}</span></a>)}</nav><div class="application-groups">{c.groups.map((g,i)=><details class="application-group" id={'group-'+g.id} open={i===0}><summary><span><small>{String(i+1).padStart(2,'0')}</small>{g.title}</span><span class="group-count">{R('taskCount',{count:g.tasks.length})} <b aria-hidden="true">+</b></span></summary><div class="application-category-body"><div class="application-visual"><div class="application-media-slot"><figure class="application-category-photo"><img class="application-category-image" src={photo(g)} width="960" height="640" alt={g.imageAlt} loading="lazy" decoding="async"/><figcaption>{g.imageCaption}</figcaption></figure></div><p>{g.intro}</p></div><div class="application-task-list">{g.tasks.map((t,j)=><details class="application-task" id={t.id} open={i===0&&j===0}><summary aria-controls={'scene-photo-'+t.id}><span class="task-heading"><h3>{t.title}</h3><small>{t.networkRole}</small></span><span class="task-toggle" aria-hidden="true">+</span></summary><div class="task-copy"><figure class="application-scene-photo" id={'scene-photo-'+t.id} data-scene-owner={t.id}><img class="application-scene-image" src={photo(g)} width="960" height="640" alt={g.imageAlt} loading="lazy" decoding="async"/><figcaption>{g.imageCaption}</figcaption></figure><p>{t.description}</p><dl><dt>{T('gatewayRole')}</dt><dd>{t.networkRole}</dd><dt>{T('deploymentConsiderations')}</dt><dd>{t.placement}</dd><dt>{T('projectDetails')}</dt><dd>{t.projectBrief}</dd></dl><a href="#enquiry" class="task-cta" data-project-scene={t.title}>{T('discussApplication')} <span aria-hidden="true">↗</span></a></div></details>)}</div></div></details>)}</div></div></section>
<section class="section specifications-section" id="specifications"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{T('specsEyebrow')}</p><h2>{split(T('specsHeading')).map((l,i)=><Fragment>{i>0&&<br/>}{i===0?l:<span>{l}</span>}</Fragment>)}</h2></div><p>{T('specsIntro')}</p></div><div class="gateway-spec-grid"><aside class="model-card"><span class="small-label">{productName}</span><h3>{split(T('specCardHeading')).map((l,i)=><Fragment>{i>0&&<br/>}{l}</Fragment>)}</h3><p>{c.specNote}</p><a href="#enquiry" class="button button-outline">{T('configurationProposal')} ↗</a><a class="text-link" href="#enquiry">{T('requestDatasheet')} ↗</a></aside><div class="spec-table"><table><caption>{tableCaption}</caption><tbody>{c.rows.map(([label,value])=><tr><th scope="row">{label}</th><td>{value}</td></tr>)}</tbody></table></div></div><div class="selection-list"><h3>{T('selectionHeading')}</h3><div>{selectionItems.map(([a,b],i)=><article><span class="step-number">0{i+1}</span><h4>{a}</h4><p>{b}</p></article>)}</div></div></div></section>
<section class="section integration-section" id="integration"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{T('integrationEyebrow')}</p><h2>{split(T('integrationHeading')).map((l,i)=><Fragment>{i>0&&<br/>}{i===0?l:<span>{l}</span>}</Fragment>)}</h2></div><p>{T('integrationIntro')}</p></div><div class="integration-grid"><article><span class="small-label">{T('cloudLabel')}</span><h3>{T('cloudHeading')}</h3><div class="route-flow"><span>{T('loraSensors')}</span><b>→</b><span>{c.model}</span><b>→</b><span>{T('cloudName')}</span></div><p>{T('cloudText')}</p><ul><li>{T('cloudBullet1')}</li><li>{T('cloudBullet2')}</li><li>{T('cloudBullet3')}</li></ul></article><article><span class="small-label">{T('customerLabel')}</span><h3>{T('customerHeading')}</h3><div class="route-flow"><span>{T('sensorRecords')}</span><b>→</b><span>MQTT</span><b>→</b><span>{T('yourPlatform')}</span></div><p>{T('customerText')}</p><ul><li>{T('customerBullet1')}</li><li>{T('customerBullet2')}</li><li>{T('customerBullet3')}</li></ul></article></div><div class="integration-handover"><h3>{T('handoverHeading')}</h3><p>{T('handoverText')}</p><a class="text-link" href="#enquiry">{T('discussIntegration')} ↗</a></div></div></section>
<section class="section faq-section" id="faq"><div class="wrap faq-layout"><div class="faq-intro"><p class="eyebrow">{T('faqEyebrow')}</p><h2>{split(T('faqHeading')).map((l,i)=><Fragment>{i>0&&<br/>}{l}</Fragment>)}</h2><p>{T('faqIntro')}</p><a href="#enquiry" class="text-link">{T('askProject')} ↗</a></div><div class="faq-list">{c.faqs.map((f,i)=><details id={'faq-'+(i+1)} open={i===0}><summary>{f.q}<span aria-hidden="true">+</span></summary><div class="faq-answer"><p>{f.a}</p></div></details>)}</div></div></section>
<section class="section enquiry-section" id="enquiry"><div class="wrap enquiry-layout"><div class="enquiry-intro"><p class="eyebrow">{T('enquiryEyebrow')}</p><h2>{split(T('enquiryHeading')).map((l,i)=><Fragment>{i>0&&<br/>}{i===0?l:<span>{l}</span>}</Fragment>)}</h2><p class="lead">{R('enquiryIntro',{model:c.model})}</p><a class="contact-email" href="mailto:sales@hitelecom.cn">sales@hitelecom.cn ↗</a><div class="enquiry-benefits"><h3>{T('enquiryBenefitsHeading')}</h3><p>{T('enquiryBenefitsText')}</p></div></div><form id="enquiry-form" action="mailto:sales@hitelecom.cn" method="post" enctype="text/plain"><div class="form-heading"><span class="small-label">{T('formEyebrow')}</span><h3>{T('formHeading')}</h3><p>{productName}</p></div><div class="form-fields"><input type="hidden" name="Model" value={c.model}/><div class="field"><label for="application">{T('applicationLabel')}</label><select id="application" name="Application" required><option value="">{T('applicationPlaceholder')}</option>{c.groups.map(g=><optgroup label={g.title}>{g.tasks.map(t=><option value={t.title}>{t.title}</option>)}</optgroup>)}<option>{T('applicationOther')}</option></select></div><div class="field"><label for="country">{T('countryLabel')}</label><input id="country" name="Country" required autocomplete="country-name" maxlength="100" placeholder={T('countryPlaceholder')}/></div><div class="field"><label for="device-count">{T('sensorCountLabel')}</label><input id="device-count" name="Sensor count" type="number" min="1" step="1" inputmode="numeric" placeholder={T('sensorCountPlaceholder')}/></div><div class="field"><label for="quantity">{T('quantityLabel')}</label><input id="quantity" name="Gateway quantity" type="number" min="1" step="1" inputmode="numeric" placeholder={T('pleaseAdvise')}/></div><div class="field full"><label for="sensors">{T('sensorModelsLabel')}</label><input id="sensors" name="Sensor models and reporting" maxlength="800" placeholder={T('sensorModelsPlaceholder')}/></div><div class="field full"><label for="platform">{T('platformLabel')}</label><input id="platform" name="Backhaul and platform" maxlength="800" placeholder={T('platformPlaceholder')}/></div><div class="field full"><label for="requirements">{T('requirementsLabel')}</label><textarea id="requirements" name="Requirements" rows="4" maxlength="3000" placeholder={T('requirementsPlaceholder')}></textarea></div></div><div class="form-actions"><button type="submit" class="button button-primary">{T('prepareEnquiry')} ↗</button><p>{T('reviewHint')}</p></div><div class="enquiry-review" id="enquiry-review" hidden><label for="enquiry-brief">{T('briefLabel')}</label><textarea id="enquiry-brief" rows="10" spellcheck="false"></textarea><div><a class="button button-primary" id="email-brief" href="mailto:sales@hitelecom.cn">{T('openEmail')} ↗</a><button type="button" id="copy-brief" class="button button-outline">{T('copyBrief')}</button></div><p id="brief-status" role="status" aria-live="polite"></p></div><noscript><p class="noscript-note">{T('directEmailIntro')} <a href={'mailto:sales@hitelecom.cn?subject='+encodeURIComponent(emailSubject)}>{T('directEmailLink')}</a>.</p></noscript></form></div></section>
<div class="wrap related-products"><p class="small-label">{T('relatedEyebrow')}</p><a href={`${prefix}/product/${c.model==='H66'?'outdoor-4g-gateway-h68':'indoor-gateway-h66'}`}>{T(c.model==='H66'?'exploreH68':'exploreH66')} ↗</a><a href={`${prefix}/product/lists/cid/261#cate`}>{T('exploreSensors')} ↗</a><a href={`${prefix}/product/temperature-sensor`}>{T('temperatureMonitoring')} ↗</a></div>
</main>
<script type="application/json" id="gw-i18n" set:html={JSON.stringify(jsI18n)}></script>
<script>import './gateway-interactions.js';</script>
