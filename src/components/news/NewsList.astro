---
/**
 * 新闻列表页主体（中英共用）：横幅 → 分类选项卡 → 头条轮播 → 新闻网格 → 空分页占位
 * cat: NewsCat（含 case/blog 动态分类）
 */
import Img from '../Img.astro';
import NewsBanner from './NewsBanner.astro';
import NewsTabs from './NewsTabs.astro';
import { getNewsContent, fmtNewsDate, type NewsCat } from '../../data/news';
import { l, type Locale } from '../../i18n';

interface Props { locale: Locale; cat: NewsCat }
const { locale, cat } = Astro.props;
const d = await getNewsContent(locale);
const catData = d.categories[cat];
const detailHref = (id: string) => `${l(`/news/show/id/${id}`, locale)}`;
---

<NewsBanner locale={locale} />

<div class="clearfix news_1">
  <NewsTabs locale={locale} active={cat} />
  <div class="indexmid">
    <div class="clearfix news_1_1 reveal">
      <div class="swiper-container swiper-container-bannerp" data-carousel="featured">
        <div class="swiper-wrapper">
          {catData.slides.map((s) => (
            <div class="swiper-slide">
              <a href={detailHref(s.id)}>
                <div class="news_1_1_mid">
                  <div class="news_1_1_mid_left">
                    <Img src={s.img} alt={s.title || 'Hitelecom news'} widths={[740, 1478]} sizes="(max-width: 810px) 100vw, 50vw" quality={85} />
                  </div>
                  <div class="news_1_1_mid_right">
                    <div class="news_1_1_mid_right_mid">
                      <div class="daxie news_1_1_mid_right_mid_1">{fmtNewsDate(s.date)}</div>
                      <div class="news_1_1_mid_right_mid_2">{s.title}</div>
                      <div class="news_1_1_mid_right_mid_3">{s.excerpt}</div>
                      <div class="news_1_1_mid_right_mid_4"><span>{d.readmore}</span></div>
                    </div>
                  </div>
                </div>
              </a>
            </div>
          ))}
        </div>
        {catData.slides.length > 1 && (
          <div class="swiper-pagination swiper-pagination-banner2 swiper-pagination-bullets" id="npp"></div>
        )}
      </div>
    </div>
  </div>
</div>

{/* 新闻网格 */}
<div class="clearfix news_2">
  <div class="indexmid">
    <div class="clearfix news_2_1">
      <ul>
        {catData.grid.map((it) => (
          <li class="reveal">
            <a href={detailHref(it.id)}>
              <div class="news_2_1_1">
                <Img src={it.img} alt={it.title || 'Hitelecom news'} widths={[480, 960]} sizes="(max-width: 640px) 100vw, (max-width: 810px) 49vw, 30vw" quality={85} />
              </div>
              <div class="news_2_1_2">
                <div class="news_2_1_2_1 daxie">{fmtNewsDate(it.date)}</div>
                <div class="news_2_1_2_2">{it.title}</div>
                <div class="news_2_1_2_3">{it.excerpt}</div>
                <div class="news_1_1_mid_right_mid_4"><span>{d.readmore}</span></div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
    {/* 原站分页容器为空（每类未超一页），保留同款间距 */}
    <div class="clearfix pro_2_mid_right_3 reveal"></div>
  </div>
</div>

<script>
  // 头条轮播：整幅滑动 + 圆点分页（复刻原站 swiper 行为：800ms、不自动播放、圆点可点）
  document.querySelectorAll<HTMLElement>('[data-carousel="featured"]').forEach((root) => {
    const wrap = root.querySelector<HTMLElement>('.swiper-wrapper');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.swiper-slide'));
    const dotsBox = root.querySelector<HTMLElement>('#npp');
    if (!wrap || slides.length < 2 || !dotsBox) return;
    let idx = 0;
    const dots = slides.map((_, i) => {
      const b = document.createElement('span');
      b.className = 'swiper-pagination-bullet' + (i === 0 ? ' swiper-pagination-bullet-active' : '');
      b.addEventListener('click', () => go(i));
      dotsBox.appendChild(b);
      return b;
    });
    function go(i: number) {
      idx = Math.max(0, Math.min(i, slides.length - 1));
      wrap.style.transition = 'transform .8s';
      wrap.style.transform = `translateX(${-idx * root.clientWidth}px)`;
      dots.forEach((b, j) => b.classList.toggle('swiper-pagination-bullet-active', j === idx));
    }
    // 触屏滑动
    let sx = 0;
    root.addEventListener('touchstart', (e) => (sx = e.touches[0].clientX), { passive: true });
    root.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - sx;
      if (Math.abs(dx) > 40) go(idx + (dx < 0 ? 1 : -1));
    }, { passive: true });
    window.addEventListener('resize', () => go(idx));
  });
</script>
