---
const {index = 0, kind = ''} = Astro.props;
// Original gas-page line weight and icon size, with marks for the confirmed feature set.
const icons = {
  range:['M4 5h16v14H4Z','M8 5v4','M12 5v6','M16 5v4','M8 15h8'],
  resolution:['M3 18h18','M3 18l4-6 3 6 4-13 3 13 4-8','M3 5h5'],
  solar:['M8 7a3 3 0 1 0 0 .01','M8 1v1','M8 12v1','M2 7H1','M14 7h1','M3 2l1 1','M12 11l1 1','M3 12l1-1','M12 3l1-1','M9 16h12v6H9Z','M13 16v-1h4v1','M14 18v2','M13 19h2'],
  sampling:['M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z','M12 7v5l4 2'],
  gas:['M7 4a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z','M17 13a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z','m9 9 6 5','M5 17h4','M7 15v4'],
  pipeline:['M3 5h18v4H3Z','M7 9v12','M17 9v12','M7 15h10','m10 12 3 3-3 3']
};
const label = String(kind).toLowerCase();
const key = /solar|energy|storage|power/.test(label) ? 'solar' : /resolution|ppb/.test(label) ? 'resolution' : /sampling|interval|frequency/.test(label) ? 'sampling' : /range|ppm/.test(label) ? 'range' : /pipeline|process|sample.point/.test(label) ? 'pipeline' : /gas|custom/.test(label) ? 'gas' : Object.keys(icons)[index % 6];
---
<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{icons[key].map(d=><path d={d}/>)}</svg>
