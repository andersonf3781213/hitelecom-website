---
import protectedHeroes from '../../data/protected-heroes.json';
import '../../styles/gateway.css';
import '../../styles/custom.css';
const {content:c,ui:u,shell,locale='en'}=Astro.props;
const originalHero=protectedHeroes[c.id];
const local=p=>(locale==='en'?'':'/'+locale)+p;
const lines=s=>String(s).split('\n');
const photo=(t,g)=>'/assets/'+(t?.imageKey||g.imageKey)+'.webp';
const icons=['M4 13a8 8 0 0 1 16 0M7 13a5 5 0 0 1 10 0M10 13a2 2 0 0 1 4 0M12 16v5','M5 19V9m5 10V5m5 14V2m5 17V7','M4 5h16v14H4zM4 9h16M8 13h3m3 0h3M8 16h8','M12 2 3 6v6c0 5 9 10 9 10s9-5 9-10V6zM8 12l3 3 5-6','M4 12h16M12 4v16M5 5l14 14M5 19 19 5','M4 18l4-7 5 4 7-11M16 4h4v4','M3 4h18v6H3zM3 14h18v6H3zM7 7h1m-1 10h1','M13 2 5 14h6l-1 8 9-13h-7z'];
---
<main id="main" class="ht-gateway custom-detail" data-model={c.id} data-name={c.name}>
<div class="hero-band"><img class="hero-background" src="/assets/sensor-hero-background.webp" width="1920" height="1090" alt="" aria-hidden="true"/><div class="wrap breadcrumb"><a href={local('/')}>{shell.home}</a><span>/</span><a href={local('/product/lists/cid/256#cate')}>{u.catalogName}</a><span>/</span><span>{c.name}</span></div>
<section class="hero wrap"><div class="hero-heading"><h1>{lines(c.heroHeading).map((l,i)=><Fragment>{i>0&&<br/>}{l}</Fragment>)}<br/><span>{lines(c.heroValue).map((l,i)=><Fragment>{i>0&&<br/>}{l}</Fragment>)}</span></h1></div><figure class:list={['hero-visual','gateway-product',{'service-visual':c.kind==='Service'}]}><img src={'/assets/'+originalHero.file} width={originalHero.width} height={originalHero.height} alt={c.imageAlt} fetchpriority="high"/><figcaption><span class="live-dot"></span>{c.caption}</figcaption></figure><p class="hero-description">{c.heroDescription}</p><div class="hero-actions"><a class="button button-primary" href="#enquiry">{u.discuss} ↗</a><a class="text-link" href="#specifications">{u.scope} ↗</a></div><div class="hero-proof">{c.proof.map(x=><div><strong>{x.value}</strong><span>{x.label}</span><small>{x.note}</small></div>)}</div></section></div>
<nav class="section-nav" aria-label={shell.pageNavAria}><div class="wrap">{[['network','planning'],['applications','applications'],['specifications','scope'],['integration','handover'],['faq','faq']].map(([id,key])=><a href={'#'+id}>{u[key]}</a>)}<a href="#enquiry" class="nav-quote">{u.discuss} ↗</a></div></nav>
<section class="section features-section" id="features"><div class="wrap"><div class="section-heading compact-heading"><div><p class="eyebrow">{u.features}</p><h2>{lines(c.featureTitle).map((l,i)=><Fragment>{i>0&&<br/>}{i?<span>{l}</span>:l}</Fragment>)}</h2></div><p>{c.featureIntro}</p></div><div class="feature-grid">{c.features.map((f,i)=><article><span class="feature-mark" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={icons[i]}/></svg></span><h3>{f.title}</h3><p>{f.text}</p></article>)}</div></div></section>
<section class="section measurement-section" id="network"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{u.planning}</p><h2>{c.planningTitle}</h2></div><p>{c.planningIntro}</p></div><div class="measurement-grid">{c.planning.map((p,i)=><article class="measurement-card"><div class="measurement-heading"><span class="measurement-number">0{i+1}</span><span>↗</span></div><h3>{p.title}</h3><p>{p.text}</p><dl><dt>{u.projectInputs}</dt><dd>{p.brief}</dd></dl></article>)}</div></div></section>
<section class="section application-section" id="applications"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{u.applications}</p><h2>{c.applicationsTitle}</h2></div><p>{c.applicationsIntro}</p></div><div class="application-overview"><p><strong>{c.groups.length}</strong> {u.applicationAreas} <span>/</span> <strong>{c.groups.reduce((n,g)=>n+g.tasks.length,0)}</strong> {u.projectTasks}</p><p class="image-note">{u.imageNote}</p></div><nav class="application-jump-nav" aria-label={u.applications}>{c.groups.map(g=><a href={'#group-'+g.id}>{g.title}<span>{g.tasks.length}</span></a>)}</nav><div class="application-groups">{c.groups.map((g,i)=><details class="application-group" id={'group-'+g.id} open={i===0}><summary><span><small>{String(i+1).padStart(2,'0')}</small>{g.title}</span><span class="group-count">{g.tasks.length} <b aria-hidden="true">+</b></span></summary><div class="application-category-body"><div class="application-visual"><div class="application-media-slot"><figure class="application-category-photo"><img class="application-category-image" src={'/assets/'+g.imageKey+'.webp'} width="960" height="640" alt={g.imageAlt} loading="lazy" decoding="async"/><figcaption>{g.imageCaption}</figcaption></figure></div><p>{g.intro}</p></div><div class="application-task-list">{g.tasks.map((t,j)=><details class="application-task" id={'task-'+g.id+'-'+j} open={i===0&&j===0}><summary><span class="task-heading"><h3>{t.title}</h3></span><span class="task-toggle">+</span></summary><div class="task-copy"><figure class="application-scene-photo"><img src={photo(t,g)} width="960" height="640" alt={t.imageAlt||g.imageAlt} loading="lazy" decoding="async"/><figcaption>{g.imageCaption}</figcaption></figure><p>{t.description}</p><dl><dt>{u.requiredInputs}</dt><dd>{t.inputs}</dd><dt>{u.definedOutputs}</dt><dd>{t.deliverables}</dd><dt>{u.acceptanceChecks}</dt><dd>{t.acceptance}</dd><dt>{u.considerations}</dt><dd>{t.considerations}</dd></dl><a class="task-cta" href="#enquiry" data-project-scene={t.title}>{u.discuss} ↗</a></div></details>)}</div></div></details>)}</div></div></section>
<section class="section specifications-section" id="specifications"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{u.scope}</p><h2>{c.scopeTitle}</h2></div><p>{c.scopeIntro}</p></div><div class="gateway-spec-grid"><aside class="model-card"><span class="small-label">{c.kind==='Service'?u.service:u.product}</span><h3>{c.name}</h3><p>{c.kind==='Service'?u.serviceNote:u.productNote}</p><a href="#enquiry" class="button button-outline">{u.discuss} ↗</a>{c.datasheet&&<a class="text-link" href={c.datasheet} type="application/pdf" hreflang="en">{u.englishPdf} ↗</a>}</aside><div class="spec-table"><table><caption>{c.scopeTitle}</caption><tbody>{c.rows.map(([k,v])=><tr><th scope="row">{k}</th><td>{v}</td></tr>)}</tbody></table></div></div></div></section>
<section class="section integration-section" id="integration"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{u.handover}</p><h2>{c.handoverTitle}</h2></div><p>{c.handoverIntro}</p></div><div class="gateway-workflow">{c.handover.map((x,i)=><article><span class="step-number">0{i+1}</span><h3>{x.title}</h3><p>{x.text}</p></article>)}</div></div></section>
<section class="section faq-section" id="faq"><div class="wrap faq-layout"><div class="faq-intro"><p class="eyebrow">{u.faq}</p><h2>{lines(u.faqTitle).map((l,i)=><Fragment>{i>0&&<br/>}{l}</Fragment>)}</h2><p>{u.faqIntro}</p></div><div class="faq-list">{c.faqs.map((f,i)=><details open={i===0}><summary>{f.q}<span aria-hidden="true">+</span></summary><div class="faq-answer"><p>{f.a}</p></div></details>)}</div></div></section>
<section class="section enquiry-section" id="enquiry"><div class="wrap enquiry-layout"><div class="enquiry-intro"><p class="eyebrow">{u.discuss}</p><h2>{lines(u.enquiryTitle).map((l,i)=><Fragment>{i>0&&<br/>}{i?<span>{l}</span>:l}</Fragment>)}</h2><p class="lead">{c.enquiryIntro}</p><a class="contact-email" href="mailto:sales@hitelecom.cn">sales@hitelecom.cn ↗</a></div><form id="enquiry-form" action="mailto:sales@hitelecom.cn" method="post" enctype="text/plain"><div class="form-heading"><h3>{c.name}</h3></div><div class="form-fields"><div class="field full"><label for="application">{u.applicationsLabel}</label><select id="application" required data-brief-field={u.applicationsLabel} name="Application"><option value="">{u.applicationsLabel}</option>{c.groups.map(g=><optgroup label={g.title}>{g.tasks.map(t=><option>{t.title}</option>)}</optgroup>)}<option>{u.other}</option></select></div><div class="field full"><label for="country">{u.country}</label><input id="country" name="Country" required autocomplete="country-name" placeholder={u.countryPlaceholder} data-brief-field={u.country}/></div>{c.enquiryFields.map((f,i)=><div class="field full"><label for={'project-'+i}>{f.label}</label><input id={'project-'+i} name={'Project-'+i} maxlength="800" placeholder={f.placeholder} data-brief-field={f.label}/></div>)}<div class="field full"><label for="requirements">{u.requirements}</label><textarea id="requirements" name="Requirements" rows="4" maxlength="3000" placeholder={u.requirementsPlaceholder} data-brief-field={u.requirements}></textarea></div></div><div class="form-actions"><button type="submit" class="button button-primary">{u.prepare} ↗</button><p>{u.reviewHint}</p></div><div id="enquiry-review" class="enquiry-review" hidden><label for="enquiry-brief">{u.reviewLabel}</label><textarea id="enquiry-brief" rows="10"></textarea><div><a id="email-brief" class="button button-primary" href="mailto:sales@hitelecom.cn">{u.openEmail} ↗</a><button id="copy-brief" class="button button-outline" type="button">{u.copyBrief}</button></div><p id="brief-status" role="status"></p></div><noscript><a href="mailto:sales@hitelecom.cn">sales@hitelecom.cn</a></noscript></form></div></section><div class="wrap related-products"><a href={local('/product/lists/cid/256#cate')}>{u.related} ↗</a></div></main><script>import './custom-interactions.js';</script>
