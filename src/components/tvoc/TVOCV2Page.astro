---
/**
 * 工业 TVOC 传感器页 V2 · 包装器（GPT6 页面包 V64，Kimi 审核集成）
 * 路由：EN /product/tvoc-sensor（无前缀）；其余语言仍走经典模板（待多语言包）。
 * 数据：tvoc-content.json（EN，组件直接 import）。
 * Organization/WebSite 实体图由 BaseLayout 全局输出，本页仅输出页面级
 * Schema（includeOrganization={false}，统一引用 /#organization）。
 * Hero 响应式 preload（imagesrcset/imagesizes 与 TVOCPage img 一致）经 head 槽输出。
 * SiteShell/QuickContact 为 GPT6 离线审阅壳，不集成（README-KIMI）。
 * 规格书按钮链接仓库既有 /downloads/tvoc-sensor-datasheet.pdf（口径已核对一致）。
 * 样式作用域：包内将 .ht-tvoc 挂在 body；集成经 BaseLayout，故挂在包装 div。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import TVOCPage from './TVOCPage.astro';
import StructuredData from './StructuredData.astro';
import { tvocImage } from './images.mjs';
import content from '../../data/tvoc-content.json';
import '../../styles/tvoc.css';
const hero = await tvocImage('product-hero.webp', true);
const ogImage = new URL(hero.src, Astro.site).href;
const heroSizes = '(max-width: 600px) calc(100vw - 76px), (max-width: 1024px) 42vw, 560px';
---

<BaseLayout locale="en" title={content.seo.title} description={content.seo.description} robots="index,follow,max-image-preview:large">
  <link slot="head" rel="preload" as="image" href={hero.src} imagesrcset={hero.srcset} imagesizes={heroSizes} fetchpriority="high" />
  <StructuredData slot="head" content={content} imageUrl={ogImage} includeOrganization={false} />
  <div class="ht-tvoc"><TVOCPage /></div>
</BaseLayout>
