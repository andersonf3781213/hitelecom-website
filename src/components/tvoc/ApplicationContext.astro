---
const {product,measurement,t={}}=Astro.props;
const S = (key) => (Object.prototype.hasOwnProperty.call(t, key) ? t[key] : key);
const referenceSrc=product.srcset.split(',')[0].trim().split(' ')[0];
---
<div class="application-voc-reference">
  <img class="voc-product-reference-image" src={referenceSrc} width={product.width} height={product.height} loading="lazy" decoding="async" alt={S("Product reference: Hitelecom H Series TVOC monitor")} />
  <div><span class="small-label">{S("TVOC AIR MONITORING")}</span><p>{measurement}</p><small>{S("H Series product reference")}</small></div>
</div>
