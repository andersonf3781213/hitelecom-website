---
import contentDefault from '../../data/tvoc-content.json';
import FeatureIcon from './FeatureIcon.astro';
import ImageCaption from './ImageCaption.astro';
import ApplicationContext from './ApplicationContext.astro';
// QuickContact 不引入：官网 BaseLayout 已提供全站浮动联系按钮（README-KIMI：正式站沿用现有共享 Header/Footer 与联系控件）
import { getImage } from 'astro:assets';
import heroBackground from '../../assets/brand/sensor-hero-background.jpg';
import { tvocImage } from './images.mjs';
const {content = contentDefault, t = {}, prefix = ''} = Astro.props;
const S = (key) => (Object.prototype.hasOwnProperty.call(t, key) ? t[key] : key);
const enc = encodeURIComponent;
const hero = await tvocImage('product-hero.webp', true);
const widths = [640,1280,1920];
const backgrounds = await Promise.all(widths.map(width=>getImage({src:heroBackground,width,format:'webp',quality:78})));
const groups = await Promise.all(content.groups.map(async group=>({...group,asset:await tvocImage(group.image.name),tasks:await Promise.all(content.applications.filter(scene=>scene.group===group.id).map(async scene=>({...scene,image:scene.image||group.image,asset:await tvocImage((scene.image||group.image).name)})))})));
const datasheet = 'https://www.hitelecom.com'+content.hero.datasheet_url;
// 型号卡网络映射（H200 LoRa／H300 4G／H500 NB-IoT，现行公开规格书型号行）；
// 站点类型短语复用集成区既有字典键，五语已覆盖。
const modelNetwork = {H200:'LoRa', H300:'4G LTE', H500:'NB-IoT'};
const modelSite = {H200:'For points across one site', H300:'For distributed locations', H500:'For distributed locations'};
---
<div class="tvoc-main">
  <div class="hero-band">
    <img class="hero-background" src={backgrounds[2].src} srcset={backgrounds.map((x,i)=>`${x.src} ${widths[i]}w`).join(', ')} sizes="100vw" width={heroBackground.width} height={heroBackground.height} alt="" aria-hidden="true" loading="eager" decoding="async" />
    <div class="wrap breadcrumb" aria-label={S("Breadcrumb")}><a href={'https://www.hitelecom.com'+prefix}>{S("Home")}</a><span aria-hidden="true">/</span><a href={'https://www.hitelecom.com'+prefix+'/product'}>{S("IoT sensors")}</a><span aria-hidden="true">/</span><span>{S("TVOC sensor")}</span></div>
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-heading"><h1 id="hero-title">{content.hero.h1}<br/><span>{content.hero.value_heading.split("\n").map((line,i)=><Fragment>{i>0&&<br/>}{line}</Fragment>)}</span></h1></div>
      <figure class="hero-visual tvoc-product">
        <img src={hero.src} srcset={hero.srcset} sizes="(max-width: 600px) calc(100vw - 76px), (max-width: 1024px) 42vw, 560px" width={hero.width} height={hero.height} alt={S("Hitelecom H Series red TVOC monitor with bottom sensing head and illustrated local alarm hardware, official product image")} loading="eager" fetchpriority="high" decoding="async" />
        <figcaption><span class="live-dot" aria-hidden="true"></span>{S("Product form shown · Hardware by configuration")}</figcaption>
      </figure>
      <p class="hero-description">{content.hero.description}</p>
      <div class="hero-actions"><a href="#enquiry" class="button button-primary">{content.hero.primary_cta} <span aria-hidden="true">↗</span></a><a href={datasheet} target="_blank" rel="noopener" class="text-link">{content.hero.secondary_cta} <span aria-hidden="true">↗</span></a></div>
      <div class="hero-proof"><div><strong>{S("0–100,000 ppb")}</strong><span>{S("Published TVOC measuring range")}</span><small>{S("Selected sensing response and calibration basis")}</small></div><div><strong>1 ppb</strong><span>{S("Published resolution")}</span><small>{S("Accuracy specified for the selected configuration")}</small></div><div><strong>{S("Your platform")}</strong><span>{S("Remote VOC readings and trends")}</span><small>{S("Hitelecom Cloud or compatible integration")}</small></div></div>
    </section>
  </div>
  <nav class="section-nav" aria-label={S("On this page")}><div class="wrap"><a href="#measurement">{S("Measurement")}</a><a href="#applications">{S("Applications")}</a><a href="#specifications">{S("Specifications")}</a><a href="#integration">{S("Integration")}</a><a href="#faq">{S("FAQ")}</a><a class="nav-quote" href="#enquiry">{S("Request a quote ↗")}</a></div></nav>

  <section class="section features-section" id="features" aria-labelledby="features-title"><div class="wrap">
    <div class="section-heading compact-heading"><div><p class="eyebrow">{S("KEY FEATURES")}</p><h2 id="features-title">{S("TVOC visibility.")}<br/><span>{S("Built around your site.")}</span></h2></div><p>{S("Connect the sensing response, installation and data path to the decisions your operation needs to make.")}</p></div>
    <div class="feature-grid">{content.features.map((feature,index)=><article><span class="feature-mark" aria-hidden="true"><FeatureIcon index={index}/></span><h3>{feature.title}</h3><p>{feature.text}</p></article>)}</div>
  </div></section>

  <section class="section measurement-section" id="measurement" aria-labelledby="measurement-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{content.measurement.eyebrow}</p><h2 id="measurement-title">{content.measurement.heading.split("\n").map((line,i)=><Fragment>{i>0&&<br/>}{i===0?line:<span>{line}</span>}</Fragment>)}</h2></div><p>{content.measurement.description}</p></div>
    <div class="measurement-grid">{content.measurement.cards.map((item,index)=><article class="measurement-card"><div class="measurement-heading"><span class="measurement-number">0{index+1}</span><span class="measurement-symbol" aria-hidden="true">{index===0?'↗':index===1?'↔':'↓'}</span></div><h3>{item.title}</h3><p>{item.text}</p><dl><dt>{S("Define your measurement")}</dt><dd>{item.project_brief}</dd></dl><a href="#enquiry" class="text-link" data-measurement={item.title}>{S("Discuss this measurement ↗")}</a></article>)}</div>
    <div class="installation-note"><span class="small-label">{S("SENSING & INSTALLATION")}</span><h3>{content.measurement.installation_heading.split("\n").map((line,i)=><Fragment>{i>0&&<br/>}{line}</Fragment>)}</h3><p>{content.measurement.installation_text}</p></div>
  </div></section>

  <section class="section profile-section" id="operating-profile" aria-labelledby="profile-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{S("FROM READING TO RESPONSE")}</p><h2 id="profile-title">{content.workflow.heading.split("\n").map((line,i)=><Fragment>{i>0&&<br/>}{line}</Fragment>)}</h2></div><p>{content.workflow.profile_text}</p></div>
    <div class="tvoc-workflow">{content.workflow.steps.map(step=><article><span class="step-number">{step.number}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div>
    <div class="profile-note"><div><span class="small-label">{S("SENSING DUTY & POWER")}</span><strong>{content.workflow.battery_title}</strong></div><p>{content.workflow.battery_text}</p></div>
  </div></section>

  <section class="section application-section" id="applications" aria-labelledby="applications-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{S("APPLICATIONS")}</p><h2 id="applications-title">{content.applicationSection.title}<br/><span>{content.applicationSection.valueHeading}</span></h2></div><p>{content.applicationSection.description}</p></div>
    <div class="application-overview"><p><strong>{content.groups.length}</strong> {S("industry categories")} <span aria-hidden="true">/</span> <strong>{content.applications.length}</strong> {S("monitoring tasks")}</p><p class="image-note">{content.applicationSection.note}</p></div>
    <nav class="application-jump-nav" aria-label={S("Browse industrial TVOC applications")}>{content.groups.map(group=><a href={'#group-'+group.id}>{group.jumpLabel}<span>{group.scenes.length}</span></a>)}</nav>
    <div class="application-groups">{groups.map((group,index)=><details class="application-group" id={'group-'+group.id} open={index===0}>
      <summary><span><small>0{index+1}</small>{group.title}</span><span class="group-count">{S(group.scenes.length + ' monitoring tasks')} <b aria-hidden="true">+</b></span></summary>
      <div class="application-category-body">
        <div class="application-visual"><div class="application-media-slot"><figure class="application-category-photo"><img class="application-category-image" src={group.asset.src} srcset={group.asset.srcset} sizes="(max-width: 600px) calc(100vw - 76px), (max-width: 900px) calc((100vw - 132px) * .42), 470px" width={group.asset.width} height={group.asset.height} loading="lazy" decoding="async" alt={group.image.alt} style={'object-position:'+group.image.focalPoint}/><ImageCaption image={group.image}/></figure></div><p>{group.intro}</p></div>
        <div class="application-task-list">{group.tasks.map((scene,taskIndex)=><details class="application-task" id={scene.id} open={index===0&&taskIndex===0}>
          <summary aria-controls={'scene-photo-'+scene.id}><span class="task-heading"><h3>{scene.title}</h3><small>{scene.measurement}</small></span><span class="task-toggle" aria-hidden="true">+</span></summary>
          <div class="task-copy"><figure class="application-scene-photo" id={'scene-photo-'+scene.id} data-scene-owner={scene.id}><img class="application-scene-image" src={scene.asset.src} srcset={scene.asset.srcset} sizes="(max-width: 600px) calc(100vw - 76px), (max-width: 900px) calc((100vw - 132px) * .42), 470px" width={scene.asset.width} height={scene.asset.height} loading="lazy" decoding="async" alt={scene.image.alt} style={'object-position:'+scene.image.focalPoint}/><ApplicationContext product={hero} measurement={scene.measurement} t={t}/><ImageCaption image={scene.image}/></figure><p>{scene.description}</p><dl><dt>{S("VOC trend to observe")}</dt><dd>{scene.measurement}</dd><dt>{S("Monitoring point")}</dt><dd>{scene.monitoringPoint}</dd><dt>{S("Placement & installation")}</dt><dd>{scene.installation}</dd><dt>{S("Project details")}</dt><dd>{scene.projectBrief}</dd></dl><a href="#enquiry" class="task-cta" data-project-scene={scene.title}>{S("Discuss this application")} <span aria-hidden="true">↗</span></a></div>
        </details>)}</div>
      </div>
    </details>)}</div>
  </div></section>

  <section class="section specifications-section" id="specifications" aria-labelledby="specifications-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{S("SERIES & CONFIGURATIONS")}</p><h2 id="specifications-title">{content.series.heading.split("\n").map((line,i)=><Fragment>{i>0&&<br/>}{i===0?line:<span>{line}</span>}</Fragment>)}</h2></div><p>{content.series.description}</p></div>
    <div class="tvoc-series">{content.series.models.map(model=><article id={'model-'+model.toLowerCase()}><span class="small-label">{S("PUBLISHED MODEL FAMILY")}</span><h3>{model}</h3><p>{modelNetwork[model] ? <><strong>{modelNetwork[model]}</strong>{" · "}{S(modelSite[model])}</> : content.series.model_card_subtitle}</p><a href="#enquiry" class="text-link" data-model={model}>{S("Discuss this configuration ↗")}</a></article>)}</div>
    <div class="tvoc-spec-grid"><aside class="model-card"><span class="small-label">{S("FAMILY REFERENCE")}</span><h3>{S("Specify the complete")}<br/>{S("measurement point.")}</h3><p>{content.specifications.description}</p><a href={datasheet} target="_blank" rel="noopener" class="button button-outline">{S("Download family datasheet ↗")}</a><a href="#enquiry" class="text-link">{S("Get a configuration proposal ↓")}</a></aside><div class="spec-table"><table><caption>{S("H Series industrial TVOC sensors — published family reference")}</caption><tbody>{content.specifications.rows.map(row=><tr><th scope="row">{row.label}</th><td>{row.value}</td></tr>)}</tbody></table></div></div>
    <div class="selection-list"><h3>{S("Bring the specification back to your project.")}</h3><div>{content.series.steps.map((step,index)=><article><span class="step-number">0{index+1}</span><h4>{step.title}</h4><p>{step.text}</p></article>)}</div></div>
  </div></section>

  <section class="section integration-section" id="integration" aria-labelledby="integration-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{S("CONNECTIVITY & INTEGRATION")}</p><h2 id="integration-title">{S("Your site.")}<br/><span>{S("Your data destination.")}</span></h2></div><p>{content.workflow.platform_text}</p></div>
    <div class="integration-grid"><article><span class="small-label">4G / NB-IoT</span><h3>{S("For distributed locations")}</h3><div class="route-flow"><span>{S("TVOC point")}</span><b aria-hidden="true">→</b><span>{S("Mobile network")}</span><b aria-hidden="true">→</b><span>{S("Your platform")}</span></div><p>{S("Select the modem and regional bands around operator availability and coverage at the transmitter position. Agree the reporting profile, power arrangement and notification workflow.")}</p><ul><li>{S("Installation country and operator")}</li><li>{S("Signal at the actual mounting position")}</li><li>{S("Sampling, reporting and required alert response")}</li></ul></article><article><span class="small-label">LoRa</span><h3>{S("For points across one site")}</h3><div class="route-flow"><span>{S("TVOC points")}</span><b aria-hidden="true">→</b><span>{S("Receiver / gateway")}</span><b aria-hidden="true">→</b><span>{S("Your platform")}</span></div><p>{S("Match the supplied radio protocol, regional settings and receiver or gateway. Specify any LoRaWAN requirement with the model and complete onward connection.")}</p><ul><li>{S("Device protocol and gateway compatibility")}</li><li>{S("Site layout and radio coverage")}</li><li>{S("Gateway power and onward data connection")}</li></ul></article></div>
    <div class="integration-handover"><h3>{S("Make the first reading useful.")}</h3><p>{S("Agree device identity, monitoring-point reference, concentration units, calibration basis and timestamps in a sample message. Check the endpoint and supported authentication, then test the complete path to the intended platform and recipients.")}</p><a href="#enquiry" class="text-link">{S("Discuss platform integration ↗")}</a></div>
  </div></section>

  <section class="section faq-section" id="faq" aria-labelledby="faq-title"><div class="wrap faq-layout"><div class="faq-intro"><p class="eyebrow">{content.faqHeading.kicker}</p><h2 id="faq-title">{S("Frequently")}{S("asked questions.") && <><br/>{S("asked questions.")}</>}</h2><p>{content.faqHeading.intro}</p><a href="#enquiry" class="text-link">{S("Ask about your project ↗")}</a></div><div class="faq-list">{content.faqs.map((faq,index)=><details id={faq.id} open={index===0}><summary>{faq.question}<span aria-hidden="true">+</span></summary><div class="faq-answer">{faq.paragraphs.map(paragraph=><p>{paragraph}</p>)}</div></details>)}</div></div></section>

  <section class="section enquiry-section" id="enquiry" aria-labelledby="enquiry-title"><div class="wrap enquiry-layout">
    <div class="enquiry-intro"><p class="eyebrow">{content.inquiry.eyebrow}</p><h2 id="enquiry-title">{content.inquiry.heading.split("\n").map((line,i)=><Fragment>{i>0&&<br/>}{i===0?line:<span>{line}</span>}</Fragment>)}</h2><p class="lead">{content.inquiry.description}</p><a class="contact-email" href="mailto:sales@hitelecom.cn">{S("sales@hitelecom.cn ↗")}</a><div class="enquiry-benefits"><h3>{S("Your chemicals. Your site requirements.")}</h3><p>{content.inquiry.supporting_text}</p></div><aside class="area-project-note"><span class="small-label">{S("HAZARDOUS-AREA PROJECTS")}</span><h3>{S("Specify your explosion-proof requirements.")}</h3><p>{S("Share the site's area classification and required approval. Review the ordered equipment's Ex marking, certificate scope, ambient limits and special conditions against the installation requirements.")}</p><a class="text-link" href="#faq-approval">{S("See the selection checklist ↗")}</a></aside></div>
    <form id="enquiry-form" action="mailto:sales@hitelecom.cn" method="post" enctype="text/plain"><div class="form-heading"><span class="small-label">{S("PROJECT ENQUIRY")}</span><h3>{S("Let’s define your TVOC configuration.")}</h3><p>{S("Start with your application. Add the details you already know.")}</p></div>
      <div class="form-fields">
        <div class="field"><label for="application">{S("Application")} <span aria-hidden="true">*</span></label><select id="application" name="Application" required><option value="">{S("Choose your application")}</option>{content.groups.map(group=><optgroup label={group.title}>{content.applications.filter(scene=>scene.group===group.id).map(scene=><option value={scene.title}>{scene.title}</option>)}</optgroup>)}<option>{S("Other / project-specific")}</option></select></div>
        <div class="field"><label for="country">{S("Country / region")} <span aria-hidden="true">*</span></label><input id="country" name="Country" required autocomplete="country-name" placeholder={S("e.g. United Kingdom")} maxlength="100"/></div>
        <div class="field"><label for="model">{S("Model family")}</label><select id="model" name="Model"><option>{S("Please advise")}</option>{content.series.models.map(model=><option>{model}</option>)}</select></div>
        <div class="field"><label for="quantity">{S("Estimated quantity")}</label><input id="quantity" name="Quantity" type="number" min="1" step="1" inputmode="numeric" placeholder={S("e.g. 20")}/></div>
        <div class="field full"><label for="target-compounds">{S("Target compounds / solvent mixture")}</label><input id="target-compounds" name="Target compounds" placeholder={S("Chemical names, CAS numbers or SDS reference")} maxlength="400"/></div>
        <div class="field full"><label for="expected-concentration">{S("Expected concentration / measurement range")}</label><input id="expected-concentration" name="Expected concentration" placeholder={S("Include the unit and normal / peak conditions, if known")} maxlength="200"/></div>
      </div>
      <details class="project-detail-fields"><summary>{S("Installation, approval & data requirements")} <span aria-hidden="true">+</span></summary><div class="form-fields">
        <div class="field full"><label for="area-classification">{S("Hazardous-area classification, if applicable")}</label><input id="area-classification" name="Area classification" placeholder={S("From your site assessment: zone / division, gas or dust group, temperature class")} maxlength="300"/></div>
        <div class="field full"><label for="required-approval">{S("Required equipment approval, if applicable")}</label><input id="required-approval" name="Required approval" placeholder={S("Approval required by your project, including certificate or marking requirements")} maxlength="250"/></div>
        <div class="field"><label for="network">{S("Preferred connectivity")}</label><select id="network" name="Connectivity"><option>{S("Please advise")}</option><option>4G LTE</option><option>NB-IoT</option><option>LoRa</option></select></div>
        <div class="field"><label for="power-hardware">{S("Power & local alarm requirements")}</label><input id="power-hardware" name="Power and alarm hardware" placeholder={S("Available power, local display or alarm needs")} maxlength="200"/></div>
        <div class="field full"><label for="timing-platform">{S("Sampling, reporting & platform requirements")}</label><input id="timing-platform" name="Timing and platform" placeholder={S("Required update timing, alert response and receiving platform")} maxlength="300"/></div>
      </div></details>
      <div class="field full project-message"><label for="requirements">{S("What would you like to monitor?")}</label><textarea id="requirements" name="Requirements" rows="3" maxlength="3000" placeholder={content.inquiry.message_placeholder}></textarea></div>
      <div class="form-actions"><button type="submit" class="button button-primary">{content.inquiry.submit_label} ↗</button><p>{S("Review your brief, then send it with your email app.")}</p></div><div id="enquiry-review" class="enquiry-review" hidden><label for="enquiry-brief">{S("Your project brief")}</label><textarea id="enquiry-brief" rows="9" spellcheck="false"></textarea><div><a id="email-brief" class="button button-primary" href="mailto:sales@hitelecom.cn">{S("Open email ↗")}</a><button id="copy-brief" type="button" class="button button-outline">{S("Copy brief")}</button></div><p id="brief-status" role="status" aria-live="polite">{S("Your brief is ready to review.")}</p></div><p class="noscript-note">{S("You can also")} <a href={'mailto:sales@hitelecom.cn?subject='+enc(S("Industrial TVOC sensor project"))}>{S("email your project details directly")}</a>.</p>
    </form>
  </div></section>
  <div class="wrap related-products"><p class="small-label">{S("CONTINUE YOUR MONITORING PROJECT")}</p><a href={'https://www.hitelecom.com'+prefix+'/product'}>{S("Explore all sensors ↗")}</a><a href={'https://www.hitelecom.com'+prefix+'/product/air-quality-sensor'}>{S("Air quality monitoring ↗")}</a><a href={'https://www.hitelecom.com'+prefix+'/product/tilt-sensor'}>{S("Tilt monitoring ↗")}</a></div>
</div>
<script>import './tvoc-interactions.js';</script>
