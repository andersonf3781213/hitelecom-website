---
import { programs } from '../../data/programs.en';
import { additionalApplications } from '../../data/additional-applications.en';
// 静态正文：不依赖浏览器端渲染。交互由一份轻量增强脚本提供。
---
<section class="enquiry-section" id="enquiry" aria-labelledby="enquiry-title"><div class="wrap enquiry-layout"><div class="enquiry-intro"><p class="eyebrow">DISCUSS YOUR REQUIREMENTS</p><h2 id="enquiry-title">Discuss your<br/>IoT project.</h2><p>Tell us what you need to measure. We will help define the sensor, connectivity and platform configuration.</p><a class="text-link" href="mailto:sales@hitelecom.cn">sales@hitelecom.cn<svg class="icon"><use href="#sol-icon-arrow"></use></svg></a></div>
    <details class="enquiry-drawer"><summary>Request a solution proposal<span aria-hidden="true">+</span></summary><form class="enquiry-form" id="enquiry-form"><fieldset class="form-fields-set" disabled><div class="form-top">PROJECT ENQUIRY</div><div class="form-grid"><div class="field"><label for="name">Name *</label><input id="name" name="name" required autocomplete="name" placeholder="Your name" maxlength="100"></div><div class="field"><label for="company">Company *</label><input id="company" name="company" required autocomplete="organization" placeholder="Your company" maxlength="150"></div><div class="field full"><label for="email">Business email *</label><input id="email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" maxlength="160"></div><div class="field"><label for="application">Monitoring application</label><select id="application" name="application"><option value="">Please advise</option>{programs.map(program => <option>{program.name}</option>)}{additionalApplications.filter(application => !programs.some(program => program.name === application.interest)).map(application => <option>{application.interest}</option>)}<option>Smart Warehousing</option><option>Pole &amp; Tower Monitoring</option><option>Water &amp; Pump Stations</option><option>Industrial Equipment</option><option>Buildings &amp; Campuses</option><option>Energy Assets</option><option>Heritage &amp; Visitor Sites</option><option>Agriculture &amp; Irrigation</option><option>Industrial Parks</option><option>Connectivity &amp; Integration</option><option>Installation &amp; Test Information</option><option>Other / Project-specific</option></select></div><div class="field"><label for="country">Country / region</label><input id="country" name="country" autocomplete="country-name" placeholder="Installation country" maxlength="100"></div><div class="field full"><label for="requirements">What would you like to monitor? *</label><textarea id="requirements" name="requirements" required placeholder="Assets, measurements, approximate points and platform requirements…" maxlength="3000"></textarea></div></div><button class="button button-blue" type="submit">Prepare my enquiry<svg class="icon"><use href="#sol-icon-arrow"></use></svg></button><p class="form-note">Review your brief, then send it with your email app.<br>Nothing is sent automatically.</p><div class="review-panel" id="enquiry-review" hidden aria-live="polite"><h3>Your project brief</h3><label for="enquiry-text">Review or edit your message</label><textarea id="enquiry-text"></textarea><div class="review-actions"><a class="text-link" id="open-email" href="mailto:sales@hitelecom.cn">Open email draft<svg class="icon"><use href="#sol-icon-arrow"></use></svg></a><button class="copy-button" id="copy-brief" type="button">Copy brief</button></div><p class="copy-status" id="copy-status" role="status"></p></div></fieldset><noscript><p class="form-note">Please send your project details directly to <a href="mailto:sales@hitelecom.cn">sales@hitelecom.cn</a>.</p></noscript></form></details>
  </div></section>

