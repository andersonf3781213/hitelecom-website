---
import '../../styles/cloud-workspace.css';
import Icon from './Icon.astro';
// 平台能力示意，不冒充实际后台截图；仅显示字段、功能和流程，不编造读数或设备统计。
const fields = [
  {icon:'sensor',name:'Device ID'},
  {icon:'chart',name:'Quantity'},
  {icon:'file',name:'Unit'},
  {icon:'network',name:'Timestamp'},
] as const;
---
<figure class="cloud-showcase" aria-labelledby="cloud-showcase-title" aria-describedby="cloud-showcase-note">
  <div class="cloud-console">
    <div class="cloud-console-header"><div class="cloud-console-brand"><Icon name="cloud"/><span>HITELECOM <b>CLOUD</b></span></div><span class="cloud-console-type">CAPABILITY VIEW</span></div>
    <div class="cloud-console-rail" aria-hidden="true"><span class="cloud-rail-item cloud-rail-active"><Icon name="sensor"/><small>Devices</small></span><span class="cloud-rail-item"><Icon name="chart"/><small>History</small></span><span class="cloud-rail-item"><Icon name="bell"/><small>Rules</small></span><span class="cloud-rail-item"><Icon name="code"/><small>API</small></span><span class="cloud-rail-end"><Icon name="network"/></span></div>
    <div class="cloud-console-main">
      <div class="cloud-workspace-heading"><div><p>DEVICE & DATA WORKSPACE</p><strong id="cloud-showcase-title">Monitoring workspace</strong></div><span class="cloud-deployment-type">Public / Private</span></div>
      <div class="cloud-records"><div class="cloud-panel-heading"><Icon name="sensor"/><strong>Measurement records</strong></div><div class="cloud-record-fields">{fields.map(field=><div><Icon name={field.icon}/><span>{field.name}</span></div>)}</div></div>
      <div class="cloud-panel-pair"><div class="cloud-history-panel"><div class="cloud-panel-heading"><Icon name="chart"/><strong>History & review</strong></div><div class="cloud-history-list"><span><i></i>Measurement history</span><span><i></i>Time-range review</span><span><i></i>Trend visualization</span></div></div><div class="cloud-rules-panel"><div class="cloud-panel-heading"><Icon name="bell"/><strong>Configured alerts</strong></div><div class="cloud-rule-flow"><span>Define condition</span><Icon name="down"/><span>Set threshold</span><Icon name="down"/><span class="cloud-rule-notify">Notify the team<Icon name="right"/></span></div></div></div>
      <div class="cloud-integration-bar"><div><span class="cloud-integration-kicker">SUPPORTED INTEGRATION ROUTES</span><strong>Connect your data</strong></div><div class="cloud-protocols"><span>MQTT</span><span>API</span><Icon name="right"/></div></div>
    </div>
  </div>
  <figcaption id="cloud-showcase-note"><span>ILLUSTRATIVE PLATFORM VIEW</span><p>Device management, measurement history, configured notifications and platform integration.</p></figcaption>
</figure>
