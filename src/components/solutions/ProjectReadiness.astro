---
import '../../styles/readiness.css';
import { projectSteps } from '../../data/solutions.en';
import ResponsiveImage from './ResponsiveImage.astro';
import Icon from './Icon.astro';
---
<section class="readiness-section" id="planning" aria-labelledby="planning-title"><div class="wrap readiness-grid">
  <figure class="readiness-visual"><ResponsiveImage imageKey="deployment-commissioning" alt="Application illustration of engineers commissioning a wireless monitoring system in an ordinary warehouse" sizes="(max-width:700px) 800px, 720px"/><div class="readiness-shade" aria-hidden="true"></div><figcaption><span>DEPLOYMENT & COMMISSIONING</span><strong>Install. Connect.<br/>Commission.</strong><small>Application illustration</small></figcaption></figure>
  <div class="readiness-copy"><p class="eyebrow">ENGINEERING DELIVERY</p><h2 id="planning-title">Deployment<br/><span>& Commissioning.</span></h2><ol class="pilot-steps">{projectSteps.map((step,index)=><li><span class="pilot-number">{String(index+1).padStart(2,'0')}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}</ol><a class="text-link" href="#enquiry" data-interest="Installation & Test Information">Discuss deployment support<Icon name="arrow"/></a></div>
</div><div class="wrap acceptance-block"><div class="acceptance-heading"><p class="eyebrow">COMMISSIONING & HANDOVER</p><h3>Documentation for everyday operation.</h3><p>Installation records, measurement checks and response responsibilities support system handover and maintenance. Documentation follows the agreed project scope.</p></div><div class="acceptance-grid">
  <article><span>01 / INSTALLATION RECORD</span><h4>Traceable measurement points</h4><p>Asset IDs, point locations, mounting photos, device variants and saved configuration settings.</p></article>
  <article><span>02 / VERIFICATION RECORD</span><h4>Measurement & communication checks</h4><p>Reference comparisons, coverage observations, received messages, timestamps and notification test results.</p></article>
  <article><span>03 / DEPLOYMENT BRIEF</span><h4>Defined operating responsibilities</h4><p>Threshold settings, inspection ownership, maintenance access and support information for ongoing operation.</p></article>
</div></div></section>
<section class="brief-resources" id="evidence" aria-labelledby="evidence-title"><div class="wrap"><div class="brief-resources-heading"><p class="eyebrow">ENGINEERING DOCUMENTATION</p><h2 id="evidence-title">Technical resources for project evaluation.</h2><p>Product specifications and project-specific engineering information support device selection, system integration and acceptance planning.</p></div><div class="brief-resource-grid">
  <article><Icon name="file"/><h3>Product documentation</h3><p>Measurement ranges, sensing options, operating conditions, power requirements and communication variants provide the basis for the device specification.</p><a class="text-link" href="https://www.hitelecom.com/service#page3">View technical resources<Icon name="arrow"/></a></article>
  <article><Icon name="shield"/><h3>Installation & test information</h3><p>Mounting methods, reference comparisons and proposed acceptance checks link the sensor specification to its actual installation.</p><a class="text-link" href="#enquiry" data-interest="Installation & Test Information">Request project guidance<Icon name="arrow"/></a></article>
  <article><Icon name="code"/><h3>Platform & data integration</h3><p>Interface support, payload definitions, field mapping and notification workflows define how measurements enter the customer’s operating environment.</p><a class="text-link" href="https://www.hitelecom.com/product">Explore platform capabilities<Icon name="arrow"/></a></article>
</div></div></section>
