---
import '../../styles/project-depth.css';
import '../../styles/v9-corrections.css';
import Icon from './Icon.astro';
import CloudWorkspace from './CloudWorkspace.astro';
import DecisionGuide from './DecisionGuide.astro';
import ProjectReadiness from './ProjectReadiness.astro';
import { faqs } from '../../data/solutions.en';
const scope = [
  {icon:'sensor', title:'Sensors & probes', text:'Wireless terminals capture physical measurements at the asset, surface, storage zone or environmental monitoring point.'},
  {icon:'energy', title:'Mounting & power', text:'Probe assemblies, mounting accessories, enclosures and power options support installation at the measurement point.'},
  {icon:'network', title:'Wireless transport', text:'Cellular terminals connect distributed assets; compatible LoRa systems aggregate local measurement points through a gateway.'},
  {icon:'cloud', title:'Monitoring software', text:'Hitelecom Cloud organizes device readings into historical records, dashboards and configurable alarm rules.'},
  {icon:'bell', title:'Operational response', text:'Email and app notifications direct attention to reported conditions, supporting inspection, investigation and maintenance follow-up.'},
] as const;
---
<DecisionGuide/>
<section class="essentials-section" id="deployment" aria-labelledby="deployment-title"><div class="wrap">
  <div class="essentials-heading"><p class="eyebrow">MONITORING ARCHITECTURE</p><h2 id="deployment-title">Sensors. Connectivity.<br/><span>Monitoring software.</span></h2><a class="text-link" href="#connectivity">Compare connectivity options<Icon name="down"/></a></div>
  <div class="data-path"><div><Icon name="sensor"/><h3>Field measurements</h3><p>Asset condition and environmental data.</p></div><Icon name="right"/><div><Icon name="network"/><h3>Wireless reporting</h3><p>Cellular or compatible LoRa networks.</p></div><Icon name="right"/><div><Icon name="cloud"/><h3>Cloud & integration</h3><p>History, visualization and configured alerts.</p></div></div>
  <div class="scope-grid">{scope.map((item,index)=><article><div class="scope-mark"><Icon name={item.icon}/><span>{String(index+1).padStart(2,'0')}</span></div><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
  <p class="scope-note">Hardware, network subscriptions, gateway, software and engineering services are specified separately in the project proposal.</p>
</div></section>
<section class="connection-section" id="connectivity" aria-labelledby="connectivity-title"><div class="wrap">
  <div class="depth-heading"><div><p class="eyebrow">COMMUNICATION ARCHITECTURE</p><h2 id="connectivity-title">Wireless connectivity<br/><span>for each deployment.</span></h2></div><p>Connect dispersed assets through cellular networks or organize facility measurement points around a local gateway.</p></div>
  <div class="network-notes">
    <article><div class="route-heading"><Icon name="tower"/><span>DIRECT CELLULAR</span></div><h3>4G LTE / NB-IoT</h3><p class="route-intro">Cellular terminals report through an operator network without a local LoRa gateway.</p><dl><div><dt>Deployment</dt><dd>Distributed tanks, remote infrastructure and assets spread across separate sites.</dd></div><div><dt>Architecture</dt><dd>Cellular terminal, SIM/data service and a supported platform connection.</dd></div><div><dt>Design factors</dt><dd>Regional bands, operator coverage, antenna position, power budget and reporting interval.</dd></div></dl></article>
    <article><div class="route-heading"><Icon name="network"/><span>LOCAL SENSOR NETWORK</span></div><h3>LoRa + gateway</h3><p class="route-intro">A compatible gateway or receiver collects local sensor messages and forwards the data.</p><dl><div><dt>Deployment</dt><dd>Grouped measurement points in warehouses, plant rooms and facility networks.</dd></div><div><dt>Architecture</dt><dd>Compatible sensors, a gateway or receiver, gateway power and data backhaul.</dd></div><div><dt>Design factors</dt><dd>Device protocol, obstructions, radio coverage, gateway placement and server roles.</dd></div></dl></article>
  </div>
  <p class="route-note">LoRaWAN device support and network-server roles depend on the supplied system. Measurement, reporting and alert timings are configured separately.</p>
  <a class="text-link" href="#enquiry" data-interest="Connectivity & Integration">Discuss your connectivity requirements<Icon name="arrow"/></a>
</div></section>
<section class="integration-section" id="integration" aria-labelledby="integration-title"><div class="wrap platform-grid">
  <div class="integration-copy"><p class="eyebrow">HITELECOM CLOUD</p><h2 id="integration-title">Cloud Platform<br/><span>& Integration.</span></h2><p class="integration-lead">Bring device status, measurement histories and configured alarms into one monitoring workspace. Hitelecom Cloud supports the day-to-day review of assets and environmental conditions, with public and private deployment options.</p>
    <div class="integration-items"><article><Icon name="chart"/><div><h3>Review measurements and events</h3><p>View reported readings, follow historical trends and review alarm events by device or monitoring point. Email and app notifications help the responsible team follow up on configured conditions.</p></div></article><article><Icon name="code"/><div><h3>Connect to customer systems</h3><p>Supported MQTT and API routes connect field data to customer platforms. The interface scope defines authentication, device identity, payload fields, units and timestamps.</p></div></article></div>
    <div class="integration-links"><a class="text-link" href="https://www.hitelecom.com/product">Explore Hitelecom Cloud<Icon name="arrow"/></a><a class="text-link" href="#enquiry" data-interest="Connectivity & Integration">Discuss platform integration<Icon name="arrow"/></a></div>
  </div>
  <CloudWorkspace/>
</div></section>
<section class="oem-strip" id="customization" aria-labelledby="customization-title"><div class="wrap oem-strip-inner"><div class="oem-strip-title"><p class="eyebrow">CUSTOM DEVELOPMENT</p><h2 id="customization-title">OEM / ODM development</h2></div><p>Adapt sensing and probes, radio connectivity, power, enclosures, mounting, firmware and branding to the application. Engineering review defines the prototype and validation scope.</p><a class="text-link" href="https://www.hitelecom.com/product/lists/cid/256">Explore customization<Icon name="arrow"/></a></div></section>
<ProjectReadiness/>
<section class="depth-faq" id="project-essentials" aria-labelledby="faq-title"><div class="wrap depth-faq-grid"><div><p class="eyebrow">SELECTION & INTEGRATION FAQ</p><h2 id="faq-title">Technical questions.<br/><span>Practical answers.</span></h2><p>Connectivity, data interfaces and device configuration for a complete monitoring system.</p><a class="text-link" href="#enquiry" data-interest="Connectivity & Integration">Discuss technical requirements<Icon name="arrow"/></a></div><div class="faq-list">{faqs.map((faq,index)=><details open={index===0}><summary>{faq.question}<span aria-hidden="true">+</span></summary><p class="answer">{faq.answer}</p></details>)}</div></div></section>
