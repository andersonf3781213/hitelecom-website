---
/**
 * V142: Solutions 详情页组件（英文）：8 个行业页 + 仓库货架监测页。
 * 内容全部来自 src/data/solutions/en.details.json 的对应条目 + en.json 的 ui/表单字段。
 */
import EnquiryForm from './EnquiryForm.astro';
import '../../styles/gateway.css';
import '../../styles/solutions.css';
import { SITE_URL } from '../../utils/jsonld';

interface Props {
  d: any;
  ui: any;
  fields: Record<string, string>;
  applicationOptions: string[];
}

const { d, ui, fields, applicationOptions } = Astro.props;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Solutions', item: `${SITE_URL}/solution` },
    { '@type': 'ListItem', position: 3, name: d.breadcrumbName },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: (d.faq ?? []).map((f: any) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<div
  class="ht-gateway ht-solutions"
  data-name={d.enquiry.formName}
  data-email-subject={ui.emailSubject}
  data-email="sales@hitelecom.cn"
>
  <div class="wrap crumb">
    <a href="/solution">{ui.solutions}</a> / <span>{d.breadcrumbName}</span>
  </div>

  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="eyebrow">{d.eyebrow}</div>
        <h1>{d.h1}</h1>
        <p class="lead">{d.heroIntro}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#enquiry">{d.ctaPrimary}<span class="arr">→</span></a>
          <a class="btn btn-outline" href="/solution">{ui.backToSolutions}</a>
        </div>
      </div>
      <figure class="hero-fig">
        <img src={d.heroImg} alt={d.heroImgAlt} width="880" height="560" fetchpriority="high" />
        <figcaption>{d.heroCaption}</figcaption>
      </figure>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>{d.challenges.h2}</h2>
      <div class="grid3">
        {d.challenges.items.map((c: any) => (
          <article class="card">
            <h3>{c.title}</h3>
            <p>{c.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <h2>{d.monitor.h2}</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>{ui.tablePoint}</th>
              <th>{ui.tableMeasurement}</th>
              <th>{ui.tableDevice}</th>
              <th>{ui.tableRequirement}</th>
            </tr>
          </thead>
          <tbody>
            {d.monitor.rows.map((r: any) => (
              <tr>
                <td>{r.point}</td>
                <td>{r.measurement}</td>
                <td>{r.device}</td>
                <td>{r.requirement}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>{d.deploy.h2}</h2>
      <div class="arch">
        {d.deploy.blocks.map((b: any) => (
          <article>
            <h3>{b.title}</h3>
            <p>{b.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <h2>{d.system.h2}</h2>
      <div class="sys">
        <div>
          <h3>{ui.systemBase}</h3>
          <ul>
            {d.system.base.map((s: any) => (
              <li>
                <a href={s.href}>{s.name}</a>
                <p>{s.why}</p>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3>{ui.systemOptional}</h3>
          <ul>
            {d.system.optional.map((s: any) => (
              <li>
                <a href={s.href}>{s.name}</a>
                <p>{s.why}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>{d.data.h2}</h2>
      <p class="sec-intro">{d.data.p}</p>
      <ul class="notes">
        {d.data.bullets.map((b: string) => <li>{b}</li>)}
      </ul>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <h2>{d.install.h2}</h2>
      <ol class="check">
        {d.install.items.map((s: string) => <li>{s}</li>)}
      </ol>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>{ui.faqTitle}</h2>
      {d.faq.map((f: any) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <div class="a">{f.a}</div>
        </details>
      ))}
    </div>
  </section>

  <EnquiryForm enquiry={d.enquiry} fields={fields} applicationOptions={applicationOptions} ui={ui} />

  <section>
    <div class="wrap">
      <h2>{ui.relatedTitle}</h2>
      <div class="related">
        {d.relatedLinks.map((r: any) => <a href={r.href}>{r.label}</a>)}
      </div>
    </div>
  </section>
</div>

<script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)} />
