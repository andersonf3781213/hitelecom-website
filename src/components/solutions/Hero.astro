---
import Icon from './Icon.astro';
import ResponsiveImage from './ResponsiveImage.astro';
---
<section class="hero" id="overview" aria-labelledby="hero-title">
  <ResponsiveImage imageKey="industrial-campus-hero" priority class="hero-backdrop" alt="Application illustration of a logistics and utility campus at blue hour" sizes="(max-width:850px) 1280px, 100vw"/>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="wrap hero-content"><p class="eyebrow">INDUSTRIAL IOT SOLUTIONS</p><h1 id="hero-title">Every site.<br/><span>In view.</span></h1><p class="hero-intro">Wireless sensors, gateways and cloud software<br class="desktop-break"/> for asset condition and environmental monitoring.</p><div class="hero-actions"><a class="button button-white" href="#solutions">View applications<Icon name="down"/></a><a class="hero-secondary" href="#enquiry">Request a solution<Icon name="arrow"/></a></div></div>
  <div class="wrap hero-bottom"><span>4G LTE <i> / </i> NB-IoT <i> / </i> LoRa</span><a href="#solutions">Sensors · Networks · Cloud<Icon name="down"/></a></div>
</section>
