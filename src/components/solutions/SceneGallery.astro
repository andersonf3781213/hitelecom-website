---
import { scenes } from '../../data/scenes.en';
import { programs } from '../../data/programs.en';
import Icon from './Icon.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import MoreSolutions from './MoreSolutions.astro';
import MonitoringProgram from './MonitoringProgram.astro';
---
<section class="gallery-section" id="solutions" aria-labelledby="solutions-title"><div class="wrap">
  <div class="gallery-heading"><div><p class="eyebrow">INDUSTRIAL MONITORING APPLICATIONS</p><h2 id="solutions-title">Monitoring<br/><span>applications.</span></h2></div><p>Wireless measurement and configured alerts for maintenance, storage, facilities and field operations.</p></div>
  <div class="scene-grid">{scenes.map(scene=><details class:list={['scene-card',scene.className]} id={scene.id}>
    <summary class="scene-cover"><ResponsiveImage imageKey={scene.image} alt={scene.alt} sizes={scene.id==='field-operations'?'(max-width:700px) 680px, 1240px':'(max-width:700px) 800px, 720px'}/><span class="scene-shade" aria-hidden="true"></span><span class="scene-number">{scene.number} / SOLUTIONS</span><span class="scene-caption"><span class="scene-title">{scene.title}</span><span class="scene-description">{scene.text}</span><span class="scene-tags">{scene.tags.map(tag=><span>{tag}</span>)}</span></span><span class="scene-open"><span>Explore</span><span class="round-arrow"><Icon name="arrow"/></span></span><span class="sr-only">Open monitoring tasks, installation and validation checks</span></summary>
    <div class="scene-content"><div class="scene-content-head"><p>MONITORING TASKS</p><button class="close-scene" type="button" data-close-scene hidden data-enhanced-only>Close <span aria-hidden="true">×</span></button></div>
      {programs.filter(program=>scene.tasks.some(id=>id===program.id)).map(program=><MonitoringProgram program={program}/>)}
      {scene.id==='warehousing'&&<div class="cold-detail"><ResponsiveImage imageKey="cold-storage" alt="Application illustration of a clean temperature-controlled storage aisle" sizes="(max-width:700px) calc(100vw - 88px), 600px"/><p>Temperature records and excursion alerts support refrigeration checks and storage-quality investigations.</p></div>}
    </div>
  </details>)}</div>
  <MoreSolutions/>
  <p class="imagery-note">Application illustrations. Explore each scene for measurement methods, system components and installation guidance.</p>
</div></section>
