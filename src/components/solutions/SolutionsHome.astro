---
import '../../styles/solutions.css';
import '../../styles/link-corrections.css';
import IconSprite from './IconSprite.astro';
import Hero from './Hero.astro';
import SceneGallery from './SceneGallery.astro';
import ProjectEssentials from './ProjectEssentials.astro';
import ProjectEnquiry from './ProjectEnquiry.astro';
interface Props { landmark?: boolean; }
const { landmark = true } = Astro.props;
const Main = landmark ? 'main' : 'div';
---
<div class="ht-solutions" data-solutions-root><IconSprite/><Main id="solutions-main"><Hero/><SceneGallery/><ProjectEssentials/><ProjectEnquiry/></Main></div>
<script>import '../../scripts/solutions.js';</script>
