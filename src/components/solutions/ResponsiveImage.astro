---
import images from '../../data/images.json';
interface Props {
  imageKey: keyof typeof images;
  alt: string;
  sizes?: string;
  priority?: boolean;
  class?: string;
}
const { imageKey, alt, sizes = '100vw', priority = false, class: className } = Astro.props;
const image = images[imageKey];
const avif = image.variants.filter((item) => item.format === 'avif');
const webp = image.variants.filter((item) => item.format === 'webp');
const fallback = webp.at(-1) ?? image.variants.at(-1)!;
const srcset = (variants: typeof image.variants) => variants.map((item) => `${item.url} ${item.width}w`).join(', ');
// 仅首屏LCP图优先；下方图片由浏览器原生懒加载，不等待JS或滚动监听器。
---
<picture class={className}>
  {avif.length > 0 && <source type="image/avif" srcset={srcset(avif)} sizes={sizes} />}
  {webp.length > 0 && <source type="image/webp" srcset={srcset(webp)} sizes={sizes} />}
  <img src={fallback.url} srcset={webp.length ? srcset(webp) : undefined} sizes={sizes}
    width={image.width} height={image.height} alt={alt}
    loading={priority ? 'eager' : 'lazy'} decoding="async"
    fetchpriority={priority ? 'high' : undefined} />
</picture>
