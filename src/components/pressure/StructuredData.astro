---
const {content,imageUrl,t={},locale='en',prefix='',includeOrganization=true} = Astro.props;
const S = (key) => (Object.prototype.hasOwnProperty.call(t, key) ? t[key] : key);
const url=`https://www.hitelecom.com${prefix}/product/pressure-sensor`;
const orgId='https://www.hitelecom.com/#organization';
const groupId=url+'#pressure-series';
const graph=[
 ...(includeOrganization?[{'@type':'Organization','@id':orgId,name:'Hitelecom',legalName:'Shanghai Hitelecom Communication Technology Co., Ltd.',url:'https://www.hitelecom.com',email:'sales@hitelecom.cn'}]:[]),
 {'@type':'WebPage','@id':url+'#webpage',url,name:content.seo.title,description:content.seo.description,inLanguage:locale,dateModified:'2026-10-09',publisher:{'@id':orgId},mainEntity:{'@id':groupId}},
 {'@type':'BreadcrumbList','@id':url+'#breadcrumb',itemListElement:[{'@type':'ListItem',position:1,name:S('Home'),item:`https://www.hitelecom.com${prefix}`},{'@type':'ListItem',position:2,name:S('IoT Sensors'),item:`https://www.hitelecom.com${prefix}/product`},{'@type':'ListItem',position:3,name:S('Wireless Pressure Sensors'),item:url}]},
 {'@type':'ProductGroup','@id':groupId,productGroupID:'H-Series-Pressure-Sensors',name:S('Hitelecom H Series Wireless Pressure Sensors'),description:content.hero.description,url,image:imageUrl,brand:{'@type':'Brand',name:'Hitelecom'},manufacturer:{'@id':orgId},hasVariant:content.series.models.map(model=>({'@id':url+'#model-'+model.toLowerCase()})),additionalProperty:[{'@type':'PropertyValue',name:S('Available full-scale range options'),value:S('1 / 1.6 / 3.5 / 7 / 10 / 20 / 35 / 100 MPa, selected by configuration')},{'@type':'PropertyValue',name:S('Published measurement accuracy'),value:'±0.5% FS'},{'@type':'PropertyValue',name:S('Annual stability'),value:S('±0.2% FS/year')},{'@type':'PropertyValue',name:S('Wireless family options'),value:S('4G Cat.1 / NB-IoT / LoRa, by model and selected variant')},{'@type':'PropertyValue',name:S('Enclosure protection'),value:S('IP68, as listed in the family datasheet')}]},
 ...content.series.models.map(model=>({'@type':'Product','@id':url+'#model-'+model.toLowerCase(),name:'Hitelecom '+model+S(' Pressure Sensor'),model,description:S('Published H Series pressure-sensor model identifier. The supplied range, sensing assembly and wireless variant are selected for the project.'),brand:{'@type':'Brand',name:'Hitelecom'},manufacturer:{'@id':orgId},isVariantOf:{'@id':groupId},url:url+'#model-'+model.toLowerCase()})),
 {'@type':'FAQPage','@id':url+'#faq',inLanguage:locale,mainEntity:content.faqs.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.paragraphs.join('\n\n')}}))}
];
---
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c')}/>
