---
/**
 * 压力传感器页 V2 · 多语言注册表（GPT6 页面包 + 五语翻译包，Kimi 审核集成 2026-10-09）
 * 同 URL 上线：/{lang}/product/pressure-sensor（slug 不变，hreflang 闭环 /
 * sitemap / 内链均由路由层原有逻辑覆盖）。zh 不在本轮范围（保持经典模板）。
 * 用法：EN 路由省略 locale（默认 en）；其余语言 locale="es|de|ja|fr|ru"。
 * 数据：src/data/pressure-content(-{lang}).json；词典：dicts.mjs
 * （键=英文原文，EN 无条目，S() 回退原文保证 EN 零差异）；
 * 样式：pressure.css（.ht-pressure 作用域，独立路由隔离打包）。
 * Organization/WebSite 实体图由 BaseLayout 全局输出，本页仅输出页面级
 * Schema（includeOrganization={false}，统一引用 /#organization）。
 * Hero 响应式 preload（imagesrcset/imagesizes 与 img 一致）经 head 槽输出，
 * 故不再使用 BaseLayout 的 preloadImage（避免重复 preload）。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PressurePage from './PressurePage.astro';
import StructuredData from './StructuredData.astro';
import { assetImage } from './images.mjs';
import { PRESSURE_DICTS } from './dicts.mjs';
import contentEn from '../../data/pressure-content.json';
import contentEs from '../../data/pressure-content-es.json';
import contentDe from '../../data/pressure-content-de.json';
import contentJa from '../../data/pressure-content-ja.json';
import contentFr from '../../data/pressure-content-fr.json';
import contentRu from '../../data/pressure-content-ru.json';
import '../../styles/pressure.css';

const REGISTRY = {
  en: { content: contentEn, prefix: '' },
  es: { content: contentEs, prefix: '/es' },
  de: { content: contentDe, prefix: '/de' },
  ja: { content: contentJa, prefix: '/ja' },
  fr: { content: contentFr, prefix: '/fr' },
  ru: { content: contentRu, prefix: '/ru' },
};

const { locale = 'en' } = Astro.props;
const { content, prefix } = REGISTRY[locale] ?? REGISTRY.en;
const t = PRESSURE_DICTS[locale];

const hero = await assetImage('product-hero.webp', true);
const ogImage = new URL(hero.src, Astro.site).href;
const heroSizes = '(max-width: 600px) 350px, (max-width: 1024px) 64vw, 760px';
---

<BaseLayout locale={locale} title={content.seo.title} description={content.seo.description}>
  <link slot="head" rel="preload" as="image" href={hero.src} imagesrcset={hero.srcset} imagesizes={heroSizes} fetchpriority="high" />
  <StructuredData slot="head" content={content} imageUrl={ogImage} t={t} locale={locale} prefix={prefix} includeOrganization={false} />
  <PressurePage content={content} t={t} locale={locale} prefix={prefix} />
</BaseLayout>
