---
import content from '../../data/pressure-content.json';
import FeatureIcon from './FeatureIcon.astro';
import ImageCaption from './ImageCaption.astro';
// QuickContact 不引入：官网 BaseLayout 已提供全站浮动联系按钮（README-KIMI 第 2 条）
import { getImage } from 'astro:assets';
import heroBackground from '../../assets/brand/sensor-hero-background.jpg';
import { assetImage } from './images.mjs';
const hero = await assetImage('product-hero.webp', true);
const widths = [640,1280,1920];
const backgrounds = await Promise.all(widths.map(width=>getImage({src:heroBackground,width,format:'webp',quality:78})));
const groups = await Promise.all(content.groups.map(async group=>({...group,asset:await assetImage(group.image.name),tasks:await Promise.all(content.applications.filter(scene=>scene.group===group.id).map(async scene=>({...scene,asset:await assetImage(scene.image.name)})))})));
---
<div class="ht-pressure"><div id="pressure-content">
  <div class="hero-band">
    <img class="hero-background" src={backgrounds[2].src} srcset={backgrounds.map((x,i)=>`${x.src} ${widths[i]}w`).join(', ')} sizes="100vw" width={heroBackground.width} height={heroBackground.height} alt="" aria-hidden="true" loading="eager" decoding="async" />
    <div class="wrap breadcrumb" aria-label="Breadcrumb"><a href="https://www.hitelecom.com">Home</a><span aria-hidden="true">/</span><a href="https://www.hitelecom.com/product">IoT sensors</a><span aria-hidden="true">/</span><span>Pressure sensor</span></div>
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-heading"><h1 id="hero-title">Wireless pressure<br/><span>sensors.</span></h1><p class="hero-value-line">Know the pressure. See the operating picture.</p></div>
      <figure class="hero-visual pressure-product"><img src={hero.src} srcset={hero.srcset} sizes="(max-width: 600px) 350px, (max-width: 1024px) 64vw, 760px" width={hero.width} height={hero.height} alt="Hitelecom wireless pressure sensor with remote pressure probe and cable, official product image" loading="eager" fetchpriority="high" decoding="async" /><figcaption><span class="live-dot" aria-hidden="true"></span>Pressure probe · Wireless terminal</figcaption></figure>
      <p class="hero-description">{content.hero.description}</p>
      <div class="hero-actions"><a href="#enquiry" class="button button-primary">Request a quote <span aria-hidden="true">↗</span></a><a href="#specifications" class="text-link">Explore ranges & configurations <span aria-hidden="true">↓</span></a></div>
      <div class="hero-proof"><div><strong>±0.5% FS</strong><span>Published measurement accuracy</span><small>Higher-precision customization on request</small></div><div><strong>IP68</strong><span>Published enclosure protection</span><small>Process connection selected for the installation</small></div><div><strong>10+ year design</strong><span>Battery-powered operation</span><small>Published hourly-reporting profile; life varies by deployment</small></div></div>
    </section>
  </div>
  <nav class="section-nav" aria-label="On this page"><div class="wrap"><a href="#measurement">Measurement</a><a href="#applications">Applications</a><a href="#specifications">Specifications</a><a href="#integration">Integration</a><a href="#faq">FAQ</a><a class="nav-quote" href="#enquiry">Request a quote ↗</a></div></nav>
  <section class="section features-section" id="features" aria-labelledby="features-title"><div class="wrap"><div class="section-heading compact-heading"><div><p class="eyebrow">KEY FEATURES</p><h2 id="features-title">Read the pressure.<br/><span>See the pattern.</span></h2></div><p>Bring readings from pumps, process lines and equipment utilities into a shared view. Match the sensing assembly and reporting profile to the work your team needs to do.</p></div><div class="feature-grid">{content.features.map((feature,index)=><article><span class="feature-mark" aria-hidden="true"><FeatureIcon index={index}/></span><h3>{feature.title}</h3><p>{feature.text}</p></article>)}</div></div></section>
  <section class="section measurement-section" id="measurement" aria-labelledby="measurement-title"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">MEASUREMENT & PROCESS CONNECTION</p><h2 id="measurement-title">Start with the process.<br/><span>Specify the pressure point.</span></h2></div><p>{content.measurement.description}</p></div><div class="measurement-grid">{content.measurement.cards.map((item,index)=><article class="measurement-card"><div class="measurement-heading"><span class="measurement-number">0{index+1}</span><span class="measurement-symbol" aria-hidden="true">{index===0?'↗':index===1?'↔':'↓'}</span></div><h3>{item.title}</h3><p>{item.text}</p><dl><dt>Define for your project</dt><dd>{item.project_brief}</dd></dl><a href="#enquiry" class="text-link" data-configuration={item.title}>Discuss this configuration ↗</a></article>)}</div><div class="installation-note"><span class="small-label">PROBE, CABLE & INSTALLATION</span><h3>A connection for the process.<br/>A position for the terminal.</h3><p>{content.measurement.installation_text}</p></div></div></section>
  <section class="section profile-section" id="operating-profile" aria-labelledby="profile-title"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">FROM PRESSURE TO ACTION</p><h2 id="profile-title">Measure. Report.<br/>Keep teams informed.</h2></div><p>{content.workflow.profile_text}</p></div><div class="pressure-workflow">{content.workflow.steps.map(step=><article><span class="step-number">{step.number}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div><div class="profile-note"><div><span class="small-label">SAMPLING, REPORTING & POWER</span><strong>Capture what matters.<br/>Report when it is useful.</strong></div><p>{content.workflow.battery_text}</p></div></div></section>
  <section class="section application-section" id="applications" aria-labelledby="applications-title"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">APPLICATIONS</p><h2 id="applications-title">{content.applicationSection.title}<br/><span>{content.applicationSection.valueHeading}</span></h2></div><p>{content.applicationSection.description}</p></div><div class="application-overview"><p><strong>{content.groups.length}</strong> industry categories <span aria-hidden="true">/</span> <strong>{content.applications.length}</strong> pressure-monitoring applications</p><p class="image-note">{content.applicationSection.note}</p></div><nav class="application-jump-nav" aria-label="Browse pressure sensor applications">{content.groups.map(group=><a href={'#group-'+group.id}>{group.jumpLabel}<span>{group.scenes.length}</span></a>)}</nav><p class="mounting-qualification">{content.applicationSection.mountingNote}</p><div class="application-groups">{groups.map((group,index)=><details class="application-group" id={'group-'+group.id} open={index===0}><summary><span><small>0{index+1}</small>{group.title}</span><span class="group-count">{group.scenes.length} applications <b aria-hidden="true">+</b></span></summary><div class="application-category-body"><div class="application-visual"><div class="application-media-slot"><figure class="application-category-photo"><img class="application-category-image" src={group.asset.src} srcset={group.asset.srcset} sizes="(max-width: 600px) calc(100vw - 76px), (max-width: 900px) calc((100vw - 132px) * .42), 470px" width={group.asset.width} height={group.asset.height} loading="lazy" decoding="async" alt={group.image.alt} style={'object-position:'+group.image.focalPoint}/><ImageCaption image={group.image}/></figure></div><p>{group.intro}</p></div><div class="application-task-list">{group.tasks.map((scene,taskIndex)=><details class="application-task" id={scene.id} open={index===0&&taskIndex===0}><summary aria-controls={'scene-photo-'+scene.id}><span class="task-heading"><h3>{scene.title}</h3>{scene.configurationLabel && <small class="configuration-label">{scene.configurationLabel}</small>}<small>{scene.tagline}</small></span><span class="task-toggle" aria-hidden="true">+</span></summary><div class="task-copy"><figure class="application-scene-photo" id={'scene-photo-'+scene.id} data-scene-owner={scene.id}><img class="application-scene-image" src={scene.asset.src} srcset={scene.asset.srcset} sizes="(max-width: 600px) calc(100vw - 76px), (max-width: 900px) calc((100vw - 132px) * .42), 470px" width={scene.asset.width} height={scene.asset.height} loading="lazy" decoding="async" alt={scene.image.alt} style={'object-position:'+scene.image.focalPoint}/><ImageCaption image={scene.image}/></figure><p>{scene.description}</p><dl><dt>Pressure-monitoring objective</dt><dd>{scene.objective}</dd><dt>Measurement connection</dt><dd>{scene.monitoringPoint}</dd><dt>Specify for this application</dt><dd>{scene.projectBrief}</dd></dl><a href="#enquiry" class="task-cta" data-project-scene={scene.title}>Discuss this application <span aria-hidden="true">↗</span></a></div></details>)}</div></div></details>)}</div></div></section>
  <section class="section specifications-section" id="specifications" aria-labelledby="specifications-title"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">SERIES & CONFIGURATIONS</p><h2 id="specifications-title">One pressure family.<br/><span>Configured for your process.</span></h2></div><p>{content.series.description}</p></div><div class="series-model-list" id="pressure-series"><span class="small-label">PUBLISHED FAMILY MODELS</span>{content.series.models.map(model=><span class="model-pill" id={'model-'+model.toLowerCase()}>{model}</span>)}</div><div class="pressure-series">{content.series.connectivity.map(item=><article><div class="model-heading"><span class="small-label">WIRELESS OPTION</span><span class="radio-badge">{item.id}</span></div><h3>{item.title}</h3><p>{item.description}</p><a href="#enquiry" class="text-link" data-radio={item.id}>Discuss {item.id} ↗</a></article>)}</div><div class="pressure-spec-grid"><aside class="model-card"><span class="small-label">PUBLISHED FAMILY REFERENCE</span><h3>Choose the range.<br/>Match the installation.</h3><p>{content.specifications.description}</p><a href={content.specifications.datasheet_url} class="button button-outline">Download datasheet ↗</a><a href="#enquiry" class="text-link">Discuss OEM / ODM ↓</a></aside><div class="spec-table"><table><caption>H Series wireless pressure sensors — published specifications</caption><tbody>{content.specifications.rows.map(row=><tr><th scope="row">{row.label}</th><td>{row.value}</td></tr>)}</tbody></table></div></div><div class="custom-sensing"><div><p class="eyebrow">APPLICATION-LED CUSTOMIZATION</p><h3>The sensing assembly your process needs.</h3><p>Start with the medium and the pressure point. Specify the range, connection and probe arrangement together, then select the terminal, wireless path and platform integration.</p></div><div class="custom-sensing-grid">{content.customSensing.map(item=><article><h4>{item.name}</h4><p>{item.text}</p></article>)}</div></div><div class="selection-list"><h3>Bring the specification back to your project.</h3><div>{content.series.steps.map((step,index)=><article><span class="step-number">0{index+1}</span><h4>{step.title}</h4><p>{step.text}</p></article>)}</div></div></div></section>
  <section class="section integration-section" id="integration" aria-labelledby="integration-title"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">CONNECTIVITY & INTEGRATION</p><h2 id="integration-title">Your pressure points.<br/><span>Your data destination.</span></h2></div><p>{content.workflow.platform_text}</p></div><div class="integration-grid"><article><span class="small-label">HITELECOM CLOUD</span><h3>For your operations team</h3><div class="route-flow"><span>Pressure point</span><b aria-hidden="true">→</b><span>Wireless connection</span><b aria-hidden="true">→</b><span>Cloud view</span></div><p>Associate each pressure point with its pipe, pump or equipment record. Review readings, timestamps and the agreed trend history, then configure thresholds and notification recipients.</p><ul><li>Device and measurement-point identity</li><li>Pressure value, unit and time</li><li>Threshold alerts and recipients</li></ul></article><article><span class="small-label">CUSTOMER PLATFORM</span><h3>For your existing workflow</h3><div class="route-flow"><span>Pressure reading</span><b aria-hidden="true">→</b><span>Agreed data path</span><b aria-hidden="true">→</b><span>Your platform</span></div><p>Bring pressure into your own operations view. Agree the MQTT endpoint or selected network integration, authentication, payload and engineering units with your platform team.</p><ul><li>Endpoint and authentication</li><li>Pressure field, unit and timestamp</li><li>Alert rules and operational context</li></ul></article></div><div class="integration-handover"><h3>Make the first pressure point useful.</h3><p>Review a sample message against a reference reading at commissioning. Confirm the unit, scale and timestamp, then test the agreed alert and notification path with the team responsible for the installation.</p><a href="#enquiry" class="text-link">Discuss platform integration ↗</a></div></div></section>
  <section class="section faq-section" id="faq" aria-labelledby="faq-title"><div class="wrap faq-layout"><div class="faq-intro"><p class="eyebrow">ANSWERS FOR YOUR PROJECT</p><h2 id="faq-title">Frequently<br/>asked questions.</h2><p>{content.faqHeading.intro}</p><a href="#enquiry" class="text-link">Ask about your project ↗</a></div><div class="faq-list">{content.faqs.map((faq,index)=><details id={faq.id} open={index===0}><summary>{faq.question}<span aria-hidden="true">+</span></summary><div class="faq-answer">{faq.paragraphs.map(paragraph=><p>{paragraph}</p>)}</div></details>)}</div></div></section>
  <section class="section enquiry-section" id="enquiry" aria-labelledby="enquiry-title"><div class="wrap enquiry-layout"><div class="enquiry-intro"><p class="eyebrow">LET'S TALK ABOUT YOUR PROJECT</p><h2 id="enquiry-title">Your pressure point.<br/><span>Our next conversation.</span></h2><p class="lead">Tell us the medium, working pressure and installation. We’ll help match the range, sensing assembly, wireless connection and platform to your project.</p><a class="contact-email" href="mailto:sales@hitelecom.cn">sales@hitelecom.cn ↗</a><div class="enquiry-benefits"><h3>Start with the process and the port.</h3><p>A pipe schematic, pressure-port photo or equipment drawing helps us understand the connection. Include your working temperature, update requirements and destination platform.</p></div></div><form id="enquiry-form" action="mailto:sales@hitelecom.cn" method="post" enctype="text/plain"><div class="form-heading"><span class="small-label">PROJECT ENQUIRY</span><h3>Let’s find your configuration.</h3><p>Pressure range · Process connection · Wireless option</p></div><div class="form-fields"><div class="field"><label for="application">Application <span aria-hidden="true">*</span></label><select id="application" name="Application" required><option value="">Choose your application</option>{content.groups.map(group=><optgroup label={group.title}>{content.applications.filter(scene=>scene.group===group.id).map(scene=><option value={scene.title}>{scene.title}</option>)}</optgroup>)}<option>Other / project-specific</option></select></div><div class="field"><label for="country">Country / installation site <span aria-hidden="true">*</span></label><input id="country" name="Country / installation site" required autocomplete="country-name" placeholder="e.g. UK water network / factory in Spain" maxlength="160"/></div><div class="field"><label for="medium">Process medium</label><input id="medium" name="Process medium" placeholder="e.g. water, hydraulic oil, compressed air" maxlength="160"/></div><div class="field"><label for="pressure-range-input">Working pressure / required range</label><input id="pressure-range-input" name="Pressure requirement" placeholder="e.g. operating 0.4–0.6 MPa; peaks 0.8 MPa" maxlength="200"/></div><div class="field"><label for="quantity">Estimated quantity</label><input id="quantity" name="Quantity" type="number" min="1" step="1" inputmode="numeric" placeholder="e.g. 20 pressure points"/></div><div class="field"><label for="wireless-option">Wireless preference</label><select id="wireless-option" name="Wireless preference"><option>Please advise</option>{content.series.connectivity.map(item=><option data-radio-id={item.id}>{item.id}</option>)}</select></div><div class="field full"><label for="requirements">What would you like to monitor?</label><textarea id="requirements" name="Requirements" rows="3" maxlength="3000" placeholder="Pressure reference, port/thread, medium temperature, sampling/reporting needs, platform and any project requirements"></textarea></div></div><div class="form-actions"><button type="submit" class="button button-primary">Prepare my enquiry ↗</button><p>Review your brief, then send it with your email app.</p></div><div id="enquiry-review" class="enquiry-review" hidden><label for="enquiry-brief">Your project brief</label><textarea id="enquiry-brief" rows="9" spellcheck="false"></textarea><div><a id="email-brief" class="button button-primary" href="mailto:sales@hitelecom.cn">Open email ↗</a><button id="copy-brief" type="button" class="button button-outline">Copy brief</button></div><p id="brief-status" role="status" aria-live="polite">Your brief is ready to review.</p></div><p class="noscript-note">You can also <a href="mailto:sales@hitelecom.cn?subject=H%20Series%20pressure%20sensor%20project">email your project details directly</a>.</p></form></div></section>
  <div class="wrap related-products"><p class="small-label">CONTINUE YOUR MONITORING PROJECT</p><a href="https://www.hitelecom.com/product">Explore all sensors ↗</a><a href="https://www.hitelecom.com/product/temperature-sensor">Temperature monitoring ↗</a><a href="https://www.hitelecom.com/product/liquid-level-sensor">Liquid level monitoring ↗</a></div>
</div></div>
<script>import './pressure-interactions.js';</script>
