---
/**
 * 合作伙伴 LOGO 墙（Ecosystem）
 * LOGO 维护：替换 src/assets/images/partners/ 下同名文件即可
 */
import Img from '../Img.astro';
import { homeContent, partnerLogos } from '../../data/home';
import type { Locale } from '../../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const { partners } = homeContent[locale];
---

<section class="partners" aria-labelledby="partners-title">
  {/* 顶部浅蓝渐变装饰图（与原站 index_2_top/img10.png 一致） */}
  <div class="wave-divider" aria-hidden="true">
    <Img src="common/wave.png" alt="" width={1920} height={256} loading="lazy" />
  </div>
  <div class="container">
    <h2 id="partners-title" class="section-title reveal">{partners.title}</h2>
    <p class="section-subtitle reveal">{partners.subtitle}</p>

    <ul class="partners-grid reveal">
      {partnerLogos.map((logo) => (
        <li class="partner-cell">
          <Img src={logo.img} alt={logo.alt} width={150} loading="lazy" />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .partners { position: relative; padding: clamp(60px, 6.5vw, 120px) 0 clamp(70px, 7.5vw, 140px); }
  .wave-divider { position: absolute; top: 0; left: 0; width: 100%; z-index: 4; pointer-events: none; }
  .wave-divider :global(img) { width: 100%; height: auto; display: block; }
  .partners-grid {
    margin-top: clamp(40px, 4.5vw, 80px);
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    row-gap: clamp(34px, 4vw, 70px);
    column-gap: clamp(16px, 2vw, 36px);
    align-items: center;
  }
  .partner-cell { display: grid; place-items: center; }
  .partner-cell :global(img) {
    max-height: clamp(36px, 3.4vw, 62px);
    width: auto;
    max-width: 100%;
    filter: saturate(0.92);
    transition: transform 0.4s var(--ease), filter 0.4s;
  }
  .partner-cell:hover :global(img) { transform: scale(1.12); filter: none; }

  @media (max-width: 980px) {
    .partners-grid { grid-template-columns: repeat(4, 1fr); }
  }
  @media (max-width: 560px) {
    .partners-grid { grid-template-columns: repeat(3, 1fr); row-gap: 28px; }
  }
</style>
