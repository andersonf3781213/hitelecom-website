---
/**
 * “We are the IoT company / 与宏太一起感知世界”
 * 标题 + 简介 + 六项能力（图标 + 标题 + 描述）
 */
import Img from '../Img.astro';
import { homeContent } from '../../data/home';
import type { Locale } from '../../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const { intro } = homeContent[locale];
---

<section class="intro" aria-labelledby="intro-title">
  <div class="container">
    <h2 id="intro-title" class="section-title reveal">{intro.title}</h2>
    <p class="section-subtitle reveal">{intro.subtitle}</p>

    <ul class="intro-grid">
      {intro.features.map((f, i) => (
        <li class:list={['reveal', `reveal-d${(i % 3) + 1}`]}>
          <div class="feature">
            <Img src={f.icon} alt="" width={96} height={96} class="feature-icon" />
            <div>
              <h3 class="feature-title">{f.title}</h3>
              <p class="feature-desc">{f.desc}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .intro { padding: clamp(64px, 7.8vw, 140px) 0 clamp(40px, 4vw, 80px); }
  .intro-grid {
    margin-top: clamp(44px, 5.5vw, 100px);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(40px, 5vw, 88px) clamp(28px, 3vw, 56px);
  }
  .feature { display: flex; align-items: flex-start; gap: 20px; }
  .feature :global(.feature-icon) {
    width: clamp(64px, 5.75vw, 96px);
    height: auto;
    flex-shrink: 0;
    transition: transform 0.5s var(--ease);
  }
  .feature:hover :global(.feature-icon) { transform: translateY(-6px); }
  .feature-title { font-size: clamp(1.15rem, 1.02rem + 0.5vw, 1.5rem); font-weight: 600; color: #000; }
  .feature-desc { color: var(--muted); font-size: 0.95rem; line-height: 1.7; margin-top: 0.35em; }

  @media (max-width: 980px) {
    .intro-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .intro-grid { grid-template-columns: 1fr; gap: 30px; }
  }
</style>
