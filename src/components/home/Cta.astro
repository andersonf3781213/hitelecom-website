---
/**
 * CTA 横幅：深蓝数字地图背景 + 双按钮（Try it now / Contact us）
 */
import { homeContent } from '../../data/home';
import { optimizedSrc } from '../../utils/images';
import { l, type Locale } from '../../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const { cta } = homeContent[locale];
const bg = await optimizedSrc('cta/bg.jpg', { width: 1920 });
---

<section class="cta" style={`--bg: url('${bg}')`} aria-labelledby="cta-title">
  <div class="container">
    <h2 id="cta-title" class="cta-title reveal">{cta.title}</h2>
    <p class="cta-subtitle reveal reveal-d1">{cta.subtitle}</p>
    <div class="cta-actions reveal reveal-d2">
      <a class="btn-ghost" href={cta.primary.href} target="_blank" rel="noopener">
        <span>{cta.primary.label}</span>
        <svg class="arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 12h15m-6-6 6 6-6 6"/></svg>
      </a>
      <a class="btn-ghost" href={l(cta.secondary.href, locale)}>
        <span>{cta.secondary.label}</span>
        <svg class="arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 12h15m-6-6 6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    background-image: var(--bg);
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    text-align: center;
    color: #fff;
    padding: clamp(90px, 10.2vw, 190px) 0;
  }
  @media (min-width: 1024px) {
    .cta { background-attachment: fixed; }
  }
  .cta-title {
    font-size: clamp(1.6rem, 1.1rem + 2.2vw, 2.9rem);
    font-weight: 700;
    line-height: 1.3;
    max-width: 22ch;
    margin-inline: auto;
  }
  .cta-subtitle {
    margin: 1.2em auto 0;
    max-width: 62ch;
    font-size: clamp(0.95rem, 0.9rem + 0.25vw, 1.1rem);
    line-height: 1.9;
    color: rgba(255, 255, 255, 0.85);
  }
  .cta-actions {
    margin-top: clamp(34px, 3.7vw, 60px);
    display: flex;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
  }
</style>
