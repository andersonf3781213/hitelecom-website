---
/**
 * 全站页脚：LOGO + 标语 / 五列链接 / 联系方式 / 社交 / 版权与备案
 */
import Img from './Img.astro';
import { homeContent } from '../data/home';
import { site } from '../data/site';
import { l, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = homeContent[locale];

const socialIcons: Record<string, string> = {
  whatsapp: '<path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4 0-.5.1-.7l.4-.5c.1-.2.2-.3.3-.5v-.5c0-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3 1 2.6 1.1 2.8.1.2 1.9 3 4.7 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1a3 3 0 0 0 1.9-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.2-.3-.2-.6-.4Z"/>',
  wechat: '<path d="M9.5 4C5.9 4 3 6.5 3 9.6c0 1.8 1 3.4 2.5 4.4l-.6 1.9 2.2-1.1c.5.1 1 .2 1.5.2h.4A5.5 5.5 0 0 1 9 13a5.6 5.6 0 0 1 5.6-5.4h.5C14.4 5.5 12.2 4 9.5 4ZM7.4 8.2a.8.8 0 1 1 0-1.6.8.8 0 0 1 0 1.6Zm4.2 0a.8.8 0 1 1 0-1.6.8.8 0 0 1 0 1.6ZM21 13.2c0-2.7-2.5-4.9-5.6-4.9s-5.6 2.2-5.6 4.9 2.5 4.9 5.6 4.9c.6 0 1.2-.1 1.8-.3l2 1-.6-1.7A4.7 4.7 0 0 0 21 13.2Zm-7.5-.7a.7.7 0 1 1 0-1.4.7.7 0 0 1 0 1.4Zm3.8 0a.7.7 0 1 1 0-1.4.7.7 0 0 1 0 1.4Z"/>',
  facebook: '<path d="M14 8.5V6.8c0-.8.5-1 1-1h2.5V2H14c-2.5 0-3.5 1.9-3.5 3.8v2.7H8V12h2.5v10H14V12h2.8l.5-3.5H14Z"/>',
  linkedin: '<path d="M6.9 8.6H3.5V21h3.4V8.6ZM5.2 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm5.2 6.6c0-1.6.6-2.9 2.2-2.9 1.5 0 2.1 1.1 2.1 2.9V21h3.4v-7.9c0-3.1-1.6-4.8-4.1-4.8-1.9 0-2.9 1-3.4 1.9V8.6H7.2c.1.9 0 12.4 0 12.4h3.4v-7.4h-.2Z"/>',
};
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <a href={l('/', locale)} aria-label="Hitelecom">
        <Img src="common/logo-footer.png" alt="Hitelecom" width={170} loading="lazy" />
      </a>
      <p class="footer-tagline">{site.tagline[locale]}</p>
    </div>

    <div class="footer-grid">
      {t.footer.columns.map((col) => (
        <nav class="footer-col" aria-label={col.title}>
          <p class="footer-col-title">{col.title}</p>
          <ul>
            {col.links.map((link) => (
              <li><a href={l(link.href, locale)}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}

      <div class="footer-col footer-contact">
        <p class="footer-col-title">{t.footer.contactTitle}</p>
        <a class="contact-phone" href={site.phoneHref}>{site.phone}</a>
        <a class="contact-mail" href={`mailto:${site.email}`}>{site.email.toUpperCase()}</a>

        <p class="footer-col-title follow">{t.footer.followTitle}</p>
        <ul class="socials">
          {site.socials.map((s) => (
            <li>
              {s.icon === 'wechat' || s.icon === 'whatsapp' ? (
                <button class="qr-btn" type="button" aria-label={s.name} aria-expanded="false">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" set:html={socialIcons[s.icon]} />
                  <span class="qr-pop">
                    <img
                      src={s.icon === 'wechat' ? '/images/qr-wechat.png' : '/images/qr-whatsapp.png'}
                      alt={`${s.name} QR code`}
                      width="120"
                      loading="lazy"
                      decoding="async"
                    />
                    <em>{s.icon === 'wechat' ? (locale === 'zh' ? '微信扫码咨询' : 'Scan on WeChat') : 'WhatsApp'}</em>
                  </span>
                </button>
              ) : (
                <a href={s.href} target="_blank" rel="noopener" aria-label={s.name}>
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" set:html={socialIcons[s.icon]} />
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>{t.footer.copyright}</p>
      <a class="nf" href={l('/about/privacy', locale)}>{locale === 'zh' ? '隐私政策' : 'Privacy Policy'}</a>
      {locale === 'zh'
        ? <a class="nf" href={site.icpUrl} target="_blank" rel="noopener">{site.icp}</a>
        : <a class="nf" href="https://iot67.com">iot67.com</a>}
    </div>
  </div>
</footer>

<script>
  // 页脚二维码图标：触屏点击展开/收起（桌面端悬停即可）
  const qrBtns = Array.from(document.querySelectorAll('.qr-btn'));
  qrBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.classList.toggle('on');
      btn.setAttribute('aria-expanded', String(open));
      qrBtns.forEach((b) => {
        if (b !== btn) { b.classList.remove('on'); b.setAttribute('aria-expanded', 'false'); }
      });
    });
  });
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('.qr-btn')) return;
    qrBtns.forEach((b) => { b.classList.remove('on'); b.setAttribute('aria-expanded', 'false'); });
  });
</script>

<style>
  .site-footer {
    background: var(--ink);
    color: #c1c7d5;
    padding: clamp(48px, 4.7vw, 90px) 0 0;
  }
  .footer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: clamp(28px, 2.6vw, 44px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    flex-wrap: wrap;
  }
  .footer-top :global(img) { width: clamp(140px, 11vw, 178px); }
  .footer-tagline {
    color: #fff;
    letter-spacing: 0.28em;
    font-size: clamp(0.78rem, 1vw, 1rem);
    text-transform: uppercase;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr) 1.4fr;
    gap: clamp(24px, 3vw, 48px);
    padding: clamp(34px, 3.6vw, 60px) 0;
  }
  .footer-col-title {
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    margin-bottom: 1.1em;
  }
  .footer-col li { margin-bottom: 0.72em; }
  .footer-col a {
    font-size: 0.86rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: color 0.3s, padding-left 0.3s var(--ease);
  }
  html[lang='zh-CN'] .footer-col a { text-transform: none; }
  .footer-col a:hover { color: #fff; padding-left: 6px; }

  .footer-contact .contact-phone {
    display: block;
    color: #fff;
    font-size: clamp(1.3rem, 1.6vw, 1.7rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: 0.35em;
  }
  .footer-contact .contact-mail {
    display: block;
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .footer-contact .follow { margin-top: 2.2em; }
  .socials { display: flex; gap: 12px; }
  .socials a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    transition: background 0.3s, transform 0.3s var(--ease);
  }
  .socials a:hover { background: var(--brand); transform: translateY(-3px); padding-left: 0; }
  .socials .qr-btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    transition: background 0.3s, transform 0.3s var(--ease);
  }
  .socials .qr-btn:hover { background: var(--brand); transform: translateY(-3px); }
  /* 二维码弹出层（与原站页脚一致：悬停图标弹出二维码） */
  .socials .qr-pop {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    background: #fff;
    padding: 10px 10px 8px;
    border-radius: 10px;
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.3);
    opacity: 0;
    visibility: hidden;
    transition: 0.25s var(--ease);
    pointer-events: none;
  }
  .socials .qr-pop::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 7px solid transparent;
    border-top-color: #fff;
  }
  .socials .qr-pop img { width: 120px; height: auto; }
  .socials .qr-pop em {
    display: block;
    font-style: normal;
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 600;
    text-align: center;
    margin-top: 6px;
    white-space: nowrap;
  }
  .socials .qr-btn:hover .qr-pop,
  .socials .qr-btn.on .qr-pop { opacity: 1; visibility: visible; transform: translateX(-50%); }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 22px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.8rem;
    color: var(--faint);
    letter-spacing: 0.05em;
  }
  .footer-bottom a:hover { color: #fff; }

  @media (max-width: 1080px) {
    .footer-grid { grid-template-columns: repeat(3, 1fr); }
    .footer-contact { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .footer-grid { grid-template-columns: repeat(2, 1fr); gap: 28px 18px; }
    .footer-tagline { width: 100%; }
  }
</style>
