---
const {content,imageUrl,includeOrganization=true,t={},prefix='',locale='en'} = Astro.props;
const S = (key) => (Object.prototype.hasOwnProperty.call(t, key) ? t[key] : key);
const url='https://www.hitelecom.com'+prefix+'/product/soil-moisture-sensor';
const orgId='https://www.hitelecom.com/#organization';
const graph=[
 ...(includeOrganization?[{'@type':'Organization','@id':orgId,name:'Hitelecom',legalName:'Shanghai Hitelecom Communication Technology Co., Ltd.',url:'https://www.hitelecom.com',email:'sales@hitelecom.cn'}]:[]),
 {'@type':'WebPage','@id':url+'#webpage',url,name:content.seo.title,description:content.seo.description,inLanguage:locale==='zh'?'zh-CN':locale,dateModified:'2026-10-13',publisher:{'@id':orgId},mainEntity:{'@id':url+'#series'}},
 {'@type':'BreadcrumbList','@id':url+'#breadcrumb',itemListElement:[{'@type':'ListItem',position:1,name:S('Home'),item:'https://www.hitelecom.com'+prefix},{'@type':'ListItem',position:2,name:S('IoT Sensors'),item:'https://www.hitelecom.com'+prefix+'/product'},{'@type':'ListItem',position:3,name:S('Soil Moisture Sensor'),item:url}]},
 {'@type':'ProductGroup','@id':url+'#series',...(locale==='zh'?{productGroupID:'H-Series-Soil-Sensors'}:{}),name:S('Hitelecom H Series soil sensors'),description:content.hero.description,brand:{'@type':'Brand',name:'Hitelecom'},manufacturer:{'@id':orgId},url,image:imageUrl,hasVariant:content.series.models.map(m=>({'@id':url+'#model-'+m.toLowerCase()})),additionalProperty:content.specifications.rows.map(row=>({'@type':'PropertyValue',name:row.label,value:row.value}))},
 ...content.series.models.map(m=>({'@type':'Product','@id':url+'#model-'+m.toLowerCase(),name:t.modelMeta?.[m]?.name ?? ('Hitelecom '+m+' Soil Sensor'),model:m,description:t.modelMeta?.[m]?.description ?? S('H Series soil-sensor model family. Measurements, probe, connectivity and reporting profile selected for the project.'),brand:{'@type':'Brand',name:'Hitelecom'},manufacturer:{'@id':orgId},...(t.modelMeta?.[m]?.connectivity?{additionalProperty:[{'@type':'PropertyValue',name:'通信',value:t.modelMeta[m].connectivity}]}:{}),isVariantOf:{'@id':url+'#series'},url:url+'#model-'+m.toLowerCase(),image:imageUrl})),
 {'@type':'FAQPage','@id':url+'#faq',inLanguage:locale==='zh'?'zh-CN':locale,mainEntity:content.faqs.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.paragraphs.join('\n\n')}}))}
];
---
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c')}/>
