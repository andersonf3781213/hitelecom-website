---
/**
 * 土壤传感器页 V2 · 包装器（GPT6 页面包 V68 + 多语言包 V69，Kimi 审核集成）
 * 路由：EN /product/soil-moisture-sensor（无前缀）；es/de/ja/fr/ru 经 locale 路由复用本组件。
 * 数据：REGISTRY 按 locale 选 soil-content-{locale}.json；EN 无字典条目，
 * S() 原样回落，EN 渲染零差异。UI 字符串：dicts.mjs（SOIL_DICTS）。
 * Organization/WebSite 实体图由 BaseLayout 全局输出，本页仅输出页面级
 * Schema（includeOrganization={false}，统一引用 /#organization）。
 * Hero 响应式 preload（imagesrcset/imagesizes 与 SoilPage img 一致）经 head 槽输出。
 * SiteShell/QuickContact 为 GPT6 离线审阅壳，不集成（README-KIMI）。
 * 规格书按钮链接仓库既有 /downloads/h300-soil-sensor-datasheet.pdf（口径已核对一致）。
 * 样式作用域：包内将 .ht-soil 挂在 body；集成经 BaseLayout，故挂在包装 div。
 * JS 文案经 pickJs 注入包装 div 的 data-i18n，soil-interactions.js T() 读取。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SoilPage from './SoilPage.astro';
import StructuredData from './StructuredData.astro';
import { soilImage } from './images.mjs';
import { SOIL_DICTS, pickJs } from './dicts.mjs';
import contentEn from '../../data/soil-content.json';
import contentEs from '../../data/soil-content-es.json';
import contentDe from '../../data/soil-content-de.json';
import contentJa from '../../data/soil-content-ja.json';
import contentFr from '../../data/soil-content-fr.json';
import contentRu from '../../data/soil-content-ru.json';
import contentZh from '../../data/soil-content-zh.json';
import '../../styles/soil.css';
const REGISTRY = {
  en: { content: contentEn, prefix: '' },
  es: { content: contentEs, prefix: '/es' },
  de: { content: contentDe, prefix: '/de' },
  ja: { content: contentJa, prefix: '/ja' },
  fr: { content: contentFr, prefix: '/fr' },
  ru: { content: contentRu, prefix: '/ru' },
  zh: { content: contentZh, prefix: '/zh' },
};
const { locale = 'en' } = Astro.props;
const { content, prefix } = REGISTRY[locale] ?? REGISTRY.en;
const t = SOIL_DICTS[locale] ?? {};
const hero = await soilImage('product-hero.webp', true);
const ogImage = new URL(hero.src, Astro.site).href;
const heroSizes = '(max-width: 600px) calc(100vw - 76px), (max-width: 1024px) 42vw, 560px';
---

<BaseLayout locale={locale} title={content.seo.title} description={content.seo.description} robots="index,follow,max-image-preview:large">
  <link slot="head" rel="preload" as="image" href={hero.src} imagesrcset={hero.srcset} imagesizes={heroSizes} fetchpriority="high" />
  <StructuredData slot="head" content={content} imageUrl={ogImage} includeOrganization={false} t={t} prefix={prefix} locale={locale} />
  <div class="ht-soil" data-i18n={JSON.stringify(pickJs(t))}><SoilPage content={content} t={t} prefix={prefix} /></div>
</BaseLayout>
