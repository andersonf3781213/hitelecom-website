---
const {image} = Astro.props;
const credit = image.credit;
---
<figcaption>
  <span class="application-photo-caption">{image.caption}</span>
  {image.disclosure && <small class="application-photo-disclosure">{image.disclosure}</small>}
  {image.target && <small class="application-photo-target">Measurement view: {image.target}</small>}
  {credit && <small class="application-photo-credit">
    Photo: <a href={credit.sourceURL} target="_blank" rel="noopener">{credit.author}</a>
    {' · '}<a href={credit.licenseURL} target="_blank" rel="noopener">{credit.license}</a>
    {credit.changes && <span>{' · '}{credit.changes}</span>}
  </small>}
</figcaption>
