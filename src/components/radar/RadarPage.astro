---
import contentDefault from '../../data/radar-content.json';
import { pickJs } from './dicts.mjs';
import FeatureIcon from './FeatureIcon.astro';
import ImageCaption from './ImageCaption.astro';
import ApplicationPhoto from './ApplicationPhoto.astro';
// QuickContact 不引入：官网 BaseLayout 已提供全站浮动联系按钮（README-KIMI 生产环境共用 Header/Footer）
import ReferenceGeometry from './ReferenceGeometry.astro';
import {getImage} from 'astro:assets';
import heroBackground from '../../assets/brand/sensor-hero-background.jpg';
import {assetImage} from './images.mjs';
const {content = contentDefault, t = {}, prefix = ''} = Astro.props;
const S = (key) => (Object.prototype.hasOwnProperty.call(t, key) ? t[key] : key);
const enc = (s) => encodeURIComponent(s);
const hero=await assetImage('product-hero.webp',true);
const widths=[640,1280,1920];
const backgrounds=await Promise.all(widths.map(width=>getImage({src:heroBackground,width,format:'webp',quality:78})));
const groups=await Promise.all(content.groups.map(async group=>({...group,asset:await assetImage(group.image.name),tasks:await Promise.all(content.applications.filter(scene=>scene.group===group.id).map(async scene=>({...scene,asset:await assetImage(scene.image.name)})))})));
---
<div class="ht-radar" data-i18n={JSON.stringify(pickJs(t))}><div id="radar-content">
  <div class="hero-band">
    <img class="hero-background" src={backgrounds[2].src} srcset={backgrounds.map((x,i)=>x.src+' '+widths[i]+'w').join(', ')} sizes="100vw" width={heroBackground.width} height={heroBackground.height} alt="" aria-hidden="true" loading="eager" decoding="async"/>
    <div class="wrap breadcrumb" aria-label={S("Breadcrumb")}><a href={'https://www.hitelecom.com'+prefix}>{S("Home")}</a><span aria-hidden="true">/</span><a href={'https://www.hitelecom.com'+prefix+'/product'}>{S("IoT sensors")}</a><span aria-hidden="true">/</span><span>{S("Radar distance sensor")}</span></div>
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-heading"><h1 id="hero-title">{S("Wireless radar")}<br/><span>{S("distance sensor.")}</span></h1><p class="hero-value-line">{content.hero.valueHeading}</p></div>
      <figure class="hero-visual radar-product"><img src={hero.src} srcset={hero.srcset} sizes="(max-width: 600px) 350px, (max-width: 1024px) 64vw, 760px" width={hero.width} height={hero.height} alt={S("Hitelecom H310-MW012 wireless radar distance sensor, official product image")} loading="eager" fetchpriority="high" decoding="async"/><figcaption><span class="live-dot" aria-hidden="true"></span>{content.hero.imageCaption}</figcaption></figure>
      <p class="hero-description">{content.hero.description}</p>
      <div class="hero-actions"><a href="#enquiry" class="button button-primary">{S("Request a quote")} <span aria-hidden="true">↗</span></a><a href={content.specifications.datasheet_url} target="_blank" rel="noopener" class="text-link">{S("Download datasheet")} <span aria-hidden="true">↗</span></a></div>
      <div class="hero-proof">{content.hero.proof.map(item=><div><strong>{item.value}</strong><span>{item.label}</span><small>{item.note}</small></div>)}</div>
    </section>
  </div>
  <nav class="section-nav" aria-label={S("On this page")}><div class="wrap"><a href="#measurement">{S("Measurement")}</a><a href="#applications">{S("Applications")}</a><a href="#specifications">{S("Specifications")}</a><a href="#integration">{S("Integration")}</a><a href="#faq">{S("FAQ")}</a><a class="nav-quote" href="#enquiry">{S("Request a quote ↗")}</a></div></nav>
  <section class="section features-section" id="features" aria-labelledby="features-title"><div class="wrap">
    <div class="section-heading compact-heading"><div><p class="eyebrow">{S("KEY FEATURES")}</p><h2 id="features-title">{S("A clear reading.")}<br/><span>{S("A connected operation.")}</span></h2></div><p>{S("See water, materials and selected positions from a distance. Match the target, installation and data connection to the work your team needs to do.")}</p></div>
    <div class="feature-grid">{content.features.map((feature,index)=><article><span class="feature-mark" aria-hidden="true"><FeatureIcon index={index}/></span><h3>{feature.title}</h3><p>{feature.text}</p></article>)}</div>
  </div></section>
  <section class="section measurement-section" id="measurement" aria-labelledby="measurement-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{S("MEASUREMENT & INSTALLATION")}</p><h2 id="measurement-title">{S("Start with the target.")}<br/><span>{S("Define the measuring path.")}</span></h2></div><p>{content.measurement.description}</p></div>
    <div class="measurement-grid">{content.measurement.cards.map((item,index)=><article class="measurement-card"><div class="measurement-heading"><span class="measurement-number">0{index+1}</span><span class="measurement-symbol" aria-hidden="true">{index===0?'↔':index===1?'↓':'↗'}</span></div><h3>{item.title}</h3><p>{item.text}</p><dl><dt>{S("Define for your project")}</dt><dd>{item.project_brief}</dd></dl><a href="#enquiry" class="text-link" data-configuration={item.title}>{S("Discuss this configuration ↗")}</a></article>)}</div>
    <div class="level-explainer">
      <div class="level-copy"><p class="eyebrow">{S("FROM DISTANCE TO LEVEL")}</p><h3>{S("One distance reading.")}<br/>{S("A useful site reference.")}</h3><p>{content.conversion.description}</p><div class="level-formula"><span>{S("Level")}</span><strong>L = H − D</strong><p>{S("4.2 m = 6.0 m − 1.8 m")}</p></div><small>{content.conversion.example.label}</small></div>
      <figure class="level-diagram"><svg class="geometry-desktop" viewBox="0 0 640 390" role="img" aria-labelledby="level-geometry-title level-geometry-description">
        <title id="level-geometry-title">{S("Illustrative vertical distance to water level conversion")}</title>
        <desc id="level-geometry-description">{S("The fixed measurement reference is 6 metres above the bottom datum. The distance to water is 1.8 metres, giving a water level of 4.2 metres.")}</desc>
        <defs><linearGradient id="water-tone" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#509aff" stop-opacity=".55"/><stop offset="1" stop-color="#285fdf" stop-opacity=".12"/></linearGradient><marker id="distance-arrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 10 5 0 10" fill="#285fdf"/></marker><clipPath id="tank-cut"><rect x="60" y="48" width="286" height="300" rx="16"/></clipPath></defs>
        <rect x="60" y="48" width="286" height="300" rx="16" fill="#f7faff" stroke="#a8bad4" stroke-width="2"/>
        <rect x="60" y="138" width="286" height="210" fill="url(#water-tone)" clip-path="url(#tank-cut)"/>
        <path d="M60 138H346" stroke="#285fdf" stroke-width="3"/>
        <rect x="190" y="17" width="28" height="25" rx="5" fill="#173454"/><path d="M204 42V48" stroke="#173454" stroke-width="4"/>
        <path d="M204 50V136" stroke="#285fdf" stroke-width="2" stroke-dasharray="5 5"/>
        <path d="M352 48H602M352 138H602M60 348H602" stroke="#9aacc5" stroke-width="1" stroke-dasharray="4 5"/>
        <path d="M410 53V133" stroke="#285fdf" stroke-width="2" marker-start="url(#distance-arrow)" marker-end="url(#distance-arrow)"/>
        <path d="M487 53V343" stroke="#285fdf" stroke-width="2" marker-start="url(#distance-arrow)" marker-end="url(#distance-arrow)"/>
        <path d="M563 143V343" stroke="#285fdf" stroke-width="2" marker-start="url(#distance-arrow)" marker-end="url(#distance-arrow)"/>
        <g font-family="Arial,sans-serif" font-size="16" fill="#17243a"><text x="373" y="86">D</text><text x="357" y="111">{S("1.8 m")}</text><text x="450" y="195">H</text><text x="434" y="220">{S("6.0 m")}</text><text x="574" y="245">L</text><text x="574" y="271">{S("4.2 m")}</text><text x="76" y="330">{S("Bottom datum")}</text><text x="77" y="124">{S("Water surface")}</text><text x="233" y="35" font-size="13">{S("Fixed reference")}</text></g>
      </svg><svg class="geometry-mobile" viewBox="0 0 360 320" role="img" aria-labelledby="level-mobile-title level-mobile-description">
        <title id="level-mobile-title">{S("Vertical water level conversion — compact mobile geometry")}</title>
        <desc id="level-mobile-description">{S("The fixed reference height H is six metres. The measured distance D to water is 1.8 metres. The resulting level L is 4.2 metres above the same bottom datum.")}</desc>
        <defs><marker id="level-mobile-arrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0 10 5 0 10" fill="#285fdf"/></marker><clipPath id="level-mobile-cut"><rect x="12" y="80" width="132" height="210" rx="10"/></clipPath></defs>
        <rect x="12" y="80" width="132" height="210" rx="10" fill="#f7faff" stroke="#a8bad4" stroke-width="2"/>
        <rect x="12" y="143" width="132" height="147" fill="#b7d5fb" clip-path="url(#level-mobile-cut)"/>
        <path d="M12 143H144" stroke="#285fdf" stroke-width="3"/>
        <rect x="66" y="46" width="24" height="25" rx="4" fill="#173454"/><path d="M78 71V80" stroke="#173454" stroke-width="4"/>
        <path d="M78 83V141" stroke="#285fdf" stroke-width="2" stroke-dasharray="5 5"/>
        <path d="M150 80H346M150 143H346M12 290H346" stroke="#9aacc5" stroke-width="1" stroke-dasharray="4 5"/>
        <path d="M180 85V138" fill="none" stroke="#285fdf" stroke-width="2" marker-start="url(#level-mobile-arrow)" marker-end="url(#level-mobile-arrow)"/>
        <path d="M252 85V285" fill="none" stroke="#285fdf" stroke-width="2" marker-start="url(#level-mobile-arrow)" marker-end="url(#level-mobile-arrow)"/>
        <path d="M313 148V285" fill="none" stroke="#285fdf" stroke-width="2" marker-start="url(#level-mobile-arrow)" marker-end="url(#level-mobile-arrow)"/>
        <g font-family="Arial,sans-serif" fill="#17243a" font-size="20">
          <text x="186" y="107">D</text><text x="186" y="129" font-size="18">{S("1.8 m")}</text>
          <text x="223" y="196">H</text><text x="203" y="219" font-size="18">{S("6.0 m")}</text>
          <text x="320" y="215">L</text><text x="258" y="243" font-size="18">{S("4.2 m")}</text>
          <text x="99" y="63" font-size="18">{S("Fixed reference")}</text>
          <text x="22" y="132" font-size="18">{S("Surface")}</text><text x="25" y="278" font-size="18">{S("Datum")}</text>
        </g>
      </svg><figcaption>{S("Fixed top mounting · vertical measuring path · shared datum")}</figcaption></figure>
      <div class="conversion-notes">{content.conversion.notes.map(item=><article><h4>{item.title}</h4><p>{item.text}</p></article>)}</div>
    </div>
    <ReferenceGeometry t={t}/>
    <div class="installation-note"><span class="small-label">{S("MOUNTING & COMMISSIONING")}</span><h3>{S("A stable reference.")}<br/>{S("A clear view of the target.")}</h3><p>{content.measurement.installation_text}</p></div>
  </div></section>
  <section class="section profile-section" id="operating-profile" aria-labelledby="profile-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{S("FROM A READING TO A RESPONSE")}</p><h2 id="profile-title">{S("Measure. Report.")}<br/>{S("Keep teams informed.")}</h2></div><p>{content.workflow.profile_text}</p></div>
    <div class="radar-workflow">{content.workflow.steps.map(step=><article><span class="step-number">{step.number}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div>
    <div class="profile-note"><div><span class="small-label">{S("POWER & REPORTING PROFILE")}</span><strong>{S("Long-life monitoring.")}<br/>{S("Matched to the task.")}</strong></div><p>{content.workflow.battery_text}</p></div>
  </div></section>
  <section class="section application-section" id="applications" aria-labelledby="applications-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{S("APPLICATIONS")}</p><h2 id="applications-title">{content.applicationSection.title}<br/><span>{content.applicationSection.valueHeading}</span></h2></div><p>{content.applicationSection.description}</p></div>
    <div class="application-overview"><p><strong>{content.groups.length}</strong> {S("industry categories")} <span aria-hidden="true">/</span> <strong>{content.applications.length}</strong> {S("monitoring tasks")}</p><p class="image-note">{content.applicationSection.note}</p></div>
    <nav class="application-jump-nav" aria-label={S("Browse radar distance sensor applications")}>{content.groups.map(group=><a href={'#group-'+group.id}>{group.jumpLabel}<span>{group.scenes.length}</span></a>)}</nav>
    <p class="mounting-qualification">{content.applicationSection.mountingNote}</p>
    <div class="application-groups">{groups.map((group,index)=><details class="application-group" id={'group-'+group.id} open={index===0}>
      <summary><span><small>0{index+1}</small>{group.title}</span><span class="group-count">{group.scenes.length}{S(" applications")} <b aria-hidden="true">+</b></span></summary>
      <div class="application-category-body">
        <div class="application-visual"><div class="application-media-slot"><figure class="application-category-photo"><ApplicationPhoto image={group.image} asset={group.asset} product={hero} category={true}/><ImageCaption image={group.image} t={t}/></figure></div><p>{group.intro}</p></div>
        <div class="application-task-list">{group.tasks.map((scene,taskIndex)=><details class="application-task" id={scene.id} open={index===0&&taskIndex===0}>
          <summary aria-controls={'scene-photo-'+scene.id}><span class="task-heading"><h3>{scene.title}</h3>{scene.configurationLabel && <small class="configuration-label">{scene.configurationLabel}</small>}<small>{scene.tagline}</small></span><span class="task-toggle" aria-hidden="true">+</span></summary>
          <div class="task-copy"><figure class="application-scene-photo" id={'scene-photo-'+scene.id} data-scene-owner={scene.id}><ApplicationPhoto image={scene.image} asset={scene.asset} product={hero}/><ImageCaption image={scene.image} t={t}/></figure><p>{scene.description}</p><dl><dt>{S("What is measured")}</dt><dd>{scene.measured}</dd><dt>{S("Installation point")}</dt><dd>{scene.point}</dd><dt>{S("Project requirements")}</dt><dd>{scene.requirements}</dd></dl><a href="#enquiry" class="task-cta" data-project-scene={scene.title}>{S("Discuss this application")} <span aria-hidden="true">↗</span></a></div>
        </details>)}</div>
      </div>
    </details>)}</div>
  </div></section>
  <section class="section specifications-section" id="specifications" aria-labelledby="specifications-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{S("SERIES & CONFIGURATIONS")}</p><h2 id="specifications-title">{S("One radar family.")}<br/><span>{S("Configured for your site.")}</span></h2></div><p>{content.series.description}</p></div>
    <div class="series-model-list" id="radar-series"><span class="small-label">{S("PUBLISHED FAMILY IDENTIFIERS")}</span>{content.series.models.map(model=><span class="model-pill">{model}</span>)}</div>
    <div class="radar-series">{content.series.connectivity.map(item=><article><div class="model-heading"><span class="small-label">{S("WIRELESS OPTION")}</span><span class="radio-badge">{item.id}</span></div><h3>{item.title}</h3><p>{item.description}</p><a href="#enquiry" class="text-link" data-radio={item.id}>{S('Discuss ' + item.id + ' ↗')}</a></article>)}</div>
    <div class="radar-spec-grid"><aside class="model-card"><span class="small-label">{S("PUBLISHED MODEL REFERENCE")}</span><h3 id="model-h310-mw012">H310-MW012</h3><p>{content.specifications.description}</p><a href={content.specifications.datasheet_url} target="_blank" rel="noopener" class="button button-outline">{S("Download datasheet ↗")}</a><a href="#enquiry" class="text-link">{S("Discuss your configuration ↓")}</a></aside><div class="spec-table"><table><caption>{S("H310-MW012 radar distance sensor — published model reference")}</caption><tbody>{content.specifications.rows.map(row=><tr><th scope="row">{row.label}</th><td>{row.value}</td></tr>)}</tbody></table></div></div>
    <div class="custom-sensing"><div><p class="eyebrow">{S("APPLICATION-LED CUSTOMIZATION")}</p><h3>{S("The configuration your site needs.")}</h3><p>{S("Start with the surface or target. Review range, measuring path, device form and mounting together, then match power, connectivity and platform integration.")}</p></div><div class="custom-sensing-grid">{content.customSensing.map(item=><article><h4>{item.name}</h4><p>{item.text}</p></article>)}</div></div>
    <div class="selection-list"><h3>{S("Bring the specification back to your project.")}</h3><div>{content.series.steps.map((step,index)=><article><span class="step-number">0{index+1}</span><h4>{step.title}</h4><p>{step.text}</p></article>)}</div></div>
  </div></section>
  <section class="section integration-section" id="integration" aria-labelledby="integration-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{S("CONNECTIVITY & INTEGRATION")}</p><h2 id="integration-title">{S("Your measurement points.")}<br/><span>{S("Your data destination.")}</span></h2></div><p>{content.workflow.platform_text}</p></div>
    <div class="integration-grid">
      <article><span class="small-label">{S("HITELECOM CLOUD")}</span><h3>{S("For your operations team")}</h3><div class="route-flow"><span>{S("Radar reading")}</span><b aria-hidden="true">→</b><span>{S("Wireless path")}</span><b aria-hidden="true">→</b><span>{S("Cloud view")}</span></div><p>{S("Associate each reading with its tank, silo, target or site. Review distance, the agreed level conversion, trends and configured alerts in the connected monitoring view.")}</p><ul><li>{S("Device and measurement-point identity")}</li><li>{S("Distance, unit, timestamp and configured level reference")}</li><li>{S("Thresholds, recipients and response workflow")}</li></ul></article>
      <article><span class="small-label">{S("CUSTOMER PLATFORM")}</span><h3>{S("For your existing workflow")}</h3><div class="route-flow"><span>{S("Distance data")}</span><b aria-hidden="true">→</b><span>{S("Agreed integration")}</span><b aria-hidden="true">→</b><span>{S("Your platform")}</span></div><p>{S("Bring radar readings into your own operations view. Agree the cellular MQTT endpoint or selected LoRa integration, authentication, payload and any level or inventory calculation.")}</p><ul><li>{S("Endpoint, network path and authentication")}</li><li>{S("Reading fields, units and measurement reference")}</li><li>{S("Vessel geometry or tank table where required")}</li></ul></article>
    </div>
    <div class="integration-handover"><h3>{S("Make the first reading useful.")}</h3><p>{S("Check a sample message against a known target distance. Confirm the reference, units, timestamps and any level calculation, then test the notification path with the team responsible for the site.")}</p><a href="#enquiry" class="text-link">{S("Discuss platform integration ↗")}</a></div>
  </div></section>
  <section class="section faq-section" id="faq" aria-labelledby="faq-title"><div class="wrap faq-layout"><div class="faq-intro"><p class="eyebrow">{S("ANSWERS FOR YOUR PROJECT")}</p><h2 id="faq-title">{S("Frequently")}<br/>{S("asked questions.")}</h2><p>{content.faqHeading.intro}</p><a href="#enquiry" class="text-link">{S("Ask about your project ↗")}</a></div><div class="faq-list">{content.faqs.map((faq,index)=><details id={faq.id} open={index===0}><summary>{faq.question}<span aria-hidden="true">+</span></summary><div class="faq-answer">{faq.paragraphs.map(paragraph=><p>{paragraph}</p>)}</div></details>)}</div></div></section>
  <section class="section enquiry-section" id="enquiry" aria-labelledby="enquiry-title"><div class="wrap enquiry-layout">
    <div class="enquiry-intro"><p class="eyebrow">{S("LET'S TALK ABOUT YOUR PROJECT")}</p><h2 id="enquiry-title">{S("Your measuring point.")}<br/><span>{S("Our next conversation.")}</span></h2><p class="lead">{S("Tell us what you need to measure and where. We’ll help match the target, range, mounting, wireless connection and platform to your project.")}</p><a class="contact-email" href="mailto:sales@hitelecom.cn">sales@hitelecom.cn ↗</a><div class="enquiry-benefits"><h3>{S("Start with a site photo or drawing.")}</h3><p>{S("Show the vessel or target, available mounting position and nearest and farthest distances. Include your update requirements and destination platform.")}</p></div></div>
    <form id="enquiry-form" action="mailto:sales@hitelecom.cn" method="post" enctype="text/plain">
      <div class="form-heading"><span class="small-label">{S("PROJECT ENQUIRY")}</span><h3>{S("Let’s find your configuration.")}</h3><p>{S("Target & range · Mounting · Wireless option")}</p></div>
      <div class="form-fields">
        <div class="field"><label for="application">{S("Application")} <span aria-hidden="true">*</span></label><select id="application" name="Application" required><option value="">{S("Choose your application")}</option>{content.groups.map(group=><optgroup label={group.title}>{content.applications.filter(scene=>scene.group===group.id).map(scene=><option value={scene.title}>{scene.title}</option>)}</optgroup>)}<option>{S("Other / project-specific")}</option></select></div>
        <div class="field"><label for="country">{S("Country / installation site")} <span aria-hidden="true">*</span></label><input id="country" name="Country / installation site" required autocomplete="country-name" placeholder={S("e.g. UK water site / factory in Spain")} maxlength="160"/></div>
        <div class="field"><label for="medium">{S("Target / material")}</label><input id="medium" name="Target / material" placeholder={S("e.g. water surface, grain, equipment target")} maxlength="160"/></div>
        <div class="field"><label for="radar-range-input">{S("Nearest & farthest measuring distances")}</label><input id="radar-range-input" name="Distance requirement" placeholder={S("e.g. 0.8–6 m from the installed sensor")} maxlength="200"/></div>
        <div class="field"><label for="quantity">{S("Estimated quantity")}</label><input id="quantity" name="Quantity" type="number" min="1" step="1" inputmode="numeric" placeholder={S("e.g. 20 monitoring points")}/></div>
        <div class="field"><label for="wireless-option">{S("Wireless preference")}</label><select id="wireless-option" name="Wireless preference"><option>{S("Please advise")}</option>{content.series.connectivity.map(item=><option data-radio-id={item.id}>{item.id}</option>)}</select></div>
        <div class="field full"><label for="requirements">{S("What would you like to monitor?")}</label><textarea id="requirements" name="Requirements" rows="3" maxlength="3000" placeholder={S("Mounting height, vessel dimensions, site conditions, sampling/reporting needs, platform and any project requirements")}></textarea></div>
      </div>
      <div class="form-actions"><button type="submit" class="button button-primary">{S("Prepare my enquiry ↗")}</button><p>{S("Review your brief, then send it with your email app.")}</p></div>
      <div id="enquiry-review" class="enquiry-review" hidden><label for="enquiry-brief">{S("Your project brief")}</label><textarea id="enquiry-brief" rows="9" spellcheck="false"></textarea><div><a id="email-brief" class="button button-primary" href="mailto:sales@hitelecom.cn">{S("Open email ↗")}</a><button id="copy-brief" type="button" class="button button-outline">{S("Copy brief")}</button></div><p id="brief-status" role="status" aria-live="polite">{S("Your brief is ready to review.")}</p></div>
      <p class="noscript-note">{S("You can also")} <a href={'mailto:sales@hitelecom.cn?subject='+enc(S('H Series radar distance sensor project'))}>{S("email your project details directly")}</a>.</p>
    </form>
  </div></section>
  <div class="wrap related-products"><p class="small-label">{S("CONTINUE YOUR MONITORING PROJECT")}</p><a href={'https://www.hitelecom.com'+prefix+'/product'}>{S("Explore all sensors ↗")}</a><a href={'https://www.hitelecom.com'+prefix+'/product/pressure-sensor'}>{S("Pressure monitoring ↗")}</a><a href={'https://www.hitelecom.com'+prefix+'/product/liquid-level-sensor'}>{S("Submersible level monitoring ↗")}</a></div>
</div></div>
<script>import './radar-interactions.js';</script>
