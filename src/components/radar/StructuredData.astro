---
const {content,imageUrl,t={},locale='en',prefix='',includeOrganization=true}=Astro.props;
const S=(key)=>(Object.prototype.hasOwnProperty.call(t,key)?t[key]:key);
const url='https://www.hitelecom.com'+prefix+'/product/radar-distance-sensor';
const orgId='https://www.hitelecom.com/#organization';
const groupId=url+'#radar-series';
const modelId=url+'#model-h310-mw012';
const property=(name,value)=>({'@type':'PropertyValue',name,value});
const graph=locale==='zh'?[
  {'@type':'WebPage','@id':url+'#webpage',url,name:content.seo.title,description:content.seo.description,inLanguage:'zh-CN',isPartOf:{'@id':'https://www.hitelecom.com/#website'},publisher:{'@id':orgId},breadcrumb:{'@id':url+'#breadcrumb'},mainEntity:{'@id':groupId}},
  {'@type':'BreadcrumbList','@id':url+'#breadcrumb',itemListElement:[
    {'@type':'ListItem',position:1,name:'首页',item:'https://www.hitelecom.com/zh'},
    {'@type':'ListItem',position:2,name:'物联网传感器',item:'https://www.hitelecom.com/zh/product'},
    {'@type':'ListItem',position:3,name:'雷达测距传感器',item:url}
  ]},
  {'@type':'ProductGroup','@id':groupId,name:'宏太 H 系列无线雷达测距传感器',description:content.hero.description,url,image:imageUrl,brand:{'@type':'Brand',name:'Hitelecom'},manufacturer:{'@id':orgId},productGroupID:'H-Series-Radar-Distance-Sensors',variesBy:['无线通信方式'],additionalProperty:content.specifications.rows.filter(row=>row.label!=='电池容量').map(row=>property(row.label,row.value)),hasVariant:[{'@id':url+'#model-h300'},{'@id':url+'#model-h500'},{'@id':url+'#model-h200'}]},
  {'@type':'Product','@id':url+'#model-h300',name:'宏太 H300 4G LTE 雷达测距传感器配置',model:'H300',url:url+'#model-h300',brand:{'@type':'Brand',name:'Hitelecom'},manufacturer:{'@id':orgId},isVariantOf:{'@id':groupId},additionalProperty:[property('无线通信方式','4G LTE'),property('电池容量参考','19,000 mAh（H300 参考配置）；实际交付规格按所选配置确认')]},
  {'@type':'Product','@id':url+'#model-h500',name:'宏太 H500 NB-IoT 雷达测距传感器配置',model:'H500',url:url+'#model-h500',brand:{'@type':'Brand',name:'Hitelecom'},manufacturer:{'@id':orgId},isVariantOf:{'@id':groupId},additionalProperty:[property('无线通信方式','NB-IoT')]},
  {'@type':'Product','@id':url+'#model-h200',name:'宏太 H200 LoRa 雷达测距传感器配置',model:'H200',url:url+'#model-h200',brand:{'@type':'Brand',name:'Hitelecom'},manufacturer:{'@id':orgId},isVariantOf:{'@id':groupId},additionalProperty:[property('无线通信方式','LoRa')]},
  {'@type':'FAQPage','@id':url+'#faq',inLanguage:'zh-CN',mainEntity:content.faqs.map(f=>({'@type':'Question','@id':url+'#'+f.id,name:f.question,acceptedAnswer:{'@type':'Answer',text:f.paragraphs.join('\n\n')}}))}
]:[
  ...(includeOrganization?[{'@type':'Organization','@id':orgId,name:'Hitelecom',legalName:'Shanghai Hitelecom Communication Technology Co., Ltd.',url:'https://www.hitelecom.com',email:'sales@hitelecom.cn'}]:[]),
  {'@type':'WebPage','@id':url+'#webpage',url,name:content.seo.title,description:content.seo.description,inLanguage:locale,dateModified:'2026-10-11',publisher:{'@id':orgId},mainEntity:{'@id':groupId}},
  {'@type':'BreadcrumbList','@id':url+'#breadcrumb',itemListElement:[
    {'@type':'ListItem',position:1,name:S('Home'),item:'https://www.hitelecom.com'+prefix},
    {'@type':'ListItem',position:2,name:S('IoT Sensors'),item:'https://www.hitelecom.com'+prefix+'/product'},
    {'@type':'ListItem',position:3,name:S('Radar Distance Sensor'),item:url}
  ]},
  {'@type':'ProductGroup','@id':groupId,productGroupID:'H-Series-Radar-Distance-Sensors',name:S('Hitelecom H Series Wireless Radar Distance Sensors'),description:content.hero.description,url,image:imageUrl,brand:{'@type':'Brand',name:'Hitelecom'},manufacturer:{'@id':orgId},hasVariant:[{'@id':modelId}],additionalProperty:[
    property(S('Measured quantity'),S('Distance to a selected surface or target')),
    property(S('Family wireless options'),S('4G / NB-IoT / LoRa, selected by configuration')),
    property(S('Application configuration'),S('Target, range, mounting reference, power and reporting profile selected for the project'))
  ]},
  {'@type':'Product','@id':modelId,name:S('Hitelecom H310-MW012 Radar Distance Sensor'),model:'H310-MW012',description:content.specifications.description,image:imageUrl,brand:{'@type':'Brand',name:'Hitelecom'},manufacturer:{'@id':orgId},isVariantOf:{'@id':groupId},url:modelId,additionalProperty:[
    property(S('Measuring range'),S('0.3–12 m')),
    property(S('Published accuracy'),S('±1 mm under 25°C Hitelecom laboratory conditions')),
    property(S('Reading resolution'),S('1 mm')),
    property(S('Beam angle'),S('<20° published model reference')),
    property(S('Enclosure protection'),S('IP68')),
    property(S('Operating temperature'),S('−30°C to +75°C')),
    property(S('Battery-life reference'),S('More than 10 years at two-hour reporting; actual service life depends on configuration and operating conditions'))
  ]},
  {'@type':'FAQPage','@id':url+'#faq',inLanguage:locale,mainEntity:content.faqs.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.paragraphs.join('\n\n')}}))}
];
---
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c')}/>
