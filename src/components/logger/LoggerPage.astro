---
import content from '../../data/logger-content.json';
import FeatureIcon from './FeatureIcon.astro';
import ImageCaption from './ImageCaption.astro';
// QuickContact 不引入：官网 BaseLayout 已提供全站浮动联系按钮（README-KIMI：生产环境保留现有共享 Header/Footer 与四个联系控件）
import { getImage } from 'astro:assets';
import heroBackground from '../../assets/brand/sensor-hero-background.jpg';
import { loggerImage } from './images.mjs';
const hero = await loggerImage('product-hero.webp', true);
const widths = [640,1280,1920];
const backgrounds = await Promise.all(widths.map(width=>getImage({src:heroBackground,width,format:'webp',quality:78})));
const groups = await Promise.all(content.groups.map(async group=>({...group,asset:await loggerImage(group.image.name),tasks:await Promise.all(content.applications.filter(scene=>scene.group===group.id).map(async scene=>({...scene,image:scene.image||group.image,asset:await loggerImage((scene.image||group.image).name)})))})));
const datasheet = content.hero.datasheet_url ? new URL(content.hero.datasheet_url,'https://www.hitelecom.com').href : null;
const readoutSteps = [
  {number:'01',title:'Connect',text:'Connect the logger to your computer by USB when you are ready to retrieve the records.'},
  {number:'02',title:'Download',text:'Use the local PC software to retrieve the temperature and humidity records stored on the device.'},
  {number:'03',title:'Review',text:'Review the recorded curves and analyse how conditions changed during the recording period.'},
  {number:'04',title:'Export',text:'Export PDF or CSV files for your project records and further review.'}
];
---
<div class="ht-logger">
<main id="main">
  <div class="hero-band">
    <img class="hero-background" src={backgrounds[2].src} srcset={backgrounds.map((x,i)=>`${x.src} ${widths[i]}w`).join(', ')} sizes="100vw" width={heroBackground.width} height={heroBackground.height} alt="" aria-hidden="true" loading="eager" decoding="async" />
    <div class="wrap breadcrumb" aria-label="Breadcrumb"><a href="https://www.hitelecom.com">Home</a><span aria-hidden="true">/</span><a href="https://www.hitelecom.com/product">IoT sensors</a><span aria-hidden="true">/</span><span>Temperature & humidity data logger</span></div>
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-heading"><p class="hero-kicker">H100 SERIES · LOCAL DATA LOGGING</p><h1 id="hero-title">Temperature & humidity<br class="logger-title-break"/> data logger.<span>Record the conditions.<br/>Review them on your computer.</span></h1></div>
      <figure class="hero-visual logger-product">
        <img src={hero.src} srcset={hero.srcset} sizes="(max-width: 600px) 350px, (max-width: 1024px) 45vw, 580px" width={hero.width} height={hero.height} alt="Hitelecom H100 temperature and humidity data logger, official product image" loading="eager" fetchpriority="high" decoding="async" />
        <figcaption><span class="record-dot" aria-hidden="true"></span>On-device records · USB readout with PC software</figcaption>
      </figure>
      <p class="hero-description">{content.hero.description}</p>
      <div class="hero-actions"><a href="#enquiry" class="button button-primary">Discuss your recording project <span aria-hidden="true">↗</span></a>{datasheet ? <a href={datasheet} target="_blank" rel="noopener" class="text-link">View data logger datasheet <span aria-hidden="true">↗</span></a> : <a href="#specifications" class="text-link">View specifications <span aria-hidden="true">↓</span></a>}</div>
      <div class="hero-proof"><div><strong>80,000</strong><span>Stored readings</span><small>Records held on the device</small></div><div><strong>±0.2°C</strong><span>Typical temperature accuracy</span><small>Typical product specification</small></div><div><strong>±2% RH</strong><span>Typical humidity accuracy</span><small>Typical product specification</small></div><div><strong>Local PC</strong><span>USB data retrieval</span><small>Review with local software</small></div></div>
    </section>
  </div>
  <nav class="section-nav" aria-label="On this page"><div class="wrap"><a href="#measurement">Recording</a><a href="#applications">Applications</a><a href="#specifications">Specifications</a><a href="#software">PC software</a><a href="#faq">FAQ</a><a class="nav-quote" href="#enquiry">Request a quote ↗</a></div></nav>

  <section class="section features-section" id="features" aria-labelledby="features-title"><div class="wrap">
    <div class="section-heading compact-heading"><div><p class="eyebrow">KEY FEATURES</p><h2 id="features-title">A record of the environment.<br/><span>Ready for a closer look.</span></h2></div><p>Record temperature and relative humidity locally, then retrieve the data with PC software when your recording period is complete.</p></div>
    <div class="feature-grid">{content.features.map((feature,index)=><article><span class="feature-mark" aria-hidden="true"><FeatureIcon index={index}/></span><h3>{feature.title}</h3><p>{feature.text}</p></article>)}</div>
  </div></section>

  <section class="section measurement-section" id="measurement" aria-labelledby="measurement-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">TEMPERATURE · RELATIVE HUMIDITY · LOCAL RECORDS</p><h2 id="measurement-title">The conditions.<br/><span>The record behind them.</span></h2></div><p>{content.measurement.description}</p></div>
    <div class="measurement-grid">{content.measurement.cards.map((item,index)=><article class="measurement-card"><div class="measurement-heading"><span class="measurement-number">0{index+1}</span><span class="measurement-symbol" aria-hidden="true">{item.symbol || ['°C','%RH','t','↗'][index]}</span></div><h3>{item.title}</h3><p>{item.text}</p><dl><dt>Plan your recording project</dt><dd>{item.project_brief}</dd></dl><a href="#enquiry" class="text-link" data-measurement={item.title}>Discuss this requirement ↗</a></article>)}</div>
    <div class="installation-note"><span class="small-label">POSITION & RECORDING PLAN</span><h3>Record the right place.<br/>Keep the context with the data.</h3><p>{content.measurement.installation_text}</p></div>
  </div></section>

  <section class="section profile-section" id="operating-profile" aria-labelledby="profile-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">SET UP · RECORD · READ OUT</p><h2 id="profile-title">Let the logger record.<br/>Return to the data.</h2></div><p>{content.workflow.profile_text}</p></div>
    <div class="logger-workflow">{content.workflow.steps.map(step=><article><span class="step-number">{step.number}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div>
    {content.workflow.battery_text && <div class="profile-note"><div><span class="small-label">RECORDING INTERVAL & BATTERY</span><strong>{content.workflow.profileTitle || 'Plan the interval around your recording period.'}</strong></div><p>{content.workflow.battery_text}</p></div>}
  </div></section>

  <section class="section application-section" id="applications" aria-labelledby="applications-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">APPLICATIONS</p><h2 id="applications-title">{content.applicationSection.title}<br/><span>{content.applicationSection.valueHeading}</span></h2></div><p>{content.applicationSection.description}</p></div>
    <div class="application-overview"><p><strong>{content.groups.length}</strong> industry categories <span aria-hidden="true">/</span> <strong>{content.applications.length}</strong> recording tasks</p><p class="image-note">{content.applicationSection.note}</p></div>
    <nav class="application-jump-nav" aria-label="Browse temperature and humidity recording applications">{content.groups.map(group=><a href={'#group-'+group.id}>{group.jumpLabel}<span>{group.scenes.length}</span></a>)}</nav>
    <div class="application-groups">{groups.map((group,index)=><details class="application-group" id={'group-'+group.id} open={index===0}>
      <summary><span><small>{String(index+1).padStart(2,'0')}</small>{group.title}</span><span class="group-count">{group.tasks.length} recording tasks <b aria-hidden="true">+</b></span></summary>
      <div class="application-category-body">
        <div class="application-visual"><div class="application-media-slot"><figure class="application-category-photo"><img class="application-category-image" src={group.asset.src} srcset={group.asset.srcset} sizes="(max-width: 600px) calc(100vw - 76px), (max-width: 900px) calc((100vw - 132px) * .42), 470px" width={group.asset.width} height={group.asset.height} loading="lazy" decoding="async" alt={group.image.alt} style={'object-position:'+group.image.focalPoint}/><ImageCaption image={group.image}/></figure></div><p>{group.intro}</p></div>
        <div class="application-task-list">{group.tasks.map((scene,taskIndex)=><details class="application-task" id={scene.id} open={index===0&&taskIndex===0}>
          <summary aria-controls={'scene-photo-'+scene.id}><span class="task-heading"><h3>{scene.title}</h3><small>{scene.measurement}</small></span><span class="task-toggle" aria-hidden="true">+</span></summary>
          <div class="task-copy"><figure class="application-scene-photo" id={'scene-photo-'+scene.id} data-scene-owner={scene.id}><img class="application-scene-image" src={scene.asset.src} srcset={scene.asset.srcset} sizes="(max-width: 600px) calc(100vw - 76px), (max-width: 900px) calc((100vw - 132px) * .42), 470px" width={scene.asset.width} height={scene.asset.height} loading="lazy" decoding="async" alt={scene.image.alt} style={'object-position:'+scene.image.focalPoint}/><ImageCaption image={scene.image}/></figure><p>{scene.description}</p><dl><dt>Conditions to record</dt><dd>{scene.measurement}</dd><dt>Recording point</dt><dd>{scene.monitoringPoint}</dd>{scene.installation && <><dt>Placement & installation</dt><dd>{scene.installation}</dd></>}<dt>Recording project details</dt><dd>{scene.projectBrief}</dd></dl><a href="#enquiry" class="task-cta" data-project-scene={scene.title}>Discuss this application <span aria-hidden="true">↗</span></a></div>
        </details>)}</div>
      </div>
    </details>)}</div>
  </div></section>

  <section class="section specifications-section" id="specifications" aria-labelledby="specifications-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">H100 DATA LOGGER</p><h2 id="specifications-title">One logger.<br/><span>Your collection interval.</span></h2></div><p>{content.series.description}</p></div>
    <div class="logger-series">{content.series.models.map(model=>{const detail=content.series.modelDetails?.find(item=>item.model===model);return <article id={'model-'+model.toLowerCase()}><div class="logger-model-heading"><span class="small-label">TEMPERATURE & HUMIDITY DATA LOGGER</span><h3>{model}</h3></div><div class="logger-model-copy">{detail?.title && <h4>{detail.title}</h4>}<p>{detail?.text || 'Local temperature and humidity recording with a configurable collection interval and USB retrieval in PC software.'}</p></div><a href="#enquiry" class="text-link" data-model={model}>Discuss your H100 project ↗</a></article>})}</div>
    <div class="logger-spec-grid"><aside class="model-card"><span class="small-label">H100 SPECIFICATIONS</span><h3>Start with the period.<br/>Specify the interval.</h3><p>{content.specifications.description}</p>{datasheet ? <a href={datasheet} target="_blank" rel="noopener" class="button button-outline">View data logger datasheet ↗</a> : <a href="#enquiry" class="button button-outline">Request the current datasheet ↗</a>}<a href="#enquiry" class="text-link">Discuss your recording plan ↓</a></aside><div class="spec-table"><table><caption>H100 temperature and humidity data logger — product specifications</caption><tbody>{content.specifications.rows.map(row=><tr><th scope="row">{row.label}</th><td>{row.value}</td></tr>)}</tbody></table></div></div>
    <div class="selection-list"><h3>Give the record a clear purpose.</h3><div>{content.series.steps.map((step,index)=><article><span class="step-number">0{index+1}</span><h4>{step.title}</h4><p>{step.text}</p></article>)}</div></div>
  </div></section>

  <section class="section software-section" id="software" aria-labelledby="software-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">LOCAL SOFTWARE & DATA RETRIEVAL</p><h2 id="software-title">From the logger.<br/><span>To your computer.</span></h2></div><p>{content.workflow.platform_text}</p></div>
    <div class="local-data-route" aria-label="Records are retrieved from the logger by USB into local PC software"><article><span class="route-icon" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="9" y="3" width="14" height="26" rx="4"/><rect x="12" y="8" width="8" height="7" rx="1"/><path d="M13 21h6m-6 4h6"/></svg></span><span class="small-label">01 / RECORDS STORED LOCALLY</span><h3>Data logger</h3><p>Temperature and humidity records stay on the device during logging.</p></article><span class="route-arrow" aria-hidden="true">→</span><article><span class="route-icon" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 26V5m-3 3 3-3 3 3M16 20l-7-6v-4m7 6 7-6V6"/><circle cx="9" cy="8" r="2"/><rect x="21" y="3" width="4" height="4"/><circle cx="16" cy="27" r="2"/></svg></span><span class="small-label">02 / CONNECT FOR READOUT</span><h3>USB connection</h3><p>Connect to your computer when you need to retrieve the recording.</p></article><span class="route-arrow" aria-hidden="true">→</span><article><span class="route-icon" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="26" height="18" rx="2"/><path d="M12 29h8m-4-6v6M7 18l5-5 5 2 7-6"/></svg></span><span class="small-label">03 / REVIEW ON YOUR COMPUTER</span><h3>Local PC software</h3><p>Download records, analyse curves and export PDF or CSV files.</p></article></div>
    <div class="readout-steps">{readoutSteps.map(step=><article><span class="step-number">{step.number}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div>
    <div class="software-profile"><div><span class="small-label">A RECORD YOU CAN USE</span><h3>Keep the recording plan<br/>with the exported data.</h3></div><p>Identify the logger, recording position, recording interval and required period. Share your computer environment with us so the local software requirements can be confirmed for your project.</p><a href="#enquiry" class="text-link">Discuss PC software requirements ↗</a></div>
  </div></section>

  <section class="section faq-section" id="faq" aria-labelledby="faq-title"><div class="wrap faq-layout"><div class="faq-intro"><p class="eyebrow">ANSWERS FOR YOUR PROJECT</p><h2 id="faq-title">Frequently<br/>asked questions.</h2><p>{content.faqHeading.intro}</p><a href="#enquiry" class="text-link">Ask about your recording project ↗</a></div><div class="faq-list">{content.faqs.map((faq,index)=><details id={faq.id} open={index===0}><summary>{faq.question}<span aria-hidden="true">+</span></summary><div class="faq-answer">{faq.paragraphs.map(paragraph=><p>{paragraph}</p>)}</div></details>)}</div></div></section>

  <section class="section enquiry-section" id="enquiry" aria-labelledby="enquiry-title"><div class="wrap enquiry-layout">
    <div class="enquiry-intro"><p class="eyebrow">LET'S PLAN YOUR RECORDING PROJECT</p><h2 id="enquiry-title">Your conditions.<br/><span>Your recording plan.</span></h2><p class="lead">Tell us where you need to record temperature and humidity, how often you need a reading and how long the recording should run. We’ll help confirm the H100 configuration and local PC software requirements.</p><a class="contact-email" href="mailto:sales@hitelecom.cn">sales@hitelecom.cn ↗</a><div class="enquiry-benefits"><h3>Start with the place and the period.</h3><p>A room plan, storage description or transport procedure helps identify the recording point. Add your required interval, recording period and computer environment.</p></div></div>
    <form id="enquiry-form" action="mailto:sales@hitelecom.cn" method="post" enctype="text/plain"><div class="form-heading"><span class="small-label">DATA LOGGER ENQUIRY</span><h3>Let’s define your recording plan.</h3><p>H100 · Temperature & relative humidity · Customizable collection interval</p></div>
      <div class="form-fields"><div class="field"><label for="application">Application <span aria-hidden="true">*</span></label><select id="application" name="Application" required><option value="">Choose your application</option>{content.groups.map(group=><optgroup label={group.title}>{content.applications.filter(scene=>scene.group===group.id).map(scene=><option value={scene.title}>{scene.title}</option>)}</optgroup>)}<option>Other / project-specific</option></select></div><div class="field"><label for="country">Country / region <span aria-hidden="true">*</span></label><input id="country" name="Country" required autocomplete="country-name" placeholder="e.g. United Kingdom" maxlength="100"/></div><div class="field"><label for="model">Product model</label><input id="model" name="Model" value={content.series.models[0]} readonly aria-readonly="true"/></div><div class="field"><label for="quantity">Estimated quantity</label><input id="quantity" name="Quantity" type="number" min="1" step="1" inputmode="numeric" placeholder="e.g. 20"/></div><div class="field"><label for="recording-interval">Preferred collection interval</label><input id="recording-interval" name="Recording interval" placeholder="Tell us your preferred interval" maxlength="160"/></div><div class="field"><label for="recording-period">Required recording period</label><input id="recording-period" name="Required recording period" placeholder="e.g. 30 days or a transport journey" maxlength="160"/></div><div class="field full"><label for="computer-environment">Computer environment</label><input id="computer-environment" name="Computer environment" placeholder="Operating system, version and any software restrictions" maxlength="250"/></div><div class="field full"><label for="requirements">Project requirements</label><textarea id="requirements" name="Requirements" rows="3" maxlength="3000" placeholder="Recording positions, expected conditions, placement, readout schedule or export requirements"></textarea></div></div>
      <div class="form-actions"><button type="submit" class="button button-primary">Prepare my enquiry ↗</button><p>Review your brief, then send it with your email app.</p></div><div id="enquiry-review" class="enquiry-review" hidden><label for="enquiry-brief">Your recording project brief</label><textarea id="enquiry-brief" rows="9" spellcheck="false"></textarea><div><a id="email-brief" class="button button-primary" href="mailto:sales@hitelecom.cn">Open email ↗</a><button id="copy-brief" type="button" class="button button-outline">Copy brief</button></div><p id="brief-status" role="status" aria-live="polite">Your brief is ready to review.</p></div><p class="noscript-note">You can also <a href="mailto:sales@hitelecom.cn?subject=H100%20temperature%20and%20humidity%20data%20logger%20project">email your project details directly</a>.</p>
    </form>
  </div></section>
  <div class="wrap related-products"><p class="small-label">CONTINUE YOUR ENVIRONMENTAL RECORDING PROJECT</p><a href="https://www.hitelecom.com/product">Explore all sensors ↗</a><a href="https://www.hitelecom.com/product/air-quality-sensor">Air quality monitoring ↗</a><a href="https://www.hitelecom.com/product/tilt-sensor">Tilt monitoring ↗</a></div>
</main>
</div>
<script>import './logger-interactions.js';</script>
