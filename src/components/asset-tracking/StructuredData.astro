---
const {content,imageUrl,includeOrganization=true} = Astro.props;
const url='https://www.hitelecom.com/product/asset-tracking-sensor';
const orgId='https://www.hitelecom.com/#organization';
const groupId=url+'#asset-tracking-series';
const graph=[
 ...(includeOrganization?[{'@type':'Organization','@id':orgId,name:'Hitelecom',legalName:'Shanghai Hitelecom Communication Technology Co., Ltd.',url:'https://www.hitelecom.com',email:'sales@hitelecom.cn'}]:[]),
 {'@type':'WebPage','@id':url+'#webpage',url,name:content.seo.title,description:content.seo.description,inLanguage:'en',dateModified:'2026-10-09',publisher:{'@id':orgId},mainEntity:{'@id':groupId}},
 {'@type':'BreadcrumbList','@id':url+'#breadcrumb',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://www.hitelecom.com'},{'@type':'ListItem',position:2,name:'IoT Sensors',item:'https://www.hitelecom.com/product'},{'@type':'ListItem',position:3,name:'Asset Tracking Sensors',item:url}]},
 {'@type':'ProductGroup','@id':groupId,name:'Hitelecom H300 and H500 Asset Tracking Sensors',description:content.hero.description,url,brand:{'@type':'Brand',name:'Hitelecom'},manufacturer:{'@id':orgId},hasVariant:content.series.models.map(model=>({'@id':url+'#model-'+model.id.toLowerCase()}))},
 ...content.series.models.map(model=>({'@type':'Product','@id':url+'#model-'+model.id.toLowerCase(),name:'Hitelecom '+model.id+' '+model.connectivity+' Asset Tracking Sensor',model:model.id,description:model.description,brand:{'@type':'Brand',name:'Hitelecom'},manufacturer:{'@id':orgId},isVariantOf:{'@id':groupId},url:url+'#model-'+model.id.toLowerCase(),additionalProperty:[{'@type':'PropertyValue',name:'Cellular connectivity',value:model.connectivity}]})),
 {'@type':'FAQPage','@id':url+'#faq',inLanguage:'en',mainEntity:content.faqs.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.paragraphs.join('\n\n')}}))}
];
---
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c')}/>
