---
import content from '../../data/asset-tracking-content.json';
import FeatureIcon from './FeatureIcon.astro';
import ImageCaption from './ImageCaption.astro';
// QuickContact 不引入：官网 BaseLayout 已提供全站浮动联系按钮（README-KIMI 第 3 条）
import { getImage } from 'astro:assets';
import heroBackground from '../../assets/brand/sensor-hero-background.jpg';
import { assetImage } from './images.mjs';
const hero = await assetImage('product-hero.webp', true);
const widths = [640,1280,1920];
const backgrounds = await Promise.all(widths.map(width=>getImage({src:heroBackground,width,format:'webp',quality:78})));
const groups = await Promise.all(content.groups.map(async group=>({...group,asset:await assetImage(group.image.name),tasks:await Promise.all(content.applications.filter(scene=>scene.group===group.id).map(async scene=>({...scene,image:scene.image||group.image,asset:await assetImage((scene.image||group.image).name)})))})));
---
<div class="ht-asset-tracking">
<div id="asset-tracking-content">
  <div class="hero-band">
    <img class="hero-background" src={backgrounds[2].src} srcset={backgrounds.map((x,i)=>`${x.src} ${widths[i]}w`).join(', ')} sizes="100vw" width={heroBackground.width} height={heroBackground.height} alt="" aria-hidden="true" loading="eager" decoding="async" />
    <div class="wrap breadcrumb" aria-label="Breadcrumb"><a href="https://www.hitelecom.com">Home</a><span aria-hidden="true">/</span><a href="https://www.hitelecom.com/product">IoT sensors</a><span aria-hidden="true">/</span><span>Asset tracking sensor</span></div>
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-heading"><h1 id="hero-title">Asset tracking.<br/><span>4G or NB-IoT.</span></h1><p class="hero-value-line">Know where assets are. Keep work moving.</p></div>
      <figure class="hero-visual asset-tracking-product">
        <img src={hero.src} srcset={hero.srcset} sizes="(max-width: 600px) 350px, (max-width: 1024px) 64vw, 760px" width={hero.width} height={hero.height} alt="Hitelecom asset tracker enclosure, official product image" loading="eager" fetchpriority="high" decoding="async" />
        <figcaption><span class="live-dot" aria-hidden="true"></span>H300 · 4G <span aria-hidden="true">/</span> H500 · NB-IoT</figcaption>
      </figure>
      <p class="hero-description">{content.hero.description}</p>
      <div class="hero-actions"><a href="#enquiry" class="button button-primary">Request a quote <span aria-hidden="true">↗</span></a><a href="#specifications" class="text-link">Compare H300 & H500 <span aria-hidden="true">↓</span></a></div>
      <div class="hero-proof"><div><strong>H300 · 4G</strong><span>4G cellular reporting</span><small>Match the network to your route</small></div><div><strong>H500 · NB-IoT</strong><span>NB-IoT cellular reporting</span><small>Match operator support to your sites</small></div><div><strong>OEM / ODM</strong><span>Built around your assets</span><small>Mounting, sensing and data integration</small></div></div>
    </section>
  </div>
  <nav class="section-nav" aria-label="On this page"><div class="wrap"><a href="#positioning">Positioning</a><a href="#applications">Applications</a><a href="#specifications">Specifications</a><a href="#integration">Integration</a><a href="#faq">FAQ</a><a class="nav-quote" href="#enquiry">Request a quote ↗</a></div></nav>

  <section class="section features-section" id="features" aria-labelledby="features-title"><div class="wrap">
    <div class="section-heading compact-heading"><div><p class="eyebrow">KEY FEATURES</p><h2 id="features-title">Find assets.<br/><span>Plan the next move.</span></h2></div><p>Give dispatch, rental and logistics teams a location record they can act on. Build the installation and reporting profile around the assets they manage.</p></div>
    <div class="feature-grid">{content.features.map((feature,index)=><article><span class="feature-mark" aria-hidden="true"><FeatureIcon index={index}/></span><h3>{feature.title}</h3><p>{feature.text}</p></article>)}</div>
  </div></section>

  <section class="section measurement-section" id="positioning" aria-labelledby="measurement-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">POSITIONING & CONNECTIVITY</p><h2 id="measurement-title">Find the asset.<br/><span>Then connect the report.</span></h2></div><p>{content.positioning.description}</p></div>
    <div class="measurement-grid">{content.positioning.cards.map((item,index)=><article class="measurement-card"><div class="measurement-heading"><span class="measurement-number">0{index+1}</span><span class="measurement-symbol" aria-hidden="true">{index===0?'↗':index===1?'↔':'↓'}</span></div><h3>{item.title}</h3><p>{item.text}</p><dl><dt>Define your location objective</dt><dd>{item.project_brief}</dd></dl><a href="#enquiry" class="text-link" data-positioning={item.title}>Discuss this configuration ↗</a></article>)}</div>
    <div class="installation-note"><span class="small-label">MOUNTING & INSTALLATION</span><h3>Plan the mounting.<br/>Validate it on the asset.</h3><p>{content.positioning.installation_text}</p></div>
  </div></section>

  <section class="section profile-section" id="operating-profile" aria-labelledby="profile-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">FROM LOCATION TO RESPONSE</p><h2 id="profile-title">Know where it is.<br/>Give your team a clear next step.</h2></div><p>{content.workflow.profile_text}</p></div>
    <div class="asset-tracking-workflow">{content.workflow.steps.map(step=><article><span class="step-number">{step.number}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div>
    <div class="profile-note"><div><span class="small-label">POWER & REPORTING PROFILE</span><strong>The right update.<br/>At the right moment.</strong></div><p>{content.workflow.battery_text}</p></div>
  </div></section>

  <section class="section application-section" id="applications" aria-labelledby="applications-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">APPLICATIONS</p><h2 id="applications-title">{content.applicationSection.title}<br/><span>{content.applicationSection.valueHeading}</span></h2></div><p>{content.applicationSection.description}</p></div>
    <div class="application-overview"><p><strong>{content.groups.length}</strong> industry categories <span aria-hidden="true">/</span> <strong>{content.applications.length}</strong> asset tracking tasks</p><p class="image-note">{content.applicationSection.note}</p></div>
    <nav class="application-jump-nav" aria-label="Browse asset tracking applications">{content.groups.map(group=><a href={'#group-'+group.id}>{group.jumpLabel}<span>{group.scenes.length}</span></a>)}</nav>
    <p class="mounting-qualification">{content.applicationSection.mountingNote}</p>
    <div class="application-groups">{groups.map((group,index)=><details class="application-group" id={'group-'+group.id} open={index===0}>
      <summary><span><small>0{index+1}</small>{group.title}</span><span class="group-count">{group.scenes.length} asset tracking tasks <b aria-hidden="true">+</b></span></summary>
      <div class="application-category-body">
        <div class="application-visual"><div class="application-media-slot"><figure class="application-category-photo"><img class="application-category-image" src={group.asset.src} srcset={group.asset.srcset} sizes="(max-width: 600px) calc(100vw - 76px), (max-width: 900px) calc((100vw - 132px) * .42), 470px" width={group.asset.width} height={group.asset.height} loading="lazy" decoding="async" alt={group.image.alt} style={'object-position:'+group.image.focalPoint}/><ImageCaption image={group.image}/></figure></div><p>{group.intro}</p></div>
        <div class="application-task-list">{group.tasks.map((scene,taskIndex)=><details class="application-task" id={scene.id} open={index===0&&taskIndex===0}>
          <summary aria-controls={'scene-photo-'+scene.id}><span class="task-heading"><h3>{scene.title}</h3><small>{scene.tagline}</small></span><span class="task-toggle" aria-hidden="true">+</span></summary>
          <div class="task-copy"><figure class="application-scene-photo" id={'scene-photo-'+scene.id} data-scene-owner={scene.id}><img class="application-scene-image" src={scene.asset.src} srcset={scene.asset.srcset} sizes="(max-width: 600px) calc(100vw - 76px), (max-width: 900px) calc((100vw - 132px) * .42), 470px" width={scene.asset.width} height={scene.asset.height} loading="lazy" decoding="async" alt={scene.image.alt} style={'object-position:'+scene.image.focalPoint}/><ImageCaption image={scene.image}/></figure><p>{scene.description}</p><dl><dt>Location objective</dt><dd>{scene.objective}</dd><dt>Mount the tracker on</dt><dd>{scene.monitoringPoint}</dd><dt>Specify for this application</dt><dd>{scene.projectBrief}</dd></dl><a href="#enquiry" class="task-cta" data-project-scene={scene.title}>Discuss this application <span aria-hidden="true">↗</span></a></div>
        </details>)}</div>
      </div>
    </details>)}</div>
  </div></section>

  <section class="section specifications-section" id="specifications" aria-labelledby="specifications-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">SERIES & CONFIGURATIONS</p><h2 id="specifications-title">A tracker for your asset.<br/><span>A configuration for your route.</span></h2></div><p>{content.series.description}</p></div>
    <div class="asset-tracking-series" id="asset-tracking-series">{content.series.models.map(model=><article id={'model-'+model.id.toLowerCase()}><div class="model-heading"><span class="small-label">ASSET TRACKING</span><span class="radio-badge">{model.connectivity}</span></div><h3>{model.id}</h3><p>{model.description}</p><a href="#enquiry" class="text-link" data-model={model.id}>Discuss {model.id} ↗</a></article>)}</div>
    <div class="asset-tracking-spec-grid"><aside class="model-card"><span class="small-label">YOUR PROJECT CONFIGURATION</span><h3>Fit the asset.<br/>Fit the workflow.</h3><p>{content.specifications.description}</p><a href="#enquiry" class="button button-outline" data-datasheet-request>Request model datasheets ↗</a><a href="#enquiry" class="text-link">Discuss OEM / ODM ↓</a></aside><div class="spec-table"><table><caption>H300 / H500 — model selection and configuration</caption><tbody>{content.specifications.rows.map(row=><tr><th scope="row">{row.label}</th><td>{row.value}</td></tr>)}</tbody></table></div></div>
    <div class="custom-sensing"><div><p class="eyebrow">PROJECT-SPECIFIC SENSING</p><h3>Location, with the context your asset needs.</h3><p>Add the measurements your project needs to the agreed device configuration, from transport conditions to handling events and indoor location zones.</p></div><div class="custom-sensing-grid">{content.customSensing.map(item=><article><h4>{item.name}</h4><p>{item.text}</p></article>)}</div></div>
    <div class="selection-list"><h3>Bring the specification back to your project.</h3><div>{content.series.steps.map((step,index)=><article><span class="step-number">0{index+1}</span><h4>{step.title}</h4><p>{step.text}</p></article>)}</div></div>
  </div></section>

  <section class="section integration-section" id="integration" aria-labelledby="integration-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">CONNECTIVITY & INTEGRATION</p><h2 id="integration-title">Your assets.<br/><span>Your data destination.</span></h2></div><p>{content.workflow.platform_text}</p></div>
    <div class="integration-grid"><article><span class="small-label">HITELECOM CLOUD</span><h3>For your operations team</h3><div class="route-flow"><span>Tracked asset</span><b aria-hidden="true">→</b><span>Cellular network</span><b aria-hidden="true">→</b><span>Cloud map</span></div><p>Connect the asset identity to its reported locations and timestamps. Review history, define geofences and agree who receives the configured alerts.</p><ul><li>Device-to-asset association</li><li>Latest reported location and history</li><li>Geofence and movement response</li></ul></article><article><span class="small-label">CUSTOMER PLATFORM</span><h3>For your existing workflow</h3><div class="route-flow"><span>Tracked asset</span><b aria-hidden="true">→</b><span>Data connection</span><b aria-hidden="true">→</b><span>Your platform</span></div><p>Review the message format and connection path with your platform team. Match the supplied data fields to dispatch, asset management or transport records.</p><ul><li>Asset and device identity</li><li>Endpoint, authentication and payload</li><li>Agreed status fields and notifications</li></ul></article></div>
    <div class="integration-handover"><h3>Make the first location useful.</h3><p>Agree coordinates, timestamp and positioning method in a sample message, together with the status fields available in the supplied configuration. Validate a complete journey from the mounting point to the intended platform and recipients.</p><a href="#enquiry" class="text-link">Discuss platform integration ↗</a></div>
  </div></section>

  <section class="section faq-section" id="faq" aria-labelledby="faq-title"><div class="wrap faq-layout"><div class="faq-intro"><p class="eyebrow">ANSWERS FOR YOUR PROJECT</p><h2 id="faq-title">Frequently<br/>asked questions.</h2><p>{content.faqHeading.intro}</p><a href="#enquiry" class="text-link">Ask about your project ↗</a></div><div class="faq-list">{content.faqs.map((faq,index)=><details id={faq.id} open={index===0}><summary>{faq.question}<span aria-hidden="true">+</span></summary><div class="faq-answer">{faq.paragraphs.map(paragraph=><p>{paragraph}</p>)}</div></details>)}</div></div></section>

  <section class="section enquiry-section" id="enquiry" aria-labelledby="enquiry-title"><div class="wrap enquiry-layout">
    <div class="enquiry-intro"><p class="eyebrow">LET'S TALK ABOUT YOUR PROJECT</p><h2 id="enquiry-title">Your assets.<br/><span>Our next conversation.</span></h2><p class="lead">Tell us what moves, where it travels and how often you need an update. We’ll help match the tracker, attachment, reporting profile and platform to your project.</p><a class="contact-email" href="mailto:sales@hitelecom.cn">sales@hitelecom.cn ↗</a><div class="enquiry-benefits"><h3>Start with the asset and the route.</h3><p>An asset photo, route outline or sample platform message helps us understand the installation. Share the additional conditions you want to monitor, if applicable.</p></div></div>
    <form id="enquiry-form" action="mailto:sales@hitelecom.cn" method="post" enctype="text/plain"><div class="form-heading"><span class="small-label">PROJECT ENQUIRY</span><h3>Let’s find your configuration.</h3><p>H300 · 4G / H500 · NB-IoT</p></div>
      <div class="form-fields"><div class="field"><label for="application">Application <span aria-hidden="true">*</span></label><select id="application" name="Application" required><option value="">Choose your application</option>{content.groups.map(group=><optgroup label={group.title}>{content.applications.filter(scene=>scene.group===group.id).map(scene=><option value={scene.title}>{scene.title}</option>)}</optgroup>)}<option>Other / project-specific</option></select></div><div class="field"><label for="country">Country / route <span aria-hidden="true">*</span></label><input id="country" name="Country / route" required autocomplete="country-name" placeholder="e.g. UK sites / France–Germany" maxlength="160"/></div><div class="field"><label for="quantity">Estimated quantity</label><input id="quantity" name="Quantity" type="number" min="1" step="1" inputmode="numeric" placeholder="e.g. 100 assets"/></div><div class="field"><label for="location-objective">Location objective</label><select id="location-objective" name="Location objective"><option>Please advise</option>{content.positioning.cards.map(card=><option>{card.title}</option>)}</select></div><div class="field"><label for="reporting-profile">Reporting requirements</label><input id="reporting-profile" name="Reporting requirements" placeholder="e.g. daily in storage / updates during transfers" maxlength="200"/></div><div class="field"><label for="preferred-model">Preferred model</label><select id="preferred-model" name="Preferred model"><option>Please advise</option>{content.series.models.map(model=><option data-model-id={model.id}>{model.id} · {model.connectivity}</option>)}</select></div><div class="field full"><label for="requirements">What would you like to track?</label><textarea id="requirements" name="Requirements" rows="3" maxlength="3000" placeholder="Asset or carrier type, available mounting space, route, platform and any additional sensing"></textarea></div></div>
      <div class="form-actions"><button type="submit" class="button button-primary">Prepare my enquiry ↗</button><p>Review your brief, then send it with your email app.</p></div><div id="enquiry-review" class="enquiry-review" hidden><label for="enquiry-brief">Your project brief</label><textarea id="enquiry-brief" rows="9" spellcheck="false"></textarea><div><a id="email-brief" class="button button-primary" href="mailto:sales@hitelecom.cn">Open email ↗</a><button id="copy-brief" type="button" class="button button-outline">Copy brief</button></div><p id="brief-status" role="status" aria-live="polite">Your brief is ready to review.</p></div><p class="noscript-note">You can also <a href="mailto:sales@hitelecom.cn?subject=H300%20%2F%20H500%20asset%20tracking%20project">email your project details directly</a>.</p>
    </form>
  </div></section>
  <div class="wrap related-products"><p class="small-label">CONTINUE YOUR MONITORING PROJECT</p><a href="https://www.hitelecom.com/product">Explore all sensors ↗</a><a href="https://www.hitelecom.com/product/air-quality-sensor">Air quality monitoring ↗</a><a href="https://www.hitelecom.com/product/tilt-sensor">Tilt monitoring ↗</a></div>
</div>
</div>
<script>import './asset-tracking-interactions.js';</script>
