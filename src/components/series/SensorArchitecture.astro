---
const {architecture:a,id='sensor-plan'}=Astro.props;
---
<section class="sensor-plan" id={id} aria-labelledby={`${id}-title`}>
 <div class="sensor-plan-wrap">
  <div class="sensor-plan-heading"><div><p class="sensor-plan-eyebrow">THE SENSOR PLAN / SELECTED FOR THE TASK</p><h2 id={`${id}-title`}>{a.heading}</h2></div><p>{a.intro}</p></div>
  <div class="sensor-layers">{a.layers.map((layer,i)=><article class:list={['sensor-layer',{'sensor-layer-core':i===0}]}><header><span class="sensor-layer-number">0{i+1}</span><p>{layer.label}</p></header><h3>{layer.title}</h3><ul>{layer.items.map(item=><li><span class="sensor-point" aria-hidden="true"/><div><strong>{item.name}</strong><p>{item.purpose}</p></div></li>)}</ul><p class="sensor-layer-note">{layer.note}</p></article>)}</div>
  <p class="sensor-plan-outcome"><span>THE RESULT</span>{a.outcome}</p>
 </div>
</section>
<style>
 .sensor-plan{background:#fff;color:#193044;padding:80px 0 90px;scroll-margin-top:100px;border-top:1px solid #e4eaf0}
 .sensor-plan-wrap{width:min(1240px,calc(100% - 160px));margin-inline:auto}
 .sensor-plan-heading{display:grid;grid-template-columns:1.2fr 1fr;gap:70px;align-items:end;margin-bottom:38px}
 .sensor-plan-eyebrow{color:#3465dc;font-size:10px;font-weight:650;line-height:1.7;letter-spacing:.15em;margin:0 0 18px}
 .sensor-plan h2{font-size:clamp(30px,3.3vw,47px);font-weight:550;line-height:1.12;letter-spacing:-.045em;white-space:pre-line;margin:0}
 .sensor-plan-heading>p{font-size:14px;line-height:1.85;color:#63788e;max-width:410px;margin:0}
 .sensor-layers{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border:1px solid #dce5ed;border-radius:18px;overflow:hidden}
 .sensor-layer{padding:27px 25px 24px;display:flex;flex-direction:column;min-width:0;background:#f8fafc}
 .sensor-layer+.sensor-layer{border-left:1px solid #dce5ed}
 .sensor-layer-core{background:#0c2d43;color:#fff}
 .sensor-layer header{display:flex;gap:11px;align-items:center;margin-bottom:18px}
 .sensor-layer-number{font-size:13px;color:#8aa2b9;font-weight:500}
 .sensor-layer header p{font-size:9px;font-weight:650;letter-spacing:.1em;line-height:1.5;margin:0;color:#537491}
 .sensor-layer-core header p,.sensor-layer-core .sensor-layer-number{color:#73d9e7}
 .sensor-layer h3{font-size:24px;font-weight:550;line-height:1.2;letter-spacing:-.03em;margin:0 0 26px}
 .sensor-layer ul{list-style:none;padding:0;margin:0;display:grid;gap:21px}
 .sensor-layer li{display:flex;gap:12px;align-items:start}
 .sensor-point{flex:0 0 7px;width:7px;height:7px;border-radius:50%;background:#3e72d6;margin-top:6px;box-shadow:0 0 0 4px #3e72d60d}
 .sensor-layer-core .sensor-point{background:#64d7e0;box-shadow:0 0 0 4px #64d7e012}
 .sensor-layer strong{display:block;font-size:13px;font-weight:600;line-height:1.5}
 .sensor-layer li p{font-size:12px;line-height:1.65;color:#647c91;margin:5px 0 0}
 .sensor-layer-core li p{color:#b2c7d6}
 .sensor-layer-note{font-size:10px;line-height:1.75;color:#617a8f;border-top:1px solid #dce5ed;padding-top:17px;margin:23px 0 0}
 .sensor-layer-core .sensor-layer-note{color:#b2c7d6;border-color:#37546a}
 .sensor-layer ul{flex:1}
 .sensor-plan-outcome{display:flex;align-items:baseline;gap:25px;font-size:13px;line-height:1.8;margin:24px 0 0;color:#3d5d77}
 .sensor-plan-outcome>span{flex-shrink:0;font-size:9px;letter-spacing:.12em;color:#3465dc;font-weight:650}
 @media(max-width:1100px){.sensor-layer{padding:24px 20px}.sensor-layer h3{font-size:22px}}
 @media(min-width:1600px){:global(.solution-series) .sensor-plan-wrap{width:min(1380px,calc(100% - 160px))}}
 @media(max-width:900px){.sensor-plan-wrap{width:calc(100% - 64px)}.sensor-plan-heading{gap:30px}.sensor-layers{grid-template-columns:1fr}.sensor-layer+.sensor-layer{border-left:0;border-top:1px solid #dce5ed}.sensor-layer{padding:28px;display:block}.sensor-layer ul{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 28px}.sensor-layer h3{font-size:25px;margin-bottom:23px}.sensor-plan{padding:60px 0}.sensor-layer-note{margin-top:22px}.sensor-plan-heading>p{font-size:13px}}
 @media(max-width:560px){.sensor-plan-wrap{width:calc(100% - 40px)}.sensor-plan-heading{grid-template-columns:1fr;gap:20px;margin-bottom:28px}.sensor-plan h2{font-size:33px}.sensor-layer{padding:24px 22px}.sensor-layer ul{grid-template-columns:1fr;gap:18px}.sensor-layer strong{font-size:14px}.sensor-layer li p{font-size:13px}.sensor-layer-note{font-size:11px}.sensor-plan-outcome{display:block;font-size:12px}.sensor-plan-outcome>span{display:block;margin-bottom:8px}.sensor-plan{padding:48px 0}}
</style>
