---
const {content,imageUrl,t={},locale='en',prefix='',includeOrganization=true} = Astro.props;
const S = (key) => (Object.prototype.hasOwnProperty.call(t, key) ? t[key] : key);
const url='https://www.hitelecom.com'+prefix+'/product/vibration-sensor';
const orgId='https://www.hitelecom.com/#organization';
const zhGraph=[
 {'@type':'WebPage','@id':url+'#webpage',url,name:content.seo.title,description:content.seo.description,inLanguage:'zh-CN',publisher:{'@id':orgId},mainEntity:{'@id':url+'#series'}},
 {'@type':'BreadcrumbList','@id':url+'#breadcrumb',itemListElement:[{'@type':'ListItem',position:1,name:'首页',item:'https://www.hitelecom.com/zh'},{'@type':'ListItem',position:2,name:'物联网传感器',item:'https://www.hitelecom.com/zh/product'},{'@type':'ListItem',position:3,name:'高频振动传感器',item:url}]},
 {'@type':'ProductGroup','@id':url+'#series',name:'Hitelecom H系列高频机械振动传感器',description:content.hero.description,url,image:imageUrl,brand:{'@type':'Brand',name:'Hitelecom'},manufacturer:{'@id':orgId},hasVariant:content.series.models.map(m=>({'@id':url+'#model-'+m.toLowerCase()})),additionalProperty:content.specifications.rows.map(row=>({'@type':'PropertyValue',name:row.label,value:row.value}))},
 ...[['H200','LoRa'],['H300','4G LTE'],['H500','NB-IoT']].map(([m,radio])=>({'@type':'Product','@id':url+'#model-'+m.toLowerCase(),name:'Hitelecom '+m+' '+radio+'高频振动传感器',model:m,description:'采用'+radio+'连接的带线外置探头与无线终端配置，用于高频机械振动监测；探头、采集与上报方案按项目确定。',brand:{'@type':'Brand',name:'Hitelecom'},manufacturer:{'@id':orgId},isVariantOf:{'@id':url+'#series'},url:url+'#model-'+m.toLowerCase(),image:imageUrl,additionalProperty:[{'@type':'PropertyValue',name:'无线连接',value:radio}]})),
 {'@type':'FAQPage','@id':url+'#faq',inLanguage:'zh-CN',mainEntity:content.faqs.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.paragraphs.join('\n\n')}}))}
];
const graph=locale==='zh'?zhGraph:[
 ...(includeOrganization?[{'@type':'Organization','@id':orgId,name:'Hitelecom',legalName:'Shanghai Hitelecom Communication Technology Co., Ltd.',url:'https://www.hitelecom.com',email:'sales@hitelecom.cn'}]:[]),
 {'@type':'WebPage','@id':url+'#webpage',url,name:content.seo.title,description:content.seo.description,inLanguage:locale,dateModified:'2026-10-12',publisher:{'@id':orgId},mainEntity:{'@id':url+'#series'}},
 {'@type':'BreadcrumbList','@id':url+'#breadcrumb',itemListElement:[{'@type':'ListItem',position:1,name:S('Home'),item:'https://www.hitelecom.com'+prefix+'/'},{'@type':'ListItem',position:2,name:S('IoT Sensors'),item:'https://www.hitelecom.com'+prefix+'/product'},{'@type':'ListItem',position:3,name:S('Wireless Vibration Sensor'),item:url}]},
 {'@type':'ProductGroup','@id':url+'#series',name:S('Hitelecom H Series high-frequency machinery vibration sensors'),description:content.hero.description,brand:{'@type':'Brand',name:'Hitelecom'},manufacturer:{'@id':orgId},url,image:imageUrl,hasVariant:content.series.models.map(m=>({'@id':url+'#model-'+m.toLowerCase()})),additionalProperty:content.specifications.rows.map(row=>({'@type':'PropertyValue',name:row.label,value:row.value}))},
 ...content.series.models.map(m=>({'@type':'Product','@id':url+'#model-'+m.toLowerCase(),name:S('Hitelecom {model} Vibration Sensor').replace('{model}',m),model:m,description:S('Published H Series model family. External cabled probe and wireless terminal for high-frequency machinery vibration monitoring. The complete configuration is selected for the project.'),brand:{'@type':'Brand',name:'Hitelecom'},manufacturer:{'@id':orgId},isVariantOf:{'@id':url+'#series'},url:url+'#model-'+m.toLowerCase(),image:imageUrl})),
 {'@type':'FAQPage','@id':url+'#faq',inLanguage:locale,mainEntity:content.faqs.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.paragraphs.join('\n\n')}}))}
];
---
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c')}/>
