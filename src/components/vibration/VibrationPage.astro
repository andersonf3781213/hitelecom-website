---
import content from '../../data/vibration-content.json';
import FeatureIcon from './FeatureIcon.astro';
import ImageCaption from './ImageCaption.astro';
// QuickContact 不引入：官网 BaseLayout 已提供全站浮动联系按钮（README-KIMI 第 4 条，生产环境共用 Header/Footer）
import { getImage } from 'astro:assets';
import heroBackground from '../../assets/brand/sensor-hero-background.jpg';
import { vibrationImage } from './images.mjs';
const hero = await vibrationImage('product-hero.webp', true);
const widths = [640,1280,1920];
const backgrounds = await Promise.all(widths.map(width=>getImage({src:heroBackground,width,format:'webp',quality:78})));
const groups = await Promise.all(content.groups.map(async group=>({...group,asset:await vibrationImage(group.image.name),tasks:await Promise.all(content.applications.filter(scene=>scene.group===group.id).map(async scene=>({...scene,image:scene.image||group.image,asset:await vibrationImage((scene.image||group.image).name)})))})));
const datasheet = new URL(content.hero.datasheet_url, 'https://www.hitelecom.com').href;
---
<div class="ht-vibration">
<main id="main">
  <div class="hero-band">
    <img class="hero-background" src={backgrounds[2].src} srcset={backgrounds.map((x,i)=>`${x.src} ${widths[i]}w`).join(', ')} sizes="100vw" width={heroBackground.width} height={heroBackground.height} alt="" aria-hidden="true" loading="eager" decoding="async" />
    <div class="wrap breadcrumb" aria-label="Breadcrumb"><a href="https://www.hitelecom.com">Home</a><span aria-hidden="true">/</span><a href="https://www.hitelecom.com/product">IoT sensors</a><span aria-hidden="true">/</span><span>Vibration sensor</span></div>
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-heading"><h1 id="hero-title">High-frequency<br class="vibration-title-break"/> vibration sensor. <span>Machine vibration.<br/>Connected to your team.</span></h1></div>
      <figure class="hero-visual vibration-product">
        <img src={hero.src} srcset={hero.srcset} sizes="(max-width: 600px) 250px, (max-width: 1024px) 40vw, 500px" width={hero.width} height={hero.height} alt="Hitelecom H Series vibration terminal with black external-probe cable and metal vibration probe, official product image" loading="eager" fetchpriority="high" decoding="async" />
        <figcaption><span class="live-dot" aria-hidden="true"></span>Official product image · Cabled vibration probe</figcaption>
      </figure>
      <p class="hero-description">{content.hero.description}</p>
      <div class="hero-actions"><a href="#enquiry" class="button button-primary">Discuss your project <span aria-hidden="true">↗</span></a><a href={datasheet} target="_blank" rel="noopener" class="text-link">Download datasheet <span aria-hidden="true">↗</span></a></div>
      <div class="hero-proof"><div><strong>0–50 <span class="proof-unit">mm/s</span></strong><span>Vibration velocity RMS</span><small>0.1 mm/s display resolution</small></div><div><strong>10–5,000 <span class="proof-unit">Hz</span></strong><span>Measurement frequency range</span><small>Single-axis or triaxial configuration</small></div><div><strong>IP68</strong><span>Enclosure rating</span><small>Probe, cable and mounting selected for the site</small></div></div>
    </section>
  </div>
  <nav class="section-nav" aria-label="On this page"><div class="wrap"><a href="#measurement">Measurement</a><a href="#applications">Applications</a><a href="#specifications">Specifications</a><a href="#integration">Integration</a><a href="#faq">FAQ</a><a class="nav-quote" href="#enquiry">Request a quote ↗</a></div></nav>

  <section class="section features-section" id="features" aria-labelledby="features-title"><div class="wrap">
    <div class="section-heading compact-heading"><div><p class="eyebrow">KEY FEATURES</p><h2 id="features-title">Machine vibration.<br/><span>Connected to maintenance.</span></h2></div><p>Bring a machine-mounted probe, a suitable measurement profile and a wireless data connection into one monitoring workflow.</p></div>
    <div class="feature-grid">{content.features.map((feature,index)=><article><span class="feature-mark" aria-hidden="true"><FeatureIcon index={index}/></span><h3>{feature.title}</h3><p>{feature.text}</p></article>)}</div>
  </div></section>

  <section class="section measurement-section" id="measurement" aria-labelledby="measurement-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">MEASURE THE RIGHT QUANTITY</p><h2 id="measurement-title">A clear quantity.<br/><span>A repeatable measurement point.</span></h2></div><p>{content.measurement.description}</p></div>
    <div class="measurement-grid">{content.measurement.cards.map((item,index)=><article class="measurement-card"><div class="measurement-heading"><span class="measurement-number">0{index+1}</span><span class="measurement-symbol" aria-hidden="true">{index===0?'↗':index===1?'↔':'↓'}</span></div><h3>{item.title}</h3><p>{item.text}</p><dl><dt>{index===2?'Share your operating context':'Define your measurement'}</dt><dd>{item.project_brief}</dd></dl><a href="#enquiry" class="text-link" data-measurement={index===0?'Vibration velocity RMS':'Please advise'}>{index===2?'Discuss your machine':'Discuss this measurement'} ↗</a></article>)}</div>
    <div class="installation-note"><span class="small-label">SENSING & INSTALLATION</span><h3>Probe on the machine.<br/>Terminal at a suitable location.</h3><p>{content.measurement.installation_text}</p></div>
    <figure class="probe-installation-diagram">
      <svg viewBox="0 0 760 240" role="img" aria-labelledby="installation-diagram-title installation-diagram-desc">
        <title id="installation-diagram-title">Motor-mounted vibration probe and separate wireless terminal</title>
        <desc id="installation-diagram-desc">The external vibration probe is mounted directly on a rigid pad on the motor bearing end shield. A secured cable runs to a separate terminal, which communicates wirelessly to the Hitelecom platform. This is a mounting principle, not a dimensioned installation drawing.</desc>
        <defs><marker id="vibration-radio-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" fill="#285fdf"/></marker></defs>
        <path d="M36 186H338" stroke="#b8c9dd" stroke-width="2"/>
        <rect x="59" y="87" width="185" height="91" rx="20" fill="#e7eef7" stroke="#9fb5ce" stroke-width="2"/>
        <path d="M87 99V164M102 99V164M117 99V164M132 99V164M147 99V164M162 99V164M177 99V164M192 99V164M207 99V164" stroke="#bdcde0" stroke-width="2"/>
        <rect x="93" y="172" width="27" height="13" rx="3" fill="#a4b9d2"/>
        <rect x="188" y="172" width="27" height="13" rx="3" fill="#a4b9d2"/>
        <rect x="244" y="113" width="39" height="37" rx="6" fill="#d9e5f3" stroke="#9fb5ce" stroke-width="2"/>
        <path d="M282 131H320" stroke="#8ca4c1" stroke-width="8"/>
        <rect id="motor-probe-mounting-pad" x="207" y="83" width="28" height="6" rx="1" fill="#8ca4c1"/>
        <rect id="motor-mounted-probe" x="210" y="61" width="22" height="22" rx="4" fill="#285fdf"/>
        <path d="M221 62V58C221 44 235 39 249 39H454C470 39 475 48 475 61V104" fill="none" stroke="#285fdf" stroke-width="3"/>
        <path d="M329 34V44M397 34V44" stroke="#17243a" stroke-width="4" stroke-linecap="round"/>
        <rect x="434" y="100" width="85" height="86" rx="14" fill="#fff" stroke="#9fb5ce" stroke-width="2"/>
        <path d="M451 126H501M451 134H501M451 142H501" stroke="#cfdeee" stroke-width="3"/>
        <circle cx="476" cy="164" r="4" fill="#285fdf"/>
        <path d="M535 140H635" stroke="#285fdf" stroke-width="2" stroke-dasharray="6 6" marker-end="url(#vibration-radio-arrow)"/>
        <rect x="655" y="105" width="78" height="60" rx="8" fill="#e9f1fc" stroke="#9fb5ce" stroke-width="2"/>
        <path d="M676 168H711M694 164V178" stroke="#9fb5ce" stroke-width="2"/>
        <path d="M667 149L679 137L691 141L706 120L720 127" stroke="#285fdf" fill="none" stroke-width="2"/>
        <g fill="#49709d" font-size="12" font-family="Inter,Arial,sans-serif"><text x="76" y="209">Motor bearing-housing point</text><text x="221" y="24" text-anchor="middle">Motor-mounted probe</text><text x="334" y="24">Secured probe cable</text><text x="427" y="209">Separate terminal</text><text x="556" y="127">Wireless link</text><text x="694" y="209" text-anchor="middle">Hitelecom Platform</text></g>
      </svg>
      <ol class="installation-diagram-steps" aria-label="Installation path"><li><span>01</span> Motor-mounted probe</li><li><span>02</span> Secured cable route</li><li><span>03</span> Separate terminal</li><li><span>04</span> Hitelecom platform link</li></ol>
      <figcaption>Installation principle: the probe is mounted on a rigid motor bearing-housing point, with secured cable routing to a separately mounted wireless terminal.</figcaption>
    </figure>
  </div></section>

  <section class="section profile-section" id="operating-profile" aria-labelledby="profile-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">FROM READING TO RESPONSE</p><h2 id="profile-title">Measure at the machine.<br/>Report to your team.</h2></div><p>{content.workflow.profile_text}</p></div>
    <div class="vibration-workflow">{content.workflow.steps.map(step=><article><span class="step-number">{step.number}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div>
    <div class="profile-note"><div><span class="small-label">PUBLISHED BATTERY-LIFE DESIGN</span><strong>Over 10 years.<br/>At one-hour reporting.</strong></div><p>{content.workflow.battery_text}</p></div>
  </div></section>

  <section class="section application-section" id="applications" aria-labelledby="applications-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">APPLICATIONS</p><h2 id="applications-title">{content.applicationSection.title}<br/><span>{content.applicationSection.valueHeading}</span></h2></div><p>{content.applicationSection.description}</p></div>
    <div class="application-overview"><p><strong>{content.groups.length}</strong> machinery families <span aria-hidden="true">/</span> <strong>{content.applications.length}</strong> monitoring tasks</p><p class="image-note">{content.applicationSection.note}</p></div>
    <nav class="application-jump-nav" aria-label="Browse machinery vibration applications">{content.groups.map(group=><a href={'#group-'+group.id}>{group.jumpLabel}<span>{group.scenes.length}</span></a>)}</nav>
    <div class="application-groups">{groups.map((group,index)=><details class="application-group" id={'group-'+group.id} open={index===0}>
      <summary><span><small>0{index+1}</small>{group.title}</span><span class="group-count">{group.scenes.length} monitoring tasks <b aria-hidden="true">+</b></span></summary>
      <div class="application-category-body">
        <div class="application-visual"><div class="application-media-slot"><figure class="application-category-photo"><img class="application-category-image" src={group.asset.src} srcset={group.asset.srcset} sizes="(max-width: 600px) calc(100vw - 76px), (max-width: 900px) calc((100vw - 132px) * .42), 470px" width={group.asset.width} height={group.asset.height} loading="lazy" decoding="async" alt={group.image.alt} style={'object-position:'+group.image.focalPoint}/><ImageCaption image={group.image}/></figure></div><p>{group.intro}</p></div>
        <div class="application-task-list">{group.tasks.map((scene,taskIndex)=><details class="application-task" id={scene.id} open={index===0&&taskIndex===0}>
          <summary aria-controls={'scene-photo-'+scene.id}><span class="task-heading"><h3>{scene.title}</h3><small>{scene.measurement}</small></span><span class="task-toggle" aria-hidden="true">+</span></summary>
          <div class="task-copy"><figure class="application-scene-photo" id={'scene-photo-'+scene.id} data-scene-owner={scene.id}><img class="application-scene-image" src={scene.asset.src} srcset={scene.asset.srcset} sizes="(max-width: 600px) calc(100vw - 76px), (max-width: 900px) calc((100vw - 132px) * .42), 470px" width={scene.asset.width} height={scene.asset.height} loading="lazy" decoding="async" alt={scene.image.alt} style={'object-position:'+scene.image.focalPoint}/><ImageCaption image={scene.image}/></figure><p>{scene.description}</p><dl><dt>Measurement focus</dt><dd>{scene.measurement}</dd><dt>Probe mounting point</dt><dd>{scene.monitoringPoint}</dd><dt>Installation planning</dt><dd>{scene.installation}</dd><dt>Project brief</dt><dd>{scene.projectBrief}</dd></dl><a href="#enquiry" class="task-cta" data-project-scene={scene.title}>Discuss this application <span aria-hidden="true">↗</span></a></div>
        </details>)}</div>
      </div>
    </details>)}</div>
  </div></section>

  <section class="section specifications-section" id="specifications" aria-labelledby="specifications-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">SERIES & CONFIGURATIONS</p><h2 id="specifications-title">One product family.<br/><span>A configuration for your machine.</span></h2></div><p>{content.series.description}</p></div>
    <div class="vibration-series">{content.series.models.map(model=><article id={'model-'+model.toLowerCase()}><span class="small-label">PUBLISHED MODEL FAMILY</span><h3>{model}</h3><p>Confirm the supplied radio, external probe and measurement profile for your project.</p><a href="#enquiry" class="text-link" data-model={model}>Discuss this configuration ↗</a></article>)}</div>
    <div class="vibration-spec-grid"><aside class="model-card"><span class="small-label">FAMILY REFERENCE</span><h3>Specify the machine.<br/>Specify the measurement.</h3><p>{content.specifications.description}</p><a href={datasheet} target="_blank" rel="noopener" class="button button-outline">Download family datasheet ↗</a><a href="#enquiry" class="text-link">Get a configuration proposal ↓</a></aside><div class="spec-table"><table><caption>H Series high-frequency vibration sensors — configuration specifications</caption><tbody>{content.specifications.rows.map(row=><tr><th scope="row">{row.label}</th><td>{row.value}</td></tr>)}</tbody></table></div></div>
    <div class="selection-list"><h3>Bring the specification back to your project.</h3><div>{content.series.steps.map((step,index)=><article><span class="step-number">0{index+1}</span><h4>{step.title}</h4><p>{step.text}</p></article>)}</div></div>
  </div></section>

  <section class="section integration-section" id="integration" aria-labelledby="integration-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">CONNECTIVITY & INTEGRATION</p><h2 id="integration-title">Your machine.<br/><span>Your data destination.</span></h2></div><p>{content.workflow.platform_text}</p></div>
    <div class="integration-grid"><article><span class="small-label">4G / NB-IoT</span><h3>For distributed locations</h3><div class="route-flow"><span>Vibration terminal</span><b aria-hidden="true">→</b><span>Mobile network</span><b aria-hidden="true">→</b><span>Your platform</span></div><p>Select the supplied modem and regional bands around operator availability and coverage at the terminal position. Agree the measurement schedule, reporting profile and configured notification workflow.</p><ul><li>Installation country and operator</li><li>Signal at the actual mounting position</li><li>Measurement schedule, reporting and alert workflow</li></ul></article><article><span class="small-label">LoRa</span><h3>For points across one site</h3><div class="route-flow"><span>Vibration terminals</span><b aria-hidden="true">→</b><span>Receiver / gateway</span><b aria-hidden="true">→</b><span>Your platform</span></div><p>Match the supplied radio protocol, regional settings and receiver or gateway. Specify any LoRaWAN requirement with the model and complete onward connection.</p><ul><li>Supplied radio protocol and gateway compatibility</li><li>Site layout and radio coverage</li><li>Gateway power and onward data connection</li></ul></article></div>
    <div class="integration-handover"><h3>Make the first reading useful.</h3><p>Agree device identity, machine and mounting-point labels, measurement quantity, units and timestamps in a sample message. Confirm the MQTT endpoint and supported authentication for the supplied configuration, then test the complete path to the intended platform and notification recipients.</p><a href="#enquiry" class="text-link">Discuss platform integration ↗</a></div>
  </div></section>

  <section class="section faq-section" id="faq" aria-labelledby="faq-title"><div class="wrap faq-layout"><div class="faq-intro"><p class="eyebrow">ANSWERS FOR YOUR PROJECT</p><h2 id="faq-title">Frequently<br/>asked questions.</h2><p>{content.faqHeading.intro}</p><a href="#enquiry" class="text-link">Ask about your project ↗</a></div><div class="faq-list">{content.faqs.map((faq,index)=><details id={faq.id} open={index===0}><summary>{faq.question}<span aria-hidden="true">+</span></summary><div class="faq-answer">{faq.paragraphs.map(paragraph=><p>{paragraph}</p>)}</div></details>)}</div></div></section>

  <section class="section enquiry-section" id="enquiry" aria-labelledby="enquiry-title"><div class="wrap enquiry-layout">
    <div class="enquiry-intro"><p class="eyebrow">LET'S TALK ABOUT YOUR PROJECT</p><h2 id="enquiry-title">Tell us about<br/><span>your machine.</span></h2><p class="lead">Share the machine, operating conditions and monitoring objective. We’ll help match the cabled probe, measurement configuration and wireless connection, then discuss your quotation.</p><a class="contact-email" href="mailto:sales@hitelecom.cn">sales@hitelecom.cn ↗</a><div class="enquiry-benefits"><h3>Start with a machine and a mounting point.</h3><p>A machine photo, bearing-housing detail or maintenance specification helps us plan the installation. Add operating speed, load, cable routing and your reporting or platform requirements.</p></div></div>
    <form id="enquiry-form" action="mailto:sales@hitelecom.cn" method="post" enctype="text/plain"><div class="form-heading"><span class="small-label">PROJECT ENQUIRY</span><h3>Let’s find your configuration.</h3><p>High-frequency machinery vibration monitoring</p></div>
      <div class="form-fields"><div class="field"><label for="application">Application <span aria-hidden="true">*</span></label><select id="application" name="Application" required><option value="">Choose your application</option>{content.groups.map(group=><optgroup label={group.title}>{content.applications.filter(scene=>scene.group===group.id).map(scene=><option value={scene.title}>{scene.title}</option>)}</optgroup>)}<option>Other / project-specific</option></select></div><div class="field"><label for="country">Country / region <span aria-hidden="true">*</span></label><input id="country" name="Country" required autocomplete="country-name" placeholder="e.g. United Kingdom" maxlength="100"/></div><div class="field"><label for="quantity">Estimated quantity</label><input id="quantity" name="Quantity" type="number" min="1" step="1" inputmode="numeric" placeholder="e.g. 20"/></div><div class="field"><label for="measurement-type">Measurement type</label><select id="measurement-type" name="Measurement"><option>Please advise</option><option>Vibration velocity RMS</option></select></div><div class="field"><label for="measurement-axes">Measurement axes</label><select id="measurement-axes" name="Measurement axes"><option>Please advise</option><option>Single-axis</option><option>Triaxial</option></select></div><div class="field"><label for="machine-speed">Machine / operating speed</label><input id="machine-speed" name="Machine and speed" placeholder="e.g. Centrifugal pump / 1,480 RPM" maxlength="160"/></div><div class="field"><label for="network">Preferred connectivity</label><select id="network" name="Connectivity"><option>Please advise</option><option>4G LTE</option><option>NB-IoT</option><option>LoRa</option></select></div><div class="field full"><label for="requirements">What would you like to monitor?</label><textarea id="requirements" name="Requirements" rows="3" maxlength="3000" placeholder="Machine and bearing point, speed and load, required quantity, probe mounting, cable routing, reporting and platform requirements"></textarea></div></div>
      <div class="form-actions"><button type="submit" class="button button-primary">Prepare my enquiry ↗</button><p>Review your brief, then send it with your email app.</p></div><div id="enquiry-review" class="enquiry-review" hidden><label for="enquiry-brief">Your project brief</label><textarea id="enquiry-brief" rows="9" spellcheck="false"></textarea><div><a id="email-brief" class="button button-primary" href="mailto:sales@hitelecom.cn">Open email ↗</a><button id="copy-brief" type="button" class="button button-outline">Copy brief</button></div><p id="brief-status" role="status" aria-live="polite">Your brief is ready to review.</p></div><p class="noscript-note">You can also <a href="mailto:sales@hitelecom.cn?subject=High-frequency%20vibration%20sensor%20project">email your project details directly</a>.</p>
    </form>
  </div></section>
  <div class="wrap related-products"><p class="small-label">CONTINUE YOUR MONITORING PROJECT</p><a href="https://www.hitelecom.com/product">Explore all sensors ↗</a><a href="https://www.hitelecom.com/product/temperature-sensor">Temperature monitoring ↗</a><a href="https://www.hitelecom.com/product/pressure-sensor">Pressure monitoring ↗</a></div>
</main>
</div>
<script>import './vibration-interactions.js';</script>
