---
/**
 * 振动传感器页 V2 · EN 包装器（GPT6 页面包，Kimi 审核集成 2026-10-11 V54）
 * 同 URL 上线：/product/vibration-sensor（slug 不变，hreflang 闭环 / sitemap /
 * 内链均由路由层原有逻辑覆盖；es/de/ja/fr/ru/zh 仍走经典模板，翻译包未到位）。
 * 数据：src/data/vibration-content.json；样式：vibration.css（.ht-vibration 作用域，独立路由隔离打包）。
 * Organization/WebSite 实体图由 BaseLayout 全局输出，本页仅输出页面级
 * Schema（includeOrganization={false}，统一引用 /#organization）。
 * Hero 响应式 preload（imagesrcset/imagesizes 与 img 一致）经 head 槽输出，
 * 故不再使用 BaseLayout 的 preloadImage（避免重复 preload）。
 * SiteShell/QuickContact 为 GPT6 离线审阅壳，不集成（README-KIMI 第 3/4 条）。
 * 页首跟随同步块已并入 vibration-interactions.js + vibration.css（离线壳绝对定位 → 生产 fixed 页首适配）。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import VibrationPage from './VibrationPage.astro';
import StructuredData from './StructuredData.astro';
import { vibrationImage } from './images.mjs';
import content from '../../data/vibration-content.json';
import '../../styles/vibration.css';
const hero = await vibrationImage('product-hero.webp', true);
const ogImage = new URL(hero.src, Astro.site).href;
const heroSizes = '(max-width: 600px) 250px, (max-width: 1024px) 40vw, 500px';
---

<BaseLayout locale="en" title={content.seo.title} description={content.seo.description}>
  <link slot="head" rel="preload" as="image" href={hero.src} imagesrcset={hero.srcset} imagesizes={heroSizes} fetchpriority="high" />
  <StructuredData slot="head" content={content} imageUrl={ogImage} includeOrganization={false} />
  <VibrationPage />
</BaseLayout>
