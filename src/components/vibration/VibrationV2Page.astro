---
/**
 * 振动传感器页 V2 · 六语言包装器（GPT6 页面包 + 五语言包，Kimi 审核集成 V54/V55）
 * 路由：EN /product/vibration-sensor（无前缀）；es/de/ja/fr/ru 带前缀，zh 仍走经典模板。
 * 数据：vibration-content.json（EN）+ vibration-content-{es,fr,de,ja,ru}.json；
 * 文案字典：dicts.mjs（键=组件英文字面量，EN 无条目零差异；JS 键经 data-i18n 注入）。
 * Organization/WebSite 实体图由 BaseLayout 全局输出，本页仅输出页面级
 * Schema（includeOrganization={false}，统一引用 /#organization）。
 * Hero 响应式 preload（imagesrcset/imagesizes 与 img 一致）经 head 槽输出。
 * SiteShell/QuickContact 为 GPT6 离线审阅壳，不集成（README-KIMI 第 3/4 条）。
 * 页首跟随同步块在 vibration-interactions.js + vibration.css。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import VibrationPage from './VibrationPage.astro';
import StructuredData from './StructuredData.astro';
import { vibrationImage } from './images.mjs';
import { VIBRATION_DICTS } from './dicts.mjs';
import contentEn from '../../data/vibration-content.json';
import contentEs from '../../data/vibration-content-es.json';
import contentDe from '../../data/vibration-content-de.json';
import contentJa from '../../data/vibration-content-ja.json';
import contentFr from '../../data/vibration-content-fr.json';
import contentRu from '../../data/vibration-content-ru.json';
import '../../styles/vibration.css';
const REGISTRY = {
  en: {content: contentEn, prefix: ''},
  es: {content: contentEs, prefix: '/es'},
  de: {content: contentDe, prefix: '/de'},
  ja: {content: contentJa, prefix: '/ja'},
  fr: {content: contentFr, prefix: '/fr'},
  ru: {content: contentRu, prefix: '/ru'},
};
const {locale = 'en'} = Astro.props;
const entry = REGISTRY[locale] ?? REGISTRY.en;
const t = VIBRATION_DICTS[locale] ?? {};
const hero = await vibrationImage('product-hero.webp', true);
const ogImage = new URL(hero.src, Astro.site).href;
const heroSizes = '(max-width: 600px) 250px, (max-width: 1024px) 40vw, 500px';
---

<BaseLayout locale={locale} title={entry.content.seo.title} description={entry.content.seo.description}>
  <link slot="head" rel="preload" as="image" href={hero.src} imagesrcset={hero.srcset} imagesizes={heroSizes} fetchpriority="high" />
  <StructuredData slot="head" content={entry.content} imageUrl={ogImage} t={t} locale={locale} prefix={entry.prefix} includeOrganization={false} />
  <VibrationPage content={entry.content} t={t} prefix={entry.prefix} />
</BaseLayout>
