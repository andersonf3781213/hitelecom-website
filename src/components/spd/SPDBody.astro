---
/** SPD英文页主体：沿用官网温度页面视觉结构；渲染智能SPD状态监测、四路同时监测及维护选型内容。 */
import FeatureIcon from './SPDFeatureIcon.astro';
import { getImage } from 'astro:assets';
import heroBackground from '../../assets/brand/sensor-hero-background.jpg';
import Applications from './SPDApplications.astro';
import typographyStyles from '../../styles/tilt-typography-en.css?raw';
const { content, t, groups, hero, canonicalPath, cropBox, applicationUi } = Astro.props;
const headings = t.headings || [];
const locale = 'en', prefix = '';
const enquiryScenes = groups.flatMap(group => group.scenes);
const backgroundImages = await Promise.all([640,1280,1920].map(width => getImage({src:heroBackground,width,format:'webp',quality:78})));
const backgroundSrcset = backgroundImages.map((image,index) => `${image.src} ${[640,1280,1920][index]}w`).join(', ');
const metricHighlights = content.hero.highlights;
// 主/副行结构 H2：拉丁语首个 ". " 切分；日语首个 ASCII 空格切分；单行语退化为仅主行
const splitTitle = (s) => {
  if (!s) return ['', null];
  if (locale === 'zh') { const i = s.indexOf('。'); return (i > 0 && i < s.length - 1) ? [s.slice(0, i + 1), s.slice(i + 1)] : [s, null]; }
  if (locale === 'ja') { const i = s.indexOf(' '); return i > 0 ? [s.slice(0, i), s.slice(i + 1)] : [s, null]; }
  const m = s.match(/^(.*?\.)\s+(.*)$/);
  return m ? [m[1], m[2]] : [s, null];
};
const [specTitleMain, specTitleSpan] = splitTitle(content.modelCatalog.title);
const [intTitleMain, intTitleSpan] = splitTitle(content.integration.title);
const [enqTitleMain, enqTitleSpan] = splitTitle(content.enquiry.title);
// H2保留原站主/副行层级；SPD不呈现倾角示例或伪造的状态数据。
const htmlEscape = (value) => String(value ?? '').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;');
const titleHtml = (value) => {
  const [main, secondary] = splitTitle(value);
  return htmlEscape(main) + (secondary != null ? `<br><span>${htmlEscape(secondary)}</span>` : '');
};
const fallbackHeadings = {
  'features-title': htmlEscape(t.featH2a) + (t.featH2b ? `<br><span>${htmlEscape(t.featH2b)}</span>` : ''),
  'overview-title': titleHtml(content.overview.title),
  'profile-title': titleHtml(content.workflow.title),
  'faq-title': content.faqHeading.title.startsWith('Frequently ')
    ? `Frequently<br>${htmlEscape(content.faqHeading.title.slice('Frequently '.length))}`
    : htmlEscape(content.faqHeading.title),
};
const headingHtml = (id) => headings.find(h => h.id === id)?.html ?? fallbackHeadings[id];
const homeHref = prefix || '/';
const sensorsHref = `${prefix}/product/lists/cid/261`;
---
<div class="ht-tilt" data-product-model={content.modelCatalog.models[0].model} data-i18n={JSON.stringify(t.js)}>
  <style is:inline data-typography-style="temperature" set:html={typographyStyles} />
  <div class="hero-band">
  <img class="hero-background" src={backgroundImages[2].src} srcset={backgroundSrcset} sizes="100vw" width={heroBackground.width} height={heroBackground.height} alt="" aria-hidden="true" loading="eager" decoding="async" />
  <div class="wrap breadcrumb" aria-label={t.bcAria}><a href={homeHref}>{t.bc[0]}</a><span aria-hidden="true">/</span><a href={sensorsHref}>{t.bc[1]}</a><span aria-hidden="true">/</span><span>{t.bc[2]}</span></div>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-heading"><h1 id="hero-title">{content.hero.h1.main}<br/><span>{content.hero.h1.spanA}{content.hero.h1.spanB != null && <br class="desktop-break"/>}{content.hero.h1.spanB}</span></h1></div>
    <figure class="hero-visual">
      <svg class="precision-product" viewBox={cropBox} role="img" aria-label={content.hero.imageAlt} preserveAspectRatio="xMidYMid meet"><image href={hero.src} width={hero.width} height={hero.height} /></svg>
      <figcaption><span class="live-dot" aria-hidden="true"></span>{content.hero.imageCaption}</figcaption>
    </figure>
    <p class="hero-description">{content.hero.description}</p>
    <div class="hero-actions"><a href="#enquiry" class="button button-primary" data-enquiry-source="Hero">{content.hero.primaryLabel} <span aria-hidden="true">↗</span></a><a href="#overview" class="text-link">{content.hero.secondaryLabel} <span aria-hidden="true">↓</span></a></div>
    <div class="hero-proof">{metricHighlights.map(item=><div><strong>{item.value}</strong><span>{item.label}</span><small>{item.note}</small></div>)}</div>
  </section>
  </div>
  <nav class="section-nav" aria-label={t.navAria}><div class="wrap"><a href="#overview">{t.nav[0]}</a><a href="#applications">{t.nav[1]}</a><a href="#specifications">{t.nav[2]}</a><a href="#integration">{t.nav[3]}</a><a href="#faq">{t.nav[4]}</a><a class="nav-quote" href="#enquiry">{t.navQuote}</a></div></nav>

  <section class="section features-section" id="features" aria-labelledby="features-title"><div class="wrap">
    <div class="section-heading compact-heading"><div><p class="eyebrow">{t.featKicker}</p><h2 id="features-title"><Fragment set:html={headingHtml('features-title')} /></h2></div><p>{t.featLead}</p></div>
    <div class="feature-grid">{content.features.map((feature,index)=><article><span class="feature-mark" aria-hidden="true"><FeatureIcon index={index} /></span><h3>{feature.title}</h3><p>{feature.text}</p></article>)}</div>
  </div></section>

  <section class="section overview-section" id="overview" aria-labelledby="overview-title"><div class="wrap overview-grid">
    <div><p class="eyebrow">{content.overview.kicker}</p><h2 id="overview-title"><Fragment set:html={headingHtml('overview-title')} /></h2><p class="lead">{content.overview.answer}</p><a class="text-link" href="#applications">{t.ovCta} <span aria-hidden="true">↓</span></a></div>
    <div class="reading-card"><ol class="reading-steps">{content.overview.steps.map((step,index)=><li><span>{step.number ?? String(index+1).padStart(2,'0')}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}</ol></div>
  </div></section>

  <section class="section profile-section" id="operating-profile" aria-labelledby="profile-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{content.workflow.kicker}</p><h2 id="profile-title"><Fragment set:html={headingHtml('profile-title')} /></h2></div><p>{content.workflow.intro}</p></div>
    <div class="profile-metrics">{content.workflow.items.map(item=><div><strong>{item.number}</strong><h3>{item.title}</h3><p>{item.text}</p></div>)}</div>
    <div class="profile-note"><div><span class="small-label">{t.profNoteLabel}</span><strong>{t.profNoteStrong.split("\n").map((line,index)=><Fragment>{index>0&&<br/>}{line}</Fragment>)}</strong></div><p>{content.workflow.note}</p></div>
  </div></section>

  <Applications groups={groups} canonicalPath={canonicalPath} applicationUi={applicationUi} modelName={content.modelCatalog.models[0].model} />

  <section class="section specifications-section" id="specifications" aria-labelledby="specifications-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{t.serKicker}</p><h2 id="specifications-title">{specTitleMain}{specTitleSpan != null && <><br/><span>{specTitleSpan}</span></>}</h2></div><p>{content.modelCatalog.intro}</p></div>
    {content.modelCatalog.models.map(model=><article class="model-grid" id={model.id}>
      <div class="model-card"><span class="small-label">{t.modelLabel}</span><h3>{model.model}</h3><p>{model.scopeNote}</p>{model.datasheet.url.startsWith('mailto:') ? <a href={model.datasheet.url} class="button button-outline">{model.datasheet.label} <span aria-hidden="true">↗</span></a> : <a href={model.datasheet.url} class="button button-outline" target="_blank" rel="noopener">{model.datasheet.label} <span aria-hidden="true">↗</span></a>}<a href="#enquiry" class="text-link" data-model={model.model}>{t.configCta}</a></div>
      <div class="spec-table"><table><caption>{t.specCaption.replace('{m}', model.model)}</caption><tbody>{model.specifications.map(s=><tr><th scope="row">{s.name}</th><td>{s.value}</td></tr>)}</tbody></table><p class="specification-note">{model.specificationNote}</p></div>
    </article>)}
    <div class="selection-list"><h3>{content.selection.title}</h3>{content.selection.intro && <p>{content.selection.intro}</p>}<div>{content.selection.items.map((s,i)=><article><span class="step-number">0{i+1}</span><h4>{s.title}</h4><p>{s.text}</p></article>)}</div></div>
  </div></section>

  <section class="section integration-section" id="integration" aria-labelledby="integration-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{content.integration.kicker}</p><h2 id="integration-title">{intTitleMain}{intTitleSpan != null && <><br/><span>{intTitleSpan}</span></>}</h2></div><p>{content.integration.intro}</p></div>
    <div class="integration-grid">{content.integration.routes.map(route=><article><span class="small-label">{route.subtitle}</span><h3>{route.title}</h3><div class="route-flow">{route.steps.map((step,i)=><><span>{step}</span>{i<route.steps.length-1&&<b aria-hidden="true">→</b>}</>)}</div><p>{route.text}</p><ul>{route.checks.map(check=><li>{check}</li>)}</ul></article>)}</div>
    <div class="integration-handover"><h3>{content.integration.handoverTitle}</h3><p>{Array.isArray(content.integration.handover)?content.integration.handover.join(' · '):content.integration.handover}</p><a href="#enquiry" class="text-link">{t.handoverCta}</a></div>
  </div></section>

  <section class="section faq-section" id="faq" aria-labelledby="faq-title"><div class="wrap faq-layout">
    <div class="faq-intro"><p class="eyebrow">{content.faqHeading.kicker}</p><h2 id="faq-title"><Fragment set:html={headingHtml('faq-title')} /></h2><p>{content.faqHeading.intro}</p><a href="mailto:sales@hitelecom.cn" class="text-link">{t.faqCta}</a></div>
    <div class="faq-list">{content.faqs.map((faq,i)=><details id={faq.id} open={i===0}><summary>{faq.question}<span aria-hidden="true">+</span></summary><div class="faq-answer">{faq.paragraphs.map(p=><p>{p}</p>)}{faq.answerLink&&<a href={typeof faq.answerLink==='string'?faq.answerLink:faq.answerLink.href} class="text-link">{typeof faq.answerLink==='string'?t.faqLinkFallback:faq.answerLink.label} →</a>}</div></details>)}</div>
  </div></section>

  <section class="section enquiry-section" id="enquiry" aria-labelledby="enquiry-title"><div class="wrap enquiry-layout">
    <div class="enquiry-intro"><p class="eyebrow">{content.enquiry.kicker}</p><h2 id="enquiry-title">{enqTitleMain}{enqTitleSpan != null && <><br/><span>{enqTitleSpan}</span></>}</h2><p class="lead">{content.enquiry.intro}</p><a class="contact-email" href="mailto:sales@hitelecom.cn">sales@hitelecom.cn ↗</a><div class="enquiry-benefits"><h3>{t.benefitsTitle}</h3><p>{t.benefitsText}</p></div></div>
    <form id="enquiry-form" action="mailto:sales@hitelecom.cn" method="post" enctype="text/plain">
      <div class="form-heading"><span class="small-label">{t.formLabel}</span><h3>{t.formTitle}</h3><p>{t.formSubtitle}</p></div>
      <div class="form-fields"><div class="field"><label for="application">{t.appLabel} <span aria-hidden="true">*</span></label><select id="application" name="Application" required><option value="">{t.appChoose}</option>{enquiryScenes.map(scene=><option value={scene.title}>{scene.title}</option>)}<option value={t.appOtherValue ?? t.appOther}>{t.appOther}</option></select></div><div class="field"><label for="country">{t.countryLabel} <span aria-hidden="true">*</span></label><input id="country" name="Country" required autocomplete="country-name" placeholder={t.countryPh} maxlength="100" /></div><div class="field"><label for="quantity">{t.qtyLabel}</label><input id="quantity" name="Quantity" type="number" min="1" step="1" inputmode="numeric" placeholder={t.qtyPh} /></div><div class="field"><label for="channels">{t.channelsLabel}</label><select id="channels" name="Channels"><option value="2">2 channels</option><option value="4" selected>4 channels · HiSPD-DPU-04</option><option value="8">8 channels</option></select></div><div class="field full"><label for="network">{t.connLabel}</label><select id="network" name="Connectivity">{Object.entries(t.js.connectivityValues).map(([value,label])=><option value={value}>{label}</option>)}</select></div><div class="field full"><label for="requirements">{t.reqLabel}</label><textarea id="requirements" name="Requirements" rows="3" maxlength="3000" placeholder={t.reqPh}></textarea></div></div>
      <div class="form-actions"><button class="button button-primary" type="submit">{t.submit} <span aria-hidden="true">↗</span></button><p>{t.submitNote}</p></div>
      <div id="enquiry-review" class="enquiry-review" hidden><label for="enquiry-brief">{t.summaryLabel}</label><textarea id="enquiry-brief" rows="8" spellcheck="false"></textarea><div><a id="email-brief" class="button button-primary" href="mailto:sales@hitelecom.cn">{t.openEmail}</a><button id="copy-brief" type="button" class="button button-outline">{t.copyBrief}</button></div><p id="brief-status" role="status" aria-live="polite">{t.statusReady}</p></div>
      <noscript><p class="noscript-note">{t.noscriptPre}<a href={`mailto:sales@hitelecom.cn?subject=${encodeURIComponent(t.noscriptSubject)}`}>{t.noscriptLink}</a>{t.noscriptPost}</p></noscript>
    </form>
  </div></section>
  <div class="wrap related-products"><p class="small-label">{t.relKicker}</p>{t.relLinks.map(link=><a href={link.href}>{link.label}</a>)}</div>
<a class="mobile-quote" href="#enquiry" data-enquiry-source="Mobile bar">{t.mobileQuote} <span aria-hidden="true">↗</span></a>
</div>
<script>
  import './spd-interactions.js';
</script>
