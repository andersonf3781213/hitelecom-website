---
/**
 * 全站导航 Header
 * - 首屏透明悬浮，滚动后白底 + 阴影（自动切换双色 LOGO）
 * - 向下滚动自动隐藏，向上滚动召回
 * - 搜索遮罩、语言切换下拉、移动端全屏菜单
 */
import Img from './Img.astro';
import { homeContent } from '../data/home';
import { site } from '../data/site';
import { ui } from '../data/ui';
import { l, alternateUrl, localeNames, locales, htmlLang, type Locale } from '../i18n';

interface Props { locale: Locale; solid?: boolean }
const { locale, solid = false } = Astro.props;
const t = homeContent[locale];
const u = ui[locale];
const pathname = Astro.url.pathname;
// build.format='file' 下各语言首页构建期地址：'/'、'/index.html'、'/zh.html'、'/es.html'
const homePaths = ['/', '/index.html', ...locales.filter((x) => x !== 'en').map((x) => `/${x}.html`)];
---

<header id="site-header" class:list={[{ scrolled: solid }]}>
  <div class="header-inner">
    <a class="logo" href={l('/', locale)} aria-label="Hitelecom Home">
      <Img class="logo-color" src="common/logo-color.png" alt="Hitelecom" loading="eager" fetchpriority="high" />
      <Img class="logo-white" src="common/logo-white.png" alt="Hitelecom" loading="eager" fetchpriority="high" />
    </a>

    <nav class="main-nav" aria-label="Main">
      <ul>
        {t.nav.map((item) => (
          <li>
            <a href={l(item.href, locale)} aria-current={item.href === '/' && homePaths.includes(pathname) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button class="icon-btn search-open" type="button" aria-label="Search">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>

      <div class="lang">
        <button class="lang-btn" type="button" aria-haspopup="true" aria-expanded="false">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.9 5.7 3.9 9S14.5 18.4 12 21c-2.5-2.6-3.9-5.7-3.9-9S9.5 5.6 12 3Z"/></svg>
          <span>{localeNames[locale]}</span>
          <svg class="chev" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <ul class="lang-menu">
          {locales.map((loc) => (
            <li>
              <a href={alternateUrl(pathname, loc)} aria-current={loc === locale ? 'true' : undefined} hreflang={htmlLang[loc]}>
                {loc === 'zh' ? <span class="nf">{localeNames[loc]}</span> : localeNames[loc]}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <a class="show-online" href={site.cloudUrl} target="_blank" rel="noopener">
        {t.showOnline}
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10 8.5v7l6-3.5Z"/></svg>
      </a>

      <button class="icon-btn menu-open" type="button" aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- 搜索遮罩 -->
<div class="search-mask" role="dialog" aria-modal="true" aria-label="Search" hidden>
  <button class="search-close" type="button" aria-label="Close search">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
  </button>
  <form class="search-form" action={l('/search/', locale)} method="get">
    <input type="search" name="q" placeholder={t.searchPlaceholder} aria-label={u.searchAriaLabel} autocomplete="off" />
    <button type="submit" class="btn-pill">
      {u.searchBtn}
      <svg class="arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 12h15m-6-6 6 6-6 6"/></svg>
    </button>
  </form>
</div>

<!-- 移动端全屏菜单 -->
<div class="mobile-menu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <div class="mobile-menu-head">
    <Img src="common/logo-white.png" alt="Hitelecom" width={150} loading="eager" />
    <button class="menu-close" type="button" aria-label="Close menu">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </div>
  <nav aria-label="Mobile">
    <ul>
      {t.nav.map((item, i) => (
        <li style={`--i:${i}`}><a href={l(item.href, locale)}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
  <div class="mobile-menu-foot">
    <a href={site.cloudUrl} target="_blank" rel="noopener">{t.showOnline} <span class="nf" aria-hidden="true">→</span></a>
    {locales.filter((loc) => loc !== locale).map((loc) => (
      <a href={alternateUrl(pathname, loc)} hreflang={htmlLang[loc]}>{localeNames[loc]} <span class="nf" aria-hidden="true">→</span></a>
    ))}
    <a href={site.phoneHref}>{site.phone}</a>
  </div>
</div>

<script>
  const header = document.getElementById('site-header')!;
  let lastY = 0;
  const forceSolid = header.classList.contains('scrolled');
  const onScroll = () => {
    if (forceSolid) return;
    const y = window.scrollY;
    header.classList.toggle('scrolled', y > 40);
    if (y > lastY && y > 320 && !document.body.classList.contains('menu-active')) {
      header.classList.add('header-hidden');
    } else {
      header.classList.remove('header-hidden');
    }
    lastY = y;
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // 搜索遮罩
  const mask = document.querySelector('.search-mask') as HTMLElement;
  const openSearch = () => { mask.hidden = false; requestAnimationFrame(() => mask.classList.add('open')); (mask.querySelector('input') as HTMLInputElement)?.focus(); };
  const closeSearch = () => { mask.classList.remove('open'); setTimeout(() => (mask.hidden = true), 250); };
  document.querySelector('.search-open')?.addEventListener('click', openSearch);
  mask.querySelector('.search-close')?.addEventListener('click', closeSearch);
  mask.addEventListener('click', (e) => { if (e.target === mask) closeSearch(); });

  // 语言下拉
  const lang = document.querySelector('.lang')!;
  const langBtn = lang.querySelector('.lang-btn')!;
  langBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = lang.classList.toggle('open');
    langBtn.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('click', () => lang.classList.remove('open'));

  // 移动端菜单
  const menu = document.querySelector('.mobile-menu') as HTMLElement;
  const menuBtn = document.querySelector('.menu-open')!;
  const openMenu = () => {
    menu.hidden = false;
    requestAnimationFrame(() => menu.classList.add('open'));
    document.body.classList.add('menu-active');
    menuBtn.setAttribute('aria-expanded', 'true');
  };
  const closeMenu = () => {
    menu.classList.remove('open');
    document.body.classList.remove('menu-active');
    menuBtn.setAttribute('aria-expanded', 'false');
    setTimeout(() => (menu.hidden = true), 320);
  };
  menuBtn.addEventListener('click', openMenu);
  menu.querySelector('.menu-close')?.addEventListener('click', closeMenu);
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { closeSearch(); closeMenu(); lang.classList.remove('open'); }
  });
</script>

<style>
  #site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 1000;
    padding: 1.35em 0;
    transition: transform 0.4s var(--ease), background 0.35s var(--ease), box-shadow 0.35s var(--ease), padding 0.35s var(--ease);
    color: #fff;
  }
  #site-header.scrolled {
    background: #fff;
    color: var(--text);
    padding: 0.75em 0;
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.08);
  }
  #site-header.header-hidden { transform: translateY(-100%); }
  body.menu-active #site-header { transform: none; }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-inline: clamp(20px, 3.125vw, 60px);
    max-width: 1920px;
    margin-inline: auto;
  }

  .logo { flex-shrink: 0; width: clamp(130px, 10.4vw, 200px); position: relative; }
  .logo :global(img) { width: 100%; height: auto; transition: opacity 0.3s; }
  .logo :global(.logo-white) { position: absolute; inset: 0; opacity: 1; }
  .logo :global(.logo-color) { opacity: 0; }
  #site-header.scrolled .logo :global(.logo-white) { opacity: 0; }
  #site-header.scrolled .logo :global(.logo-color) { opacity: 1; }

  .main-nav { margin-inline: auto; }
  .main-nav ul { display: flex; gap: clamp(18px, 2.6vw, 50px); }
  .main-nav a {
    position: relative;
    font-size: 1rem;
    font-weight: 500;
    padding: 6px 0;
    transition: color 0.3s;
  }
  .main-nav a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -4px;
    width: 0;
    height: 2px;
    background: var(--brand);
    transform: translateX(-50%);
    transition: width 0.35s var(--ease);
  }
  .main-nav a:hover::after,
  .main-nav a[aria-current='page']::after { width: 100%; }
  #site-header:not(.scrolled) .main-nav a:hover { color: #fff; }

  .header-actions { display: flex; align-items: center; gap: 14px; margin-left: auto; }
  .main-nav + .header-actions { margin-left: 0; }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    transition: background 0.3s, color 0.3s;
  }
  .icon-btn:hover { color: var(--brand); }
  #site-header.scrolled .icon-btn:hover { background: #eef5fc; }

  .lang { position: relative; }
  .lang-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.5em 1.1em;
    font-size: 0.9rem;
    transition: opacity 0.3s;
  }
  .lang-btn:hover { opacity: 0.75; }
  .lang-btn .chev { transition: transform 0.3s; }
  .lang.open .lang-btn .chev { transform: rotate(180deg); }
  .lang-menu {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    min-width: 150px;
    background: #fff;
    color: var(--text);
    border-radius: 12px;
    box-shadow: 0 18px 44px rgba(18, 28, 43, 0.16);
    padding: 8px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: 0.25s var(--ease);
  }
  .lang.open .lang-menu { opacity: 1; visibility: visible; transform: none; }
  .lang-menu a {
    display: block;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 0.92rem;
    transition: background 0.25s, color 0.25s;
  }
  .lang-menu a:hover { background: #eef5fc; color: var(--brand); }
  .lang-menu a[aria-current='true'] { color: var(--brand); font-weight: 600; }

  .show-online {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: #fff;
    color: var(--brand);
    border-radius: 999px;
    padding: 0.62em 1.3em;
    font-size: 0.92rem;
    font-weight: 500;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .show-online:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(39, 144, 229, 0.35); }
  #site-header.scrolled .show-online { box-shadow: inset 0 0 0 1px var(--line); }

  /* 三线在按钮盒内水平垂直双居中（place-items 对 flex 主轴无效，须显式 justify-content）；
     线宽/间距与旁侧语言胶囊视觉重量对齐 */
  .menu-open { display: none; flex-direction: column; justify-content: center; align-items: center; gap: 6px; width: 40px; height: 40px; }
  .menu-open span { width: 24px; height: 2.5px; background: currentColor; border-radius: 2px; transition: 0.3s; }

  /* 搜索遮罩 */
  .search-mask {
    position: fixed;
    inset: 0;
    z-index: 1200;
    display: grid;
    place-items: center;
    background: rgba(10, 18, 30, 0.92);
    backdrop-filter: blur(10px);
    opacity: 0;
    transition: opacity 0.25s var(--ease);
  }
  .search-mask.open { opacity: 1; }
  .search-close { position: absolute; top: 34px; right: 40px; color: #fff; opacity: 0.8; transition: opacity 0.3s, transform 0.3s; }
  .search-close:hover { opacity: 1; transform: rotate(90deg); }
  .search-form { display: flex; gap: 18px; width: min(680px, 86vw); }
  .search-form input {
    flex: 1;
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
    color: #fff;
    font-size: clamp(1.2rem, 2.4vw, 1.8rem);
    padding: 0.6em 0.2em;
    outline: none;
    transition: border-color 0.3s;
  }
  .search-form input:focus { border-color: #fff; }
  .search-form input::placeholder { color: rgba(255, 255, 255, 0.45); }

  /* 移动端菜单 */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 1100;
    background: linear-gradient(160deg, #0d1726 0%, #12385f 100%);
    color: #fff;
    padding: 26px clamp(22px, 6vw, 48px) 40px;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.32s var(--ease);
    overflow-y: auto;
  }
  .mobile-menu.open { transform: none; }
  .mobile-menu-head { display: flex; justify-content: space-between; align-items: center; }
  .mobile-menu-head :global(img) { width: 150px; }
  .menu-close { color: #fff; }
  .mobile-menu nav { margin-top: 8vh; }
  .mobile-menu nav a {
    display: block;
    font-size: clamp(1.7rem, 6vw, 2.3rem);
    font-weight: 600;
    padding: 0.42em 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease), color 0.3s;
    transition-delay: calc(var(--i) * 0.05s);
  }
  .mobile-menu.open nav a { opacity: 1; transform: none; }
  .mobile-menu nav a:hover { color: var(--brand); }
  .mobile-menu-foot {
    margin-top: auto;
    padding-top: 34px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: rgba(255, 255, 255, 0.75);
    font-size: 1.02rem;
  }
  .mobile-menu-foot a:hover { color: #fff; }

  @media (max-width: 1080px) {
    .main-nav { display: none; }
    .menu-open { display: flex; }
    .lang-btn span { display: none; }
    .lang-btn { padding: 0.55em 0.8em; }
  }
  @media (max-width: 640px) {
    .show-online { display: none; }
    #site-header { padding: 1em 0; }
  }
</style>
