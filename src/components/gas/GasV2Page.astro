---
/**
 * 定制防爆气体传感器页 V2 · 包装器（GPT6 页面包 V76，Kimi 审核集成）
 * 路由：EN /product/custom-gas-sensor（无前缀）；es/fr/de/ja/ru 经 locale 路由复用本组件（V77）。
 * 数据：REGISTRY 按 locale 选 gas-content-{locale}.json；EN 无字典条目，
 * S() 原样回落，EN 渲染零差异。UI 字符串：dicts.mjs（GAS_DICTS）。
 * JS 文案经 pickJs 注入包装 div 的 data-i18n，gas-interactions.js T() 读取。
 * 包缺口（回退 EN，不杜撰）：ProductGroup 名 / Product 变体名模板。
 * Organization/WebSite 实体图由 BaseLayout 全局输出，本页仅输出页面级
 * Schema（includeOrganization={false}，统一引用 /#organization）。
 * Hero 响应式 preload（imagesrcset/imagesizes 与 GasPage img 一致）经 head 槽输出。
 * SiteShell/QuickContact 为 GPT6 离线审阅壳，不集成（README-KIMI；V64/V68/V70 同规）。
 * 供电口径：外接 9–24 V DC（用户确认）。旧规格书 custom-gas-sensor-datasheet.pdf
 * 仍为电池口径，本页按包设计不链接（参数卡按钮改为询价入口）；content 内
 * datasheet_url 为死数据保留，待新规格书到货后恢复真实下载入口。
 * 样式作用域：包内将 .ht-gas 挂在 body；集成经 BaseLayout，故挂在包装 div。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import GasPage from './GasPage.astro';
import StructuredData from './StructuredData.astro';
import { gasImage } from './images.mjs';
import { GAS_DICTS, pickJs } from './dicts.mjs';
import contentEn from '../../data/gas-content.json';
import contentEs from '../../data/gas-content-es.json';
import contentFr from '../../data/gas-content-fr.json';
import contentDe from '../../data/gas-content-de.json';
import contentJa from '../../data/gas-content-ja.json';
import contentRu from '../../data/gas-content-ru.json';
import '../../styles/gas.css';
const REGISTRY = {
  en: { content: contentEn, prefix: '' },
  es: { content: contentEs, prefix: '/es' },
  fr: { content: contentFr, prefix: '/fr' },
  de: { content: contentDe, prefix: '/de' },
  ja: { content: contentJa, prefix: '/ja' },
  ru: { content: contentRu, prefix: '/ru' },
};
const { locale = 'en' } = Astro.props;
const { content, prefix } = REGISTRY[locale] ?? REGISTRY.en;
const t = GAS_DICTS[locale] ?? {};
const hero = await gasImage('product-hero.webp', true);
const ogImage = new URL(hero.src, Astro.site).href;
const heroSizes = '(max-width: 600px) calc(100vw - 76px), (max-width: 1024px) 42vw, 560px';
---

<BaseLayout locale={locale} title={content.seo.title} description={content.seo.description} robots="index,follow,max-image-preview:large">
  <link slot="head" rel="preload" as="image" href={hero.src} imagesrcset={hero.srcset} imagesizes={heroSizes} fetchpriority="high" />
  <StructuredData slot="head" content={content} imageUrl={ogImage} includeOrganization={false} t={t} prefix={prefix} locale={locale} />
  <div class="ht-gas" data-i18n={JSON.stringify(pickJs(t))}><GasPage content={content} t={t} prefix={prefix} /></div>
</BaseLayout>
