---
/**
 * 温度传感器页 · 多语言页体（GPT6 页面包 + 五语翻译包，Kimi 审核集成 2026-10-08）
 * 数据驱动化（V43，同倾斜页 TiltPage 模式）：props { content, t, locale, prefix }；
 * EN 输出与改造前逐字节一致（leadRest 前置空格、箭头/间距原样保留为模板字面量）。
 * 文案来源：t = dicts.mjs（附录 A 精确替换表）；content = temperature-content(-{lang}).json。
 * 数量文案：applications.monitoringTasks ru 按 Intl.PluralRules 构建端选形；
 * ja 数字与标签间无空格（numSep=''）。无脚本邮件句末标点 form.directAfter。
 * 接入修正（V41 口径保持）：无独立 QuickContact（Sidebar 四入口）、无自带 main#main、
 * 资料按钮相对地址；图片署名 ImageCaption（CC BY/CC0，许可要求必须保留）。
 */
import FeatureIcon from './FeatureIcon.astro';
import ImageCaption from './ImageCaption.astro';
import { getImage } from 'astro:assets';
import heroBackground from '../../assets/brand/sensor-hero-background.jpg';
import { temperatureImage } from './images.mjs';
const { content, t, locale, prefix } = Astro.props;
const hero = await temperatureImage('product-hero.png', true);
const widths = [640,1280,1920];
const backgrounds = await Promise.all(widths.map(width=>getImage({src:heroBackground,width,format:'webp',quality:78})));
const groups = await Promise.all(content.groups.map(async group=>({...group,asset:await temperatureImage(group.image.name),tasks:await Promise.all(content.applications.filter(scene=>scene.group===group.id).map(async scene=>({...scene,image:scene.image||group.image,asset:await temperatureImage((scene.image||group.image).name)})))})));
const datasheet = content.hero.datasheet_url;
const h1 = t.page.heroH1;
const br2 = (s) => s.split('\n');
const [featA, featB] = br2(t.features.heading);
const [measA, measB] = br2(t.measurement.heading);
const [instA, instB] = br2(t.measurement.installationHeading);
const [wfA, wfB] = br2(t.workflow.heading);
const [batA, batB] = br2(t.workflow.batteryHeading);
const [serA, serB] = br2(t.series.heading);
const [specA, specB] = br2(t.spec.heading);
const [intA, intB] = br2(t.integration.heading);
const [faqA, faqB] = br2(t.faq.heading);
const [enqA, enqB] = br2(t.enquiry.heading);
const pluralRules = new Intl.PluralRules(locale);
const taskWord = t.applications.monitoringTasks;
const tasksLabel = (n) => (typeof taskWord === 'string' ? taskWord : taskWord[pluralRules.select(n)]);
const numSep = locale === 'ja' ? '' : ' ';
const directSep = locale === 'ja' ? '' : ' ';
const directMailto = `mailto:sales@hitelecom.cn?subject=${encodeURIComponent(t.js.directSubject)}`;
---
<div class="ht-temperature" data-i18n={JSON.stringify(t.js)}>
  <div class="hero-band">
    <img class="hero-background" src={backgrounds[2].src} srcset={backgrounds.map((x,i)=>`${x.src} ${widths[i]}w`).join(', ')} sizes="100vw" width={heroBackground.width} height={heroBackground.height} alt="" aria-hidden="true" loading="eager" decoding="async" />
    <div class="wrap breadcrumb" aria-label={t.page.breadcrumbAria}><a href={prefix+'/'}>{t.page.home}</a><span aria-hidden="true">/</span><a href={prefix+'/product'}>{t.page.iotSensors}</a><span aria-hidden="true">/</span><span>{t.page.temperatureSensor}</span></div>
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-heading"><h1 id="hero-title">{h1.lead}{h1.leadRest && <br class="temperature-title-break"/>}{h1.leadRest}<br/><span>{h1.spanA}<br/>{h1.spanB}</span></h1></div>
      <figure class="hero-visual temperature-product">
        <img src={hero.src} srcset={hero.srcset} sizes="(max-width: 600px) 350px, (max-width: 1024px) 64vw, 760px" width={hero.width} height={hero.height} alt={t.page.heroProductAlt} loading="eager" fetchpriority="high" decoding="async" />
        <figcaption><span class="live-dot" aria-hidden="true"></span>{t.page.heroCaption}</figcaption>
      </figure>
      <p class="hero-description">{content.hero.description}</p>
      <div class="hero-actions"><a href="#enquiry" class="button button-primary">{t.page.discussProject} <span aria-hidden="true">↗</span></a><a href={datasheet} target="_blank" rel="noopener" class="text-link">{t.page.downloadDatasheet} <span aria-hidden="true">↗</span></a></div>
      <div class="hero-proof">{t.proof.map(p=><div><strong>{p.strong}</strong><span>{p.span}</span><small>{p.small}</small></div>)}</div>
    </section>
  </div>
  <nav class="section-nav" aria-label={t.nav.aria}><div class="wrap"><a href="#measurement">{t.nav.measurement}</a><a href="#applications">{t.nav.applications}</a><a href="#specifications">{t.nav.specifications}</a><a href="#integration">{t.nav.integration}</a><a href="#faq">{t.nav.faq}</a><a class="nav-quote" href="#enquiry">{t.nav.quote} ↗</a></div></nav>

  <section class="section features-section" id="features" aria-labelledby="features-title"><div class="wrap">
    <div class="section-heading compact-heading"><div><p class="eyebrow">{t.features.kicker}</p><h2 id="features-title">{featA}<br/><span>{featB}</span></h2></div><p>{t.features.intro}</p></div>
    <div class="feature-grid">{content.features.map((feature,index)=><article><span class="feature-mark" aria-hidden="true"><FeatureIcon index={index}/></span><h3>{feature.title}</h3><p>{feature.text}</p></article>)}</div>
  </div></section>

  <section class="section measurement-section" id="measurement" aria-labelledby="measurement-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{t.measurement.kicker}</p><h2 id="measurement-title">{measA}<br/><span>{measB}</span></h2></div><p>{content.measurement.description}</p></div>
    <div class="measurement-grid">{content.measurement.cards.map((item,index)=><article class="measurement-card"><div class="measurement-heading"><span class="measurement-number">0{index+1}</span><span class="measurement-symbol" aria-hidden="true">{index===0?'↗':index===1?'↔':'↓'}</span></div><h3>{item.title}</h3><p>{item.text}</p><dl><dt>{t.measurement.define}</dt><dd>{item.project_brief}</dd></dl><a href="#enquiry" class="text-link" data-measurement={item.title}>{t.measurement.discuss} ↗</a></article>)}</div>
    <div class="installation-note"><span class="small-label">{t.measurement.probeTransmitter}</span><h3>{instA}<br/>{instB}</h3><p>{content.measurement.installation_text}</p></div>
  </div></section>

  <section class="section profile-section" id="operating-profile" aria-labelledby="profile-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{t.workflow.kicker}</p><h2 id="profile-title">{wfA}<br/>{wfB}</h2></div><p>{content.workflow.profile_text}</p></div>
    <div class="temperature-workflow">{content.workflow.steps.map(step=><article><span class="step-number">{step.number}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div>
    <div class="profile-note"><div><span class="small-label">{t.workflow.batteryKicker}</span><strong>{batA}<br/>{batB}</strong></div><p>{content.workflow.battery_text}</p></div>
  </div></section>

  <section class="section application-section" id="applications" aria-labelledby="applications-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{t.applications.kicker}</p><h2 id="applications-title">{content.applicationSection.title}<br/><span>{content.applicationSection.valueHeading}</span></h2></div><p>{content.applicationSection.description}</p></div>
    <div class="application-overview"><p><strong>{content.groups.length}</strong>{numSep}{t.applications.industryCategories} <span aria-hidden="true">/</span> <strong>{content.applications.length}</strong>{numSep}{tasksLabel(content.applications.length)}</p><p class="image-note">{content.applicationSection.note}</p></div>
    <nav class="application-jump-nav" aria-label={t.applications.aria}>{content.groups.map(group=><a href={'#group-'+group.id}>{group.jumpLabel}<span>{group.scenes.length}</span></a>)}</nav>
    <div class="application-groups">{groups.map((group,index)=><details class="application-group" id={'group-'+group.id} open={index===0}>
      <summary><span><small>0{index+1}</small>{group.title}</span><span class="group-count">{group.scenes.length}{numSep}{tasksLabel(group.scenes.length)} <b aria-hidden="true">+</b></span></summary>
      <div class="application-category-body">
        <div class="application-visual"><div class="application-media-slot"><figure class="application-category-photo"><img class="application-category-image" src={group.asset.src} srcset={group.asset.srcset} sizes="(max-width: 600px) calc(100vw - 76px), (max-width: 900px) calc((100vw - 132px) * .42), 470px" width={group.asset.width} height={group.asset.height} loading="lazy" decoding="async" alt={group.image.alt} style={'object-position:'+group.image.focalPoint}/><ImageCaption image={group.image} t={t}/></figure></div><p>{group.intro}</p></div>
        <div class="application-task-list">{group.tasks.map((scene,taskIndex)=><details class="application-task" id={scene.id} open={index===0&&taskIndex===0}>
          <summary aria-controls={'scene-photo-'+scene.id}><span class="task-heading"><h3>{scene.title}</h3><small>{scene.measurement}</small></span><span class="task-toggle" aria-hidden="true">+</span></summary>
          <div class="task-copy"><figure class="application-scene-photo" id={'scene-photo-'+scene.id} data-scene-owner={scene.id}><img class="application-scene-image" src={scene.asset.src} srcset={scene.asset.srcset} sizes="(max-width: 600px) calc(100vw - 76px), (max-width: 900px) calc((100vw - 132px) * .42), 470px" width={scene.asset.width} height={scene.asset.height} loading="lazy" decoding="async" alt={scene.image.alt} style={'object-position:'+scene.image.focalPoint}/><ImageCaption image={scene.image} t={t}/></figure><p>{scene.description}</p><dl><dt>{t.applications.temperature}</dt><dd>{scene.measurement}</dd><dt>{t.applications.point}</dt><dd>{scene.monitoringPoint}</dd><dt>{t.applications.plan}</dt><dd>{scene.projectBrief}</dd></dl><a href="#enquiry" class="task-cta" data-project-scene={scene.title}>{t.applications.discuss} <span aria-hidden="true">↗</span></a></div>
        </details>)}</div>
      </div>
    </details>)}</div>
  </div></section>

  <section class="section specifications-section" id="specifications" aria-labelledby="specifications-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{t.series.kicker}</p><h2 id="specifications-title">{serA}<br/><span>{serB}</span></h2></div><p>{content.series.description}</p></div>
    <div class="temperature-series">{content.series.models.map(model=><article id={'model-'+model.toLowerCase()}><span class="small-label">{t.series.modelKicker}</span><h3>{model}</h3><p>{t.series.modelDescription}</p><a href="#enquiry" class="text-link" data-model={model}>{t.series.discuss} ↗</a></article>)}</div>
    <div class="temperature-spec-grid"><aside class="model-card"><span class="small-label">{t.spec.familyReference}</span><h3>{specA}<br/>{specB}</h3><p>{content.specifications.description}</p><a href={datasheet} target="_blank" rel="noopener" class="button button-outline">{t.spec.download} ↗</a><a href="#enquiry" class="text-link">{t.spec.proposal} ↓</a></aside><div class="spec-table"><table><caption>{t.spec.caption}</caption><tbody>{content.specifications.rows.map(row=><tr><th scope="row">{row.label}</th><td>{row.value}</td></tr>)}</tbody></table></div></div>
    <div class="selection-list"><h3>{t.spec.selectionHeading}</h3><div>{content.series.steps.map((step,index)=><article><span class="step-number">0{index+1}</span><h4>{step.title}</h4><p>{step.text}</p></article>)}</div></div>
  </div></section>

  <section class="section integration-section" id="integration" aria-labelledby="integration-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{t.integration.kicker}</p><h2 id="integration-title">{intA}<br/><span>{intB}</span></h2></div><p>{content.workflow.platform_text}</p></div>
    <div class="integration-grid"><article><span class="small-label">4G / NB-IoT</span><h3>{t.integration.distributed}</h3><div class="route-flow"><span>{t.integration.point}</span><b aria-hidden="true">→</b><span>{t.integration.mobileNetwork}</span><b aria-hidden="true">→</b><span>{t.integration.platform}</span></div><p>{t.integration.cellularDescription}</p><ul><li>{t.integration.countryOperator}</li><li>{t.integration.signal}</li><li>{t.integration.intervals}</li></ul></article><article><span class="small-label">LoRa</span><h3>{t.integration.site}</h3><div class="route-flow"><span>{t.integration.points}</span><b aria-hidden="true">→</b><span>{t.integration.gateway}</span><b aria-hidden="true">→</b><span>{t.integration.platform}</span></div><p>{t.integration.loraDescription}</p><ul><li>{t.integration.protocol}</li><li>{t.integration.layout}</li><li>{t.integration.gatewayPower}</li></ul></article></div>
    <div class="integration-handover"><h3>{t.integration.firstReading}</h3><p>{t.integration.handover}</p><a href="#enquiry" class="text-link">{t.integration.discuss} ↗</a></div>
  </div></section>

  <section class="section faq-section" id="faq" aria-labelledby="faq-title"><div class="wrap faq-layout"><div class="faq-intro"><p class="eyebrow">{t.faq.kicker}</p><h2 id="faq-title">{faqA}<br/>{faqB}</h2><p>{content.faqHeading.intro}</p><a href="#enquiry" class="text-link">{t.faq.ask} ↗</a></div><div class="faq-list">{content.faqs.map((faq,index)=><details id={faq.id} open={index===0}><summary>{faq.question}<span aria-hidden="true">+</span></summary><div class="faq-answer">{faq.paragraphs.map(paragraph=><p>{paragraph}</p>)}</div></details>)}</div></div></section>

  <section class="section enquiry-section" id="enquiry" aria-labelledby="enquiry-title"><div class="wrap enquiry-layout">
    <div class="enquiry-intro"><p class="eyebrow">{t.enquiry.kicker}</p><h2 id="enquiry-title">{enqA}<br/><span>{enqB}</span></h2><p class="lead">{t.enquiry.intro}</p><a class="contact-email" href="mailto:sales@hitelecom.cn">sales@hitelecom.cn ↗</a><div class="enquiry-benefits"><h3>{t.enquiry.start}</h3><p>{t.enquiry.supporting}</p></div></div>
    <form id="enquiry-form" action="mailto:sales@hitelecom.cn" method="post" enctype="text/plain"><div class="form-heading"><span class="small-label">{t.form.kicker}</span><h3>{t.form.heading}</h3><p>{t.form.subtitle}</p></div>
      <div class="form-fields"><div class="field"><label for="application">{t.form.application} <span aria-hidden="true">*</span></label><select id="application" name="Application" required><option value="">{t.form.chooseApplication}</option>{content.groups.map(group=><optgroup label={group.title}>{content.applications.filter(scene=>scene.group===group.id).map(scene=><option value={scene.title}>{scene.title}</option>)}</optgroup>)}<option>{t.form.other}</option></select></div><div class="field"><label for="country">{t.form.country} <span aria-hidden="true">*</span></label><input id="country" name="Country" required autocomplete="country-name" placeholder={t.form.countryExample} maxlength="100"/></div><div class="field"><label for="quantity">{t.form.quantity}</label><input id="quantity" name="Quantity" type="number" min="1" step="1" inputmode="numeric" placeholder={t.form.quantityExample}/></div><div class="field"><label for="measurement-type">{t.form.measurement}</label><select id="measurement-type" name="Measurement"><option>{t.form.pleaseAdvise}</option>{content.measurement.cards.map(card=><option>{card.title}</option>)}</select></div><div class="field"><label for="temperature-range">{t.form.temperatureRange}</label><input id="temperature-range" name="Temperature range" placeholder={t.form.rangeExample} maxlength="120"/></div><div class="field"><label for="network">{t.form.connectivity}</label><select id="network" name="Connectivity"><option>{t.form.pleaseAdvise}</option><option>4G LTE</option><option>NB-IoT</option><option>LoRa</option></select></div><div class="field full"><label for="requirements">{t.form.requirements}</label><textarea id="requirements" name="Requirements" rows="3" maxlength="3000" placeholder={t.form.requirementsPlaceholder}></textarea></div></div>
      <div class="form-actions"><button type="submit" class="button button-primary">{t.form.submit} ↗</button><p>{t.form.reviewNote}</p></div><div id="enquiry-review" class="enquiry-review" hidden><label for="enquiry-brief">{t.form.projectBrief}</label><textarea id="enquiry-brief" rows="9" spellcheck="false"></textarea><div><a id="email-brief" class="button button-primary" href="mailto:sales@hitelecom.cn">{t.form.openEmail} ↗</a><button id="copy-brief" type="button" class="button button-outline">{t.form.copy}</button></div><p id="brief-status" role="status" aria-live="polite">{t.form.ready}</p></div><p class="noscript-note">{t.form.directBefore}{directSep}<a href={directMailto}>{t.form.directEmail}</a>{t.form.directAfter}</p>
    </form>
  </div></section>
  <div class="wrap related-products"><p class="small-label">{t.related.kicker}</p><a href={prefix+'/product'}>{t.related.all} ↗</a><a href={prefix+'/product/air-quality-sensor'}>{t.related.air} ↗</a><a href={prefix+'/product/tilt-sensor'}>{t.related.tilt} ↗</a></div>
</div>
<script>import './temperature-interactions.js';</script>
