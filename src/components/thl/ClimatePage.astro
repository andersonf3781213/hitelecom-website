---
import contentDefault from '../../data/thl-content.json';
import { pickJs } from './dicts.mjs';
import FeatureIcon from './FeatureIcon.astro';
import ImageCaption from './ImageCaption.astro';
// QuickContact 不引入：官网 BaseLayout 已提供全站浮动联系按钮（README-KIMI：生产环境保留现有共享 Header/Footer 与四个联系控件）
import { getImage } from 'astro:assets';
import heroBackground from '../../assets/brand/sensor-hero-background.jpg';
import { climateImage } from './images.mjs';
const {content = contentDefault, t = {}, prefix = ''} = Astro.props;
const S = (key) => (Object.prototype.hasOwnProperty.call(t, key) ? t[key] : key);
const enc = encodeURIComponent;
// 测量卡 → 询价通道的语义键（GPT6 五语言包 §4：固定 EN value，翻译显示文字，避免按标题误判）
const MEASUREMENT_KEYS = ['temperature','humidity','light','custom'];
const hero = await climateImage('product-hero.webp', true);
const widths = [640,1280,1920];
const backgrounds = await Promise.all(widths.map(width=>getImage({src:heroBackground,width,format:'webp',quality:78})));
const groups = await Promise.all(content.groups.map(async group=>({...group,asset:await climateImage(group.image.name),tasks:await Promise.all(content.applications.filter(scene=>scene.group===group.id).map(async scene=>({...scene,image:scene.image||group.image,asset:await climateImage((scene.image||group.image).name)})))})));
const datasheet = content.hero.datasheet_url ? new URL(content.hero.datasheet_url,'https://www.hitelecom.com').href : null;
---
<div class="ht-thl" data-i18n={JSON.stringify(pickJs(t))}>
<main id="main">
  <div class="hero-band">
    <img class="hero-background" src={backgrounds[2].src} srcset={backgrounds.map((x,i)=>`${x.src} ${widths[i]}w`).join(', ')} sizes="100vw" width={heroBackground.width} height={heroBackground.height} alt="" aria-hidden="true" loading="eager" decoding="async" />
    <div class="wrap breadcrumb" aria-label={S("Breadcrumb")}><a href={'https://www.hitelecom.com'+prefix}>{S("Home")}</a><span aria-hidden="true">/</span><a href={'https://www.hitelecom.com'+prefix+'/product'}>{S("IoT sensors")}</a><span aria-hidden="true">/</span><span>{S("Temperature, humidity & light sensor")}</span></div>
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-heading"><h1 id="hero-title">{S("Temperature, humidity")}<br/>{S("and light sensor.")}<br/><span>{S("Indoor conditions.")}<br/>{S("Connected to your team.")}</span></h1></div>
      <figure class="hero-visual climate-product">
        <img src={hero.src} srcset={hero.srcset} sizes="(max-width: 600px) 350px, (max-width: 1024px) 64vw, 760px" width={hero.width} height={hero.height} alt={S("Hitelecom indoor temperature, relative humidity and light sensor with integrated LCD display, official product image")} loading="eager" fetchpriority="high" decoding="async" />
        <figcaption><span class="live-dot" aria-hidden="true"></span>{S("Integrated indoor sensor · Display configuration")}</figcaption>
      </figure>
      <p class="hero-description">{content.hero.description}</p>
      <div class="hero-actions"><a href="#enquiry" class="button button-primary">{S("Discuss your project")} <span aria-hidden="true">↗</span></a>{datasheet && <a href={datasheet} target="_blank" rel="noopener" class="text-link">{S("View T&H reference datasheet")} <span aria-hidden="true">↗</span></a>}</div>
      <div class="hero-proof"><div><strong>{S("°C")}</strong><span>{S("Temperature")}</span><small>{S("Local indoor conditions")}</small></div><div><strong>{S("%RH")}</strong><span>{S("Relative humidity")}</span><small>{S("Moisture in the surrounding air")}</small></div><div><strong>{S("lux")}</strong><span>{S("Illuminance")}</span><small>{S("Light at the sensing position")}</small></div><div class="hero-custom"><a href="#enquiry" data-measurement="custom"><strong>{S("Custom")} <b aria-hidden="true">↗</b></strong><span>{S("Sensors for your project")}</span><small>{S("Channels, product form & installation")}</small></a></div></div>
    </section>
  </div>
  <nav class="section-nav" aria-label={S("On this page")}><div class="wrap"><a href="#measurement">{S("Measurement")}</a><a href="#applications">{S("Applications")}</a><a href="#specifications">{S("Specifications")}</a><a href="#integration">{S("Integration")}</a><a href="#faq">{S("FAQ")}</a><a class="nav-quote" href="#enquiry">{S("Request a quote ↗")}</a></div></nav>

  <section class="section features-section" id="features" aria-labelledby="features-title"><div class="wrap">
    <div class="section-heading compact-heading"><div><p class="eyebrow">{S("KEY FEATURES")}</p><h2 id="features-title">{S("Three measurements.")}<br/><span>{S("One clear view of the space.")}</span></h2></div><p>{S("Connect room conditions, collection environments and light exposure with the people responsible for them.")}</p></div>
    <div class="feature-grid">{content.features.map((feature,index)=><article><span class="feature-mark" aria-hidden="true"><FeatureIcon index={index}/></span><h3>{feature.title}</h3><p>{feature.text}</p></article>)}</div>
  </div></section>

  <section class="section measurement-section" id="measurement" aria-labelledby="measurement-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{S("TEMPERATURE · HUMIDITY · LIGHT · CUSTOM SENSING")}</p><h2 id="measurement-title">{S("See the conditions.")}<br/><span>{S("Understand the context.")}</span></h2></div><p>{content.measurement.description}</p></div>
    <div class="measurement-grid">{content.measurement.cards.map((item,index)=><article class="measurement-card"><div class="measurement-heading"><span class="measurement-number">0{index+1}</span><span class="measurement-symbol" aria-hidden="true">{item.symbol || ['°C','%RH','lux'][index]}</span></div><h3>{item.title}</h3><p>{item.text}</p><dl><dt>{S("Define your measurement")}</dt><dd>{item.project_brief}</dd></dl><a href="#enquiry" class="text-link" data-measurement={MEASUREMENT_KEYS[index] || 'custom'}>{S("Discuss this measurement ↗")}</a></article>)}</div>
    <div class="installation-note"><span class="small-label">{S("SENSING & INSTALLATION")}</span><h3>{S("Choose a representative position.")}<br/>{S("Keep the light path clear.")}</h3><p>{content.measurement.installation_text}</p></div>
  </div></section>

  <section class="section profile-section" id="operating-profile" aria-labelledby="profile-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{S("FROM READING TO RESPONSE")}</p><h2 id="profile-title">{S("From room conditions.")}<br/>{S("To a considered response.")}</h2></div><p>{content.workflow.profile_text}</p></div>
    <div class="climate-workflow">{content.workflow.steps.map(step=><article><span class="step-number">{step.number}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div>
    {content.workflow.battery_text && <div class="profile-note"><div><span class="small-label">{S("CONFIGURATION & OPERATING PROFILE")}</span><strong>{content.workflow.profileTitle || S("Matched to your site. Agreed for your project.")}</strong></div><p>{content.workflow.battery_text}</p></div>}
  </div></section>

  <section class="section application-section" id="applications" aria-labelledby="applications-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{S("APPLICATIONS")}</p><h2 id="applications-title">{content.applicationSection.title}<br/><span>{content.applicationSection.valueHeading}</span></h2></div><p>{content.applicationSection.description}</p></div>
    <div class="application-overview"><p><strong>{content.groups.length}</strong> {S("industry categories")} <span aria-hidden="true">/</span> <strong>{content.applications.length}</strong> {S("monitoring tasks")}</p><p class="image-note">{content.applicationSection.note}</p></div>
    <nav class="application-jump-nav" aria-label={S("Browse temperature, humidity and light applications")}>{content.groups.map(group=><a href={'#group-'+group.id}>{group.jumpLabel}<span>{group.scenes.length}</span></a>)}</nav>
    <div class="application-groups">{groups.map((group,index)=><details class="application-group" id={'group-'+group.id} open={index===0}>
      <summary><span><small>0{index+1}</small>{group.title}</span><span class="group-count">{S("6 monitoring tasks")} <b aria-hidden="true">+</b></span></summary>
      <div class="application-category-body">
        <div class="application-visual"><div class="application-media-slot"><figure class="application-category-photo"><img class="application-category-image" src={group.asset.src} srcset={group.asset.srcset} sizes="(max-width: 600px) calc(100vw - 76px), (max-width: 900px) calc((100vw - 132px) * .42), 470px" width={group.asset.width} height={group.asset.height} loading="lazy" decoding="async" alt={group.image.alt} style={'object-position:'+group.image.focalPoint}/><ImageCaption image={group.image} t={t}/></figure></div><p>{group.intro}</p></div>
        <div class="application-task-list">{group.tasks.map((scene,taskIndex)=><details class="application-task" id={scene.id} open={index===0&&taskIndex===0}>
          <summary aria-controls={'scene-photo-'+scene.id}><span class="task-heading"><h3>{scene.title}</h3><small>{scene.measurement}</small></span><span class="task-toggle" aria-hidden="true">+</span></summary>
          <div class="task-copy"><figure class="application-scene-photo" id={'scene-photo-'+scene.id} data-scene-owner={scene.id}><img class="application-scene-image" src={scene.asset.src} srcset={scene.asset.srcset} sizes="(max-width: 600px) calc(100vw - 76px), (max-width: 900px) calc((100vw - 132px) * .42), 470px" width={scene.asset.width} height={scene.asset.height} loading="lazy" decoding="async" alt={scene.image.alt} style={'object-position:'+scene.image.focalPoint}/><ImageCaption image={scene.image} t={t}/></figure><p>{scene.description}</p><dl><dt>{S("Measurements to monitor")}</dt><dd>{scene.measurement}</dd><dt>{S("Measurement point")}</dt><dd>{scene.monitoringPoint}</dd>{scene.installation && <><dt>{S("Placement & installation")}</dt><dd>{scene.installation}</dd></>}<dt>{S("Project details to specify")}</dt><dd>{scene.projectBrief}</dd></dl><a href="#enquiry" class="task-cta" data-project-scene={scene.title}>{S("Discuss this application")} <span aria-hidden="true">↗</span></a></div>
        </details>)}</div>
      </div>
    </details>)}</div>
  </div></section>

  <section class="section specifications-section" id="specifications" aria-labelledby="specifications-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{S("SERIES & CONFIGURATIONS")}</p><h2 id="specifications-title">{S("The right design.")}<br/><span>{S("The right configuration.")}</span></h2></div><p>{content.series.description}</p></div>
    <div class="climate-series">{content.series.models.map(model=>{const detail=content.series.modelDetails?.find(item=>item.model===model);return <article id={'model-'+model.toLowerCase()}><span class="small-label">{S("WIRELESS MODEL FAMILY")}</span><h3>{model}<span class="network-tag">{detail?.network}</span></h3>{detail?.title && <h4>{detail.title}</h4>}<p>{detail?.text || "Wireless connection, measurement channels and installation profile selected for your project."}</p><a href="#enquiry" class="text-link" data-model={model}>{S("Discuss this configuration ↗")}</a></article>})}</div>
    <div class="climate-spec-grid"><aside class="model-card"><span class="small-label">{S("FAMILY REFERENCE")}</span><h3>{S("Specify the environment.")}<br/>{S("Select the channels.")}</h3><p>{content.specifications.description}</p>{datasheet && <a href={datasheet} target="_blank" rel="noopener" class="button button-outline">{S("View T&H reference datasheet ↗")}</a>}<a href="#enquiry" class="text-link">{S("Get a configuration proposal ↓")}</a></aside><div class="spec-table"><table><caption>{S("H Series temperature, humidity and light sensors — configuration reference")}</caption><tbody>{content.specifications.rows.map(row=><tr><th scope="row">{row.label}</th><td>{row.value}</td></tr>)}</tbody></table></div></div>
    <div class="selection-list"><h3>{S("Bring the specification back to your project.")}</h3><div>{content.series.steps.map((step,index)=><article><span class="step-number">0{index+1}</span><h4>{step.title}</h4><p>{step.text}</p></article>)}</div></div>
  </div></section>

  <section class="section integration-section" id="integration" aria-labelledby="integration-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{S("CONNECTIVITY & INTEGRATION")}</p><h2 id="integration-title">{S("Your site.")}<br/><span>{S("Your data destination.")}</span></h2></div><p>{content.workflow.platform_text}</p></div>
    <div class="integration-grid"><article><span class="small-label">4G / NB-IoT</span><h3>{S("For distributed locations")}</h3><div class="route-flow"><span>{S("Indoor sensing point")}</span><b aria-hidden="true">→</b><span>{S("Mobile network")}</span><b aria-hidden="true">→</b><span>{S("Hitelecom Platform")}<br/>{S("or your platform")}</span></div><p>{S("Select the modem and regional bands around operator availability and coverage at the transmitter position. Agree the reporting profile, power arrangement and notification workflow.")}</p><ul><li>{S("Installation country and operator")}</li><li>{S("Signal at the actual mounting position")}</li><li>{S("Sampling, reporting and required alert response")}</li></ul></article><article><span class="small-label">LoRa</span><h3>{S("For points across one site")}</h3><div class="route-flow"><span>{S("Indoor sensing points")}</span><b aria-hidden="true">→</b><span>{S("Receiver / gateway")}</span><b aria-hidden="true">→</b><span>{S("Hitelecom Platform")}<br/>{S("or your platform")}</span></div><p>{S("Match the supplied radio protocol, regional settings and receiver or gateway. Specify any LoRaWAN requirement with the model and complete onward connection.")}</p><ul><li>{S("Device protocol and gateway compatibility")}</li><li>{S("Site layout and radio coverage")}</li><li>{S("Gateway power and onward data connection")}</li></ul></article></div>
    <div class="integration-handover"><h3>{S("Make the first reading useful.")}</h3><p>{S("Agree device identity, sensing point or channel, temperature, humidity and light units, and timestamps in a sample message. Check the endpoint and supported authentication, then test the complete path to the intended platform and recipients.")}</p><a href="#enquiry" class="text-link">{S("Discuss platform integration ↗")}</a></div>
  </div></section>

  <section class="section faq-section" id="faq" aria-labelledby="faq-title"><div class="wrap faq-layout"><div class="faq-intro"><p class="eyebrow">{S("ANSWERS FOR YOUR PROJECT")}</p><h2 id="faq-title">{S("Frequently")}<br/>{S("asked questions.")}</h2><p>{content.faqHeading.intro}</p><a href="#enquiry" class="text-link">{S("Ask about your project ↗")}</a></div><div class="faq-list">{content.faqs.map((faq,index)=><details id={faq.id} open={index===0}><summary>{faq.question}<span aria-hidden="true">+</span></summary><div class="faq-answer">{faq.paragraphs.map(paragraph=><p>{paragraph}</p>)}</div></details>)}</div></div></section>

  <section class="section enquiry-section" id="enquiry" aria-labelledby="enquiry-title"><div class="wrap enquiry-layout">
    <div class="enquiry-intro"><p class="eyebrow">{S("LET'S TALK ABOUT YOUR PROJECT")}</p><h2 id="enquiry-title">{S("Your space.")}<br/><span>{S("Let’s plan the monitoring.")}</span></h2><p class="lead">{S("Tell us about the room, collection or operation you want to monitor. We’ll help match the measurement channels, installation and data connection to your project.")}</p><a class="contact-email" href="mailto:sales@hitelecom.cn">sales@hitelecom.cn ↗</a><div class="enquiry-benefits"><h3>{S("Start with the space and the purpose.")}</h3><p>{S("A room plan, display-case photo or monitoring procedure helps us understand the location. Add your temperature, humidity and light targets, reporting needs and platform requirements.")}</p></div></div>
    <form id="enquiry-form" action="mailto:sales@hitelecom.cn" method="post" enctype="text/plain"><div class="form-heading"><span class="small-label">{S("PROJECT ENQUIRY")}</span><h3>{S("Let’s find your configuration.")}</h3><p>{S("H Series temperature, humidity & light monitoring")}</p></div>
      <div class="form-fields"><div class="field"><label for="application">{S("Application")} <span aria-hidden="true">*</span></label><select id="application" name="Application" required><option value="">{S("Choose your application")}</option>{content.groups.map(group=><optgroup label={group.title}>{content.applications.filter(scene=>scene.group===group.id).map(scene=><option value={scene.title}>{scene.title}</option>)}</optgroup>)}<option>{S("Other / project-specific")}</option></select></div><div class="field"><label for="country">{S("Country / region")} <span aria-hidden="true">*</span></label><input id="country" name="Country" required autocomplete="country-name" placeholder={S("e.g. United Kingdom")} maxlength="100"/></div><div class="field"><label for="quantity">{S("Estimated quantity")}</label><input id="quantity" name="Quantity" type="number" min="1" step="1" inputmode="numeric" placeholder={S("e.g. 20")}/></div><div class="field"><label for="measurement-type">{S("Measurement channels")}</label><select id="measurement-type" name="Measurement channels"><option value="Please advise">{S("Please advise")}</option><option value="Temperature & relative humidity">{S("Temperature & relative humidity")}</option><option value="Temperature, relative humidity & light">{S("Temperature, relative humidity & light")}</option><option value="Custom sensors / project-specific sensing">{S("Custom sensors / project-specific sensing")}</option></select></div><div class="field"><label for="location-type">{S("Room / installation type")}</label><input id="location-type" name="Room / installation type" placeholder={S("e.g. gallery, display case or archive store")} maxlength="160"/></div><div class="field"><label for="network">{S("Preferred connectivity")}</label><select id="network" name="Connectivity"><option value="Please advise">{S("Please advise")}</option><option>4G LTE</option><option>NB-IoT</option><option>LoRa</option></select></div><div class="field full"><label for="monitoring-targets">{S("Monitoring targets")}</label><input id="monitoring-targets" name="Monitoring targets" placeholder={S("Temperature / humidity bands, light exposure or project targets")} maxlength="250"/></div><div class="field full"><label for="requirements">{S("What would you like to monitor?")}</label><textarea id="requirements" name="Requirements" rows="3" maxlength="3000" placeholder={S("Monitoring positions, required channels, installation, reporting, alerts or platform requirements")}></textarea></div></div>
      <div class="form-actions"><button type="submit" class="button button-primary">{S("Prepare my enquiry ↗")}</button><p>{S("Review your brief, then send it with your email app.")}</p></div><div id="enquiry-review" class="enquiry-review" hidden><label for="enquiry-brief">{S("Your project brief")}</label><textarea id="enquiry-brief" rows="9" spellcheck="false"></textarea><div><a id="email-brief" class="button button-primary" href="mailto:sales@hitelecom.cn">{S("Open email ↗")}</a><button id="copy-brief" type="button" class="button button-outline">{S("Copy brief")}</button></div><p id="brief-status" role="status" aria-live="polite">{S("Your brief is ready to review.")}</p></div><p class="noscript-note">{S("You can also")} <a href={'mailto:sales@hitelecom.cn?subject='+enc(S("Temperature humidity light sensor project"))}>{S("email your project details directly")}</a>.</p>
    </form>
  </div></section>
  <div class="wrap related-products"><p class="small-label">{S("CONTINUE YOUR MONITORING PROJECT")}</p><a href={'https://www.hitelecom.com'+prefix+'/product'}>{S("Explore all sensors ↗")}</a><a href={'https://www.hitelecom.com'+prefix+'/product/air-quality-sensor'}>{S("Air quality monitoring ↗")}</a><a href={'https://www.hitelecom.com'+prefix+'/product/tilt-sensor'}>{S("Tilt monitoring ↗")}</a></div>
</main>
</div>
<script>import './climate-interactions.js';</script>
