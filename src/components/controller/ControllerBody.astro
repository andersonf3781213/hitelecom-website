/** HD20-2000 系列 IoT Controller 产品页正文（V134，2026-10-30 GPT6 包 V2，Kimi 审核集成）。
 * 复用 gateway.css + controller.css；表单 name 全英文，mailto 摘要机制与现网一致。 */
---
import '../../styles/gateway.css';
import '../../styles/controller.css';
const { content:c, ui:u, locale='en' }=Astro.props;
const prefix=locale==='en'?'':'/'+locale;
const local=(p)=>prefix+p;
const lines=(s)=>String(s).split('\n');
const marks=['M5 5h14v14H5zM9 2v3m6-3v3M9 19v3m6-3v3M2 9h3m-3 6h3m14-6h3m-3 6h3','M4 12h16M13 5l7 7-7 7','M4 5h16v14H4zM4 10h16M9 10v9','M4 18l4-7 5 4 7-11M16 4h4v4','M5 19V9m5 10V5m5 14V2m5 17V7','M5 6h14v12H5zM8 3v3m8-3v3M8 18v3m8-3v3','M7 8a5 5 0 0 1 10 0M4 6a9 9 0 0 1 16 0M12 12v9','M4 6h16M4 12h16M4 18h16M8 3v6m8 0v6m-6 0v6'];
---
<main id="main" class="ht-gateway controller-detail" data-model={c.model} data-name={u.productName}>
 <div class="hero-band"><img class="hero-background" src="/assets/sensor-hero-background.webp" width="1920" height="1090" alt="" aria-hidden="true"/><div class="wrap breadcrumb"><a href={prefix+'/'}>{u.home}</a><span>/</span><a href={prefix+'/product'}>{u.products}</a><span>/</span><span>{u.breadcrumb}</span></div>
 <section class="hero wrap"><div class="hero-heading"><h1>{c.heroHeading}<span>{lines(c.heroValue).map((l,i)=><Fragment>{i>0&&<br/>}{l}</Fragment>)}</span></h1></div><figure class="hero-visual gateway-product"><img src={'/assets/'+c.image} width={c.imageWidth} height={c.imageHeight} alt={u.heroAlt} fetchpriority="high" loading="eager"/><figcaption>{u.heroCaption}</figcaption></figure><p class="hero-description">{c.heroDescription}</p><div class="hero-actions"><a class="button button-primary" href="#enquiry">{u.discuss} ↗</a><a class="text-link" href="#specifications">{u.specificationLink} ↗</a></div><div class="hero-proof">{u.proofs.map(x=><div><strong>{x.title}</strong><span>{x.label}</span><small>{x.note}</small></div>)}</div></section></div>
 <nav class="section-nav" aria-label={u.pageNav}><div class="wrap"><a href="#interfaces">{u.navInterfaces}</a><a href="#workflow">{u.navOperation}</a><a href="#applications">{u.navApplications}</a><a href="#specifications">{u.navSpecifications}</a><a href="#integration">{u.navIntegration}</a><a href="#faq">{u.navFaq}</a><a class="nav-quote" href="#enquiry">{u.discuss} ↗</a></div></nav>
 <section class="section features-section" id="features"><div class="wrap"><div class="section-heading compact-heading"><div><p class="eyebrow">{u.featureEyebrow}</p><h2>{lines(u.featureHeading).map((l,i)=><Fragment>{i>0&&<br/>}{i?<span>{l}</span>:l}</Fragment>)}</h2></div><p>{u.featureIntro}</p></div><div class="feature-grid">{c.features.map((f,i)=><article><span class="feature-mark" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={marks[i]}/></svg></span><h3>{f.title}</h3><p>{f.text}</p></article>)}</div></div></section>
<section class="section controller-interfaces" id="interfaces"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{u.interfaceEyebrow}</p><h2>{lines(u.interfaceHeading).map((l,i)=><Fragment>{i>0&&<br/>}{i?<span>{l}</span>:l}</Fragment>)}</h2></div><p>{u.interfaceIntro}</p></div><div class="controller-interface-grid">{c.interfaceCards.map(x=><article class="measurement-card"><span class="interface-count">{x.count} × {x.type}</span><h3>{x.title}</h3><p>{x.text}</p><ul>{x.examples.map(e=><li>{e}</li>)}</ul></article>)}</div></div></section> <section class="section measurement-section" id="workflow"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{u.workflowEyebrow}</p><h2>{lines(u.workflowHeading).map((l,i)=><Fragment>{i>0&&<br/>}{i?<span>{l}</span>:l}</Fragment>)}</h2></div><p>{u.workflowIntro}</p></div><div class="measurement-grid">{c.workflow.map((w,i)=><article class="measurement-card"><div class="measurement-heading"><span class="measurement-number">0{i+1}</span><span aria-hidden="true">↗</span></div><h3>{w.title}</h3><p>{w.text}</p></article>)}</div></div></section>
 <section class="section application-section" id="applications"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{u.applicationsEyebrow}</p><h2>{lines(u.applicationsHeading).map((l,i)=><Fragment>{i>0&&<br/>}{i?<span>{l}</span>:l}</Fragment>)}</h2></div><p>{c.applicationsIntro}</p></div><div class="application-overview"><p><strong>{c.groups.length}</strong> {u.applicationAreas} <span>/</span> <strong>{c.groups.reduce((n,g)=>n+g.tasks.length,0)}</strong> {u.projectTasks}</p><p class="image-note">{u.imageNote}</p></div><nav class="application-jump-nav" aria-label={u.navApplications}>{c.groups.map(g=><a href={'#group-'+g.id}>{g.title}<span>{g.tasks.length}</span></a>)}</nav><div class="application-groups">{c.groups.map((g,i)=><details class="application-group" id={'group-'+g.id} open={i===0}><summary><span><small>{String(i+1).padStart(2,'0')}</small>{g.title}</span><span class="group-count">{g.tasks.length} <b aria-hidden="true">+</b></span></summary><div class="application-category-body"><div class="application-visual"><div class="application-media-slot"><figure class="application-category-photo"><img class="application-category-image" src={'/assets/'+g.imageKey+'.webp'} width="960" height="640" alt={g.imageAlt} loading="lazy" decoding="async"/><figcaption>{g.imageAlt}</figcaption></figure></div><p>{g.intro}</p></div><div class="application-task-list">{g.tasks.map((t,j)=><details class="application-task" id={'task-'+g.id+'-'+j} open={i===0&&j===0}><summary><span class="task-heading"><h3>{t.title}</h3></span><span class="task-toggle" aria-hidden="true">+</span></summary><div class="task-copy"><figure class="application-scene-photo"><img src={'/assets/'+(t.imageKey||g.imageKey)+'.webp'} width="960" height="640" alt={t.imageAlt||g.imageAlt} loading="lazy" decoding="async"/><figcaption>{t.imageAlt||g.imageAlt}</figcaption></figure><p>{t.text}</p><dl><dt>{u.fieldInterface}</dt><dd>{t.interface}</dd><dt>{u.controlScope}</dt><dd>{t.control}</dd><dt>{u.verification}</dt><dd>{t.verification}</dd></dl><a class="task-cta" href="#enquiry" data-project-scene={t.title}>{u.discussApplication} ↗</a></div></details>)}</div></div></details>)}</div></div></section>
 <section class="section specifications-section" id="specifications"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{u.specEyebrow}</p><h2>{lines(u.specHeading).map((l,i)=><Fragment>{i>0&&<br/>}{i?<span>{l}</span>:l}</Fragment>)}</h2></div><p>{c.specsIntro}</p></div><div class="gateway-spec-grid"><aside class="model-card"><span class="small-label">{u.modelLabel}</span><h3>{u.seriesName}</h3><p>{u.modelNote}</p><a class="button button-outline" href="#enquiry">{u.reviewConfiguration} ↗</a><a class="text-link" href={c.datasheet} type="application/pdf" hreflang="en">{u.datasheet} ↗</a><p class="download-note">{u.downloadNote}</p></aside><div class="spec-table">{c.specGroups.map(g=><section class="spec-group"><h3>{g.title}</h3><table><caption>{u.seriesName+' — '+g.title}</caption><tbody>{g.rows.map(([name,value])=><tr><th scope="row">{name}</th><td>{value}</td></tr>)}</tbody></table></section>)}</div></div><p class="scope-note">{u.scopeNote}</p></div></section>
 <section class="section integration-section" id="integration"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{u.integrationEyebrow}</p><h2>{c.platformTitle}</h2></div><p>{c.platformIntro}</p></div><div class="platform-points">{c.platformBullets.map(p=><p>{p}</p>)}</div></div></section>
 <section class="section faq-section" id="faq"><div class="wrap faq-layout"><div class="faq-intro"><p class="eyebrow">{u.faqEyebrow}</p><h2>{lines(u.faqHeading).map((l,i)=><Fragment>{i>0&&<br/>}{l}</Fragment>)}</h2><p>{u.faqIntro}</p></div><div class="faq-list">{c.faqs.map((f,i)=><details open={i===0}><summary>{f.q}<span aria-hidden="true">+</span></summary><div class="faq-answer"><p>{f.a}</p></div></details>)}</div></div></section>
 <section class="section enquiry-section" id="enquiry"><div class="wrap enquiry-layout"><div class="enquiry-intro"><p class="eyebrow">{u.enquiryEyebrow}</p><h2>{lines(u.enquiryHeading).map((l,i)=><Fragment>{i>0&&<br/>}{i?<span>{l}</span>:l}</Fragment>)}</h2><p class="lead">{c.enquiryIntro}</p><a class="contact-email" href="mailto:sales@hitelecom.cn">sales@hitelecom.cn ↗</a></div><form id="enquiry-form" action="mailto:sales@hitelecom.cn" method="post" enctype="text/plain"><div class="form-heading"><h3>{u.productName}</h3></div><div class="form-fields"><div class="field full"><label for="application">{u.applicationLabel}</label><select id="application" name="Application" required data-brief-field={u.applicationLabel.replace(/ \*$/,'')}><option value="">{u.applicationPlaceholder}</option>{c.groups.map(g=><optgroup label={g.title}>{g.tasks.map(t=><option>{t.title}</option>)}</optgroup>)}<option>{u.other}</option></select></div><div class="field full"><label for="country">{u.countryLabel}</label><input id="country" name="Country" required autocomplete="country-name" placeholder={u.countryPlaceholder} data-brief-field={u.countryLabel.replace(/ \*$/,'')}/></div><div class="field full"><label for="signals">{u.signalsLabel}</label><input id="signals" name="Signals" maxlength="800" placeholder={u.signalsPlaceholder} data-brief-field={u.signalsLabel.replace(/ \*$/,'')}/></div><div class="field full"><label for="actions">{u.actionsLabel}</label><input id="actions" name="Actions" maxlength="800" placeholder={u.actionsPlaceholder} data-brief-field={u.actionsLabel.replace(/ \*$/,'')}/></div><div class="field full"><label for="platform">{u.platformLabel}</label><input id="platform" name="Platform" maxlength="800" placeholder={u.platformPlaceholder} data-brief-field={u.platformLabel.replace(/ \*$/,'')}/></div><div class="field full"><label for="requirements">{u.requirementsLabel}</label><textarea id="requirements" name="Requirements" maxlength="3000" rows="4" placeholder={u.requirementsPlaceholder} data-brief-field={u.requirementsLabel.replace(/ \*$/,'')}></textarea></div></div><div class="form-actions"><button class="button button-primary" type="submit">{u.prepare} ↗</button><p>{u.reviewHint}</p></div><div id="enquiry-review" class="enquiry-review" hidden><label for="enquiry-brief">{u.briefLabel}</label><textarea id="enquiry-brief" rows="10"></textarea><div><a id="email-brief" class="button button-primary" href="mailto:sales@hitelecom.cn">{u.openEmail} ↗</a><button id="copy-brief" class="button button-outline" type="button">{u.copyBrief}</button></div><p id="brief-status" role="status"></p></div><noscript><a href="mailto:sales@hitelecom.cn">{u.directEmail}</a></noscript></form></div></section>
 <div class="wrap related-products"><a href={local('/product/lists/cid/261#cate')}>{u.exploreSensors} ↗</a><a href={local('/product/lists/cid/258#cate')}>{u.exploreGateways} ↗</a></div>
</main>
<script>import './controller-interactions.js';</script>
