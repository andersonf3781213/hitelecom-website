---
/** 两款新三轴页：沿用主站 BaseLayout 和温度/倾斜页面 UI。
 * EN 内容以 2026-10-27 已上线源码为准；非 EN 整页对象来自 GPT6 多语言 MD 包（Kimi 审核集成 2026-10-27）。 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import TriaxialBody from './TriaxialBody.astro';
import TriaxialStructuredData from './TriaxialStructuredData.astro';
import TILT_DICTS from '../tilt/dicts.mjs';
import { htmlLang, type Locale } from '../../i18n';
import highContent from '../../data/tilt-triaxial/high-content.json';
import mediumContent from '../../data/tilt-triaxial/medium-content.json';
import highGroups from '../../data/tilt-triaxial/high-applications.json';
import mediumGroups from '../../data/tilt-triaxial/medium-applications.json';
import ui from '../../data/tilt-triaxial/triaxial-ui.json';
import highZh from '../../data/tilt-triaxial/i18n/high-zh.json';
import highEs from '../../data/tilt-triaxial/i18n/high-es.json';
import highDe from '../../data/tilt-triaxial/i18n/high-de.json';
import highJa from '../../data/tilt-triaxial/i18n/high-ja.json';
import highFr from '../../data/tilt-triaxial/i18n/high-fr.json';
import highRu from '../../data/tilt-triaxial/i18n/high-ru.json';
import mediumZh from '../../data/tilt-triaxial/i18n/medium-zh.json';
import mediumEs from '../../data/tilt-triaxial/i18n/medium-es.json';
import mediumDe from '../../data/tilt-triaxial/i18n/medium-de.json';
import mediumJa from '../../data/tilt-triaxial/i18n/medium-ja.json';
import mediumFr from '../../data/tilt-triaxial/i18n/medium-fr.json';
import mediumRu from '../../data/tilt-triaxial/i18n/medium-ru.json';
import highImage from '../../assets/tilt-triaxial/h310-ts380c.png';
import mediumImage from '../../assets/tilt-triaxial/h310-ts350m.png';
import { getImage } from 'astro:assets';
import '../../styles/tilt.css';
import '../../styles/tilt-triaxial-product.css';

const REGISTRY = {
  high: {
    content: highContent, groups: highGroups, ui: ui.high, image: highImage,
    slug: 'triaxial-high-precision-tilt-sensor',
    publicImage: '/images/products/h310-ts380c-triaxial.png',
    cropBox: '165 78 838 1086',
    i18n: { zh: highZh, es: highEs, de: highDe, ja: highJa, fr: highFr, ru: highRu },
  },
  medium: {
    content: mediumContent, groups: mediumGroups, ui: ui.medium, image: mediumImage,
    slug: 'triaxial-medium-precision-tilt-sensor',
    publicImage: '/images/products/h310-ts350m-triaxial.png',
    cropBox: '325 298.125 623.125 686.25',
    i18n: { zh: mediumZh, es: mediumEs, de: mediumDe, ja: mediumJa, fr: mediumFr, ru: mediumRu },
  },
};
const { variant = 'high', locale = 'en' } = Astro.props as { variant?: string; locale?: Locale };
const config = REGISTRY[variant];
if (!config) throw new Error(`Unknown triaxial variant: ${variant}`);
const isEn = locale === 'en';
const pack = isEn ? null : config.i18n[locale];
if (!isEn && !pack) throw new Error(`Missing ${variant} triaxial locale data: ${locale}`);
const prefix = isEn ? '' : `/${locale}`;
const path = `${prefix}/product/${config.slug}`;
const content = pack?.content ?? config.content;
const groups = pack?.groups ?? config.groups;
const pageUi = pack?.ui ?? config.ui;
const applicationUi = pack?.applicationUi ?? config.ui.applications;
const dict = TILT_DICTS[locale] ?? TILT_DICTS.en;
const t = { ...dict, ...pageUi, js: { ...dict.js, ...pageUi.js } };
const optimized = await getImage({ src: config.image, width: 1280, format: 'webp', quality: 88 });
const hero = { src: optimized.src, width: config.image.width, height: config.image.height };
const imageUrl = new URL(config.publicImage, Astro.site).href;
// 七语路由均已上线：语言菜单/hreflang 指向同型号各语言产品页（URL 不加 .html）
const allLocales: Locale[] = ['en','zh','es','de','ja','fr','ru'];
const langTargets = Object.fromEntries(allLocales.map((loc) => [loc, `${loc === 'en' ? '' : `/${loc}`}/product/${config.slug}`]));
---
<BaseLayout locale={locale} title={content.seo.title} description={content.seo.description}
  keywords={content.seo.keywords} preloadImage={hero.src} socialImage={config.publicImage}
  langOverrides={langTargets}>
  <TriaxialStructuredData slot="head" content={content} t={t} canonicalPath={path} imageUrl={imageUrl} inLanguage={htmlLang[locale]}/>
  <TriaxialBody content={content} t={t} groups={groups} headings={pageUi.headings}
    hero={hero} cropBox={config.cropBox} canonicalPath={path} applicationUi={applicationUi} locale={locale} prefix={prefix}/>
</BaseLayout>
