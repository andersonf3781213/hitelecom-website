---
import '../../styles/gateway.css';
import '../../styles/station-i18n.css';
const { content:c, ui:u, locale='en' }=Astro.props;
const split=(s)=>String(s).split(/\n|\\n/);
const local=(path)=>{ if(!path.startsWith('/')||path.startsWith('//')) return path; const base=path.replace(/^\/(?:zh|es|de|ja|fr|ru)(?=\/)/,''); return (locale==='en'?'':'/'+locale)+base; };
const photo=(g)=>'/assets/'+g.imageKey+'.webp';
const icons=['M4 13a8 8 0 0 1 16 0M7 13a5 5 0 0 1 10 0M10 13a2 2 0 0 1 4 0M12 16v5','M5 19V9m5 10V5m5 14V2m5 17V7','M4 5h16v14H4zM4 9h16M8 13h3m3 0h3M8 16h8','M12 2 3 6v6c0 5 9 10 9 10s9-5 9-10V6zM8 12l3 3 5-6','M4 12h16M12 4v16M5 5l14 14M5 19 19 5','M4 18l4-7 5 4 7-11M16 4h4v4','M3 4h18v6H3zM3 14h18v6H3zM7 7h1m-1 10h1','M13 2 5 14h6l-1 8 9-13h-7z'];
---
<main id="main" class="ht-gateway" data-model={c.model}>
<div class="hero-band">
<img class="hero-background" src="/assets/sensor-hero-background.webp" width="1920" height="1090" alt="" aria-hidden="true" loading="eager" decoding="async"/>
<div class="wrap breadcrumb" aria-label={u.breadcrumbAria}><a href={local('/')}>{u.home}</a><span>/</span><a href={local('/product/lists/cid/256#cate')}>{u.customCatalog}</a><span>/</span><span>{u['productName'+c.model]}</span></div>
<section class="hero wrap" aria-labelledby="hero-title">
<div class="hero-heading"><h1 id="hero-title">{split(c.heroHeading).map((line,i)=><Fragment>{i>0&&<br/>}{line}</Fragment>)}<br/><span>{split(c.heroValue).map((line,i)=><Fragment>{i>0&&<br/>}{line}</Fragment>)}</span></h1></div>
<figure class="hero-visual gateway-product"><img src={'/assets/'+c.image} width={c.imageWidth} height={c.imageHeight} alt={c.imageAlt} fetchpriority="high" loading="eager" decoding="async"/><figcaption><span class="live-dot" aria-hidden="true"></span>{c.caption}</figcaption></figure>
<p class="hero-description">{c.heroDescription}</p>
<div class="hero-actions"><a href="#enquiry" class="button button-primary">{u.discussProject} <span aria-hidden="true">↗</span></a><a href="#specifications" class="text-link">{u.viewSpecifications} <span aria-hidden="true">↗</span></a></div>
<div class="hero-proof">{c.proof.map(x=><div><strong>{x.value}</strong><span>{x.label}</span><small>{x.note}</small></div>)}</div>
</section></div>
<nav class="section-nav" aria-label={u.pageNavAria}><div class="wrap"><a href="#network">{u.networkNav}</a><a href="#applications">{u.applicationsNav}</a><a href="#specifications">{u.specificationsNav}</a><a href="#integration">{u.integrationNav}</a><a href="#faq">{u.faqNav}</a><a href="#enquiry" class="nav-quote">{u.requestQuote} ↗</a></div></nav>
<section class="section features-section" id="features"><div class="wrap"><div class="section-heading compact-heading"><div><p class="eyebrow">{u.featuresEyebrow}</p><h2>{split(c.featureTitle).map((l,i)=><Fragment>{i>0&&<br/>}{i===0?l:<span>{l}</span>}</Fragment>)}</h2></div><p>{c.featureIntro}</p></div><div class="feature-grid">{c.features.map((f,i)=><article><span class="feature-mark" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={icons[i]}/></svg></span><h3>{f.title}</h3><p>{f.text}</p></article>)}</div></div></section>
<section class="section measurement-section" id="network"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{u.networkEyebrow}</p><h2>{split(u.networkHeading).map((l,i)=><Fragment>{i>0&&<br/>}{i===0?l:<span>{l}</span>}</Fragment>)}</h2></div><p>{c.planningIntro}</p></div><div class="measurement-grid">{c.planning.map((p,i)=><article class="measurement-card"><div class="measurement-heading"><span class="measurement-number">0{i+1}</span><span class="measurement-symbol" aria-hidden="true">↗</span></div><h3>{p.title}</h3><p>{p.text}</p><dl><dt>{u.planNetwork}</dt><dd>{p.brief}</dd></dl><a class="text-link" href="#enquiry">{u.discussNetwork} ↗</a></article>)}</div><div class="installation-note"><span class="small-label">{u.installationEyebrow}</span><h3>{split(u.installationHeading).map((l,i)=><Fragment>{i>0&&<br/>}{l}</Fragment>)}</h3><p>{c.installationText}</p></div></div></section>
<section class="section profile-section" id="operating-profile"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{u.workflowEyebrow}</p><h2>{split(u.workflowHeading).map((l,i)=><Fragment>{i>0&&<br/>}{l}</Fragment>)}</h2></div><p>{u.workflowIntro}</p></div><div class="gateway-workflow">{c.workflow.map((x,i)=><article><span class="step-number">0{i+1}</span><h3>{x.title}</h3><p>{x.text}</p></article>)}</div><div class="profile-note"><div><span class="small-label">{u.coverageEyebrow}</span><strong>{split(c.coverageTitle).map((l,i)=><Fragment>{i>0&&<br/>}{l}</Fragment>)}</strong></div><p>{c.coverageText}</p></div></div></section>
<section class="section application-section" id="applications"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{u.applicationsEyebrow}</p><h2>{split(c.applicationsHeading).map((l,i)=><Fragment>{i>0&&<br/>}{i===0?l:<span>{l}</span>}</Fragment>)}</h2></div><p>{c.applicationsIntro}</p></div><div class="application-overview"><p>{u.categoryCount.split('{count}').map((part,i)=><Fragment>{i>0&&<strong>{c.groups.length}</strong>}{part}</Fragment>)} <span>/</span> {u.taskCount.split('{count}').map((part,i)=><Fragment>{i>0&&<strong>{c.groups.reduce((n,g)=>n+g.tasks.length,0)}</strong>}{part}</Fragment>)}</p><p class="image-note">{u.imageNote}</p></div><nav class="application-jump-nav" aria-label={u.applicationsAria}>{c.groups.map(g=><a href={'#group-'+g.id}>{g.jumpLabel}<span>{g.tasks.length}</span></a>)}</nav><div class="application-groups">{c.groups.map((g,i)=><details class="application-group" id={'group-'+g.id} open={i===0}><summary><span><small>{String(i+1).padStart(2,'0')}</small>{g.title}</span><span class="group-count">{u.taskCount.replace('{count}',String(g.tasks.length))} <b aria-hidden="true">+</b></span></summary><div class="application-category-body"><div class="application-visual"><div class="application-media-slot"><figure class="application-category-photo"><img class="application-category-image" src={photo(g)} width="960" height="640" alt={g.imageAlt} loading="lazy" decoding="async"/><figcaption>{g.imageCaption}</figcaption></figure></div><p>{g.intro}</p></div><div class="application-task-list">{g.tasks.map((t,j)=><details class="application-task" id={t.id} open={i===0&&j===0}><summary aria-controls={'scene-photo-'+t.id}><span class="task-heading"><h3>{t.title}</h3><small>{t.networkRole}</small></span><span class="task-toggle" aria-hidden="true">+</span></summary><div class="task-copy"><figure class="application-scene-photo" id={'scene-photo-'+t.id} data-scene-owner={t.id}><img class="application-scene-image" src={photo(g)} width="960" height="640" alt={g.imageAlt} loading="lazy" decoding="async"/><figcaption>{g.imageCaption}</figcaption></figure><p>{t.description}</p><dl><dt>{u.gatewayRole}</dt><dd>{t.networkRole}</dd><dt>{u.deploymentConsiderations}</dt><dd>{t.placement}</dd><dt>{u.projectDetails}</dt><dd>{t.projectBrief}</dd></dl><a href="#enquiry" class="task-cta" data-project-scene={t.title}>{u.discussApplication} <span aria-hidden="true">↗</span></a></div></details>)}</div></div></details>)}</div></div></section>
<section class="section specifications-section" id="specifications"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{u.specsEyebrow}</p><h2>{split(u.specsHeading).map((l,i)=><Fragment>{i>0&&<br/>}{i===0?l:<span>{l}</span>}</Fragment>)}</h2></div><p>{u.specsIntro}</p></div><div class="gateway-spec-grid"><aside class="model-card"><span class="small-label">{u['productName'+c.model]}</span><h3>{split(u.specCardHeading).map((l,i)=><Fragment>{i>0&&<br/>}{l}</Fragment>)}</h3><p>{c.specNote}</p><a href="#enquiry" class="button button-outline">{u.configurationProposal} ↗</a><a class="text-link" href={c.datasheet} type="application/pdf" hreflang="en" title={u.englishDatasheetNote}>{u.requestDatasheet} ↗</a></aside><div class="spec-table"><table><caption>{u['tableCaption'+c.model]}</caption><tbody>{c.rows.map(([label,value])=><tr><th scope="row">{label}</th><td>{value}</td></tr>)}</tbody></table></div></div><div class="selection-list"><h3>{u.selectionHeading}</h3><div>{['Sensor','Install','System'].map((type,i)=><article><span class="step-number">0{i+1}</span><h4>{u['selection'+type+'Title']}</h4><p>{u['selection'+type+'Text']}</p></article>)}</div></div></div></section>
<section class="section integration-section" id="integration"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{u.integrationEyebrow}</p><h2>{split(u.integrationHeading).map((l,i)=><Fragment>{i>0&&<br/>}{i===0?l:<span>{l}</span>}</Fragment>)}</h2></div><p>{u.integrationIntro}</p></div><div class="integration-grid"><article><span class="small-label">{u.cloudLabel}</span><h3>{u.cloudHeading}</h3><div class="route-flow"><span>{u.flowDataSource}</span><b>→</b><span>{c.model}</span><b>→</b><span>{u.cloudName}</span></div><p>{u.cloudText}</p><ul><li>{u.cloudBullet1}</li><li>{u.cloudBullet2}</li><li>{u.cloudBullet3}</li></ul></article><article><span class="small-label">{u.customerLabel}</span><h3>{u.customerHeading}</h3><div class="route-flow"><span>{u.sensorRecords}</span><b>→</b><span>MQTT</span><b>→</b><span>{u.yourPlatform}</span></div><p>{u.customerText}</p><ul><li>{u.customerBullet1}</li><li>{u.customerBullet2}</li><li>{u.customerBullet3}</li></ul></article></div><div class="integration-handover"><h3>{u.handoverHeading}</h3><p>{u.handoverText}</p><a class="text-link" href="#enquiry">{u.discussIntegration} ↗</a></div></div></section>
<section class="section faq-section" id="faq"><div class="wrap faq-layout"><div class="faq-intro"><p class="eyebrow">{u.faqEyebrow}</p><h2>{split(u.faqHeading).map((l,i)=><Fragment>{i>0&&<br/>}{l}</Fragment>)}</h2><p>{u.faqIntro}</p><a href="#enquiry" class="text-link">{u.askProject} ↗</a></div><div class="faq-list">{c.faqs.map((f,i)=><details id={'faq-'+(i+1)} open={i===0}><summary>{f.q}<span aria-hidden="true">+</span></summary><div class="faq-answer"><p>{f.a}</p></div></details>)}</div></div></section>
<section class="section enquiry-section" id="enquiry"><div class="wrap enquiry-layout"><div class="enquiry-intro"><p class="eyebrow">{u.enquiryEyebrow}</p><h2>{split(u.enquiryHeading).map((l,i)=><Fragment>{i>0&&<br/>}{i===0?l:<span>{l}</span>}</Fragment>)}</h2><p class="lead">{u.enquiryIntro.replace('{model}',c.model)}</p><a class="contact-email" href="mailto:sales@hitelecom.cn">sales@hitelecom.cn ↗</a><div class="enquiry-benefits"><h3>{u.enquiryBenefitsHeading}</h3><p>{u.enquiryBenefitsText}</p></div></div><form id="enquiry-form" action="mailto:sales@hitelecom.cn" method="post" enctype="text/plain"><div class="form-heading"><span class="small-label">{u.formEyebrow}</span><h3>{u.formHeading}</h3><p>{u['productName'+c.model]}</p></div><div class="form-fields"><input type="hidden" name="Model" value={c.model}/><div class="field"><label for="application">{u.applicationLabel}</label><select id="application" name="Application" required><option value="">{u.applicationPlaceholder}</option>{c.groups.map(g=><optgroup label={g.title}>{g.tasks.map(t=><option value={t.title}>{t.title}</option>)}</optgroup>)}<option>{u.applicationOther}</option></select></div><div class="field"><label for="country">{u.countryLabel}</label><input id="country" name="Country" required autocomplete="country-name" maxlength="100" placeholder={u.countryPlaceholder}/></div><div class="field"><label for="device-count">{u.sensorCountLabel}</label><input id="device-count" name="Sensor count" type="number" min="1" step="1" inputmode="numeric" placeholder={u.sensorCountPlaceholder}/></div><div class="field"><label for="quantity">{u.quantityLabel}</label><input id="quantity" name="Gateway quantity" type="number" min="1" step="1" inputmode="numeric" placeholder={u.pleaseAdvise}/></div><div class="field full"><label for="sensors">{u.sensorModelsLabel}</label><input id="sensors" name="Sensor models and reporting" maxlength="800" placeholder={u.sensorModelsPlaceholder}/></div><div class="field full"><label for="platform">{u.platformLabel}</label><input id="platform" name="Backhaul and platform" maxlength="800" placeholder={u.platformPlaceholder}/></div><div class="field full"><label for="requirements">{u.requirementsLabel}</label><textarea id="requirements" name="Requirements" rows="4" maxlength="3000" placeholder={u.requirementsPlaceholder}></textarea></div></div><div class="form-actions"><button type="submit" class="button button-primary">{u.prepareEnquiry} ↗</button><p>{u.reviewHint}</p></div><div class="enquiry-review" id="enquiry-review" hidden><label for="enquiry-brief">{u.briefLabel}</label><textarea id="enquiry-brief" rows="10" spellcheck="false"></textarea><div><a class="button button-primary" id="email-brief" href="mailto:sales@hitelecom.cn">{u.openEmail} ↗</a><button type="button" id="copy-brief" class="button button-outline">{u.copyBrief}</button></div><p id="brief-status" role="status" aria-live="polite"></p></div><noscript><p class="noscript-note">{u.directEmailIntro} <a href={'mailto:sales@hitelecom.cn?subject='+encodeURIComponent(u.emailSubject.replace('{model}',c.model))}>{u.directEmailLink}</a>.</p></noscript></form></div></section>
<div class="wrap related-products"><p class="small-label">{u.relatedEyebrow}</p><a href={local(c.relatedPath)}>{c.relatedLabel} ↗</a><a href={local('/product/lists/cid/261#cate')}>{u.exploreSensors} ↗</a><a href={local('/product/temperature-sensor')}>{u.temperatureMonitoring} ↗</a></div>
</main>
<script id="station-ui" type="application/json" set:html={JSON.stringify(u).replace(/</g,'\\u003c')}></script>
<script>import './station-interactions.js';</script>
