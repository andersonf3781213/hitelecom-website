---
import content from '../../data/water-leak-content.json';
import FeatureIcon from './FeatureIcon.astro';
import ImageCaption from './ImageCaption.astro';
import { getImage } from 'astro:assets';
import heroBackground from '../../assets/brand/sensor-hero-background.jpg';
import { waterLeakImage } from './images.mjs';
const hero = await waterLeakImage('product-hero.png', true);
const widths = [640,1280,1920];
const backgrounds = await Promise.all(widths.map(width=>getImage({src:heroBackground,width,format:'webp',quality:78})));
const groups = await Promise.all(content.groups.map(async group=>({...group,asset:await waterLeakImage(group.image.name),tasks:await Promise.all(content.applications.filter(scene=>scene.group===group.id).map(async scene=>({...scene,image:scene.image||group.image,asset:await waterLeakImage((scene.image||group.image).name)})))})));
const email = content.inquiry.email;
const detectionSymbols = { point:'◉', path:'↔', response:'↗' };
---
<div class="ht-water-leak">
  <div class="hero-band">
    <img class="hero-background" src={backgrounds[2].src} srcset={backgrounds.map((x,i)=>`${x.src} ${widths[i]}w`).join(', ')} sizes="100vw" width={heroBackground.width} height={heroBackground.height} alt="" aria-hidden="true" loading="eager" decoding="async" />
    <div class="wrap breadcrumb" aria-label="Breadcrumb"><a href="https://www.hitelecom.com">Home</a><span aria-hidden="true">/</span><a href="https://www.hitelecom.com/product/lists/cid/261#cate">IoT sensors</a><span aria-hidden="true">/</span><span>Water leak sensor</span></div>
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-heading"><h1 id="hero-title">{content.hero.h1}<span>{content.hero.value_heading}</span></h1></div>
      <figure class="hero-visual water-leak-product">
        <img src={hero.src} srcset={hero.srcset} sizes="(max-width: 600px) 350px, (max-width: 1024px) 64vw, 760px" width={hero.width} height={hero.height} alt={content.hero.image_alt} loading="eager" fetchpriority="high" decoding="async" />
        <figcaption>{content.hero.image_caption}</figcaption>
      </figure>
      <p class="hero-description">{content.hero.description}</p>
      <div class="hero-actions"><a href="#enquiry" class="button button-primary">{content.hero.primary_cta} <span aria-hidden="true">↗</span></a><a href="#enquiry" class="text-link" data-enquiry-reason="Please send model-specific details and supporting documentation for my water leak project.">{content.hero.secondary_cta} <span aria-hidden="true">↗</span></a></div>
      <div class="hero-proof">{content.hero.quick_points.map(point=><div><strong>{point.value}</strong><span>{point.label}</span><small>{point.text}</small></div>)}</div>
    </section>
  </div>
  <nav class="section-nav" aria-label="On this page"><div class="wrap"><a href="#measurement">Detection</a><a href="#applications">Applications</a><a href="#specifications">Specifications</a><a href="#integration">Integration</a><a href="#faq">FAQ</a><a class="nav-quote" href="#enquiry">Request a quote ↗</a></div></nav>

  <section class="section features-section" id="features" aria-labelledby="features-title"><div class="wrap">
    <div class="section-heading compact-heading"><div><p class="eyebrow">{content.featureHeading.eyebrow}</p><h2 id="features-title">{content.featureHeading.heading}</h2></div><p>{content.featureHeading.description}</p></div>
    <div class="feature-grid">{content.features.map((feature,index)=><article><span class="feature-mark" aria-hidden="true"><FeatureIcon index={index}/></span><h3>{feature.title}</h3><p>{feature.text}</p></article>)}</div>
  </div></section>

  <section class="section measurement-section" id="measurement" aria-labelledby="measurement-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{content.measurement.eyebrow}</p><h2 id="measurement-title">{content.measurement.heading}</h2></div><p>{content.measurement.description}</p></div>
    <div class="measurement-grid">{content.measurement.cards.map((item,index)=><article class="measurement-card"><div class="measurement-heading"><span class="measurement-number">0{index+1}</span><span class="measurement-symbol" aria-hidden="true">{detectionSymbols[item.symbol] || '↗'}</span></div><h3>{item.title}</h3><p>{item.text}</p><dl><dt>Define the detection layout</dt><dd>{item.project_brief}</dd></dl><a href="#enquiry" class="text-link" data-measurement={item.title}>Discuss this layout ↗</a></article>)}</div>
    <div class="installation-note"><span class="small-label">DETECTION & INSTALLATION</span><h3>{content.measurement.installation_heading}</h3><p>{content.measurement.installation_text}</p></div>
  </div></section>

  <section class="section profile-section" id="operating-profile" aria-labelledby="profile-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{content.workflow.eyebrow}</p><h2 id="profile-title">{content.workflow.heading}</h2></div><p>{content.workflow.profile_text}</p></div>
    <div class="water-leak-workflow">{content.workflow.steps.map(step=><article><span class="step-number">{step.number}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div>
    <div class="profile-note"><div><span class="small-label">{content.workflow.profile_note_label}</span><strong>{content.workflow.profile_note_heading}</strong></div><p>{content.workflow.profile_note_text}</p></div>
  </div></section>

  <section class="section application-section" id="applications" aria-labelledby="applications-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">APPLICATIONS</p><h2 id="applications-title">{content.applicationSection.title}<br/><span>{content.applicationSection.valueHeading}</span></h2></div><p>{content.applicationSection.description}</p></div>
    <div class="application-overview"><p><strong>{content.groups.length}</strong> industry categories <span aria-hidden="true">/</span> <strong>{content.applications.length}</strong> monitoring tasks</p><p class="image-note">{content.applicationSection.note}</p></div>
    <nav class="application-jump-nav" aria-label="Browse water leak applications">{content.groups.map(group=><a href={'#group-'+group.id}>{group.jumpLabel}<span>{group.scenes.length}</span></a>)}</nav>
    <div class="application-groups">{groups.map((group,index)=><details class="application-group" id={'group-'+group.id} open={index===0}>
      <summary><span><small>0{index+1}</small>{group.title}</span><span class="group-count">{group.scenes.length} monitoring tasks <b aria-hidden="true">+</b></span></summary>
      <div class="application-category-body">
        <div class="application-visual"><div class="application-media-slot"><figure class="application-category-photo"><img class="application-category-image" src={group.asset.src} srcset={group.asset.srcset} sizes="(max-width: 600px) calc(100vw - 76px), (max-width: 900px) calc((100vw - 132px) * .42), 470px" width={group.asset.width} height={group.asset.height} loading="lazy" decoding="async" alt={group.image.alt} style={'object-position:'+group.image.focalPoint}/><ImageCaption image={group.image}/></figure></div><p>{group.intro}</p></div>
        <div class="application-task-list">{group.tasks.map((scene,taskIndex)=><details class="application-task" id={scene.id} open={index===0&&taskIndex===0}>
          <summary aria-controls={'scene-photo-'+scene.id}><span class="task-heading"><h3>{scene.title}</h3><small>{scene.measurement}</small></span><span class="task-toggle" aria-hidden="true">+</span></summary>
          <div class="task-copy"><figure class="application-scene-photo" id={'scene-photo-'+scene.id} data-scene-owner={scene.id}><img class="application-scene-image" src={scene.asset.src} srcset={scene.asset.srcset} sizes="(max-width: 600px) calc(100vw - 76px), (max-width: 900px) calc((100vw - 132px) * .42), 470px" width={scene.asset.width} height={scene.asset.height} loading="lazy" decoding="async" alt={scene.image.alt} style={'object-position:'+scene.image.focalPoint}/><ImageCaption image={scene.image}/></figure><p>{scene.description}</p><dl><dt>What to detect</dt><dd>{scene.measurement}</dd><dt>Detection point</dt><dd>{scene.monitoringPoint}</dd><dt>Installation approach</dt><dd>{scene.installation}</dd><dt>Specify for your project</dt><dd>{scene.projectBrief}</dd></dl><a href="#enquiry" class="task-cta" data-project-scene={scene.title} data-detection-point={scene.monitoringPoint}>Discuss this application <span aria-hidden="true">↗</span></a></div>
        </details>)}</div>
      </div>
    </details>)}</div>
  </div></section>

  <section class="section specifications-section" id="specifications" aria-labelledby="specifications-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{content.series.eyebrow}</p><h2 id="specifications-title">{content.series.heading}</h2></div><p>{content.series.description}</p></div>
    <div class="water-leak-series">{content.series.models.map(model=><article id={'model-'+model.family.toLowerCase()}><span class="small-label">{model.connectivity}</span><h3>{model.family}</h3>{model.partNumber&&<p class="model-part-number">{model.partNumber}</p>}<p>{model.description}</p><a href="#enquiry" class="text-link" data-model={model.family} data-connectivity={model.connectivity}>Discuss this configuration ↗</a></article>)}</div>
    <div class="water-leak-spec-grid"><aside class="model-card"><span class="small-label">{content.specifications.eyebrow}</span><h3>{content.specifications.heading}</h3><p>{content.specifications.description}</p><a href="#enquiry" class="button button-outline" data-enquiry-reason="Please send model-specific details and supporting documentation for my water leak project.">{content.specifications.datasheet_label} ↗</a><a href="#enquiry" class="text-link">Get a configuration proposal ↓</a></aside><div class="spec-table"><table><caption>H Series wireless water leak sensors — model and configuration reference</caption><tbody>{content.specifications.rows.map(row=><tr><th scope="row">{row.label}</th><td>{row.value}</td></tr>)}</tbody></table></div></div>
    <div class="selection-list"><h3>Specify the detection point and the response.</h3><div>{content.series.steps.map((step,index)=><article><span class="step-number">0{index+1}</span><h4>{step.title}</h4><p>{step.text}</p></article>)}</div></div>
  </div></section>

  <section class="section integration-section" id="integration" aria-labelledby="integration-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">CONNECTIVITY & INTEGRATION</p><h2 id="integration-title">{content.workflow.platform_title}</h2></div><p>{content.workflow.platform_text}</p></div>
    <div class="integration-grid"><article><span class="small-label">H300 · 4G / H500 · NB-IoT</span><h3>Connect distributed sites.</h3><div class="route-flow"><span>Detection point</span><b aria-hidden="true">→</b><span>Mobile network</span><b aria-hidden="true">→</b><span>Platform</span></div><p>Match the regional bands and operator coverage to the installation country. Check the signal where the transmitter will be installed, including plant rooms and below-ground locations.</p><ul><li>Country, operator and network availability</li><li>Device power and reporting requirements</li><li>Alert delivery and responsible recipients</li></ul></article><article><span class="small-label">H200 · LoRa</span><h3>Connect points across one site.</h3><div class="route-flow"><span>Detection points</span><b aria-hidden="true">→</b><span>Receiver / gateway</span><b aria-hidden="true">→</b><span>Platform</span></div><p>Match the supplied LoRa protocol and regional settings to the receiver or gateway. Confirm LoRaWAN compatibility explicitly when the project requires it.</p><ul><li>Device protocol and receiver compatibility</li><li>Coverage through walls, floors and equipment</li><li>Gateway power and onward connection</li></ul></article></div>
    <div class="integration-handover"><h3>Test the complete alert path.</h3><p>Identify each detection point in a sample message. Agree wet/dry state definitions, timestamps, device status and the supported event or reporting behavior. Test alert receipt and the site response before handover.</p><a href="#enquiry" class="text-link">Discuss platform integration ↗</a></div>
  </div></section>

  <section class="section faq-section" id="faq" aria-labelledby="faq-title"><div class="wrap faq-layout"><div class="faq-intro"><p class="eyebrow">{content.faqHeading.kicker}</p><h2 id="faq-title">{content.faqHeading.title}</h2><p>{content.faqHeading.intro}</p><a href="#enquiry" class="text-link">Ask about your project ↗</a></div><div class="faq-list">{content.faqs.map((faq,index)=><details id={faq.id} open={index===0}><summary>{faq.question}<span aria-hidden="true">+</span></summary><div class="faq-answer">{faq.paragraphs.map(paragraph=><p>{paragraph}</p>)}</div></details>)}</div></div></section>

  <section class="section enquiry-section" id="enquiry" aria-labelledby="enquiry-title"><div class="wrap enquiry-layout">
    <div class="enquiry-intro"><p class="eyebrow">{content.inquiry.eyebrow}</p><h2 id="enquiry-title">{content.inquiry.heading}</h2><p class="lead">{content.inquiry.description}</p><a class="contact-email" href={'mailto:'+email}>{email} ↗</a><div class="enquiry-benefits"><h3>A useful first conversation.</h3><p>{content.inquiry.supporting_text}</p></div></div>
    <form id="enquiry-form" action={'mailto:'+email} method="post" enctype="text/plain" data-enquiry-email={email}><div class="form-heading"><span class="small-label">PROJECT ENQUIRY</span><h3>Let’s find your configuration.</h3><p>H Series wireless water leak monitoring</p></div>
      <div class="form-fields">
        <div class="field"><label for="application">Application <span aria-hidden="true">*</span></label><select id="application" name="Application" required><option value="">Choose your application</option>{content.groups.map(group=><optgroup label={group.title}>{content.applications.filter(scene=>scene.group===group.id).map(scene=><option value={scene.title}>{scene.title}</option>)}</optgroup>)}<option>Other / project-specific</option></select></div>
        <div class="field"><label for="country">Country / region <span aria-hidden="true">*</span></label><input id="country" name="Country" required autocomplete="country-name" placeholder="e.g. United Kingdom" maxlength="100"/></div>
        <div class="field"><label for="model">Model family</label><select id="model" name="Model"><option value="">Please advise</option>{content.series.models.map(model=><option value={model.family}>{model.family} · {model.connectivity}{model.partNumber?' · '+model.partNumber:''}</option>)}</select></div>
        <div class="field"><label for="quantity">Estimated quantity</label><input id="quantity" name="Quantity" type="number" min="1" step="1" inputmode="numeric" placeholder="e.g. 20"/></div>
      </div>
      <details class="project-details"><summary>Detection and integration details <span>Optional</span></summary><div class="form-fields">
        <div class="field"><label for="water-source">Water source / liquid</label><input id="water-source" name="Water source" placeholder="e.g. Cooling water, condensate, roof ingress" maxlength="200"/></div>
        <div class="field"><label for="detection-layout">Detection layout</label><input id="detection-layout" name="Detection layout" placeholder="e.g. Tray low point or pipe route" maxlength="250"/></div>
        <div class="field"><label for="network">Preferred connectivity</label><select id="network" name="Connectivity"><option value="">Please advise</option><option>LoRa</option><option>4G</option><option>NB-IoT</option></select></div>
        <div class="field"><label for="alarm-platform">Alarm and platform</label><input id="alarm-platform" name="Alarm and platform" placeholder="Platform, recipients or required response" maxlength="250"/></div>
        <div class="field full"><label for="requirements">Project requirements</label><textarea id="requirements" name="Requirements" rows="3" maxlength="3000" placeholder={content.inquiry.message_placeholder}></textarea></div>
      </div></details>
      <div class="form-actions"><button type="submit" class="button button-primary">{content.inquiry.submit_label} ↗</button><p>{content.inquiry.mailto_note}</p></div><div id="enquiry-review" class="enquiry-review" hidden><label for="enquiry-brief">Your project brief</label><textarea id="enquiry-brief" rows="11" spellcheck="false"></textarea><div><a id="email-brief" class="button button-primary" href={'mailto:'+email}>Open email ↗</a><button id="copy-brief" type="button" class="button button-outline">Copy brief</button></div><p id="brief-status" role="status" aria-live="polite">Your brief is ready to review.</p></div><p class="noscript-note">You can also <a href={'mailto:'+email+'?subject=Water%20leak%20sensor%20project'}>email your project details directly</a>.</p>
    </form>
  </div></section>
  <div class="wrap related-products"><p class="small-label">CONTINUE YOUR MONITORING PROJECT</p><a href="https://www.hitelecom.com/product/lists/cid/261#cate">Explore all sensors ↗</a><a href="https://www.hitelecom.com/product/temperature-sensor">Temperature monitoring ↗</a><a href="https://www.hitelecom.com/product/liquid-level-sensor">Continuous liquid level measurement ↗</a></div>
</div>
<script>import './water-leak-interactions.js';</script>
