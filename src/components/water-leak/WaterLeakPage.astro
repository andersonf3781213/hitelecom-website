---
/**
 * 水浸传感器页内容组件 · 多语言（2026-10-16 V103）
 * 通过 props 注入 content/ui/prefix；EN 路由省略 props 时回退英文数据与词典，
 * 保证既有英文页零差异。ui 词典见 dicts.mjs（键 = 翻译包语义定位标识）。
 */
import contentEn from '../../data/water-leak-content.json';
import FeatureIcon from './FeatureIcon.astro';
import ImageCaption from './ImageCaption.astro';
import { getImage } from 'astro:assets';
import heroBackground from '../../assets/brand/sensor-hero-background.jpg';
import { waterLeakImage } from './images.mjs';
import { WL_UI, pickJs } from './dicts.mjs';
const { content = contentEn, ui = WL_UI.en, prefix = '' } = Astro.props;
const hero = await waterLeakImage('product-hero.png', true);
const widths = [640,1280,1920];
const backgrounds = await Promise.all(widths.map(width=>getImage({src:heroBackground,width,format:'webp',quality:78})));
const groups = await Promise.all(content.groups.map(async group=>({...group,asset:await waterLeakImage(group.image.name),tasks:await Promise.all(content.applications.filter(scene=>scene.group===group.id).map(async scene=>({...scene,image:scene.image||group.image,asset:await waterLeakImage((scene.image||group.image).name)})))})));
const email = content.inquiry.email;
// EN 保持包内绝对地址零差异；本地化路由使用前缀相对地址
const homeUrl = prefix ? prefix + '/' : 'https://www.hitelecom.com';
const listUrl = (prefix || 'https://www.hitelecom.com') + '/product/lists/cid/261#cate';
const temperatureUrl = (prefix || 'https://www.hitelecom.com') + '/product/temperature-sensor';
const levelUrl = (prefix || 'https://www.hitelecom.com') + '/product/liquid-level-sensor';
const detectionSymbols = { point:'◉', path:'↔', response:'↗' };
// 与温度页等其他传感器 V2 页一致：两行标题第二行包 <span>（灰色），
// 工作流与规格卡标题两行同色（仅 <br/>），全部语言共用此结构。
const br2 = (s) => s.split('\n');
const [featA, featB] = br2(content.featureHeading.heading);
const [measA, measB] = br2(content.measurement.heading);
const [wfA, wfB] = br2(content.workflow.heading);
const [serA, serB] = br2(content.series.heading);
const [specA, specB] = br2(content.specifications.heading);
const [intA, intB] = br2(content.workflow.platform_title);
const [enqA, enqB] = br2(content.inquiry.heading);
---
<div class="ht-water-leak" data-i18n={JSON.stringify(pickJs(ui))}>
  <div class="hero-band">
    <img class="hero-background" src={backgrounds[2].src} srcset={backgrounds.map((x,i)=>`${x.src} ${widths[i]}w`).join(', ')} sizes="100vw" width={heroBackground.width} height={heroBackground.height} alt="" aria-hidden="true" loading="eager" decoding="async" />
    <div class="wrap breadcrumb" aria-label={ui['breadcrumb.aria']}><a href={homeUrl}>{ui['breadcrumb.home']}</a><span aria-hidden="true">/</span><a href={listUrl}>{ui['breadcrumb.sensors']}</a><span aria-hidden="true">/</span><span>{ui['breadcrumb.product']}</span></div>
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-heading"><h1 id="hero-title">{content.hero.h1}<span>{content.hero.value_heading}</span></h1></div>
      <figure class="hero-visual water-leak-product">
        <img src={hero.src} srcset={hero.srcset} sizes="(max-width: 600px) 350px, (max-width: 1024px) 64vw, 760px" width={hero.width} height={hero.height} alt={content.hero.image_alt} loading="eager" fetchpriority="high" decoding="async" />
        <figcaption>{content.hero.image_caption}</figcaption>
      </figure>
      <p class="hero-description">{content.hero.description}</p>
      <div class="hero-actions"><a href="#enquiry" class="button button-primary">{content.hero.primary_cta} <span aria-hidden="true">↗</span></a><a href="#enquiry" class="text-link" data-enquiry-reason={ui['hero.enquiryReason']}>{content.hero.secondary_cta} <span aria-hidden="true">↗</span></a></div>
      <div class="hero-proof">{content.hero.quick_points.map(point=><div><strong>{point.value}</strong><span>{point.label}</span><small>{point.text}</small></div>)}</div>
    </section>
  </div>
  <nav class="section-nav" aria-label={ui['nav.aria']}><div class="wrap"><a href="#measurement">{ui['nav.detection']}</a><a href="#applications">{ui['nav.applications']}</a><a href="#specifications">{ui['nav.specifications']}</a><a href="#integration">{ui['nav.integration']}</a><a href="#faq">{ui['nav.faq']}</a><a class="nav-quote" href="#enquiry">{ui['nav.quote']}</a></div></nav>

  <section class="section features-section" id="features" aria-labelledby="features-title"><div class="wrap">
    <div class="section-heading compact-heading"><div><p class="eyebrow">{content.featureHeading.eyebrow}</p><h2 id="features-title">{featA}<br/><span>{featB}</span></h2></div><p>{content.featureHeading.description}</p></div>
    <div class="feature-grid">{content.features.map((feature,index)=><article><span class="feature-mark" aria-hidden="true"><FeatureIcon index={index}/></span><h3>{feature.title}</h3><p>{feature.text}</p></article>)}</div>
  </div></section>

  <section class="section measurement-section" id="measurement" aria-labelledby="measurement-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{content.measurement.eyebrow}</p><h2 id="measurement-title">{measA}<br/><span>{measB}</span></h2></div><p>{content.measurement.description}</p></div>
    <div class="measurement-grid">{content.measurement.cards.map((item,index)=><article class="measurement-card"><div class="measurement-heading"><span class="measurement-number">0{index+1}</span><span class="measurement-symbol" aria-hidden="true">{detectionSymbols[item.symbol] || '↗'}</span></div><h3>{item.title}</h3><p>{item.text}</p><dl><dt>{ui['measurement.layoutLabel']}</dt><dd>{item.project_brief}</dd></dl><a href="#enquiry" class="text-link" data-measurement={item.title}>{ui['measurement.cta']}</a></article>)}</div>
    <div class="installation-note"><span class="small-label">{ui['measurement.installationLabel']}</span><h3>{content.measurement.installation_heading}</h3><p>{content.measurement.installation_text}</p></div>
  </div></section>

  <section class="section profile-section" id="operating-profile" aria-labelledby="profile-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{content.workflow.eyebrow}</p><h2 id="profile-title">{wfA}<br/>{wfB}</h2></div><p>{content.workflow.profile_text}</p></div>
    <div class="water-leak-workflow">{content.workflow.steps.map(step=><article><span class="step-number">{step.number}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div>
    <div class="profile-note"><div><span class="small-label">{content.workflow.profile_note_label}</span><strong>{content.workflow.profile_note_heading}</strong></div><p>{content.workflow.profile_note_text}</p></div>
  </div></section>

  <section class="section application-section" id="applications" aria-labelledby="applications-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{ui['applications.eyebrow']}</p><h2 id="applications-title">{content.applicationSection.title}<br/><span>{content.applicationSection.valueHeading}</span></h2></div><p>{content.applicationSection.description}</p></div>
    <div class="application-overview"><p><strong>{content.groups.length}</strong> {ui['applications.categoryCountLabel']} <span aria-hidden="true">/</span> <strong>{content.applications.length}</strong> {ui['applications.taskCountLabel']}</p><p class="image-note">{content.applicationSection.note}</p></div>
    <nav class="application-jump-nav" aria-label={ui['applications.browseAria']}>{content.groups.map(group=><a href={'#group-'+group.id}>{group.jumpLabel}<span>{group.scenes.length}</span></a>)}</nav>
    <div class="application-groups">{groups.map((group,index)=><details class="application-group" id={'group-'+group.id} open={index===0}>
      <summary><span><small>0{index+1}</small>{group.title}</span><span class="group-count">{group.scenes.length} {ui['applications.taskCountLabel']} <b aria-hidden="true">+</b></span></summary>
      <div class="application-category-body">
        <div class="application-visual"><div class="application-media-slot"><figure class="application-category-photo"><img class="application-category-image" src={group.asset.src} srcset={group.asset.srcset} sizes="(max-width: 600px) calc(100vw - 76px), (max-width: 900px) calc((100vw - 132px) * .42), 470px" width={group.asset.width} height={group.asset.height} loading="lazy" decoding="async" alt={group.image.alt} style={'object-position:'+group.image.focalPoint}/><ImageCaption image={group.image} creditLabel={ui['image.creditLabel']}/></figure></div><p>{group.intro}</p></div>
        <div class="application-task-list">{group.tasks.map((scene,taskIndex)=><details class="application-task" id={scene.id} open={index===0&&taskIndex===0}>
          <summary aria-controls={'scene-photo-'+scene.id}><span class="task-heading"><h3>{scene.title}</h3><small>{scene.measurement}</small></span><span class="task-toggle" aria-hidden="true">+</span></summary>
          <div class="task-copy"><figure class="application-scene-photo" id={'scene-photo-'+scene.id} data-scene-owner={scene.id}><img class="application-scene-image" src={scene.asset.src} srcset={scene.asset.srcset} sizes="(max-width: 600px) calc(100vw - 76px), (max-width: 900px) calc((100vw - 132px) * .42), 470px" width={scene.asset.width} height={scene.asset.height} loading="lazy" decoding="async" alt={scene.image.alt} style={'object-position:'+scene.image.focalPoint}/><ImageCaption image={scene.image} creditLabel={ui['image.creditLabel']}/></figure><p>{scene.description}</p><dl><dt>{ui['applications.whatToDetect']}</dt><dd>{scene.measurement}</dd><dt>{ui['applications.detectionPoint']}</dt><dd>{scene.monitoringPoint}</dd><dt>{ui['applications.installationApproach']}</dt><dd>{scene.installation}</dd><dt>{ui['applications.projectBrief']}</dt><dd>{scene.projectBrief}</dd></dl><a href="#enquiry" class="task-cta" data-project-scene={scene.title} data-detection-point={scene.monitoringPoint}>{ui['applications.cta']} <span aria-hidden="true">↗</span></a></div>
        </details>)}</div>
      </div>
    </details>)}</div>
  </div></section>

  <section class="section specifications-section" id="specifications" aria-labelledby="specifications-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{content.series.eyebrow}</p><h2 id="specifications-title">{serA}<br/><span>{serB}</span></h2></div><p>{content.series.description}</p></div>
    <div class="water-leak-series">{content.series.models.map(model=><article id={'model-'+model.family.toLowerCase()}><span class="small-label">{model.connectivity}</span><h3>{model.family}</h3>{model.partNumber&&<p class="model-part-number">{model.partNumber}</p>}<p>{model.description}</p><a href="#enquiry" class="text-link" data-model={model.family} data-connectivity={model.connectivity}>{ui['series.cta']}</a></article>)}</div>
    <div class="water-leak-spec-grid"><aside class="model-card"><span class="small-label">{content.specifications.eyebrow}</span><h3>{specA}<br/>{specB}</h3><p>{content.specifications.description}</p><a href="#enquiry" class="button button-outline" data-enquiry-reason={ui['hero.enquiryReason']}>{content.specifications.datasheet_label} ↗</a><a href="#enquiry" class="text-link">{ui['specifications.proposal']}</a></aside><div class="spec-table"><table><caption>{ui['specifications.caption']}</caption><tbody>{content.specifications.rows.map(row=><tr><th scope="row">{row.label}</th><td>{row.value}</td></tr>)}</tbody></table></div></div>
    <div class="selection-list"><h3>{ui['series.selectionHeading']}</h3><div>{content.series.steps.map((step,index)=><article><span class="step-number">0{index+1}</span><h4>{step.title}</h4><p>{step.text}</p></article>)}</div></div>
  </div></section>

  <section class="section integration-section" id="integration" aria-labelledby="integration-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">{ui['integration.eyebrow']}</p><h2 id="integration-title">{intA}<br/><span>{intB}</span></h2></div><p>{content.workflow.platform_text}</p></div>
    <div class="integration-grid"><article><span class="small-label">H300 · 4G / H500 · NB-IoT</span><h3>{ui['integration.cellularHeading']}</h3><div class="route-flow"><span>{ui['integration.detectionPoint']}</span><b aria-hidden="true">→</b><span>{ui['integration.mobileNetwork']}</span><b aria-hidden="true">→</b><span>{ui['integration.platform']}</span></div><p>{ui['integration.cellularText']}</p><ul><li>{ui['integration.cellularChecklist1']}</li><li>{ui['integration.cellularChecklist2']}</li><li>{ui['integration.cellularChecklist3']}</li></ul></article><article><span class="small-label">H200 · LoRa</span><h3>{ui['integration.loraHeading']}</h3><div class="route-flow"><span>{ui['integration.detectionPoints']}</span><b aria-hidden="true">→</b><span>{ui['integration.gateway']}</span><b aria-hidden="true">→</b><span>{ui['integration.platform']}</span></div><p>{ui['integration.loraText']}</p><ul><li>{ui['integration.loraChecklist1']}</li><li>{ui['integration.loraChecklist2']}</li><li>{ui['integration.loraChecklist3']}</li></ul></article></div>
    <div class="integration-handover"><h3>{ui['integration.handoverHeading']}</h3><p>{ui['integration.handoverText']}</p><a href="#enquiry" class="text-link">{ui['integration.handoverCta']}</a></div>
  </div></section>

  <section class="section faq-section" id="faq" aria-labelledby="faq-title"><div class="wrap faq-layout"><div class="faq-intro"><p class="eyebrow">{content.faqHeading.kicker}</p><h2 id="faq-title">{content.faqHeading.title}</h2><p>{content.faqHeading.intro}</p><a href="#enquiry" class="text-link">{ui['faq.cta']}</a></div><div class="faq-list">{content.faqs.map((faq,index)=><details id={faq.id} open={index===0}><summary>{faq.question}<span aria-hidden="true">+</span></summary><div class="faq-answer">{faq.paragraphs.map(paragraph=><p>{paragraph}</p>)}</div></details>)}</div></div></section>

  <section class="section enquiry-section" id="enquiry" aria-labelledby="enquiry-title"><div class="wrap enquiry-layout">
    <div class="enquiry-intro"><p class="eyebrow">{content.inquiry.eyebrow}</p><h2 id="enquiry-title">{enqA}<br/><span>{enqB}</span></h2><p class="lead">{content.inquiry.description}</p><a class="contact-email" href={'mailto:'+email}>{email} ↗</a><div class="enquiry-benefits"><h3>{ui['inquiry.benefitsHeading']}</h3><p>{content.inquiry.supporting_text}</p></div></div>
    <form id="enquiry-form" action={'mailto:'+email} method="post" enctype="text/plain" data-enquiry-email={email}><div class="form-heading"><span class="small-label">{ui['inquiry.formEyebrow']}</span><h3>{ui['inquiry.formHeading']}</h3><p>{ui['inquiry.formDescription']}</p></div>
      <div class="form-fields">
        <div class="field"><label for="application">{ui['form.application']} <span aria-hidden="true">*</span></label><select id="application" name="Application" required><option value="">{ui['form.chooseApplication']}</option>{content.groups.map(group=><optgroup label={group.title}>{content.applications.filter(scene=>scene.group===group.id).map(scene=><option value={scene.title}>{scene.title}</option>)}</optgroup>)}<option>{ui['form.otherApplication']}</option></select></div>
        <div class="field"><label for="country">{ui['form.country']} <span aria-hidden="true">*</span></label><input id="country" name="Country" required autocomplete="country-name" placeholder={ui['form.countryPlaceholder']} maxlength="100"/></div>
        <div class="field"><label for="model">{ui['form.model']}</label><select id="model" name="Model"><option value="">{ui['form.pleaseAdvise']}</option>{content.series.models.map(model=><option value={model.family}>{model.family} · {model.connectivity}{model.partNumber?' · '+model.partNumber:''}</option>)}</select></div>
        <div class="field"><label for="quantity">{ui['form.quantity']}</label><input id="quantity" name="Quantity" type="number" min="1" step="1" inputmode="numeric" placeholder={ui['form.quantityPlaceholder']}/></div>
      </div>
      <details class="project-details"><summary>{ui['form.detailsSummary']} <span>{ui['form.optional']}</span></summary><div class="form-fields">
        <div class="field"><label for="water-source">{ui['form.waterSource']}</label><input id="water-source" name="Water source" placeholder={ui['form.waterSourcePlaceholder']} maxlength="200"/></div>
        <div class="field"><label for="detection-layout">{ui['form.detectionLayout']}</label><input id="detection-layout" name="Detection layout" placeholder={ui['form.layoutPlaceholder']} maxlength="250"/></div>
        <div class="field"><label for="network">{ui['form.connectivity']}</label><select id="network" name="Connectivity"><option value="">{ui['form.pleaseAdvise']}</option><option>LoRa</option><option>4G</option><option>NB-IoT</option></select></div>
        <div class="field"><label for="alarm-platform">{ui['form.alarmPlatform']}</label><input id="alarm-platform" name="Alarm and platform" placeholder={ui['form.alarmPlatformPlaceholder']} maxlength="250"/></div>
        <div class="field full"><label for="requirements">{ui['form.requirements']}</label><textarea id="requirements" name="Requirements" rows="3" maxlength="3000" placeholder={content.inquiry.message_placeholder}></textarea></div>
      </div></details>
      <div class="form-actions"><button type="submit" class="button button-primary">{content.inquiry.submit_label} ↗</button><p>{content.inquiry.mailto_note}</p></div><div id="enquiry-review" class="enquiry-review" hidden><label for="enquiry-brief">{ui['form.briefLabel']}</label><textarea id="enquiry-brief" rows="11" spellcheck="false"></textarea><div><a id="email-brief" class="button button-primary" href={'mailto:'+email}>{ui['form.openEmail']}</a><button id="copy-brief" type="button" class="button button-outline">{ui['form.copyBrief']}</button></div><p id="brief-status" role="status" aria-live="polite">{ui['form.initialBriefStatus']}</p></div><p class="noscript-note">{ui['form.noscriptBefore']} <a href={'mailto:'+email+'?subject='+encodeURIComponent(ui['form.noscriptEmailSubject'])}>{ui['form.noscriptLink']}</a>{ui['form.noscriptAfter']}</p>
    </form>
  </div></section>
  <div class="wrap related-products"><p class="small-label">{ui['related.eyebrow']}</p><a href={listUrl}>{ui['related.allSensors']}</a><a href={temperatureUrl}>{ui['related.temperature']}</a><a href={levelUrl}>{ui['related.level']}</a></div>
</div>
<script>import './water-leak-interactions.js';</script>
