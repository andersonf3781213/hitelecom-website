---
/**
 * 水浸传感器页结构化数据 · 多语言（2026-10-16 V103）
 * Organization 由 BaseLayout 全局输出，本组件统一引用 /#organization；
 * 用户可读实体名称、分类、面包屑、属性标签随 ui 词典本地化；
 * @type / 属性名保持标准英文。url/@id 指向本语言实际发布地址。
 */
import { WL_UI } from './dicts.mjs';
const {content,heroUrl,includeOrganization=true,ui=WL_UI.en,prefix='',inLanguage='en'} = Astro.props;
const url='https://www.hitelecom.com'+prefix+'/product/water-leakage-sensor';
const orgId='https://www.hitelecom.com/#organization';
// The user-supplied photograph shows the H300 configuration. Do not attribute
// this configuration-specific image to H200 or H500 variants.
const graph=[
 ...(includeOrganization?[{'@type':'Organization','@id':orgId,name:'Hitelecom',url:'https://www.hitelecom.com',email:'sales@hitelecom.cn'}]:[]),
 {'@type':'WebPage','@id':url+'#webpage',url,name:content.seo.title,description:content.seo.description,inLanguage,datePublished:'2026-10-16',dateModified:'2026-10-16',publisher:{'@id':orgId},mainEntity:{'@id':url+'#series'}},
 {'@type':'BreadcrumbList','@id':url+'#breadcrumb',itemListElement:[{'@type':'ListItem',position:1,name:ui['schema.breadcrumbHome'],item:prefix?'https://www.hitelecom.com'+prefix+'/':'https://www.hitelecom.com'},{'@type':'ListItem',position:2,name:ui['schema.breadcrumbSensors'],item:'https://www.hitelecom.com'+prefix+'/product/lists/cid/261#cate'},{'@type':'ListItem',position:3,name:ui['schema.breadcrumbProduct'],item:url}]},
 {'@type':'ProductGroup','@id':url+'#series',name:ui['schema.productGroupName'],description:content.hero.description,brand:{'@type':'Brand',name:'Hitelecom'},manufacturer:{'@id':orgId},image:heroUrl,url,category:ui['schema.category'],variesBy:'Wireless connectivity',hasVariant:content.series.models.map(model=>({'@id':url+'#model-'+model.family.toLowerCase()})),additionalProperty:content.specifications.rows.map(row=>({'@type':'PropertyValue',name:row.label,value:row.value}))},
 ...content.series.models.map(model=>({'@type':'Product','@id':url+'#model-'+model.family.toLowerCase(),name:ui['schema.productNameTemplate'].replace('{part}',model.partNumber||model.family).replace('{family}',model.family).replace('{connectivity}',model.connectivity),// 中文终稿要求 H300 实体 model 使用具体型号；其他语言保持 family+mpn 不变
 model:inLanguage==='zh'?(model.partNumber||model.family):model.family,...(model.partNumber?{mpn:model.partNumber}:{}),...(model.family==='H300'?{image:heroUrl}:{}),description:model.description,category:ui['schema.category'],brand:{'@type':'Brand',name:'Hitelecom'},manufacturer:{'@id':orgId},isVariantOf:{'@id':url+'#series'},url:url+'#model-'+model.family.toLowerCase(),additionalProperty:[{'@type':'PropertyValue',name:ui['schema.wirelessConnectivity'],value:model.connectivity},// 中文终稿已确认事实：采集周期可按客户要求设定
 ...(inLanguage==='zh'&&model.family==='H300'?[{'@type':'PropertyValue',name:'数据采集周期',value:'可按客户要求设定'}]:[])]})),
 {'@type':'FAQPage','@id':url+'#faq',inLanguage,mainEntity:content.faqs.map(faq=>({'@type':'Question',name:faq.question,acceptedAnswer:{'@type':'Answer',text:faq.paragraphs.join('\n\n')}}))}
];
---
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c')}/>
