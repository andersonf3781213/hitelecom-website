---
const {content,heroUrl,includeOrganization=true} = Astro.props;
const url='https://www.hitelecom.com/product/water-leakage-sensor';
const orgId='https://www.hitelecom.com/#organization';
// The user-supplied photograph shows the H300 configuration. Do not attribute
// this configuration-specific image to H200 or H500 variants.
const graph=[
 ...(includeOrganization?[{'@type':'Organization','@id':orgId,name:'Hitelecom',url:'https://www.hitelecom.com',email:'sales@hitelecom.cn'}]:[]),
 {'@type':'WebPage','@id':url+'#webpage',url,name:content.seo.title,description:content.seo.description,inLanguage:'en',datePublished:'2026-10-16',dateModified:'2026-10-16',publisher:{'@id':orgId},mainEntity:{'@id':url+'#series'}},
 {'@type':'BreadcrumbList','@id':url+'#breadcrumb',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://www.hitelecom.com'},{'@type':'ListItem',position:2,name:'IoT Sensors',item:'https://www.hitelecom.com/product/lists/cid/261#cate'},{'@type':'ListItem',position:3,name:'Water Leak Sensor',item:url}]},
 {'@type':'ProductGroup','@id':url+'#series',name:'Hitelecom H Series wireless water leak sensors',description:content.hero.description,brand:{'@type':'Brand',name:'Hitelecom'},manufacturer:{'@id':orgId},image:heroUrl,url,category:'Water leak sensors',variesBy:'Wireless connectivity',hasVariant:content.series.models.map(model=>({'@id':url+'#model-'+model.family.toLowerCase()})),additionalProperty:content.specifications.rows.map(row=>({'@type':'PropertyValue',name:row.label,value:row.value}))},
 ...content.series.models.map(model=>({'@type':'Product','@id':url+'#model-'+model.family.toLowerCase(),name:'Hitelecom '+model.family+' '+model.connectivity+' Water Leak Sensor',model:model.family,...(model.partNumber?{mpn:model.partNumber}:{}),...(model.family==='H300'?{image:heroUrl}:{}),description:model.description,category:'Water leak sensors',brand:{'@type':'Brand',name:'Hitelecom'},manufacturer:{'@id':orgId},isVariantOf:{'@id':url+'#series'},url:url+'#model-'+model.family.toLowerCase(),additionalProperty:[{'@type':'PropertyValue',name:'Wireless connectivity',value:model.connectivity}]})),
 {'@type':'FAQPage','@id':url+'#faq',inLanguage:'en',mainEntity:content.faqs.map(faq=>({'@type':'Question',name:faq.question,acceptedAnswer:{'@type':'Answer',text:faq.paragraphs.join('\n\n')}}))}
];
---
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c')}/>
