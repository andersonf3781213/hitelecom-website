---
import faq from '../data/warehouse-ops-faq.json';
import '../styles/warehouse-faq-v17.css';

// Visible answers and FAQPage structured data share a single source.
const canonical = 'https://www.hitelecom.com/solution/warehouse-monitoring';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': canonical + '#warehouse-faq',
  isPartOf: { '@id': canonical + '#webpage' },
  inLanguage: 'en',
  mainEntity: faq.items.map(item => ({
    '@type': 'Question',
    '@id': canonical + '#faq-' + item.id,
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
};
---

<section class="w7-section w17-faq" id="warehouse-faq" aria-labelledby="warehouse-faq-title">
  <div class="v2-wrap w17-faq-layout">
    <div class="w17-faq-heading">
      <p class="w7-eyebrow">PRACTICAL ANSWERS</p>
      <h2 id="warehouse-faq-title">Questions from<br/>warehouse teams.</h2>
      <a class="w17-faq-link" href="#enquiry">Discuss your rack monitoring<span aria-hidden="true">↗</span></a>
    </div>
    <div class="w17-faq-list">
      {faq.items.map(item => (
        <details id={'faq-' + item.id} data-faq-id={item.id}>
          <summary><span>{item.question}</span><i aria-hidden="true"></i></summary>
          <div class="w17-faq-answer" data-faq-answer><p>{item.answer}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
<script is:inline type="application/ld+json" data-warehouse-faq-schema set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}/>
