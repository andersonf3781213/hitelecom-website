---
interface Props { meta:{number:string;key:string;title:string;nextLabel:string;nextPath:string} }
const {meta}=Astro.props;
const warehouse=meta.number==='01';
---
<section class="scope-v2 v2-contact" id="enquiry" aria-labelledby="contact-title"><div class="v2-wrap v2-contact-grid"><div><p class="v2-eyebrow">BUILD THE MONITORING PLAN</p><h2 id="contact-title">{warehouse?'What does your warehouse need to monitor?':'Start with your asset and site conditions.'}</h2><p>{warehouse?'Tell us the warehouse type, goods and the problem you want to see more clearly. Share the layout and existing systems if available.':'Share the asset type, structural members, measurement objective, available references and site access. We will help define a suitable point plan and data route.'}</p><a class="v2-email" href="mailto:sales@hitelecom.cn">sales@hitelecom.cn <span aria-hidden="true">↗</span></a></div><div class="v2-contact-card"><h3>Prepare your project brief</h3><p>Review it, then send it with your email app.</p><form id="detail-enquiry-form" data-solution-name={meta.title.replace(' | Hitelecom','')} data-solution-key={meta.key}><fieldset disabled><div class="enquiry-fields"><label>Name *<input name="name" required autocomplete="name" maxlength="100"/></label><label>Company *<input name="company" required autocomplete="organization" maxlength="160"/></label><label class="full">Business email *<input name="email" type="email" required autocomplete="email" maxlength="180"/></label><label class="full">Installation country / region<input name="country" autocomplete="country-name" maxlength="100"/></label><label class="full">Project requirements *<textarea name="requirements" required rows="4" maxlength="3000" placeholder={warehouse?'The problem you want to monitor: rack tilt, storage conditions, leaks, equipment or personnel EHS…':'Asset type, points, angle / distance / water level, installation…'}></textarea></label></div><button type="submit" class="v2-button">Prepare my enquiry <span aria-hidden="true">↗</span></button><div id="brief-review" class="brief-review" hidden><label for="brief-text">Review or edit your brief</label><textarea id="brief-text" rows="9"></textarea><div><a id="brief-email" href="mailto:sales@hitelecom.cn">Open email draft ↗</a><button id="brief-copy" type="button">Copy brief</button></div><p id="brief-status" role="status"></p></div></fieldset><noscript><p>Send your requirements to <a href="mailto:sales@hitelecom.cn">sales@hitelecom.cn</a>.</p></noscript></form></div></div></section>
<aside class="scope-v2"><div class="v2-wrap v2-next"><span>EXPLORE ANOTHER SOLUTION</span><a href={meta.nextPath}>{meta.nextLabel}<span aria-hidden="true">↗</span></a></div></aside>
