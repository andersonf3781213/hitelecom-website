---
import ResponsiveImage from './solutions/ResponsiveImage.astro';
import images from '../data/images.json';
import content from '../data/infrastructure-v2.json';
import '../styles/infrastructure-v2.css';
const imageKey = (key: string) => key as keyof typeof images;
---
<div class="scope-v2 infrastructure-v2">
  <section class="infra-hero" aria-labelledby="infra-title">
    <ResponsiveImage imageKey={imageKey(content.meta.heroImage)} alt={content.meta.heroAlt} priority={true} sizes="100vw" class="infra-hero-photo" />
    <div class="infra-hero-shade"></div>
    <div class="v2-wrap infra-hero-content">
      <nav class="infra-breadcrumb" aria-label="Breadcrumb"><a href="https://www.hitelecom.com/solution">Solutions</a><span aria-hidden="true">/</span><span>02 · Infrastructure</span></nav>
      <p class="v2-eyebrow">HITELECOM / CONNECTED FIELD MONITORING</p>
      <h1 class="v2-title" id="infra-title">{'Infrastructure\nmonitoring.'}</h1>
      <p class="v2-lead infra-hero-lead">{content.lead}</p>
      <div class="infra-hero-actions"><a class="v2-button" href="#enquiry">Discuss your infrastructure <span aria-hidden="true">↗</span></a><a href="#infra-measurements">Explore monitoring duties <span aria-hidden="true">↓</span></a></div>
      <div class="infra-hero-bottom"><span>Structures · Water · Supporting equipment</span><span>Application illustration</span></div>
    </div>
  </section>

  <nav class="infra-asset-nav" aria-label="Infrastructure assets"><div class="v2-wrap"><span>CHOOSE THE ASSET</span><ul>{content.navigation.map(item=><li><a href={`#${item.id}`}>{item.name}<span aria-hidden="true">↘</span></a></li>)}</ul></div></nav>

  <section class="infra-duty-section" id="infra-measurements" aria-labelledby="infra-duty-title"><div class="v2-wrap">
    <div class="infra-section-heading"><div><p class="v2-eyebrow">DIFFERENT QUANTITIES. DIFFERENT DECISIONS.</p><h2 id="infra-duty-title">Choose what the point<br/>needs to tell you.</h2></div><p>A bridge bearing, a tunnel lining and a drainage chamber ask different questions. Select the measurement before specifying the device.</p></div>
    <div class="infra-duties">{content.duties.map(duty=><article><span class="infra-duty-symbol" aria-hidden="true">{duty.symbol}</span><h3>{duty.title}</h3><p>{duty.text}</p><span class="infra-device-label">{duty.device}</span></article>)}</div>
  </div></section>

  <section class="infra-bridge-section" id="bridges-walls" aria-labelledby="infra-bridge-title"><div class="v2-wrap">
    <div class="infra-section-heading"><div><p class="v2-eyebrow">ASSET / BRIDGES & WALLS</p><h2 id="infra-bridge-title">{content.bridge.title}</h2></div><p>{content.bridge.intro}</p></div>
    <div class="infra-point-pair">{content.bridge.points.map((point,index)=><article><div class="infra-point-top"><span>{index===0?'ANGLE AT THE MEMBER':'DISTANCE TO A TARGET'}</span><span aria-hidden="true">{index===0?'°':'↔'}</span></div><h3>{point.name}</h3><dl><div><dt>Point</dt><dd>{point.point}</dd></div><div><dt>Measurement</dt><dd>{point.measurement}</dd></div><div><dt>Field action</dt><dd>{point.action}</dd></div></dl><a class="infra-text-link" href={index===0?'https://www.hitelecom.com/product/tilt-sensor':'https://www.hitelecom.com/product/radar-distance-sensor'}>{index===0?'Explore tilt sensing':'Review a radar target project'}<span aria-hidden="true">↗</span></a></article>)}</div>
    <div class="infra-reference-note"><strong>REFERENCE-TARGET PROJECT</strong><p>Agree the target, measuring axis and reference arrangement. Verify return signal, working range and installed repeatability before interpreting structural movement.</p></div>
  </div></section>

  <section class="infra-underground-section" aria-label="Underground and rail infrastructure"><div class="v2-wrap">
    <figure class="infra-wide-photo"><ResponsiveImage imageKey={imageKey('tunnel-structure')} alt="Application illustration of a civil tunnel with visible lining segments and a protected service walkway" sizes="(max-width: 760px) 100vw, 1240px" /><figcaption>Tunnel application illustration · point locations and access follow the owner's monitoring plan.</figcaption></figure>
    <div class="infra-context-pair">
      <article id="tunnels" aria-labelledby="infra-tunnel-title"><p class="v2-eyebrow">ASSET / UNDERGROUND</p><h2 id="infra-tunnel-title">{content.tunnel.title}</h2><p class="infra-asset-intro">{content.tunnel.intro}</p><dl><div><dt>Point</dt><dd>{content.tunnel.point}</dd></div><div><dt>Measurement</dt><dd>{content.tunnel.measurement}</dd></div><div><dt>Field action</dt><dd>{content.tunnel.action}</dd></div></dl></article>
      <article id="rail-corridors" aria-labelledby="infra-rail-title"><p class="v2-eyebrow">ASSET / RAIL CORRIDORS</p><h2 id="infra-rail-title">{content.rail.title}</h2><p class="infra-asset-intro">{content.rail.intro}</p><dl><div><dt>Point</dt><dd>{content.rail.point}</dd></div><div><dt>Measurement</dt><dd>{content.rail.measurement}</dd></div><div><dt>Field action</dt><dd>{content.rail.action}</dd></div></dl></article>
    </div>
    <p class="infra-install-note">Underground installations need an assessed communication route. Structural target-distance projects require approved attachment, a clear observation path and the reference checks defined by the engineer.</p>
  </div></section>

  <section class="infra-slope-section" id="slopes-dams" aria-labelledby="infra-slope-title"><div class="v2-wrap infra-slope-layout"><div><p class="v2-eyebrow">ASSET / EARTHWORKS & WATER-RETAINING STRUCTURES</p><h2 id="infra-slope-title">{content.slope.title}</h2><p>{content.slope.intro}</p><div class="infra-scope-tags"><span>Selected structural point</span><span>Independent target reference</span><span>Separate water-level datum</span></div></div><dl><div><dt>Point</dt><dd>{content.slope.point}</dd></div><div><dt>Measurement</dt><dd>{content.slope.measurement}</dd></div><div><dt>Field action</dt><dd>{content.slope.action}</dd></div></dl></div></section>

  <section class="infra-drainage-section" id="drainage" aria-labelledby="infra-drainage-title"><div class="v2-wrap infra-drainage-layout">
    <figure class="infra-drainage-photo"><ResponsiveImage imageKey={imageKey('pipeline-level-blockage')} alt="Application illustration of a concrete culvert opening and exposed drainage-channel water" sizes="(max-width: 760px) 100vw, 50vw" /><figcaption>Application illustration · observe a defined surface from a documented reference.</figcaption></figure>
    <div class="infra-drainage-copy"><p class="v2-eyebrow">ASSET / DRAINAGE</p><h2 id="infra-drainage-title">{content.drainage.title}</h2><p class="infra-asset-intro">{content.drainage.intro}</p><div class="infra-drainage-points">{content.drainage.points.map(point=><article><h3>{point.name}</h3><dl><div><dt>Point</dt><dd>{point.point}</dd></div><div><dt>Measurement</dt><dd>{point.measurement}</dd></div><div><dt>Field action</dt><dd>{point.action}</dd></div></dl></article>)}</div><p class="infra-boundary">{content.drainage.boundary}</p><a class="infra-text-link" href="https://www.hitelecom.com/product/radar-distance-sensor">Explore radar level measurement<span aria-hidden="true">↗</span></a></div>
  </div></section>

  <section class="infra-poles-section" id="poles-towers" aria-labelledby="infra-poles-title"><div class="v2-wrap infra-poles-layout">
    <div><p class="v2-eyebrow">ASSET / DISTRIBUTED SUPPORTS</p><h2 id="infra-poles-title">{content.poles.title}</h2><p class="infra-asset-intro">{content.poles.intro}</p><dl><div><dt>Point</dt><dd>{content.poles.point}</dd></div><div><dt>Measurement</dt><dd>{content.poles.measurement}</dd></div><div><dt>Field action</dt><dd>{content.poles.action}</dd></div></dl><a class="infra-text-link" href="https://www.hitelecom.com/product/tilt-sensor">Explore wireless tilt sensors<span aria-hidden="true">↗</span></a></div>
    <figure class="infra-poles-photo"><ResponsiveImage imageKey={imageKey('pole-supports')} alt="Application illustration of street lighting poles and a freestanding sign support on a landscaped road" sizes="(max-width: 760px) 100vw, 45vw" /><figcaption>Roadside support application illustration.</figcaption></figure>
  </div></section>

  <section class="infra-response-section" aria-labelledby="infra-response-title"><div class="v2-wrap"><div class="infra-section-heading"><div><p class="v2-eyebrow">REVIEW THE EVENT. THEN THE ASSET.</p><h2 id="infra-response-title">Put the change<br/>in its site context.</h2></div><p>Keep environmental events, construction activity and maintenance alongside the measurement history for the points they affect.</p></div><ol class="infra-event-flow">{content.response.map((item,index)=><li><span>0{index+1}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></li>)}</ol></div></section>

  <section class="infra-extension-section" aria-labelledby="infra-extension-title"><div class="v2-wrap"><div class="infra-section-heading"><div><p class="v2-eyebrow">SUPPORTING SITE CONDITIONS</p><h2 id="infra-extension-title">Add monitoring<br/>around the asset.</h2></div><p>Include these tasks where the site needs them. Each has its own sensing, power, installation and response requirements.</p></div><div class="infra-extension-grid">{content.extensions.map(item=><details><summary>{item.name}<span aria-hidden="true">+</span></summary><div class="infra-extension-body"><p><strong>What to observe</strong>{item.measurement}</p><p><strong>What to select</strong>{item.selection}</p><a class="infra-text-link" href={item.url}>{item.link}<span aria-hidden="true">↗</span></a></div></details>)}</div></div></section>

  <section class="infra-handover-section" aria-labelledby="infra-handover-title"><div class="v2-wrap infra-handover-grid"><div><p class="v2-eyebrow">FIELD CONNECTION & HANDOVER</p><h2 id="infra-handover-title">Keep the point record<br/>connected to the owner.</h2></div><div><p><strong>Network.</strong> Match a 4G / NB-IoT or compatible LoRa route to the actual points. Confirm regional support, power, gateway backhaul and platform fields; review LoRaWAN explicitly where required.</p><p><strong>Pilot.</strong> Check mounting, reference repeatability, timestamps, scheduled reports and event delivery separately. Retain the accepted point schedule and inspection contacts.</p><a class="infra-text-link" href="#enquiry">Plan the monitoring configuration<span aria-hidden="true">↗</span></a></div></div></section>

  <section class="infra-faq-section" aria-labelledby="infra-faq-title"><div class="v2-wrap infra-faq-layout"><div><p class="v2-eyebrow">BEFORE THE SITE SURVEY</p><h2 id="infra-faq-title">Define the task.<br/>Confirm the method.</h2></div><div class="infra-faq-list">{content.faqs.map(item=><details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></div></section>
</div>
