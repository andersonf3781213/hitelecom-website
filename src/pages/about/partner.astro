---
/**
 * 关于我们 - 生态合作伙伴（英文）：/about/partner.html
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutShell from '../../components/about/AboutShell.astro';
import AboutPartner from '../../components/about/AboutPartner.astro';
import { contentImageSrc } from '../../utils/content';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hitelecom.com/' },
    { '@type': 'ListItem', position: 2, name: 'About', item: 'https://www.hitelecom.com/about.html' },
    { '@type': 'ListItem', position: 3, name: 'Ecological Partners', item: 'https://www.hitelecom.com/about/partner.html' },
  ],
};
const aboutBanner = (await contentImageSrc('/images/about/up_7428e98f9a91fcccdaa6c5ede77c3cc2.webp', 1920)) ?? undefined;
---

<BaseLayout
  preloadImage={aboutBanner}
  locale="en"
  title="Partner Program | IoT Sensor Channel & Ecological Partners - Hitelecom"
  description="Join the Hitelecom partner network: channel-first strategy for industrial IoT sensors, outdoor 4G and NB-IoT terminals, with training, marketing and technical support for partners."
>
  <AboutShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <AboutPartner locale="en" />
  </AboutShell>
</BaseLayout>
