---
/**
 * 关于我们 - 品质与可靠（英文）：/about/quality.html
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutShell from '../../components/about/AboutShell.astro';
import AboutQuality from '../../components/about/AboutQuality.astro';
import { contentImageSrc } from '../../utils/content';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hitelecom.com/' },
    { '@type': 'ListItem', position: 2, name: 'About', item: 'https://www.hitelecom.com/about.html' },
    { '@type': 'ListItem', position: 3, name: 'Quality And Reliability', item: 'https://www.hitelecom.com/about/quality.html' },
  ],
};
const aboutBanner = (await contentImageSrc('/images/about/up_7428e98f9a91fcccdaa6c5ede77c3cc2.webp', 1920)) ?? undefined;
---

<BaseLayout
  preloadImage={aboutBanner}
  locale="en"
  title="Quality & Reliability | Industrial IoT Sensor Manufacturing - Hitelecom"
  description="Hitelecom quality policy for industrial IoT sensors: automotive-grade SMT lines, MPM/KOHYOUNG/OMRON equipment, TQM procedures and RoHS, REACH and halogen-free compliance."
>
  <AboutShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <AboutQuality locale="en" />
  </AboutShell>
</BaseLayout>
