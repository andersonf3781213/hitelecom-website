---
/**
 * 新闻中心-行业资讯（英文）：/news/index/cid/80
 */
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import NewsShell from '../../../../../components/news/NewsShell.astro';
import NewsList from '../../../../../components/news/NewsList.astro';
import { optimizedSrc } from '../../../../../utils/images';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://www.hitelecom.com/ru' },
    { '@type': 'ListItem', position: 2, name: 'Новости', item: 'https://www.hitelecom.com/ru/news' },
    { '@type': 'ListItem', position: 3, name: 'Новости отрасли', item: 'https://www.hitelecom.com/ru/news/index/cid/80' },
  ],
};
const pageBanner = await optimizedSrc('news/banner.jpg', { width: 1920, quality: 82 });
---

<BaseLayout
  preloadImage={pageBanner}
  locale="ru"
  title="Обзоры промышленного IoT | Hitelecom"
  description="Избранные новости об умном водоснабжении, городской инфраструктуре, дистанционном мониторинге и приложениях промышленного IoT."
>
  <NewsShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <NewsList locale="ru" cat="ind" />
  </NewsShell>
</BaseLayout>
