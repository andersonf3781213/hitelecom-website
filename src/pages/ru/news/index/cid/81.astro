---
/**
 * 新闻中心-展会信息（英文）：/news/index/cid/81
 */
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import NewsShell from '../../../../../components/news/NewsShell.astro';
import NewsList from '../../../../../components/news/NewsList.astro';
import { optimizedSrc } from '../../../../../utils/images';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://www.hitelecom.com/ru' },
    { '@type': 'ListItem', position: 2, name: 'Новости', item: 'https://www.hitelecom.com/ru/news' },
    { '@type': 'ListItem', position: 3, name: 'Выставки', item: 'https://www.hitelecom.com/ru/news/index/cid/81' },
  ],
};
const pageBanner = await optimizedSrc('news/banner.jpg', { width: 1920, quality: 82 });
---

<BaseLayout
  preloadImage={pageBanner}
  locale="ru"
  title="События и выставки | Hitelecom"
  description="Промышленные датчики IoT, шлюзы и облачные интеграции Hitelecom на IOTE и других отраслевых событиях."
>
  <NewsShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <NewsList locale="ru" cat="exh" />
  </NewsShell>
</BaseLayout>
