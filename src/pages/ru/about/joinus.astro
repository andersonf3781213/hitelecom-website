---
/**
 * 关于我们 - 加入我们（英文）：/about/joinus
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AboutShell from '../../../components/about/AboutShell.astro';
import AboutJoinus from '../../../components/about/AboutJoinus.astro';
import { contentImageSrc } from '../../../utils/content';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://www.hitelecom.com/ru' },
    { '@type': 'ListItem', position: 2, name: 'О компании', item: 'https://www.hitelecom.com/ru/about' },
    { '@type': 'ListItem', position: 3, name: 'Вакансии', item: 'https://www.hitelecom.com/ru/about/joinus' },
  ],
};
const aboutBanner = (await contentImageSrc('/images/about/up_7428e98f9a91fcccdaa6c5ede77c3cc2.webp', 1920)) ?? undefined;
---

<BaseLayout
  preloadImage={aboutBanner}
  locale="ru"
  title="Вакансии Hitelecom | Промышленный IoT"
  description="Вакансии Hitelecom в Шанхае: встраиваемые системы, ПО IoT, производство электроники, качество, продажи и операции."
>
  <AboutShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <AboutJoinus locale="ru" />
  </AboutShell>
</BaseLayout>
