---
/**
 * 关于我们 - 品质与可靠（英文）：/about/quality
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AboutShell from '../../../components/about/AboutShell.astro';
import AboutQuality from '../../../components/about/AboutQuality.astro';
import { contentImageSrc } from '../../../utils/content';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://www.hitelecom.com/ru' },
    { '@type': 'ListItem', position: 2, name: 'О компании', item: 'https://www.hitelecom.com/ru/about' },
    { '@type': 'ListItem', position: 3, name: 'Качество и надёжность', item: 'https://www.hitelecom.com/ru/about/quality' },
  ],
};
const aboutBanner = (await contentImageSrc('/images/about/up_7428e98f9a91fcccdaa6c5ede77c3cc2.webp', 1920)) ?? undefined;
---

<BaseLayout
  preloadImage={aboutBanner}
  locale="ru"
  title="Качество и надёжность | Производство датчиков IoT"
  description="Как Hitelecom управляет качеством датчиков IoT: SMT-производство, контроль, испытания на надёжность и сертифицированные системы менеджмента."
>
  <AboutShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <AboutQuality locale="ru" />
  </AboutShell>
</BaseLayout>
