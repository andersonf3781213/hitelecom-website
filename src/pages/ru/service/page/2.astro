---
/**
 * 旧资料分页 /ru/service/page/2：Support V9 起资料不再分页。
 * 生产环境由 Cloudflare Pages 301 到 /ru/service；本页仅为回退跳转。
 */
const target = '/ru/service#page3';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Resources have moved | Hitelecom</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href="https://www.hitelecom.com/ru/service" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p>Product resources have moved to <a href={target}>Support &amp; Service</a>.</p>
    <script is:inline>location.replace('/ru/service#page3');</script>
  </body>
</html>
