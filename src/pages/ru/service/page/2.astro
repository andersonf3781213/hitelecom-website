---
/**
 * 支持服务页（英文，第 2 页）：/service/page/2
 * 与原站 /service.html?page=2 一致：文档下载区为第 2 页卡片（3 张），分页 2 高亮
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ServiceShell from '../../../../components/service/ServiceShell.astro';
import ServiceBody from '../../../../components/service/ServiceBody.astro';
import { optimizedSrc } from '../../../../utils/images';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://www.hitelecom.com/ru' },
    { '@type': 'ListItem', position: 2, name: 'Поддержка', item: 'https://www.hitelecom.com/ru/service' },
  ],
};
const pageBanner = await optimizedSrc('service/banner.jpg', { width: 1920, quality: 82 });
---

<BaseLayout
  preloadImage={pageBanner}
  locale="ru"
  title="Загрузка документов | Брошюры датчиков IoT - Hitelecom"
  description="Скачайте брошюры и руководства Hitelecom для датчиков 4G или NB-IoT: температура, давление, расстояние и другие промышленные параметры."
>
  <ServiceShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <ServiceBody locale="ru" page={2} />
  </ServiceShell>
</BaseLayout>
