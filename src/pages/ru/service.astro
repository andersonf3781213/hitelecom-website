---
/**
 * 支持服务页（俄语）：/ru/service
 * V160：Support V9 多语言 —— 复用官网 BaseLayout 外壳，正文由 StaticLocale
 * 构建期静态翻译（词典 src/i18n/support/ru.json），无客户端整页替换。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import StaticLocale from '../../components/support/StaticLocale.astro';
import SupportContent from '../../components/support/SupportContent.astro';
import { faq, title, description } from '../../data/support';
import { dictionary } from '../../i18n/support/localize';
import { locales } from '../../i18n/support/config';
import '../../styles/support-i18n.css';

const locale = 'ru';
const dict = dictionary(locale);
const norm = (s: string) => s.replace(/\s+/g, ' ').trim();
const t = (s: string) => dict[norm(s)] ?? s;
const canonical = `https://www.hitelecom.com/${locale}/service`;
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t('Home'), item: 'https://www.hitelecom.com/ru/' },
        { '@type': 'ListItem', position: 2, name: t('Support'), item: canonical },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': canonical + '#faq',
      inLanguage: locales[locale].lang,
      mainEntity: faq.map((x) => ({
        '@type': 'Question',
        name: t(x.q),
        acceptedAnswer: { '@type': 'Answer', text: t(x.a) },
      })),
    },
  ],
};
const runtimeKeys = ['{count} resources found','Showing {count} of {total} resources','Show featured resources','Show all resources','Please complete this field.','Hitelecom support request','Name','Business email','Company','Not provided','Topic','General support','Product / model','Description','Hitelecom support','Nothing has been sent. Review your draft before opening your email app.','Draft copied. Nothing has been sent.','Copy is unavailable here. Select and copy the draft above. Nothing has been sent.'];
const runtimeCopy = Object.fromEntries(runtimeKeys.map((key) => [key, dict[key] ?? key]));
---

<BaseLayout
  locale={locale}
  title={t(title)}
  description={t(description)}
  socialImage="/assets/support/tilt-device.webp"
  preloadImage="/assets/support/tilt-device.webp"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
  <script slot="head" id="support-i18n" type="application/json" set:html={JSON.stringify(runtimeCopy).replace(/</g, '\\u003c')} />
  <StaticLocale locale={locale}>
    <SupportContent />
  </StaticLocale>
</BaseLayout>
