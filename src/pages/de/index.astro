---
/**
 * 德语首页（挂载于 /de/）
 * 采用与英文首页一致的 V18 设计（用户决策：所有语言以 EN 为基础），
 * 主体为本地化组件 src/components/home/HomeV18De.astro
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeV18De from '../../components/home/HomeV18De.astro';
import { site } from '../../data/site';
// V18 首页样式进 Astro 管线：自动压缩 + 内容哈希（长缓存 immutable），源图仍在 public 下绝对引用，同名可换
import '../../styles/home-v18.css';
import '../../styles/home-v18-override.css';

// 首页专属结构化数据（GEO/SEO）：页面可见的 12 大传感器家族 + 4 大应用领域
// 每个家族指向其语义化详情页（与卡片上的 View product details 一致）
const families: Array<[string, string]> = [
  ['Industrielle Temperatursensoren', '/de/product/temperature-sensor'],
  ['Temperatur- und Feuchtigkeitssensoren', '/de/product/temperature-humidity-sensor'],
  ['Datenlogger für Temperatur und Feuchtigkeit', '/de/product/temperature-humidity-data-logger'],
  ['Luftqualitätssensoren', '/de/product/air-quality-sensor'],
  ['TVOC-Sensoren', '/de/product/tvoc-sensor'],
  ['Drucksensoren', '/de/product/pressure-sensor'],
  ['Bodensensoren', '/de/product/soil-moisture-sensor'],
  ['Neigungssensoren', '/de/product/tilt-sensor'],
  ['Vibrationssensoren', '/de/product/vibration-sensor'],
  ['Radar-Abstandssensoren', '/de/product/radar-distance-sensor'],
  ['Asset-Tracking-Sensoren', '/de/product/asset-tracking-sensor'],
  ['Kundenspezifische Gassensoren', '/de/product/custom-gas-sensor'],
];
// 应用领域：仅收录有独立落地页的条目进 ItemList（与英文首页口径一致）
const applications: Array<[string, string]> = [
  ['Intelligente Städte – Bauwerksüberwachung', '/de/solution/show/id/57'],
  ['Intelligente Fabriken – Umgebungsbedingungen und Anlagenzustand', '/de/solution/show/id/58'],
  ['Intelligentes Wassermanagement – Rohrleitungs-, Füllstands- und Blockierungsüberwachung', '/de/solution/show/id/67'],
  ['Intelligentes Kulturerbe – Mikroklima und Objektbewegung', '/de/solution/show/id/66'],
];
const homeItemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'IoT-Produktfamilien und -Anwendungen von Hitelecom',
  itemListElement: [
    ...families.map(([name, href], i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name,
      url: new URL(href, 'https://www.hitelecom.com').href,
    })),
    ...applications.map(([name, href], i) => ({
      '@type': 'ListItem',
      position: families.length + i + 1,
      name,
      url: new URL(href, 'https://www.hitelecom.com').href,
    })),
  ],
};
---

<BaseLayout locale="de" headerSolid v18Grid
  title="Hitelecom | Industrielle 4G- & NB-IoT-Sensoren + IoT-Cloud"
  description="Machen Sie die physische Welt messbar. Über 50 industrielle 4G-, NB-IoT- und LoRa-Sensorterminals von Hitelecom, mit OEM/ODM-Support.">
  <!-- 首屏 H1 衬线字体（Playfair 500，23KB）预载：黄金 3 秒 -->
  <link slot="head" rel="preload" href="/fonts/playfair-500.woff2" as="font" type="font/woff2" crossorigin />

  <!-- 首屏轮播第 1 帧设备图按断点预载（LCP），其余大图全部 lazy。
       桌面端用 imagesrcset：浏览器按 DPR 自选 1920/2560，与 <img> 决策一致，避免高分辨率屏重复下载 -->
  <link slot="head" rel="preload" as="image" href="/home-assets/img/hero-devices-m-1200-v9.avif" type="image/avif" media="(max-width: 760px)" fetchpriority="high" />
  <link slot="head" rel="preload" as="image" type="image/avif" media="(min-width: 761px)" fetchpriority="high"
        imagesrcset="/home-assets/img/hero-devices-1920-v10.avif 1920w, /home-assets/img/hero-devices-2560-v10.avif 2560w"
        imagesizes="100vw" />

  <!-- 首屏轮播第 2 帧（IoT 云平台图）低优先级预载：
       保证 7s 自动轮播/手动点击切换时图片已就绪，不出现白场闪烁；
       low 优先级不与 LCP 首帧抢带宽 -->
  <link slot="head" rel="preload" as="image" href="/home-assets/img/hero-platform-m-1200-v10.avif" type="image/avif" media="(max-width: 760px)" fetchpriority="low" />
  <link slot="head" rel="preload" as="image" type="image/avif" media="(min-width: 761px)" fetchpriority="low"
        imagesrcset="/home-assets/img/hero-platform-1920-v11.avif 1920w, /home-assets/img/hero-platform-2560-v11.avif 2560w"
        imagesizes="100vw" />

  <script slot="head" type="application/ld+json" set:html={JSON.stringify(homeItemListLd)} />

  <HomeV18De />

  <!-- 询盘表单提交配置（Web3Forms），供 home-v18.js 读取；留空自动回退 mailto -->
  <script is:inline define:vars={{ formEndpoint: site.formEndpoint, formAccessKey: site.formAccessKey }}>
    window.HITE_FORM_ENDPOINT = formEndpoint;
    window.HITE_FORM_KEY = formAccessKey;
  </script>
  <!-- 首页交互进 Astro 管线：打包压缩 + 内容哈希，type=module 天然 defer -->
  <script>import '../../scripts/home-v18.js';</script>
</BaseLayout>
