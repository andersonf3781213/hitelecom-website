---
/**
 * 支持服务页（英文，第 1 页）：/service
 * 与原站 1:1：横幅 + 锚点选项卡 + 技术支持六卡 + 软件区 + 文档下载（8 卡 + 分页）+ 售后表单
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceShell from '../../components/service/ServiceShell.astro';
import ServiceBody from '../../components/service/ServiceBody.astro';
import { optimizedSrc } from '../../utils/images';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: 'https://www.hitelecom.com/de' },
    { '@type': 'ListItem', position: 2, name: 'Support', item: 'https://www.hitelecom.com/de/service' },
  ],
};
const pageBanner = await optimizedSrc('service/banner.jpg', { width: 1920, quality: 82 });
---

<BaseLayout
  preloadImage={pageBanner}
  locale="de"
  title="IoT-Support und kundenspezifische Entwicklung | Hitelecom"
  description="Technischer Support, kundenspezifische Hard- und Softwareentwicklung, Fernassistenz und After-Sales-Service für IoT-Projekte von Hitelecom."
>
  <ServiceShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <ServiceBody locale="de" page={1} />
  </ServiceShell>
</BaseLayout>
