---
/**
 * 新闻中心（英文，公司新闻）：/news
 * 与原站 /news/ 1:1：横幅 + 分类选项卡 + 头条轮播（2 条）+ 9 张新闻卡
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsShell from '../../components/news/NewsShell.astro';
import NewsList from '../../components/news/NewsList.astro';
import { optimizedSrc } from '../../utils/images';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: 'https://www.hitelecom.com/de' },
    { '@type': 'ListItem', position: 2, name: 'News', item: 'https://www.hitelecom.com/de/news' },
  ],
};
const pageBanner = await optimizedSrc('news/banner.jpg', { width: 1920, quality: 82 });
---

<BaseLayout
  preloadImage={pageBanner}
  locale="de"
  title="Hitelecom News | Industrielle IoT-Produkte und -Veranstaltungen"
  description="Lesen Sie Produktankündigungen, Zertifizierungsupdates, Messenachrichten und ausgewählte Markteinblicke zum industriellen IoT von Hitelecom."
>
  <NewsShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <NewsList locale="de" cat="company" />
  </NewsShell>
</BaseLayout>
