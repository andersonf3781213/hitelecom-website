---
/**
 * 支持服务页（英文）：/service
 * V159：接入 GPT6 Support V9 —— 技术支持（选型/安装/排查）+ 软硬件定制 +
 * 远程/电话/现场支持 + 资料中心（17 项，渐进增强检索）+ 售后 + FAQ +
 * 邮件草稿询盘（不自动发送）。复用 BaseLayout 公共外壳与 SEO 输出。
 * 其它语言 /{locale}/service 保持原页面不变。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SupportContent from '../components/support/SupportContent.astro';
import { faq, title, description } from '../data/support';

const canonical = 'https://www.hitelecom.com/service';
// BaseLayout 已输出 Organization/WebSite 实体图，这里仅补充面包屑与 FAQ
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hitelecom.com/' },
        { '@type': 'ListItem', position: 2, name: 'Support', item: canonical },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': canonical + '#faq',
      mainEntity: faq.map((x) => ({
        '@type': 'Question',
        name: x.q,
        acceptedAnswer: { '@type': 'Answer', text: x.a },
      })),
    },
  ],
};
---

<BaseLayout
  locale="en"
  title={title}
  description={description}
  socialImage="/assets/support/tilt-device.webp"
  preloadImage="/assets/support/tilt-device.webp"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
  <SupportContent />
</BaseLayout>
