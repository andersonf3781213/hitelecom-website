---
/**
 * 新闻详情页（中文）：/zh/news/show/id/{id}.html
 */
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import NewsShell from '../../../../../components/news/NewsShell.astro';
import NewsDetailBody from '../../../../../components/news/NewsDetailBody.astro';
import { getNewsContent, getNewsIds } from '../../../../../data/news';
import { optimizedSrc } from '../../../../../utils/images';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () =>
  (await getNewsIds('zh')).map((id) => ({ params: { id } }));

const { id } = Astro.params;
const d = await getNewsContent('zh');
const det = d.details[id];
const card = d.index[id];
const pageTitle = det.title ? `${det.title} - 宏太智慧` : '新闻中心 - 宏太智慧';
// 原站列表无摘要时退回正文纯文本截取，避免多页共用同一 description
const bodyText = det.body
  .replace(/<[^>]+>/g, ' ')
  .replace(/&nbsp;/g, ' ')
  .replace(/&#39;|&rsquo;/g, "'")
  .replace(/&quot;|&ldquo;|&rdquo;/g, '"')
  .replace(/&amp;/g, '&')
  .replace(/\s+/g, ' ')
  .trim();
const pageDesc = card?.excerpt || bodyText.slice(0, 160) || undefined;
const isoDate = (det.date.match(/(\d{4})[-.](\d{2})[-.](\d{2})/) || []).slice(1).join('-') || undefined;
const articleImg = card?.img ? new URL(await optimizedSrc(card.img, { width: 900 }), Astro.site).href : undefined;

const catUrl = { company: 'zh/news.html', exh: 'zh/news/index/cid/81.html', ind: 'zh/news/index/cid/80.html' }[det.cat];
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://www.hitelecom.com/zh.html' },
    { '@type': 'ListItem', position: 2, name: '新闻中心', item: 'https://www.hitelecom.com/zh/news.html' },
    { '@type': 'ListItem', position: 3, name: d.catNames[det.cat], item: `https://www.hitelecom.com/${catUrl}` },
    ...(det.title ? [{ '@type': 'ListItem', position: 4, name: det.title }] : []),
  ],
};
const articleLd = det.title ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: det.title,
  ...(articleImg ? { image: articleImg } : {}),
  ...(isoDate ? { datePublished: isoDate } : {}),
  ...(det.updated ? { dateModified: det.updated } : isoDate ? { dateModified: isoDate } : {}),
  inLanguage: 'zh-CN',
  author: { '@id': 'https://www.hitelecom.com/#organization' },
  publisher: { '@id': 'https://www.hitelecom.com/#organization' },
  mainEntityOfPage: `https://www.hitelecom.com/zh/news/show/id/${id}.html`,
} : null;
---

<BaseLayout locale="zh" preloadImage={articleImg} title={pageTitle} description={pageDesc}>
  <NewsShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    {articleLd && <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
    <NewsDetailBody locale="zh" id={id} />
  </NewsShell>
</BaseLayout>
