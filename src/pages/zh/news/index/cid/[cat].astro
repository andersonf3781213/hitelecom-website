---
/**
 * 新闻中心-成功案例/技术博客（中文）：/zh/news/index/cid/{case|blog}.html
 * 仅在对应内容集合有条目时生成（无内容不产出空页面，保持与原站 1:1）
 */
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import NewsShell from '../../../../../components/news/NewsShell.astro';
import NewsList from '../../../../../components/news/NewsList.astro';
import { getExtraNewsCats, getNewsContent } from '../../../../../data/news';
import { optimizedSrc } from '../../../../../utils/images';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () =>
  (await getExtraNewsCats('zh')).map((cat) => ({ params: { cat } }));

const { cat } = Astro.params as { cat: 'case' | 'blog' };
const d = await getNewsContent('zh');
const catName = d.catNames[cat];
const pageBanner = await optimizedSrc('news/banner.jpg', { width: 1920, quality: 82 });
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://www.hitelecom.com/zh' },
    { '@type': 'ListItem', position: 2, name: '新闻中心', item: 'https://www.hitelecom.com/zh/news' },
    { '@type': 'ListItem', position: 3, name: catName, item: `https://www.hitelecom.com/zh/news/index/cid/${cat}` },
  ],
};
const desc =
  cat === 'case'
    ? '宏太通信成功案例：户外4G与NB-IoT传感终端在智慧水务、智慧城市、能源与工业监测项目中的部署实践。'
    : '宏太通信技术博客：工业物联网传感器、低功耗设计、4G/NB-IoT通信与规模化部署的工程笔记。';
---

<BaseLayout preloadImage={pageBanner} locale="zh" title={`${catName} | 宏太通信工业物联网传感器`} description={desc}>
  <NewsShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <NewsList locale="zh" cat={cat} />
  </NewsShell>
</BaseLayout>
