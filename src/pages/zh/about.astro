---
/**
 * 关于我们 - 公司简介（中文）：/zh/about * 与原站 /about/ 1:1：横幅 + 五个选项卡 + 简介/企业文化/发展历程/环境/荣誉
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutShell from '../../components/about/AboutShell.astro';
import AboutIntro from '../../components/about/AboutIntro.astro';
import { contentImageSrc } from '../../utils/content';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://www.hitelecom.com/zh' },
    { '@type': 'ListItem', position: 2, name: '关于我们', item: 'https://www.hitelecom.com/zh/about' },
  ],
};
const aboutBanner = (await contentImageSrc('/images/about/up_7428e98f9a91fcccdaa6c5ede77c3cc2.webp', 1920)) ?? undefined;
---

<BaseLayout
  preloadImage={aboutBanner}
  locale="zh"
  title="关于我们 | 宏太智慧 - 工业物联网传感器制造商"
  description="宏太智慧（宏太通信，2012 年成立于上海）专注工业物联网传感器：户外4G、NB-IoT 传感终端、温湿度记录仪与宏太云平台。了解公司发展历程、企业文化与资质荣誉。"
>
  <AboutShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <AboutIntro locale="zh" />
  </AboutShell>
</BaseLayout>
