---
/**
 * 关于我们 - 加入我们（中文）：/zh/about/joinus.html */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AboutShell from '../../../components/about/AboutShell.astro';
import AboutJoinus from '../../../components/about/AboutJoinus.astro';
import { contentImageSrc } from '../../../utils/content';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://www.hitelecom.com/zh.html' },
    { '@type': 'ListItem', position: 2, name: '关于我们', item: 'https://www.hitelecom.com/zh/about.html' },
    { '@type': 'ListItem', position: 3, name: '加入我们', item: 'https://www.hitelecom.com/zh/about/joinus.html' },
  ],
};
const aboutBanner = (await contentImageSrc('/images/about/up_7428e98f9a91fcccdaa6c5ede77c3cc2.webp', 1920)) ?? undefined;
---

<BaseLayout
  preloadImage={aboutBanner}
  locale="zh"
  title="加入我们 | 宏太智慧招聘 - 工业物联网传感器公司"
  description="宏太智慧招聘：加入上海工业物联网传感器企业，参与户外4G、NB-IoT 感知与低碳产品，共建全球物联网解决方案。"
>
  <AboutShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <AboutJoinus locale="zh" />
  </AboutShell>
</BaseLayout>
