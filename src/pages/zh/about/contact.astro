---
/**
 * 关于我们 - 联系我们（中文）：/zh/about/contact.html */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AboutShell from '../../../components/about/AboutShell.astro';
import AboutContact from '../../../components/about/AboutContact.astro';
import { contentImageSrc } from '../../../utils/content';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://www.hitelecom.com/zh.html' },
    { '@type': 'ListItem', position: 2, name: '关于我们', item: 'https://www.hitelecom.com/zh/about.html' },
    { '@type': 'ListItem', position: 3, name: '联系我们', item: 'https://www.hitelecom.com/zh/about/contact.html' },
  ],
};
const aboutBanner = (await contentImageSrc('/images/about/up_7428e98f9a91fcccdaa6c5ede77c3cc2.webp', 1920)) ?? undefined;
---

<BaseLayout
  preloadImage={aboutBanner}
  locale="zh"
  title="联系我们 | 宏太智慧 - 工业物联网传感器制造商"
  description="联系宏太智慧：工业物联网传感器、户外4G与NB-IoT终端及 OEM/ODM 项目咨询，电话 +86-18616602589，邮箱 sales@hitelecom.com，上海市松江区车阳路116号。"
>
  <AboutShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <AboutContact locale="zh" />
  </AboutShell>
</BaseLayout>
