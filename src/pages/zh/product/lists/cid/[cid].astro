---
/**
 * 产品列表页（中文）：/zh/product/lists/cid/{cid}.html
 */
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import ProductShell from '../../../../../components/product/ProductShell.astro';
import CategoryTabs from '../../../../../components/product/CategoryTabs.astro';
import ListSidebar from '../../../../../components/product/ListSidebar.astro';
import ProductCard from '../../../../../components/product/ProductCard.astro';
import { productContent, listParent, productTabs, listSeo, productPath, getMergedProducts } from '../../../../../data/product';
import { optimizedSrc } from '../../../../../utils/images';
import { l } from '../../../../../i18n';
import { breadcrumbLd, itemListLd, SITE_URL } from '../../../../../utils/jsonld';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () =>
  Object.keys(productContent.zh.lists).map((cid) => ({ params: { cid } }));

const { cid } = Astro.params;
const pc = await getMergedProducts('zh');
const page = pc.lists[cid];
const parent = listParent[cid];
const tabLabel = productTabs.zh.find((t) => t.key === parent)?.label ?? '产品中心';
const subLabel = page.subcats.find((s) => s.cid === cid && s.name !== '全部')?.name;
const pageTitle = subLabel
  ? `${subLabel} - ${tabLabel} | 宏太通信工业物联网传感器`
  : `${tabLabel} | 户外4G与NB-IoT物联网产品 - 宏太通信`;
const pageDesc = subLabel
  ? `宏太通信${subLabel}产品：户外4G与NB-IoT工业物联网传感终端，支持宏太云接入与OEM/ODM定制。`
  : `宏太通信${tabLabel}：工业物联网传感终端，户外4G与NB-IoT通信，支持宏太云接入与OEM/ODM定制。`;
const seoOverride = listSeo.zh[cid];
const banner = await optimizedSrc(page.bannerImg, { width: 1920 });
// 侧栏用：各子分类 → 其产品（传感器名称，直达详情页）
const zhLists = pc.lists;
const sideProds = Object.fromEntries(
  page.subcats.map((s) => [s.cid, (zhLists[s.cid]?.products ?? []).map((p) => ({ id: p.id, name: p.name }))])
);

// GEO：面包屑 + 产品清单语义化（无详情页的定制条目不进入 ItemList）
const catName = subLabel ?? tabLabel;
const pageUrl = `${SITE_URL}/zh/product/lists/cid/${cid}.html`;
const bcLd = breadcrumbLd([
  { name: '首页', url: `${SITE_URL}/zh.html` },
  { name: '产品中心', url: `${SITE_URL}/zh/product.html` },
  ...(subLabel ? [{ name: tabLabel, url: `${SITE_URL}/zh/product/lists/cid/${parent}.html` }] : []),
  { name: catName },
]);
const listLd = itemListLd(
  page.products.filter((p) => p.id).map((p) => ({ name: p.name, url: `${SITE_URL}${l(productPath(p.id), 'zh')}` })),
  pageUrl,
  `宏太通信${catName}`,
);
---

<BaseLayout locale="zh" preloadImage={banner} title={seoOverride?.title ?? pageTitle} description={seoOverride?.desc ?? pageDesc}>
  <ProductShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify([bcLd, listLd])} />
    <h1 class="sr-only">{subLabel ?? tabLabel}</h1>
    <div class="clearfix nybanner">
      <div class="nybanner_img" style={`background-image:url(${banner});background-position:center top;`}></div>
      <div class="nybanner_jj">
        <div class="cell_mid"><div class="cell_h"><div class="indexmid">
          <div class="nybanner_jj_mid">
            <div class="nybanner_jj_mid_1 reveal"></div>
            <div class="nybanner_jj_mid_2 reveal"></div>
          </div>
        </div></div></div>
      </div>
      <div id="cate"></div>
    </div>

    <CategoryTabs locale="zh" active={parent} />

    <div class="clearfix pro_2">
      <div class="indexmid">
        <div class="pro_2_mid">
          <ListSidebar locale="zh" subcats={page.subcats} sideProds={sideProds} parentCid={parent} />
          <div class="pro_2_mid_right">
            <div class="clearfix pro_2_mid_right_2">
              <ul class={`hi${cid}`}>
                {page.products.map((p) => <ProductCard locale="zh" product={p} />)}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </ProductShell>
</BaseLayout>
