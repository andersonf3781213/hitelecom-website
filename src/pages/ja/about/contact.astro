---
/**
 * 关于我们 - 联系我们（日语）：/about/contact
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AboutShell from '../../../components/about/AboutShell.astro';
import AboutContact from '../../../components/about/AboutContact.astro';
import { contentImageSrc } from '../../../utils/content';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://www.hitelecom.com/ja' },
    { '@type': 'ListItem', position: 2, name: '会社概要', item: 'https://www.hitelecom.com/ja/about' },
    { '@type': 'ListItem', position: 3, name: 'お問い合わせ', item: 'https://www.hitelecom.com/ja/about/contact' },
  ],
};
const aboutBanner = (await contentImageSrc('/images/about/up_7428e98f9a91fcccdaa6c5ede77c3cc2.webp', 1920)) ?? undefined;
---

<BaseLayout
  preloadImage={aboutBanner}
  locale="ja"
  title="Hitelecomへのお問い合わせ | 産業用IoTセンサー"
  description="産業用4G・NB-IoT・LoRaセンサー、クラウド連携、OEM/ODMプロジェクトについてはHitelecomまでお問い合わせください。営業サポートは上海にあります。"
>
  <AboutShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <AboutContact locale="ja" />
  </AboutShell>
</BaseLayout>
