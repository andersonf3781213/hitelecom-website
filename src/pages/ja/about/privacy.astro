---
/**
 * 关于我们 - 隐私政策（日语）：/about/privacy
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AboutShell from '../../../components/about/AboutShell.astro';
import { getAboutSection } from '../../../data/about';
import { enhanceContentHtml, normalizeBody, contentImageSrc } from '../../../utils/content';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://www.hitelecom.com/ja' },
    { '@type': 'ListItem', position: 2, name: '会社概要', item: 'https://www.hitelecom.com/ja/about' },
    { '@type': 'ListItem', position: 3, name: 'プライバシーポリシー', item: 'https://www.hitelecom.com/ja/about/privacy' },
  ],
};
const aboutBanner = (await contentImageSrc('/images/about/up_7428e98f9a91fcccdaa6c5ede77c3cc2.webp', 1920)) ?? undefined;
---

<BaseLayout
  preloadImage={aboutBanner}
  locale="ja"
  title="プライバシーポリシー | Hitelecom"
  description="Hitelecomがこのウェブサイトを通じて収集する個人情報の収集・利用・保護の方法と、プライバシーに関するお問い合わせ先について説明します。"
>
  <AboutShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <Fragment set:html={await enhanceContentHtml(normalizeBody(await getAboutSection('ja', 'privacy')), 'Hitelecom Privacy Policy')} />
  </AboutShell>
</BaseLayout>
