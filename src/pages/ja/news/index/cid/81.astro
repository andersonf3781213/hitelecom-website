---
/**
 * 新闻中心-展会信息（日语）：/news/index/cid/81
 */
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import NewsShell from '../../../../../components/news/NewsShell.astro';
import NewsList from '../../../../../components/news/NewsList.astro';
import { optimizedSrc } from '../../../../../utils/images';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://www.hitelecom.com/ja' },
    { '@type': 'ListItem', position: 2, name: 'ニュース', item: 'https://www.hitelecom.com/ja/news' },
    { '@type': 'ListItem', position: 3, name: '展示会', item: 'https://www.hitelecom.com/ja/news/index/cid/81' },
  ],
};
const pageBanner = await optimizedSrc('news/banner.jpg', { width: 1920, quality: 82 });
---

<BaseLayout
  preloadImage={pageBanner}
  locale="ja"
  title="イベント・展示会 | Hitelecom"
  description="IOTEなどの業界イベントに出展されたHitelecomの産業用IoTセンサー、ゲートウェイ、クラウド連携をご覧ください。"
>
  <NewsShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <NewsList locale="ja" cat="exh" />
  </NewsShell>
</BaseLayout>
