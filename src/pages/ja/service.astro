---
/**
 * 支持服务页（英文，第 1 页）：/service
 * 与原站 1:1：横幅 + 锚点选项卡 + 技术支持六卡 + 软件区 + 文档下载（8 卡 + 分页）+ 售后表单
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceShell from '../../components/service/ServiceShell.astro';
import ServiceBody from '../../components/service/ServiceBody.astro';
import { optimizedSrc } from '../../utils/images';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://www.hitelecom.com/ja' },
    { '@type': 'ListItem', position: 2, name: 'サポート', item: 'https://www.hitelecom.com/ja/service' },
  ],
};
const pageBanner = await optimizedSrc('service/banner.jpg', { width: 1920, quality: 82 });
---

<BaseLayout
  preloadImage={pageBanner}
  locale="ja"
  title="IoTサポートとカスタム開発 | Hitelecom"
  description="IoT展開のための技術サポート、カスタムハードウェア・ソフトウェア開発、リモートアシスタンス、製品ドキュメント、アフターサービスをご利用ください。"
>
  <ServiceShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <ServiceBody locale="ja" page={1} />
  </ServiceShell>
</BaseLayout>
