---
/**
 * 旧数字地址跳转页（西语）：/product/show/id/{id}.html → /product/{slug}.html
 * 保留给外部旧链接与搜索引擎已收录地址；sitemap 已排除本组地址。
 */
import { productSlugs } from '../../../../../data/product';
import { l } from '../../../../../i18n';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () =>
  Object.keys(productSlugs).map((id) => ({ params: { id } }));

const { id } = Astro.params;
const target = l(`/product/${productSlugs[id]}`, 'es');
const abs = `https://www.hitelecom.com${target}`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Moved Permanently | Hitelecom</title>
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href={abs} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p>Esta página se ha movido a <a href={target}>{abs}</a>.</p>
    <script is:inline define:vars={{ target }}>
      location.replace(target);
    </script>
  </body>
</html>
