---
/**
 * 产品列表页（西语）：/product/lists/cid/{cid}.html
 * 覆盖 4 个主分类 + 14 个子分类，数据见 src/data/product.ts
 */
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import ProductShell from '../../../../../components/product/ProductShell.astro';
import CategoryTabs from '../../../../../components/product/CategoryTabs.astro';
import ListSidebar from '../../../../../components/product/ListSidebar.astro';
import ProductCard from '../../../../../components/product/ProductCard.astro';
import { productContent, listParent, productTabs, listSeo, productPath, getMergedProducts } from '../../../../../data/product';
import { applyCatalog } from '../../../../../lib/catalog-site';
import { optimizedSrc } from '../../../../../utils/images';
import { l } from '../../../../../i18n';
import { breadcrumbLd, itemListLd, SITE_URL } from '../../../../../utils/jsonld';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () =>
  Object.keys(productContent.es.lists).map((cid) => ({ params: { cid } }));

const { cid } = Astro.params;
const pc = await getMergedProducts('es');
// V109 目录管理：基础顺序/本月主推/草稿隐藏/新发布产品卡片由 product-catalog.json 驱动
const catalogCardPool = Object.values(pc.lists).flatMap((lp) => lp.products);
const adaptedLists = Object.fromEntries(Object.entries(pc.lists).map(([k, lp]) => [k, { ...lp, products: applyCatalog(lp.products, k, 'es', catalogCardPool) }]));
const page = adaptedLists[cid];
const parent = listParent[cid];
const tabLabel = productTabs.es.find((t) => t.key === parent)?.label ?? 'Productos';
const subLabel = page.subcats.find((s) => s.cid === cid && s.name !== 'Todos')?.name;
const pageTitle = subLabel
  ? `${subLabel} - ${tabLabel} | Sensores IoT industriales Hitelecom`
  : `${tabLabel} | Productos 4G y NB-IoT para exteriores - Hitelecom`;
const pageDesc = subLabel
  ? `Productos de ${subLabel.toLowerCase()} de Hitelecom: terminales de sensores IoT industriales 4G y NB-IoT para exteriores con integración de nube IoT, OEM/ODM disponible.`
  : `Hitelecom ${tabLabel}: terminales de sensores IoT industriales, conectividad 4G y NB-IoT para exteriores, integración de nube IoT y personalización OEM/ODM.`;
const seoOverride = listSeo.es[cid];
const banner = await optimizedSrc(page.bannerImg, { width: 1920 });
// 侧栏用：各子分类 → 其产品（传感器名称，直达详情页）
const enLists = adaptedLists;
const sideProds = Object.fromEntries(
  page.subcats.map((s) => [s.cid, (enLists[s.cid]?.products ?? []).map((p) => ({ id: p.id, name: p.name, url: p.url, href: p.href }))])
);

// GEO：面包屑 + 产品清单语义化（无详情页的定制条目不进入 ItemList）
const catName = subLabel ?? tabLabel;
const pageUrl = `${SITE_URL}/es/product/lists/cid/${cid}`;
const bcLd = breadcrumbLd([
  { name: 'Inicio', url: `${SITE_URL}/es/` },
  { name: 'Productos', url: `${SITE_URL}/es/product` },
  ...(subLabel ? [{ name: tabLabel, url: `${SITE_URL}/es/product/lists/cid/${parent}` }] : []),
  { name: catName },
]);
const listLd = itemListLd(
  page.products.filter((p) => p.id).map((p) => ({ name: p.name, url: new URL(p.url || l(productPath(p.id), 'es'), SITE_URL).href })),
  pageUrl,
  `Hitelecom ${catName}`,
);
---

<BaseLayout locale="es" preloadImage={banner} title={seoOverride?.title ?? pageTitle} description={seoOverride?.desc ?? pageDesc}>
  <ProductShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify([bcLd, listLd])} />
    <h1 class="sr-only">{cid === '274' ? 'Estación hidrológica' : cid === '275' ? 'Estación meteorológica' : (subLabel ?? tabLabel)}</h1>
    {/* 内页横幅（纯图片，与原站一致无文字） */}
    <div class="clearfix nybanner">
      <div class="nybanner_img" style={`background-image:url(${banner});background-position:center top;`}></div>
      <div class="nybanner_jj">
        <div class="cell_mid"><div class="cell_h"><div class="indexmid">
          <div class="nybanner_jj_mid">
            <div class="nybanner_jj_mid_1 reveal"></div>
            <div class="nybanner_jj_mid_2 reveal"></div>
          </div>
        </div></div></div>
      </div>
      <div id="cate"></div>
    </div>

    <CategoryTabs locale="es" active={parent} />

    <div class="clearfix pro_2">
      <div class="indexmid">
        <div class="pro_2_mid">
          <ListSidebar locale="es" subcats={page.subcats} sideProds={sideProds} parentCid={parent} />
          <div class="pro_2_mid_right">
            <div class="clearfix pro_2_mid_right_2">
              <ul class={`hi${cid}`}>
                {page.products.map((p) => <ProductCard locale="es" product={p} />)}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </ProductShell>
</BaseLayout>
