---
/**
 * 关于我们 - 品质与可靠（西语）：/about/quality
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AboutShell from '../../../components/about/AboutShell.astro';
import AboutQuality from '../../../components/about/AboutQuality.astro';
import { contentImageSrc } from '../../../utils/content';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.hitelecom.com/es' },
    { '@type': 'ListItem', position: 2, name: 'Nosotros', item: 'https://www.hitelecom.com/es/about' },
    { '@type': 'ListItem', position: 3, name: 'Calidad y confiabilidad', item: 'https://www.hitelecom.com/es/about/quality' },
  ],
};
const aboutBanner = (await contentImageSrc('/images/about/up_7428e98f9a91fcccdaa6c5ede77c3cc2.webp', 1920)) ?? undefined;
---

<BaseLayout
  preloadImage={aboutBanner}
  locale="es"
  title="Calidad y confiabilidad | Fabricación de sensores IoT"
  description="Vea cómo Hitelecom gestiona la calidad de los sensores IoT mediante producción SMT, inspección, pruebas de confiabilidad y sistemas de gestión certificados."
>
  <AboutShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <AboutQuality locale="es" />
  </AboutShell>
</BaseLayout>
