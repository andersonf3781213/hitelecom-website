---
/**
 * 关于我们 - 加入我们（西语）：/about/joinus
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AboutShell from '../../../components/about/AboutShell.astro';
import AboutJoinus from '../../../components/about/AboutJoinus.astro';
import { contentImageSrc } from '../../../utils/content';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.hitelecom.com/es' },
    { '@type': 'ListItem', position: 2, name: 'Nosotros', item: 'https://www.hitelecom.com/es/about' },
    { '@type': 'ListItem', position: 3, name: 'Carreras', item: 'https://www.hitelecom.com/es/about/joinus' },
  ],
};
const aboutBanner = (await contentImageSrc('/images/about/up_7428e98f9a91fcccdaa6c5ede77c3cc2.webp', 1920)) ?? undefined;
---

<BaseLayout
  preloadImage={aboutBanner}
  locale="es"
  title="Carreras en Hitelecom | IoT industrial"
  description="Explore las oportunidades laborales en Hitelecom Shanghái: sistemas embebidos, software IoT, fabricación electrónica, calidad, ventas y operaciones."
>
  <AboutShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <AboutJoinus locale="es" />
  </AboutShell>
</BaseLayout>
