---
/**
 * 关于我们 - 隐私政策（西语）：/about/privacy
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AboutShell from '../../../components/about/AboutShell.astro';
import { getAboutSection } from '../../../data/about';
import { enhanceContentHtml, normalizeBody, contentImageSrc } from '../../../utils/content';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.hitelecom.com/es' },
    { '@type': 'ListItem', position: 2, name: 'Nosotros', item: 'https://www.hitelecom.com/es/about' },
    { '@type': 'ListItem', position: 3, name: 'Política de privacidad', item: 'https://www.hitelecom.com/es/about/privacy' },
  ],
};
const aboutBanner = (await contentImageSrc('/images/about/up_7428e98f9a91fcccdaa6c5ede77c3cc2.webp', 1920)) ?? undefined;
---

<BaseLayout
  preloadImage={aboutBanner}
  locale="es"
  title="Política de privacidad | Hitelecom"
  description="Cómo Hitelecom recopila, usa y protege la información personal enviada a través de este sitio web, y cómo contactarnos sobre privacidad."
>
  <AboutShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <Fragment set:html={await enhanceContentHtml(normalizeBody(await getAboutSection('es', 'privacy')), 'Hitelecom Privacy Policy')} />
  </AboutShell>
</BaseLayout>
