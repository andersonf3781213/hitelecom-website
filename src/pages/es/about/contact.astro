---
/**
 * 关于我们 - 联系我们（西语）：/about/contact
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AboutShell from '../../../components/about/AboutShell.astro';
import AboutContact from '../../../components/about/AboutContact.astro';
import { contentImageSrc } from '../../../utils/content';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.hitelecom.com/es' },
    { '@type': 'ListItem', position: 2, name: 'Nosotros', item: 'https://www.hitelecom.com/es/about' },
    { '@type': 'ListItem', position: 3, name: 'Contacto', item: 'https://www.hitelecom.com/es/about/contact' },
  ],
};
const aboutBanner = (await contentImageSrc('/images/about/up_7428e98f9a91fcccdaa6c5ede77c3cc2.webp', 1920)) ?? undefined;
---

<BaseLayout
  preloadImage={aboutBanner}
  locale="es"
  title="Contacte a Hitelecom | Sensores IoT industriales"
  description="Contacte a Hitelecom para sensores industriales 4G, NB-IoT y LoRa, integración en la nube y proyectos OEM/ODM. El soporte de ventas está en Shanghái."
>
  <AboutShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <AboutContact locale="es" />
  </AboutShell>
</BaseLayout>
