---
/**
 * 新闻中心-常见问题（西语）：/news/faqs
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NewsShell from '../../../components/news/NewsShell.astro';
import FaqsBody from '../../../components/news/FaqsBody.astro';
import { getNewsContent } from '../../../data/news';
import { optimizedSrc } from '../../../utils/images';

const faqs = (await getNewsContent('es')).faqs;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.hitelecom.com/es' },
    { '@type': 'ListItem', position: 2, name: 'Noticias', item: 'https://www.hitelecom.com/es/news' },
    { '@type': 'ListItem', position: 3, name: 'Preguntas frecuentes', item: 'https://www.hitelecom.com/es/news/faqs' },
  ],
};
// FAQPage 结构化数据：GEO 核心，问答对可被 Google/AI 直接引用
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const pageBanner = await optimizedSrc('news/banner.jpg', { width: 1920, quality: 82 });
---

<BaseLayout
  preloadImage={pageBanner}
  locale="es"
  title="Preguntas frecuentes sobre sensores IoT industriales | Hitelecom"
  description="Respuestas sobre duración de la batería de sensores, conectividad, EMC, instalación, calibración, integración en la nube y actualizaciones remotas de firmware."
>
  <NewsShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    <FaqsBody locale="es" />
  </NewsShell>
</BaseLayout>
