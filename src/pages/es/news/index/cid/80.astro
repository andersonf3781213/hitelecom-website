---
/**
 * 新闻中心-行业资讯（西语）：/news/index/cid/80
 */
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import NewsShell from '../../../../../components/news/NewsShell.astro';
import NewsList from '../../../../../components/news/NewsList.astro';
import { optimizedSrc } from '../../../../../utils/images';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.hitelecom.com/es' },
    { '@type': 'ListItem', position: 2, name: 'Noticias', item: 'https://www.hitelecom.com/es/news' },
    { '@type': 'ListItem', position: 3, name: 'Noticias de la industria', item: 'https://www.hitelecom.com/es/news/index/cid/80' },
  ],
};
const pageBanner = await optimizedSrc('news/banner.jpg', { width: 1920, quality: 82 });
---

<BaseLayout
  preloadImage={pageBanner}
  locale="es"
  title="Análisis de IoT industrial | Hitelecom"
  description="Lea actualizaciones seleccionadas sobre agua inteligente, infraestructura urbana, monitoreo remoto y aplicaciones de IoT industrial."
>
  <NewsShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <NewsList locale="es" cat="ind" />
  </NewsShell>
</BaseLayout>
