---
/**
 * 新闻详情页（西语）：/news/show/id/{id}.html
 * 与原站 1:1：横幅 → 面包屑+Return → 标题/日期/正文 → Prev/Next → 相关推荐轮播
 */
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import NewsShell from '../../../../../components/news/NewsShell.astro';
import NewsDetailBody from '../../../../../components/news/NewsDetailBody.astro';
import { getNewsContent, getNewsIds } from '../../../../../data/news';
import { optimizedSrc } from '../../../../../utils/images';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () =>
  (await getNewsIds('es')).map((id) => ({ params: { id } }));

const { id } = Astro.params;
const d = await getNewsContent('es');
const det = d.details[id];
const card = d.index[id];
// 原站英文 1394 已按中文版补齐；SEO 标题兜底
const pageTitle = det.title ? det.title : 'Noticias de Hitelecom | Productos y eventos de IoT industrial';
// 部分文章在原站列表无摘要：退回正文纯文本截取，避免多页共用同一 description
const bodyText = det.body
  .replace(/<[^>]+>/g, ' ')
  .replace(/&nbsp;/g, ' ')
  .replace(/&#39;|&rsquo;/g, "'")
  .replace(/&quot;|&ldquo;|&rdquo;/g, '"')
  .replace(/&amp;/g, '&')
  .replace(/\s+/g, ' ')
  .trim();
// 人工维护的 SEO description（完整句、120–155 字符；校对报告 2026-09-04 第 10 节）。
// 优先级高于列表摘要；新增新闻时在此补一条，别让程序从正文截半句。
const seoDesc: Record<string, string> = {
  '1345': 'Hitelecom agradece a clientes y socios su apoyo en 2024 y reafirma su compromiso con productos y servicios confiables de IoT industrial para 2025.',
  '1348': 'Hitelecom presenta un sensor de inclinación con resolución de 0,001°, bajo consumo, conectividad 4G, NB-IoT y LoRa y monitoreo remoto.',
  '1355': 'Hitelecom agradece el apoyo de clientes y socios y les desea un próspero Año Nuevo Lunar y un excelente Año del Dragón.',
  '1356': 'Hitelecom anuncia la certificación ISO 45001 de su sistema de gestión de seguridad y salud en el trabajo tras una auditoría independiente.',
  '1357': 'Hitelecom anuncia la certificación ISO 9001 de su sistema de gestión de la calidad tras una auditoría independiente de sus procesos.',
  '1358': 'Hitelecom presenta un sensor de suelo de bajo consumo para agricultura de precisión, riego, monitoreo ambiental, horticultura e investigación.',
  '1359': 'Hitelecom presenta un sensor de temperatura de bajo consumo para agricultura, cadena de frío, industria, energía y monitoreo ambiental.',
  '1377': 'Hitelecom presentó más de 20 terminales IoT en IOTE Shenzhen 2024, donde el sensor H300-MW012 recibió un premio a la innovación.',
  '1378': 'Resumen de las directrices chinas de 2024 sobre ciudades resilientes, redes subterráneas, monitoreo municipal y sistemas de líneas vitales.',
  '1379': 'China anunció planes para renovar redes urbanas subterráneas y mejorar el drenaje, el control de inundaciones y el monitoreo de servicios.',
  '1380': 'Resumen de las medidas chinas de 2024 para ahorrar agua en instituciones públicas, con requisitos de medición, monitoreo y cuotas.',
  '1381': 'China impulsa proyectos de seguridad de líneas vitales urbanas para redes de gas y agua, puentes, drenaje, túneles y galerías de servicios.',
  '1383': 'China acelera la renovación de redes urbanas de gas, agua, drenaje y calefacción, con sistemas de detección y monitoreo integrados.',
  '1384': 'Panorama de las políticas chinas de 2018–2023 sobre líneas vitales urbanas, bases de datos de riesgos y plataformas de alerta temprana.',
  '1385': 'El ministerio chino de vivienda publicó nuevas medidas para renovar tuberías urbanas de gas, con criterios de financiación y supervisión.',
  '1386': 'Hitelecom presentó su plataforma en la nube, gateways IoT y sensores de bajo consumo para monitoreo industrial en IOTE Shanghai 2024.',
  '1387': 'Hitelecom presentó su plataforma en la nube y sensores ambientales en una feria de monitoreo y control de procesos celebrada en Shanghái.',
  '1388': 'Hitelecom mostró su sensor de distancia por radar conectado a la nube para pozos de registro e infraestructura urbana en Wuhan 2024.',
  '1389': 'Hitelecom presentó su plataforma en la nube y un sensor de inclinación de bajo consumo para monitoreo estructural en electronica China 2023.',
  '1390': 'Hitelecom agradece el apoyo de sus clientes y socios y les desea un feliz Festival del Medio Otoño lleno de salud y prosperidad.',
  '1391': 'Hitelecom agradece el apoyo de sus clientes y socios y les desea un feliz Festival del Bote del Dragón lleno de salud y prosperidad.',
  '1392': 'Hitelecom reconoce la contribución de las mujeres de sus equipos, clientes y socios y reafirma su compromiso con un entorno laboral inclusivo.',
  '1393': 'Hitelecom presenta un sensor de calidad del aire 6 en 1 para CO₂, PM2,5, TVOC, temperatura, humedad y presión, con canales opcionales.',
  '1394': 'Hitelecom presentó más de 20 terminales de sensores en MWC Shanghai e IOTE Shanghai 2025 y recibió un premio IoT Star a la innovación.',
};
const pageDesc = seoDesc[id] || card?.excerpt || bodyText.slice(0, 160) || undefined;
const isoDate = (det.date.match(/(\d{4})[-.](\d{2})[-.](\d{2})/) || []).slice(1).join('-') || undefined;
const articleImg = card?.img ? new URL(await optimizedSrc(card.img, { width: 900 }), Astro.site).href : undefined;

const catUrl = { company: 'news', exh: 'news/index/cid/81', ind: 'news/index/cid/80' }[det.cat];
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.hitelecom.com/es' },
    { '@type': 'ListItem', position: 2, name: 'Noticias', item: 'https://www.hitelecom.com/es/news' },
    { '@type': 'ListItem', position: 3, name: d.catNames[det.cat], item: `https://www.hitelecom.com/es/${catUrl}` },
    ...(det.title ? [{ '@type': 'ListItem', position: 4, name: det.title }] : []),
  ],
};
const articleLd = det.title ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: det.title,
  ...(articleImg ? { image: articleImg } : {}),
  ...(isoDate ? { datePublished: isoDate } : {}),
  ...(det.updated ? { dateModified: det.updated } : isoDate ? { dateModified: isoDate } : {}),
  inLanguage: 'es',
  author: { '@id': 'https://www.hitelecom.com/#organization' },
  publisher: { '@id': 'https://www.hitelecom.com/#organization' },
  mainEntityOfPage: `https://www.hitelecom.com/es/news/show/id/${id}`,
} : null;
---

<BaseLayout locale="es" preloadImage={articleImg} title={pageTitle} description={pageDesc}>
  <NewsShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    {articleLd && <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
    <NewsDetailBody locale="es" id={id} />
  </NewsShell>
</BaseLayout>
