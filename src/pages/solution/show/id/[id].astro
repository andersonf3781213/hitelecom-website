---
/**
 * V142: 行业方案详情页（英文，/solution/show/id/{id}）：57/58/59/60/64/65/66/67。
 * 全新设计，数据在 en.details.json（warehouse 条目走独立路由，不在此生成）。
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SolutionDetail from '../../../../components/solutions/SolutionDetail.astro';
import { SITE_URL } from '../../../../utils/jsonld';
import hubData from '../../../../data/solutions/en.json';
import details from '../../../../data/solutions/en.details.json';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () =>
  Object.keys(details)
    .filter((id) => id !== 'warehouse')
    .map((id) => ({ params: { id } }));

const { id } = Astro.params;
const ui = hubData.ui;
const d = (details as any)[id!];

const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: d.title,
  description: d.metaDescription,
  url: `${SITE_URL}${d.url}`,
  inLanguage: 'en',
};
---

<BaseLayout
  locale="en"
  title={d.title}
  description={d.metaDescription}
  preloadImage={d.heroImg}
  alternates={['en']}
>
  <SolutionDetail d={d} ui={ui} fields={hubData.enquiry.fields} applicationOptions={hubData.enquiry.applicationOptions} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(webPageLd)} />
  <script>
    import '../../../../components/solutions/solutions-interactions.js';
  </script>
</BaseLayout>
