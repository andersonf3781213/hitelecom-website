---
/**
 * 解决方案首页（英文）：/solution
 * GPT6 V18.1 页面接入现网公共 BaseLayout：
 * - 复用官网页头、页脚、七语切换、SEO canonical/hreflang
 * - 正文限定在 .ht-solutions 命名空间，避免污染其他语言与详情页
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SolutionsHome from '../components/solutions/SolutionsHome.astro';
import { site } from '../data/solutions.en';
import { programs } from '../data/programs.en';
import { additionalApplications } from '../data/additional-applications.en';

const pageUrl = new URL('/solution', Astro.site).href;
const origin = new URL(pageUrl).origin;
const pageId = `${pageUrl}#webpage`;
const listId = `${pageUrl}#solution-list`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const schemaIndustries = [
  ...programs.map(({ name, id }) => ({ name, url: `#${id}` })),
  // 与 GPT6 验收保持一致：共用任务的扩展应用不重复登记实体
  ...additionalApplications
    .filter((application) => !programs.some((program) => program.name === application.interest))
    .map(({ title, id }) => ({ name: title.replace(/\n/g, ' '), url: `#${id}` })),
];
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': pageId,
      url: pageUrl,
      name: site.title,
      description: site.description,
      inLanguage: 'en',
      publisher: { '@id': `${origin}/#organization` },
      mainEntity: { '@id': listId },
      breadcrumb: { '@id': breadcrumbId },
    },
    {
      '@type': 'ItemList',
      '@id': listId,
      name: 'Hitelecom monitoring solutions by application',
      numberOfItems: schemaIndustries.length,
      itemListElement: schemaIndustries.map((industry, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'Thing',
          '@id': new URL(industry.url, pageUrl).href,
          url: new URL(industry.url, pageUrl).href,
          name: industry.name,
        },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` },
        { '@type': 'ListItem', position: 2, name: 'Solutions', item: pageUrl },
      ],
    },
  ],
}).replace(/</g, '\\u003c');
---

<BaseLayout
  locale="en"
  title={site.title}
  description={site.description}
  socialImage="/assets/solutions/og-solutions.webp"
>
  <script slot="head" type="application/ld+json" set:html={structuredData} />
  <SolutionsHome landmark={false} />
</BaseLayout>
