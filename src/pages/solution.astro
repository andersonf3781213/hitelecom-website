---
/**
 * V142: Solutions 总览（英文，/solution）。
 * 全新设计：hero + 精选任务 + 行业入口 + 监测主题 + 组网架构 + 证据 + 步骤 + FAQ + 询盘。
 * 旧第二页内容合并进本页，/solution/page/2 301 到本页（见 scripts/make-redirects.mjs）。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SolutionsHub from '../components/solutions/SolutionsHub.astro';
import { SITE_URL } from '../utils/jsonld';
import hubData from '../data/solutions/en.json';

const d = hubData;

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: d.title,
  description: d.metaDescription,
  url: `${SITE_URL}/solution`,
  inLanguage: 'en',
};
---

<BaseLayout
  locale="en"
  title={d.title}
  description={d.metaDescription}
  preloadImage="/assets/solution/index-banner.jpg"
  alternates={['en']}
>
  <SolutionsHub d={d} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(collectionLd)} />
  <script>
    import '../components/solutions/solutions-interactions.js';
  </script>
</BaseLayout>
