---
/**
 * 新闻中心（英文，公司新闻）：/news.html
 * 与原站 /news/ 1:1：横幅 + 分类选项卡 + 头条轮播（2 条）+ 9 张新闻卡
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsShell from '../components/news/NewsShell.astro';
import NewsList from '../components/news/NewsList.astro';
import { optimizedSrc } from '../utils/images';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hitelecom.com/' },
    { '@type': 'ListItem', position: 2, name: 'News', item: 'https://www.hitelecom.com/news.html' },
  ],
};
const pageBanner = await optimizedSrc('news/banner.jpg', { width: 1920, quality: 82 });
---

<BaseLayout
  preloadImage={pageBanner}
  locale="en"
  title="Hitelecom News | Industrial IoT Products and Events"
  description="Read Hitelecom product announcements, certification updates, exhibition news and selected industrial IoT market insights."
>
  <NewsShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <NewsList locale="en" cat="company" />
  </NewsShell>
</BaseLayout>
