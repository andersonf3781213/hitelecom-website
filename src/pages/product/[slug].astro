---
/**
 * 产品详情页（英文）：/product/{slug}.html（语义化专业地址）
 * 结构与原站一致：首屏系列横幅 + 面包屑 + 特性图标 + 技术规格 + 应用场景 + 相关推荐
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductShell from '../../components/product/ProductShell.astro';
import ProductCard from '../../components/product/ProductCard.astro';
import Img from '../../components/Img.astro';
import { productContent, detailSeo, productSlugs, productIdsBySlug, getMergedProducts, getCmsProductDetails } from '../../data/product';
import { l } from '../../i18n';
import { optimizedSrc } from '../../utils/images';
import { enhanceContentHtml, normalizeBody } from '../../utils/content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const cms = await getCmsProductDetails('en');
  return [...Object.values(productSlugs), ...Object.keys(cms)].map((slug) => ({ params: { slug } }));
};

const { slug } = Astro.params;
const id = productIdsBySlug[slug] ?? slug;
const pc = await getMergedProducts('en');
const d = pc.details[id];
const relatedCards = d.related
  .map((rid) => Object.values(pc.lists).flatMap((l_) => l_.products).find((p) => p.id === rid))
  .filter(Boolean);
const heroSrc = await optimizedSrc(d.heroImg, { width: 760 });
const bodyHtml = d.body ? await enhanceContentHtml(normalizeBody(d.body), d.series) : '';

// ——— GEO：完整实体图（Product + Breadcrumb + WebPage + FAQPage）———
const pageUrl = `https://www.hitelecom.com/product/${slug}.html`;
const heroUrl = new URL(heroSrc, Astro.site).href;
// 规格：优先结构化，回退旧 [name,value] 格式（19 系列零内容成本）
const specSource = d.specsStructured ?? d.specs.map(([name, value]) => ({ name, value }));
const sku = d.sku ?? d.specs.find(([k]) => /models?|型号/i.test(k))?.[1] ?? d.series;
const additionalProperty = [
  ...specSource.map((s) => ({
    '@type': 'PropertyValue',
    name: s.name,
    value: s.value,
    ...('unitText' in s && s.unitText ? { unitText: s.unitText } : {}),
    ...('minValue' in s && s.minValue !== undefined ? { minValue: s.minValue } : {}),
    ...('maxValue' in s && s.maxValue !== undefined ? { maxValue: s.maxValue } : {}),
  })),
  // 应用领域也进 additionalProperty，多一重保险
  ...(d.applications ?? []).map((a) => ({
    '@type': 'PropertyValue',
    name: 'Application',
    value: a.name,
    description: a.desc,
  })),
];
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  '@id': `${pageUrl}#product`,
  name: d.series,
  sku,
  mpn: sku,
  description: d.summary ?? d.desc,
  image: { '@type': 'ImageObject', url: heroUrl, caption: d.series },
  brand: { '@type': 'Brand', name: 'Hitelecom' },
  manufacturer: { '@id': 'https://www.hitelecom.com/#organization' },
  category: d.crumbCat,
  countryOfOrigin: { '@type': 'Country', name: 'CN' },
  url: pageUrl,
  additionalProperty,
  // B2B 无公开报价，但必须有 offers 节点，否则 AI 判定为「非商品」
  offers: {
    '@type': 'Offer',
    url: pageUrl,
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    businessFunction: 'http://purl.org/goodrelations/v1#Sell',
    seller: { '@id': 'https://www.hitelecom.com/#organization' },
    areaServed: 'Worldwide',
    priceSpecification: { '@type': 'PriceSpecification', valueAddedTaxIncluded: false },
  },
  audience: {
    '@type': 'BusinessAudience',
    audienceType: 'Infrastructure monitoring, construction, mining, utilities, rail, water conservancy, telecom, manufacturing',
  },
  ...(d.applications?.length ? { keywords: d.applications.map((a) => a.name).join(', ') } : {}),
  isSimilarTo: d.related
    .filter((rid) => productContent.en.details[rid])
    .slice(0, 6)
    .map((rid) => ({ '@type': 'Product', '@id': `https://www.hitelecom.com/product/${productSlugs[rid] ?? rid}.html#product` })),
  ...(d.certifications?.length
    ? {
        hasCertification: d.certifications.map((c) => ({
          '@type': 'Certification',
          name: c,
          issuedBy: { '@type': 'Organization', name: c.startsWith('ISO') ? 'ISO' : 'Regulatory body' },
        })),
      }
    : {}),
};
const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: detailSeo.en[id]?.title ?? `${d.series} | Hitelecom Industrial IoT Sensors`,
  description: detailSeo.en[id]?.desc ?? d.desc,
  inLanguage: 'en',
  isPartOf: { '@id': 'https://www.hitelecom.com/#website' },
  about: { '@id': `${pageUrl}#product` },
  primaryImageOfPage: { '@type': 'ImageObject', url: heroUrl },
  ...(d.dateModified ? { dateModified: d.dateModified } : {}),
};
const faqLd = d.faqs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: d.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hitelecom.com/' },
    { '@type': 'ListItem', position: 2, name: 'Product', item: 'https://www.hitelecom.com/product.html' },
    { '@type': 'ListItem', position: 3, name: d.series },
  ],
};
---

<BaseLayout locale="en" preloadImage={heroSrc} title={detailSeo.en[id]?.title ?? `${d.series} | Hitelecom Industrial IoT Sensors`} description={detailSeo.en[id]?.desc ?? d.desc}>
  <ProductShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify([productLd, breadcrumbLd, webPageLd, faqLd].filter(Boolean))} />

    {/* 首屏：系列标题 + 卖点 + 产品大图（深色全屏） */}
    <div class="clearfix pro_info_1">
      <div class="pro_info_1_mask">
        <div class="cell_mid"><div class="cell_h">
          <div class="indexmid">
            <div class="pro_info_1_mask_mid">
              <h1 class="pro_info_1_mask_1 reveal">{d.series}</h1>
              <div class="pro_info_1_mask_2 reveal">{d.tagline}</div>
              <p class="pro_info_1_mask_3 reveal">{d.summary ?? d.desc}</p>
              <div class="pro_info_1_mask_4">
                <div class="yun_6_1 reveal">
                  <ul>
                    {d.pdf && <li><a href={d.pdf} target="_blank" rel="noopener" class="css3"><span>PDF</span></a></li>}
                    <li><a href={l('/about/contact', 'en')} class="css3"><span>Contact us</span></a></li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div></div>
      </div>
      <div class="bpic he_b1s1">
        <div class="indexmid">
          <div class="bpic_img">
            <div class="bpic_img_img">
              <div style="display:inline-block" class="he_c04rig">
                <Img src={d.heroImg} alt={d.series} widths={[420, 760]} sizes="(max-width: 900px) 70vw, 36vw" loading="eager" fetchpriority="high" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="clearfix pro_info_2">
      {/* 面包屑 + 返回 */}
      <div class="clearfix so_info_1">
        <div class="indexmid">
          <div class="so_info_1_mid reveal">
            <div class="so_info_1_mid_left">
              <a href={l('/', 'en')}>Home</a> / <a href={l('/product/', 'en')}>Product</a> / <span>{d.crumbCat}</span>
            </div>
            <div class="so_info_1_mid_right">
              <a href={l(`/product/lists/cid/${d.returnCid}`, 'en')}>Return</a>
            </div>
          </div>
        </div>
      </div>

      {/* 特性图标网格 */}
      <div class="pro_info_2_2">
        <div class="indexmid">
          <div class="pro_info_1_mask_mid pro_info_1_mask_mid_pro">
            <h2 class="pro_info_1_mask_1 reveal">Key Features</h2>
            <div class="pro_info_1_mask_2 reveal">{d.tagline}</div>
            <div class="pro_info_2_2_list">
              <ul>
                {d.features.map((f) => (
                  <li class="reveal">
                    <div class="pro_info_2_2_list_mid">
                      <div class="pro_info_2_2_list_mid_left">
                        {f.icon ? <Img src={f.icon} alt="" natural loading="lazy" /> : null}
                      </div>
                      <div class="pro_info_2_2_list_mid_right"><span>{f.text}</span></div>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* 技术规格 */}
    <div class="clearfix pro_info_3">
      <div class="indexmid">
        <div class="pro_info_3_mid">
          <div class="pro_info_3_mid_left">
            <div class="cell_mid"><div class="cell_h">
              <div class="pro_info_3_mid_left_mid">
                <div class="pro_info_3_mid_left_mid_1 reveal">{d.specsTitle}</div>
                <div class="pro_info_3_mid_left_mid_2 reveal">{d.specsDesc}</div>
                <div class="pro_info_1_mask_4">
                  <div class="yun_6_1 reveal" id="spec-tabs">
                    <ul>
                      <li><a href="javascript:;" class="css3 on" data-tab="param"><span>Parameter</span></a></li>
                      <li><a href="javascript:;" class="css3" data-tab="cert"><span>Certificate</span></a></li>
                    </ul>
                  </div>
                </div>
              </div>
            </div></div>
          </div>
          <div class="pro_info_3_mid_right">
            <div class="pro_info_3_mid_right_mid" data-pane="param">
              {/* 语义化规格表（GEO：AI 抽取的第二重保险），样式与原 div 版完全一致 */}
              <table class="spec-table reveal">
                <caption class="sr-only">{d.series} — Technical Specifications</caption>
                <tbody>
                  {specSource.map((s) => (
                    <tr>
                      <th scope="row">{s.name}</th>
                      <td>{s.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <div class="pro_info_3_mid_right_mid" data-pane="cert" hidden></div>
          </div>
        </div>
      </div>
    </div>

    {/* CMS 新品正文（Overview 附加节） */}
    {bodyHtml ? (
      <section class="clearfix pro_apps" aria-labelledby="pro-overview-title">
        <div class="indexmid">
          <h2 class="index_1_1 reveal" id="pro-overview-title">Overview</h2>
          <div class="pro_apps_intro reveal" set:html={bodyHtml} />
        </div>
      </section>
    ) : null}

    {/* 应用场景（横向滑动；无场景时不渲染整节） */}
    {d.scenarios.length ? (
    <div class="clearfix index_2 pro_info_4">
      <div class="index_2_top">
        <Img src="common/wave.png" alt="" width={1920} height={256} />
      </div>
      <div class="indexmid">
        <div class="index_1_1 reveal">{d.scenariosHeading}</div>
        <div class="clearfix pro_info_4_1 reveal">
          <div class="pro_scen_track" id="scen-track">
            {d.scenarios.map((s) => (
              <div class="pro_scen_item">
                <div class="pro_info_4_1_mid">
                  <div class="pro_info_4_1_mid_1">
                    <Img src={s.img} alt={s.label} widths={[320, 560]} sizes="(max-width: 900px) 60vw, 25vw" />
                  </div>
                  <div class="pro_info_4_1_mid_2">
                    <div class="pro_info_4_1_mid_2_1">{s.label}</div>
                    <div class="pro_info_4_1_mid_2_2"></div>
                  </div>
                </div>
              </div>
            ))}
          </div>
          <div class="pro_info_4_1_left">
            <div class="about_4_1_left_1_left css3" id="l1"></div>
          </div>
          <div class="pro_info_4_1_right">
            <div class="about_4_1_left_1_right css3" id="l2"></div>
          </div>
        </div>
      </div>
    </div>
    ) : null}

    {/* 应用领域（GEO 主战场：每个领域一句「测什么、解决什么问题」，正文真实可见） */}
    {d.applications?.length ? (
      <section class="clearfix pro_apps" aria-labelledby="pro-apps-title">
        <div class="indexmid">
          <h2 class="index_1_1 reveal" id="pro-apps-title">Applications</h2>
          <p class="pro_apps_intro reveal">The {d.series} is deployed across {d.applications.length} monitoring scenarios:</p>
          <ul class="pro_apps_list">
            {d.applications.map((a) => (
              <li class="reveal">
                <h3>{a.name}</h3>
                <p>{a.desc}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ) : null}

    {/* FAQ（GEO：AI 引用率最高的内容形态；正文与 JSON-LD 同步，不作弊） */}
    {d.faqs?.length ? (
      <section class="clearfix pro_faq" aria-labelledby="pro-faq-title">
        <div class="indexmid">
          <h2 class="index_1_1 reveal" id="pro-faq-title">Frequently Asked Questions</h2>
          <dl class="pro_faq_list">
            {d.faqs.map((f) => (
              <div class="pro_faq_item reveal">
                <dt>{f.q}</dt>
                <dd>{f.a}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    ) : null}

    {/* 相关推荐 */}
    <div class="clearfix so_info_5">
      <div class="indexmid">
        <div class="index_1_1 reveal">Other products that you may be interested in</div>
        <div class="clearfix so_info_5_1 reveal">
          <div class="pro_2_mid_right_1">
            <ul class="pro_rel_track" id="rel-track">
              {relatedCards.map((p) => p && <ProductCard locale="en" product={p} />)}
            </ul>
            <div class="pro_rel_pag" id="rel-pag"></div>
          </div>
        </div>
      </div>
    </div>
  </ProductShell>
</BaseLayout>


<script>
  // Parameter / Certificate 切换（原站证书区无内容，保持一致的切换行为）
  document.querySelectorAll('#spec-tabs a').forEach((a) => {
    a.addEventListener('click', () => {
      const tab = (a as HTMLElement).dataset.tab;
      document.querySelectorAll('#spec-tabs a').forEach((x) => x.classList.toggle('on', x === a));
      document.querySelectorAll('[data-pane]').forEach((p) => {
        (p as HTMLElement).hidden = (p as HTMLElement).dataset.pane !== tab;
      });
    });
  });

  // 首屏产品大图随滚动上下移动（复刻原站 s1Text 逻辑）：
  // 滚动未越界时 top = 视口高*0.18 + scrollY，图片视觉钉住、相对页面向下移；
  // 超过 end-80 后 top 固定为 end，图片随页面一同滚走。
  // end = 视口高*0.18 + 视口高 + 面包屑栏高（与原站 getParam 完全一致）。
  const heroPic = document.querySelector('.he_b1s1') as HTMLElement | null;
  const soInfo = document.querySelector('.so_info_1') as HTMLElement | null;
  if (heroPic && soInfo) {
    let vh = 0;
    let end = 0;
    const getParam = () => {
      vh = window.innerHeight;
      end = vh * 0.18 + vh + soInfo.offsetHeight;
    };
    const judeFixed = () => {
      if (getComputedStyle(heroPic).display === 'none') return; // 移动端隐藏该图，不启用
      const st = window.scrollY || document.documentElement.scrollTop || 0;
      heroPic.style.top = (st > end - 80 ? end : vh * 0.18 + st) + 'px';
    };
    const initParallax = () => { getParam(); judeFixed(); };
    initParallax();
    window.addEventListener('load', initParallax);
    window.addEventListener('resize', initParallax);
    window.addEventListener('scroll', judeFixed, { passive: true });
  }

  // 横滑轨（相关推荐 + 应用场景）：按单张步进，复刻原站 Swiper slidesPerGroup:1 行为
  const setupTrack = (track: HTMLElement | null, pag: HTMLElement | null) => {
    if (!track) return { goTo: (_i: number) => {}, curIdx: () => 0 };
    const gap = () => parseFloat(getComputedStyle(track).gap) || 20;
    const step = () => (track.children[0] as HTMLElement).getBoundingClientRect().width + gap();
    const perView = () => Math.max(1, Math.round((track.clientWidth + gap()) / step()));
    const maxIdx = () => Math.max(0, track.children.length - perView());
    const goTo = (i: number) => {
      const idx = Math.max(0, Math.min(i, maxIdx()));
      track.scrollTo({ left: idx * step(), behavior: 'smooth' });
    };
    const curIdx = () => Math.round(track.scrollLeft / step());
    if (pag) {
      const buildDots = () => {
        pag.innerHTML = '';
        for (let i = 0; i <= maxIdx(); i++) {
          const dot = document.createElement('span');
          if (i === Math.min(curIdx(), maxIdx())) dot.classList.add('on');
          dot.addEventListener('click', () => goTo(i));
          pag.appendChild(dot);
        }
      };
      buildDots();
      window.addEventListener('resize', buildDots);
      track.addEventListener('scroll', () => {
        const i = Math.min(curIdx(), maxIdx());
        pag.querySelectorAll('span').forEach((d, k) => d.classList.toggle('on', k === i));
      }, { passive: true });
    }
    return { goTo, curIdx };
  };
  const relTrack = setupTrack(document.getElementById('rel-track'), document.getElementById('rel-pag'));
  const scenTrack = setupTrack(document.getElementById('scen-track'), null);
  document.getElementById('l1')?.addEventListener('click', () => scenTrack.goTo(scenTrack.curIdx() - 1));
  document.getElementById('l2')?.addEventListener('click', () => scenTrack.goTo(scenTrack.curIdx() + 1));
</script>
