---
/**
 * 关于我们 - 公司简介（英文）：/about.html
 * 与原站 /about/ 1:1：横幅 + 五个选项卡 + 简介/企业文化/发展历程/环境/荣誉
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutShell from '../components/about/AboutShell.astro';
import AboutIntro from '../components/about/AboutIntro.astro';
import { contentImageSrc } from '../utils/content';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hitelecom.com/' },
    { '@type': 'ListItem', position: 2, name: 'About', item: 'https://www.hitelecom.com/about.html' },
  ],
};
const aboutBanner = (await contentImageSrc('/images/about/up_7428e98f9a91fcccdaa6c5ede77c3cc2.webp', 1920)) ?? undefined;
---

<BaseLayout
  preloadImage={aboutBanner}
  locale="en"
  title="About Hitelecom | Industrial IoT Sensor Manufacturer Since 2012"
  description="Hitelecom (est. 2012, Shanghai) designs and manufactures industrial IoT sensors: outdoor 4G and NB-IoT terminals, data loggers and Hitelecom Cloud. Learn about our history, culture and honors."
>
  <AboutShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <AboutIntro locale="en" />
  </AboutShell>
</BaseLayout>
