---
/**
 * 支持服务页（英文，第 2 页）：/service/page/2.html
 * 与原站 /service.html?page=2 一致：文档下载区为第 2 页卡片（3 张），分页 2 高亮
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ServiceShell from '../../../components/service/ServiceShell.astro';
import ServiceBody from '../../../components/service/ServiceBody.astro';
import { optimizedSrc } from '../../../utils/images';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hitelecom.com/' },
    { '@type': 'ListItem', position: 2, name: 'Service', item: 'https://www.hitelecom.com/service.html' },
  ],
};
const pageBanner = await optimizedSrc('service/banner.jpg', { width: 1920, quality: 82 });
---

<BaseLayout
  preloadImage={pageBanner}
  locale="en"
  title="Document Download | IoT Sensor Brochures - Hitelecom"
  description="Download Hitelecom IoT sensor brochures: radar distance, temperature and pressure sensors for outdoor 4G and NB-IoT monitoring, with Hitelecom Cloud integration."
>
  <ServiceShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <ServiceBody locale="en" page={2} />
  </ServiceShell>
</BaseLayout>
