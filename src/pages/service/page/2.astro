---
/**
 * 旧英文资料分页 /service/page/2：Support V9 起资料不再分页。
 * 生产环境由 Cloudflare Pages 301 到 /service（见 scripts/make-redirects.mjs）；
 * 本页仅为回退：meta refresh + JS 跳转到 /service#page3（资料区）。
 */
const target = '/service#page3';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Resources have moved | Hitelecom</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href="https://www.hitelecom.com/service" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p>Product resources have moved to <a href={target}>Support &amp; Service</a>.</p>
    <script is:inline>location.replace('/service#page3');</script>
  </body>
</html>
