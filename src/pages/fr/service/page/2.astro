---
/**
 * 支持服务页（英文，第 2 页）：/service/page/2
 * 与原站 /service.html?page=2 一致：文档下载区为第 2 页卡片（3 张），分页 2 高亮
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ServiceShell from '../../../../components/service/ServiceShell.astro';
import ServiceBody from '../../../../components/service/ServiceBody.astro';
import { optimizedSrc } from '../../../../utils/images';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.hitelecom.com/fr' },
    { '@type': 'ListItem', position: 2, name: 'Support', item: 'https://www.hitelecom.com/fr/service' },
  ],
};
const pageBanner = await optimizedSrc('service/banner.jpg', { width: 1920, quality: 82 });
---

<BaseLayout
  preloadImage={pageBanner}
  locale="fr"
  title="Téléchargement de documents | Brochures capteurs IoT - Hitelecom"
  description="Téléchargez les brochures et manuels Hitelecom des produits 4G ou NB-IoT : température, pression, distance et plus."
>
  <ServiceShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <ServiceBody locale="fr" page={2} />
  </ServiceShell>
</BaseLayout>
