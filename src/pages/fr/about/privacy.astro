---
/**
 * 关于我们 - 隐私政策（英文）：/about/privacy
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AboutShell from '../../../components/about/AboutShell.astro';
import { getAboutSection } from '../../../data/about';
import { enhanceContentHtml, normalizeBody, contentImageSrc } from '../../../utils/content';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.hitelecom.com/fr' },
    { '@type': 'ListItem', position: 2, name: 'À propos', item: 'https://www.hitelecom.com/fr/about' },
    { '@type': 'ListItem', position: 3, name: 'Politique de confidentialité', item: 'https://www.hitelecom.com/fr/about/privacy' },
  ],
};
const aboutBanner = (await contentImageSrc('/images/about/up_7428e98f9a91fcccdaa6c5ede77c3cc2.webp', 1920)) ?? undefined;
---

<BaseLayout
  preloadImage={aboutBanner}
  locale="fr"
  title="Politique de confidentialité | Hitelecom"
  description="Comment Hitelecom collecte, utilise et protège les informations personnelles transmises via ce site, et comment nous contacter au sujet de la confidentialité."
>
  <AboutShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <Fragment set:html={await enhanceContentHtml(normalizeBody(await getAboutSection('fr', 'privacy')), 'Hitelecom Privacy Policy')} />
  </AboutShell>
</BaseLayout>
