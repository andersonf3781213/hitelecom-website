---
/**
 * 关于我们 - 加入我们（英文）：/about/joinus
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AboutShell from '../../../components/about/AboutShell.astro';
import AboutJoinus from '../../../components/about/AboutJoinus.astro';
import { contentImageSrc } from '../../../utils/content';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.hitelecom.com/fr' },
    { '@type': 'ListItem', position: 2, name: 'À propos', item: 'https://www.hitelecom.com/fr/about' },
    { '@type': 'ListItem', position: 3, name: 'Carrières', item: 'https://www.hitelecom.com/fr/about/joinus' },
  ],
};
const aboutBanner = (await contentImageSrc('/images/about/up_7428e98f9a91fcccdaa6c5ede77c3cc2.webp', 1920)) ?? undefined;
---

<BaseLayout
  preloadImage={aboutBanner}
  locale="fr"
  title="Carrières chez Hitelecom | IoT industriel"
  description="Découvrez les carrières chez Hitelecom à Shanghai : systèmes embarqués, logiciels IoT, fabrication électronique, qualité, ventes et opérations."
>
  <AboutShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <AboutJoinus locale="fr" />
  </AboutShell>
</BaseLayout>
