---
/**
 * 关于我们 - 品质与可靠（英文）：/about/quality
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AboutShell from '../../../components/about/AboutShell.astro';
import AboutQuality from '../../../components/about/AboutQuality.astro';
import { contentImageSrc } from '../../../utils/content';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.hitelecom.com/fr' },
    { '@type': 'ListItem', position: 2, name: 'À propos', item: 'https://www.hitelecom.com/fr/about' },
    { '@type': 'ListItem', position: 3, name: 'Qualité et fiabilité', item: 'https://www.hitelecom.com/fr/about/quality' },
  ],
};
const aboutBanner = (await contentImageSrc('/images/about/up_7428e98f9a91fcccdaa6c5ede77c3cc2.webp', 1920)) ?? undefined;
---

<BaseLayout
  preloadImage={aboutBanner}
  locale="fr"
  title="Qualité et fiabilité | Fabrication de capteurs IoT"
  description="Découvrez comment Hitelecom gère la qualité de ses capteurs IoT : production SMT, inspection, tests de fiabilité et systèmes de management certifiés."
>
  <AboutShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <AboutQuality locale="fr" />
  </AboutShell>
</BaseLayout>
