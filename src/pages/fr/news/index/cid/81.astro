---
/**
 * 新闻中心-展会信息（英文）：/news/index/cid/81
 */
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import NewsShell from '../../../../../components/news/NewsShell.astro';
import NewsList from '../../../../../components/news/NewsList.astro';
import { optimizedSrc } from '../../../../../utils/images';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.hitelecom.com/fr' },
    { '@type': 'ListItem', position: 2, name: 'Actualités', item: 'https://www.hitelecom.com/fr/news' },
    { '@type': 'ListItem', position: 3, name: 'Salons', item: 'https://www.hitelecom.com/fr/news/index/cid/81' },
  ],
};
const pageBanner = await optimizedSrc('news/banner.jpg', { width: 1920, quality: 82 });
---

<BaseLayout
  preloadImage={pageBanner}
  locale="fr"
  title="Événements et salons | Hitelecom"
  description="Découvrez les capteurs IoT industriels, passerelles et intégrations cloud Hitelecom présentés à IOTE et d'autres salons du secteur."
>
  <NewsShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <NewsList locale="fr" cat="exh" />
  </NewsShell>
</BaseLayout>
