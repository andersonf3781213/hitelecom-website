---
/**
 * 关于我们 - 公司简介（英文）：/about
 * 与原站 /about/ 1:1：横幅 + 五个选项卡 + 简介/企业文化/发展历程/环境/荣誉
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutShell from '../../components/about/AboutShell.astro';
import AboutIntro from '../../components/about/AboutIntro.astro';
import { contentImageSrc } from '../../utils/content';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.hitelecom.com/fr' },
    { '@type': 'ListItem', position: 2, name: 'À propos', item: 'https://www.hitelecom.com/fr/about' },
  ],
};
const aboutBanner = (await contentImageSrc('/images/about/up_7428e98f9a91fcccdaa6c5ede77c3cc2.webp', 1920)) ?? undefined;
---

<BaseLayout
  preloadImage={aboutBanner}
  locale="fr"
  title="À propos de Hitelecom | Fabricant de capteurs IoT"
  description="Fondée à Shanghai en 2012, Hitelecom conçoit capteurs IoT industriels, enregistreurs de données et solutions de surveillance cloud, avec support OEM/ODM."
>
  <AboutShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <AboutIntro locale="fr" />
  </AboutShell>
</BaseLayout>
