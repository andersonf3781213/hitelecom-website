---
/**
 * 新闻中心（英文，公司新闻）：/news
 * 与原站 /news/ 1:1：横幅 + 分类选项卡 + 头条轮播（2 条）+ 9 张新闻卡
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsShell from '../../components/news/NewsShell.astro';
import NewsList from '../../components/news/NewsList.astro';
import { optimizedSrc } from '../../utils/images';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.hitelecom.com/fr' },
    { '@type': 'ListItem', position: 2, name: 'Actualités', item: 'https://www.hitelecom.com/fr/news' },
  ],
};
const pageBanner = await optimizedSrc('news/banner.jpg', { width: 1920, quality: 82 });
---

<BaseLayout
  preloadImage={pageBanner}
  locale="fr"
  title="Actualités Hitelecom | Produits et événements IoT industriels"
  description="Lisez les annonces produits, les certifications, les salons et une sélection d'analyses du marché de l'IoT industriel de Hitelecom."
>
  <NewsShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <NewsList locale="fr" cat="company" />
  </NewsShell>
</BaseLayout>
