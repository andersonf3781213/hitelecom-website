---
/**
 * 新闻中心-展会信息（英文）：/news/index/cid/81
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import NewsShell from '../../../../components/news/NewsShell.astro';
import NewsList from '../../../../components/news/NewsList.astro';
import { optimizedSrc } from '../../../../utils/images';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hitelecom.com/' },
    { '@type': 'ListItem', position: 2, name: 'News', item: 'https://www.hitelecom.com/news' },
    { '@type': 'ListItem', position: 3, name: 'Exhibition', item: 'https://www.hitelecom.com/news/index/cid/81' },
  ],
};
const pageBanner = await optimizedSrc('news/banner.jpg', { width: 1920, quality: 82 });
---

<BaseLayout
  preloadImage={pageBanner}
  locale="en"
  title="Events & Exhibitions | Hitelecom"
  description="See Hitelecom industrial IoT sensors, gateways and cloud integrations presented at IOTE and other industry events."
>
  <NewsShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <NewsList locale="en" cat="exh" />
  </NewsShell>
</BaseLayout>
