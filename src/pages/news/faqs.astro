---
/**
 * 新闻中心-常见问题（英文）：/news/faqs.html
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsShell from '../../components/news/NewsShell.astro';
import FaqsBody from '../../components/news/FaqsBody.astro';
import { getNewsContent } from '../../data/news';
import { optimizedSrc } from '../../utils/images';

const faqs = (await getNewsContent('en')).faqs;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hitelecom.com/' },
    { '@type': 'ListItem', position: 2, name: 'News', item: 'https://www.hitelecom.com/news.html' },
    { '@type': 'ListItem', position: 3, name: 'FAQs', item: 'https://www.hitelecom.com/news/faqs.html' },
  ],
};
// FAQPage 结构化数据：GEO 核心，问答对可被 Google/AI 直接引用
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const pageBanner = await optimizedSrc('news/banner.jpg', { width: 1920, quality: 82 });
---

<BaseLayout
  preloadImage={pageBanner}
  locale="en"
  title="FAQs | Industrial IoT Sensor Questions & Answers - Hitelecom"
  description="Frequently asked questions about Hitelecom industrial IoT sensors: battery life, EMC design, deployment, accuracy, 4G/NB-IoT/LoRa connectivity and Hitelecom Cloud updates."
>
  <NewsShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    <FaqsBody locale="en" />
  </NewsShell>
</BaseLayout>
