---
/**
 * 新闻详情页（英文）：/news/show/id/{id}.html
 * 与原站 1:1：横幅 → 面包屑+Return → 标题/日期/正文 → Prev/Next → 相关推荐轮播
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import NewsShell from '../../../../components/news/NewsShell.astro';
import NewsDetailBody from '../../../../components/news/NewsDetailBody.astro';
import { getNewsContent, getNewsIds } from '../../../../data/news';
import { optimizedSrc } from '../../../../utils/images';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () =>
  (await getNewsIds('en')).map((id) => ({ params: { id } }));

const { id } = Astro.params;
const d = await getNewsContent('en');
const det = d.details[id];
const card = d.index[id];
// 原站英文 1394 已按中文版补齐；SEO 标题兜底
const pageTitle = det.title ? `${det.title} - Hitelecom` : 'News Center - Hitelecom';
// 部分文章在原站列表无摘要：退回正文纯文本截取，避免多页共用同一 description
const bodyText = det.body
  .replace(/<[^>]+>/g, ' ')
  .replace(/&nbsp;/g, ' ')
  .replace(/&#39;|&rsquo;/g, "'")
  .replace(/&quot;|&ldquo;|&rdquo;/g, '"')
  .replace(/&amp;/g, '&')
  .replace(/\s+/g, ' ')
  .trim();
const pageDesc = card?.excerpt || bodyText.slice(0, 160) || undefined;
const isoDate = (det.date.match(/(\d{4})\.(\d{2})\.(\d{2})/) || []).slice(1).join('-') || undefined;
const articleImg = card?.img ? new URL(await optimizedSrc(card.img, { width: 900 }), Astro.site).href : undefined;

const catUrl = { company: 'news.html', exh: 'news/index/cid/81.html', ind: 'news/index/cid/80.html' }[det.cat];
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hitelecom.com/' },
    { '@type': 'ListItem', position: 2, name: 'News', item: 'https://www.hitelecom.com/news.html' },
    { '@type': 'ListItem', position: 3, name: d.catNames[det.cat], item: `https://www.hitelecom.com/${catUrl}` },
    ...(det.title ? [{ '@type': 'ListItem', position: 4, name: det.title }] : []),
  ],
};
const articleLd = det.title ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: det.title,
  ...(articleImg ? { image: articleImg } : {}),
  ...(isoDate ? { datePublished: isoDate, dateModified: isoDate } : {}),
  inLanguage: 'en',
  author: { '@id': 'https://www.hitelecom.com/#organization' },
  publisher: { '@id': 'https://www.hitelecom.com/#organization' },
  mainEntityOfPage: `https://www.hitelecom.com/news/show/id/${id}.html`,
} : null;
---

<BaseLayout locale="en" preloadImage={articleImg} title={pageTitle} description={pageDesc}>
  <NewsShell>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    {articleLd && <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
    <NewsDetailBody locale="en" id={id} />
  </NewsShell>
</BaseLayout>
