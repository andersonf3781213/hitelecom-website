---
/**
 * 英文首页（默认语言，挂载于 /）
 * V18 设计：主体见 src/components/home/HomeV18.astro
 * headerSolid：首屏为浅色设计，导航栏固定使用实色样式（不随滚动切换）
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeV18 from '../components/home/HomeV18.astro';
import { site } from '../data/site';
// V18 首页样式进 Astro 管线：自动压缩 + 内容哈希（长缓存 immutable），源图仍在 public 下绝对引用，同名可换
import '../styles/home-v18.css';
import '../styles/home-v18-override.css';

// 首页专属结构化数据（GEO/SEO）：页面可见的 12 大传感器家族 + 8 大应用领域
// 每个家族指向其语义化详情页（与卡片上的 View product details 一致）
const families: Array<[string, string]> = [
  ['Industrial Temperature Sensors', '/product/temperature-sensor.html'],
  ['Temperature & Humidity Sensors', '/product/temperature-humidity-sensor.html'],
  ['Temperature & Humidity Data Loggers', '/product/temperature-humidity-data-logger.html'],
  ['Air Quality Sensors', '/product/air-quality-sensor.html'],
  ['TVOC Sensors', '/product/tvoc-sensor.html'],
  ['Pressure Sensors', '/product/pressure-sensor.html'],
  ['Soil Sensors', '/product/soil-moisture-sensor.html'],
  ['Tilt Sensors', '/product/tilt-sensor.html'],
  ['Vibration Sensors', '/product/vibration-sensor.html'],
  ['Radar Distance Sensors', '/product/radar-distance-sensor.html'],
  ['Asset Tracking Sensors', '/product/asset-tracking-sensor.html'],
  ['Custom Gas Sensors', '/product/custom-gas-sensor.html'],
];
// 应用领域：仅收录有独立落地页的条目进 ItemList；
// Warehousing / Transportation / Cold Chain / Sanitation 暂共用 solution.html，
// 多名目同 URL 会被搜索引擎视为列表填充——页面卡片照常展示，只是不进结构化数据
const applications: Array<[string, string]> = [
  ['Smart Cities — Structural health monitoring', '/solution/show/id/57.html'],
  ['Smart Factories — Environment & equipment condition', '/solution/show/id/58.html'],
  ['Smart Water — Pipeline, level & blockage monitoring', '/solution/show/id/67.html'],
  ['Smart Heritage — Microclimate & artifact movement', '/solution/show/id/66.html'],
];
const homeItemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Hitelecom IoT Product Families and Applications',
  itemListElement: [
    ...families.map(([name, href], i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name,
      url: new URL(href, 'https://www.hitelecom.com').href,
    })),
    ...applications.map(([name, href], i) => ({
      '@type': 'ListItem',
      position: families.length + i + 1,
      name,
      url: new URL(href, 'https://www.hitelecom.com').href,
    })),
  ],
};
---

<BaseLayout locale="en" headerSolid v18Grid
  title="Hitelecom | Industrial 4G & NB-IoT Sensors + IoT Cloud"
  description="Sense the Physical World. Hitelecom designs 50+ industrial 4G, NB-IoT and LoRa sensor terminals with private or public cloud deployment. OEM/ODM support.">
  <!-- 首屏 H1 衬线字体（Playfair 500，23KB）预载：黄金 3 秒 -->
  <link slot="head" rel="preload" href="/fonts/playfair-500.woff2" as="font" type="font/woff2" crossorigin />

  <!-- 首屏轮播第 1 帧设备图按断点预载（LCP），其余大图全部 lazy。
       桌面端用 imagesrcset：浏览器按 DPR 自选 1920/2560，与 <img> 决策一致，避免高分辨率屏重复下载 -->
  <link slot="head" rel="preload" as="image" href="/home-assets/img/hero-devices-m-1200-v9.avif" type="image/avif" media="(max-width: 760px)" fetchpriority="high" />
  <link slot="head" rel="preload" as="image" type="image/avif" media="(min-width: 761px)" fetchpriority="high"
        imagesrcset="/home-assets/img/hero-devices-1920-v10.avif 1920w, /home-assets/img/hero-devices-2560-v10.avif 2560w"
        imagesizes="100vw" />

  <!-- 首屏轮播第 2 帧（IoT 云平台图）低优先级预载：
       保证 7s 自动轮播/手动点击切换时图片已就绪，不出现白场闪烁；
       low 优先级不与 LCP 首帧抢带宽 -->
  <link slot="head" rel="preload" as="image" href="/home-assets/img/hero-platform-m-1200-v10.avif" type="image/avif" media="(max-width: 760px)" fetchpriority="low" />
  <link slot="head" rel="preload" as="image" type="image/avif" media="(min-width: 761px)" fetchpriority="low"
        imagesrcset="/home-assets/img/hero-platform-1920-v11.avif 1920w, /home-assets/img/hero-platform-2560-v11.avif 2560w"
        imagesizes="100vw" />

  <script slot="head" type="application/ld+json" set:html={JSON.stringify(homeItemListLd)} />

  <HomeV18 />

  <!-- 询盘表单提交配置（Web3Forms），供 home-v18.js 读取；留空自动回退 mailto -->
  <script is:inline define:vars={{ formEndpoint: site.formEndpoint, formAccessKey: site.formAccessKey }}>
    window.HITE_FORM_ENDPOINT = formEndpoint;
    window.HITE_FORM_KEY = formAccessKey;
  </script>
  <!-- 首页交互进 Astro 管线：打包压缩 + 内容哈希，type=module 天然 defer -->
  <script>import '../scripts/home-v18.js';</script>
</BaseLayout>
