RewriteRule ^zh/product/show/id/286\.html$ /zh/product/explosion-proof-temperature-pressure-sensor.html [R=301,L]
RewriteRule ^product/show/id/287\.html$ /product/coupling-isolator-h100.html [R=301,L]
RewriteRule ^zh/product/show/id/287\.html$ /zh/product/coupling-isolator-h100.html [R=301,L]
RewriteRule ^product/show/id/301\.html$ /product/temperature-humidity-sensor.html [R=301,L]
RewriteRule ^zh/product/show/id/301\.html$ /zh/product/temperature-humidity-sensor.html [R=301,L]
