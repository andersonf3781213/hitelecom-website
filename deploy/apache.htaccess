# ---------------------------------------------------------------
# Hitelecom 官网 · Apache / 虚拟主机配置（由 scripts/make-redirects.mjs 生成，勿手改）
# 用法：重命名为 .htaccess 放到 dist 解压后的站点根目录（需 AllowOverride All），
# 或并入 httpd.conf / vhost 配置。
# ---------------------------------------------------------------

RewriteEngine On

# === 1. 旧产品地址 301 ===
RewriteRule ^product/show/id/270\.html$ /product/temperature-sensor.html [R=301,L]
RewriteRule ^zh/product/show/id/270\.html$ /zh/product/temperature-sensor.html [R=301,L]
RewriteRule ^product/show/id/274\.html$ /product/pressure-sensor.html [R=301,L]
RewriteRule ^zh/product/show/id/274\.html$ /zh/product/pressure-sensor.html [R=301,L]
