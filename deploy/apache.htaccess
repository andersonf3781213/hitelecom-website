RewriteRule ^zh/product/show/id/280\.html$ /zh/product/soil-moisture-sensor.html [R=301,L]
RewriteRule ^product/show/id/281\.html$ /product/liquid-level-sensor.html [R=301,L]
RewriteRule ^zh/product/show/id/281\.html$ /zh/product/liquid-level-sensor.html [R=301,L]
RewriteRule ^product/show/id/282\.html$ /product/tilt-sensor.html [R=301,L]
RewriteRule ^zh/product/show/id/282\.html$ /zh/product/tilt-sensor.html [R=301,L]
RewriteRule ^product/show/id/283\.html$ /product/radar-distance-sensor.html [R=301,L]
RewriteRule ^zh/product/show/id/283\.html$ /zh/product/radar-distance-sensor.html [R=301,L]
RewriteRule ^product/show/id/284\.html$ /product/vibration-sensor.html [R=301,L]
RewriteRule ^zh/product/show/id/284\.html$ /zh/product/vibration-sensor.html [R=301,L]
RewriteRule ^product/show/id/285\.html$ /product/air-quality-sensor.html [R=301,L]
RewriteRule ^zh/product/show/id/285\.html$ /zh/product/air-quality-sensor.html [R=301,L]
